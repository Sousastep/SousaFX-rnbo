            {
                "box": {
                    "id": "obj-14",
                    "maxclass": "newobj",
                    "numinlets": 2,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 2,
                            "revision": 0,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 1807.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "ai.triode_bias_shift",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// triode_bias_shift.txt — cascaded 12AX7 preamp stages with grid conduction:\n//                         each stage's coupling cap charges whenever its grid\n//                         is driven positive, shifting the bias toward cutoff\n//                         (blocking distortion: the choked, farty bloom after\n//                         a hard bass hit, recovering over blocking_ms)\n//\n// From: J. Macak, J. Schimmel, \"Real-Time Guitar Tube Amplifier Simulation\n//       using an Approximation of Differential Equations\", DAFx-10 P12: §3\n//       (triode models: plate current ~ (Vgk + Vpk/mu)^1.5 above cutoff,\n//       grid current once the grid goes positive), §4-5 (triode amplifier:\n//       the coupling-cap voltage is a state of the stage, so the operating\n//       point moves with the signal), §10 (the coupling-cap/grid-current\n//       interaction is what makes a cascade \"block\");\n//       W. R. Dunkel et al., \"The Fender Bassman 5F6-A Family of Preamplifier\n//       Circuits — A Wave Digital Filter Case Study\", DAFx-16 paper 53: §2.2\n//       (cascaded voltage-amp stages coupled by RC networks), §3.4 (triode\n//       model with grid current);\n//       I. Cohen, T. Hélie, \"Real-Time Simulation of a Guitar Power\n//       Amplifier\", DAFx-10 P45 §3.3 (grid current and its effect on bias).\n//\n// One stage (normalized volts, cutoff at grid = -1):\n//   vg  = vin - vc                         (coupling cap vc, grid leak Rg)\n//   vc += a * (vg + 100 * max(vg, 0))      (a = 1 / (blocking_ms * sr):\n//                                           Rg leak + grid-current charge)\n//   ve  = vg - 0.9 * softplus(8 vg) / 8    (grid conduction squashes vg > 0)\n//   ip  = (softplus(6 (ve + bp)) / 6)^1.5  (bp = operating point, from bias)\n//   out = -(ip - ip0) / slope0             (inverting, unity small-signal)\n//   out = lp(out, 10 kHz)                  (Miller capacitance)\n// Stage 1 input = x * dbtoa(drive_db) * 2; later stages get x 3.\n// Output: cutoff ceiling scaled to -6 dBFS, then a 10 Hz coupling cap.\n//\n// Inlets:\n//   in1 / in2: stereo tuba\n// Outlets:\n//   out1 / out2: stereo\n// No safety limiter, no metering.\n// ============================================================================\n\n// Drive into the first stage (dB)\n@param({ min: 0, max: 40 }) drive_db = 20;\n// Bias: cold (0) .. hot (1)\n@param({ min: 0, max: 1 }) bias = 0.5;\n// Coupling-cap recovery (ms)\n@param({ min: 5, max: 500, exponent: 2 }) blocking_ms = 60;\n// Number of triode stages\n@param({ min: 1, max: 3, steps: 3 }) stages = 2;\n// Dry/wet\n@param({ min: 0, max: 1 }) mix = 1;\n// Output gain (dB)\n@param({ min: -36, max: 12 }) output_db = 0;\n\n// coupling-cap voltage per stage x channel: slot = 2 * stage + ch\n@state vc = new FixedSampleArray(6);\n// Miller lowpass per stage x channel, 6/7 output coupling cap\n@state zs = new FixedSampleArray(8);\n\nfunction softplus(z: number): number {\n\treturn (z > 30.0) ? z : log(1.0 + exp(z));\n}\n\n// One triode stage on slot k\nfunction triode(k: Int, vin: number, a: number, kc: number, bp: number, ip0: number, invSlope: number, ggM: number): number {\n\tlet vg = vin - vc[k];\n\tvc[k] = vc[k] + a * vg + kc * maximum(vg, 0.0);\n\tlet ve = vg - 0.9 * softplus(8.0 * vg) * 0.125;\n\tlet base = softplus(6.0 * (ve + bp)) / 6.0;\n\tlet ip = base * sqrt(base);\n\tlet y = (ip0 - ip) * invSlope;\n\tlet v = (y - zs[k]) * ggM;\n\tlet lp = v + zs[k];\n\tzs[k] = lp + v;\n\treturn lp;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\n\nlet bp = 0.2 + 0.6 * clamp(bias, 0.0, 1.0);\nlet a = 1.0 / (clamp(blocking_ms, 5.0, 500.0) * 0.001 * sr);\nlet kc = minimum(100.0 * a, 0.5);\n// idle point: the grid-conduction squash at vg = 0 is softplus(0) / 8\nlet ve0 = 0.0 - 0.9 * 0.6931471805599453 * 0.125;\nlet base0 = softplus(6.0 * (ve0 + bp)) / 6.0;\nlet ip0 = base0 * sqrt(base0);\n// d ip / d vg at idle: 1.5 sqrt(base) * sigmoid(6 (ve0 + bp)) * (1 - 0.45)\nlet sig0 = 1.0 / (1.0 + exp(0.0 - 6.0 * (ve0 + bp)));\nlet invSlope = 1.0 / maximum(1.5 * sqrt(base0) * sig0 * 0.55, 0.0001);\nlet gM = tan(pi * minimum(10000.0, sr * 0.45) / sr);\nlet ggM = gM / (1.0 + gM);\nlet nSt: Int = trunc(clamp(stages, 1.0, 3.0) + 0.5);\nlet gIn = dbtoa(clamp(drive_db, 0.0, 40.0)) * 2.0;\n\nlet yL = xL * gIn;\nlet yR = xR * gIn;\nfor (let s: Int = 0; s < 3; s++) {\n\tif (s < nSt) {\n\t\tlet gs = (s == 0) ? 1.0 : 3.0;\n\t\tyL = triode(2 * s, yL * gs, a, kc, bp, ip0, invSlope, ggM);\n\t\tyR = triode(2 * s + 1, yR * gs, a, kc, bp, ip0, invSlope, ggM);\n\t}\n}\n\n// odd stage counts invert: flip back so mix stays in phase; the cutoff\n// ceiling (ip0 * invSlope) is scaled to -6 dBFS whatever the bias\nlet pol = (nSt == 2) ? 1.0 : -1.0;\nlet scl = pol * 0.5 / maximum(ip0 * invSlope, 0.0001);\nlet yoL = yL * scl;\nlet yoR = yR * scl;\n\n// output coupling cap (10 Hz): asymmetric clipping and blocking make DC\nlet gDc = tan(pi * 10.0 / sr);\nlet ggDc = gDc / (1.0 + gDc);\nlet vdL = (yoL - zs[6]) * ggDc;\nlet lpL = vdL + zs[6];\nzs[6] = lpL + vdL;\nlet vdR = (yoR - zs[7]) * ggDc;\nlet lpR = vdR + zs[7];\nzs[7] = lpR + vdR;\nlet wetL = yoL - lpL;\nlet wetR = yoR - lpR;\n\nlet w = clamp(mix, 0.0, 1.0);\nlet outGain = dbtoa(clamp(output_db, -36.0, 12.0));\nout1 = linearinterp(w, xL, wetL) * outGain;\nout2 = linearinterp(w, xR, wetR) * outGain;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 2,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "nocache": 0,
                                        "expr": "",
                                        "code": "// ============================================================================\n// triode_bias_shift.txt — cascaded 12AX7 preamp stages with grid conduction:\n//                         each stage's coupling cap charges whenever its grid\n//                         is driven positive, shifting the bias toward cutoff\n//                         (blocking distortion: the choked, farty bloom after\n//                         a hard bass hit, recovering over blocking_ms)\n//\n// From: J. Macak, J. Schimmel, \"Real-Time Guitar Tube Amplifier Simulation\n//       using an Approximation of Differential Equations\", DAFx-10 P12: §3\n//       (triode models: plate current ~ (Vgk + Vpk/mu)^1.5 above cutoff,\n//       grid current once the grid goes positive), §4-5 (triode amplifier:\n//       the coupling-cap voltage is a state of the stage, so the operating\n//       point moves with the signal), §10 (the coupling-cap/grid-current\n//       interaction is what makes a cascade \"block\");\n//       W. R. Dunkel et al., \"The Fender Bassman 5F6-A Family of Preamplifier\n//       Circuits — A Wave Digital Filter Case Study\", DAFx-16 paper 53: §2.2\n//       (cascaded voltage-amp stages coupled by RC networks), §3.4 (triode\n//       model with grid current);\n//       I. Cohen, T. Hélie, \"Real-Time Simulation of a Guitar Power\n//       Amplifier\", DAFx-10 P45 §3.3 (grid current and its effect on bias).\n//\n// One stage (normalized volts, cutoff at grid = -1):\n//   vg  = vin - vc                         (coupling cap vc, grid leak Rg)\n//   vc += a * (vg + 100 * max(vg, 0))      (a = 1 / (blocking_ms * sr):\n//                                           Rg leak + grid-current charge)\n//   ve  = vg - 0.9 * softplus(8 vg) / 8    (grid conduction squashes vg > 0)\n//   ip  = (softplus(6 (ve + bp)) / 6)^1.5  (bp = operating point, from bias)\n//   out = -(ip - ip0) / slope0             (inverting, unity small-signal)\n//   out = lp(out, 10 kHz)                  (Miller capacitance)\n// Stage 1 input = x * dbtoa(drive_db) * 2; later stages get x 3.\n// Output: cutoff ceiling scaled to -6 dBFS, then a 10 Hz coupling cap.\n//\n// Inlets:\n//   in1 / in2: stereo tuba\n// Outlets:\n//   out1 / out2: stereo\n// No safety limiter, no metering.\n// ============================================================================\n\n// Drive into the first stage (dB)\n@param({ min: 0, max: 40 }) drive_db = 20;\n// Bias: cold (0) .. hot (1)\n@param({ min: 0, max: 1 }) bias = 0.5;\n// Coupling-cap recovery (ms)\n@param({ min: 5, max: 500, exponent: 2 }) blocking_ms = 60;\n// Number of triode stages\n@param({ min: 1, max: 3, steps: 3 }) stages = 2;\n// Dry/wet\n@param({ min: 0, max: 1 }) mix = 1;\n// Output gain (dB)\n@param({ min: -36, max: 12 }) output_db = 0;\n\n// coupling-cap voltage per stage x channel: slot = 2 * stage + ch\n@state vc = new FixedSampleArray(6);\n// Miller lowpass per stage x channel, 6/7 output coupling cap\n@state zs = new FixedSampleArray(8);\n\nfunction softplus(z: number): number {\n\treturn (z > 30.0) ? z : log(1.0 + exp(z));\n}\n\n// One triode stage on slot k\nfunction triode(k: Int, vin: number, a: number, kc: number, bp: number, ip0: number, invSlope: number, ggM: number): number {\n\tlet vg = vin - vc[k];\n\tvc[k] = vc[k] + a * vg + kc * maximum(vg, 0.0);\n\tlet ve = vg - 0.9 * softplus(8.0 * vg) * 0.125;\n\tlet base = softplus(6.0 * (ve + bp)) / 6.0;\n\tlet ip = base * sqrt(base);\n\tlet y = (ip0 - ip) * invSlope;\n\tlet v = (y - zs[k]) * ggM;\n\tlet lp = v + zs[k];\n\tzs[k] = lp + v;\n\treturn lp;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\n\nlet bp = 0.2 + 0.6 * clamp(bias, 0.0, 1.0);\nlet a = 1.0 / (clamp(blocking_ms, 5.0, 500.0) * 0.001 * sr);\nlet kc = minimum(100.0 * a, 0.5);\n// idle point: the grid-conduction squash at vg = 0 is softplus(0) / 8\nlet ve0 = 0.0 - 0.9 * 0.6931471805599453 * 0.125;\nlet base0 = softplus(6.0 * (ve0 + bp)) / 6.0;\nlet ip0 = base0 * sqrt(base0);\n// d ip / d vg at idle: 1.5 sqrt(base) * sigmoid(6 (ve0 + bp)) * (1 - 0.45)\nlet sig0 = 1.0 / (1.0 + exp(0.0 - 6.0 * (ve0 + bp)));\nlet invSlope = 1.0 / maximum(1.5 * sqrt(base0) * sig0 * 0.55, 0.0001);\nlet gM = tan(pi * minimum(10000.0, sr * 0.45) / sr);\nlet ggM = gM / (1.0 + gM);\nlet nSt: Int = trunc(clamp(stages, 1.0, 3.0) + 0.5);\nlet gIn = dbtoa(clamp(drive_db, 0.0, 40.0)) * 2.0;\n\nlet yL = xL * gIn;\nlet yR = xR * gIn;\nfor (let s: Int = 0; s < 3; s++) {\n\tif (s < nSt) {\n\t\tlet gs = (s == 0) ? 1.0 : 3.0;\n\t\tyL = triode(2 * s, yL * gs, a, kc, bp, ip0, invSlope, ggM);\n\t\tyR = triode(2 * s + 1, yR * gs, a, kc, bp, ip0, invSlope, ggM);\n\t}\n}\n\n// odd stage counts invert: flip back so mix stays in phase; the cutoff\n// ceiling (ip0 * invSlope) is scaled to -6 dBFS whatever the bias\nlet pol = (nSt == 2) ? 1.0 : -1.0;\nlet scl = pol * 0.5 / maximum(ip0 * invSlope, 0.0001);\nlet yoL = yL * scl;\nlet yoR = yR * scl;\n\n// output coupling cap (10 Hz): asymmetric clipping and blocking make DC\nlet gDc = tan(pi * 10.0 / sr);\nlet ggDc = gDc / (1.0 + gDc);\nlet vdL = (yoL - zs[6]) * ggDc;\nlet lpL = vdL + zs[6];\nzs[6] = lpL + vdL;\nlet vdR = (yoR - zs[7]) * ggDc;\nlet lpR = vdR + zs[7];\nzs[7] = lpR + vdR;\nlet wetL = yoL - lpL;\nlet wetR = yoR - lpR;\n\nlet w = clamp(mix, 0.0, 1.0);\nlet outGain = dbtoa(clamp(output_db, -36.0, 12.0));\nout1 = linearinterp(w, xL, wetL) * outGain;\nout2 = linearinterp(w, xR, wetR) * outGain;\n",
                                        "safemath": 1
                                    },
