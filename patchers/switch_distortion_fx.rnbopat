            {
                "box": {
                    "id": "obj-8",
                    "maxclass": "newobj",
                    "numinlets": 2,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 2,
                            "revision": 0,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 2015.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "ai.cab_speaker_excursion",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// cab_speaker_excursion.txt — guitar-cab speaker simulation with excursion\n//                             distortion: a nonlinear cone oscillator whose\n//                             motor force falls and whose suspension\n//                             stiffens with excursion (so low, loud notes\n//                             distort and compress while highs stay clean),\n//                             plus box, cone breakup and off-axis mic tone\n//\n// From: M. Karjalainen, \"Nonlinear Modeling of a Guitar Loudspeaker Cabinet\",\n//       DAFx-08 (2008 paper 17): §2.1 (linear driver: a mass-spring-damper\n//       driven by the voice-coil force; radiated pressure ~ cone\n//       acceleration, so the response rolls off at 12 dB/oct below the\n//       mechanical resonance), §2.2 (nonlinear behaviour at low frequencies\n//       and high levels: force factor Bl(x) and suspension stiffness K(x)\n//       vary with excursion x), §5.1 (model development: a low-frequency\n//       excursion-dependent nonlinearity plus linear filtering for the\n//       cabinet's upper response, cone breakup region included);\n//       J. Macak, J. Schimmel, DAFx-10 P12 §8 (the speaker cabinet as the\n//       last block of the amp chain).\n//\n// Cone (mass 1, normalized excursion e = x w^2; one oscillator per channel):\n//   F  = Bl(e) u - w^2 (1 + 0.3 e^2) x - (w / Q) v,  Bl(e) = 1 / (1 + 0.15 e^2)\n//   v += F dt,  x += v dt                    (semi-implicit Euler)\n//   p  = F                                   (pressure ~ acceleration)\n//   u  = x_in * dbtoa(excursion_db) * 2,  wet scaled by 1 / that gain\n//   w  = 2 pi resonance_hz (1 + 0.4 c),  Q = 0.7 + 1.3 c  (c = closed_pct/100:\n//        a sealed box's air spring raises resonance and Q)\n// Box: open back adds dipole cancellation, p_open = hp1(p, 150 Hz);\n//      p = c p + (1 - c) p_open\n// Cone breakup: +6 dB peak at breakup_hz (Q 1.5), 2-pole lowpass at\n//      1.6 breakup_hz (Q 0.8)\n// Mic: 2-pole lowpass at mic_hz (Q 0.6), off-axis darkening\n//\n// Inlets:\n//   in1 / in2: stereo tuba\n// Outlets:\n//   out1 / out2: stereo\n// No safety limiter, no metering.\n// ============================================================================\n\n// Speaker resonance (Hz)\n@param({ min: 50, max: 150 }) resonance_hz = 80;\n// Drive into the speaker (dB)\n@param({ min: 0, max: 30 }) excursion_db = 12;\n// Cone breakup (Hz)\n@param({ min: 1000, max: 5000, exponent: 2 }) breakup_hz = 2500;\n// Closed back (0 = open back)\n@param({ min: 0, max: 100 }) closed_pct = 70;\n// Mic off-axis lowpass (Hz)\n@param({ min: 2000, max: 10000, exponent: 2 }) mic_hz = 5000;\n// Dry/wet\n@param({ min: 0, max: 1 }) mix = 1;\n// Output gain (dB)\n@param({ min: -36, max: 12 }) output_db = 0;\n\n@state conePos = new FixedSampleArray(2);\n@state coneVel = new FixedSampleArray(2);\n// TPT one-pole states: 0/1 dipole high-pass\n@state zs = new FixedSampleArray(2);\n// SVF states: slot = 2 * filter + ch (0 breakup lp, 1 mic lp)\n@state ic1 = new FixedSampleArray(4);\n@state ic2 = new FixedSampleArray(4);\n// breakup peak biquad (TDF2)\n@state bq1 = new FixedSampleArray(2);\n@state bq2 = new FixedSampleArray(2);\n\n// TPT one-pole lowpass on state slot idx; gg = g / (1 + g)\nfunction lp1(idx: Int, x: number, gg: number): number {\n\tlet v = (x - zs[idx]) * gg;\n\tlet y = v + zs[idx];\n\tzs[idx] = y + v;\n\treturn y;\n}\n\n// Linear TPT state-variable lowpass on slot k (kd = 1/Q)\nfunction svfLp(k: Int, x: number, g: number, kd: number): number {\n\tlet a1 = 1.0 / (1.0 + g * (g + kd));\n\tlet a2 = g * a1;\n\tlet a3 = g * a2;\n\tlet v3 = x - ic2[k];\n\tlet v1 = a1 * ic1[k] + a2 * v3;\n\tlet v2 = ic2[k] + a2 * ic1[k] + a3 * v3;\n\tic1[k] = 2.0 * v1 - ic1[k];\n\tic2[k] = 2.0 * v2 - ic2[k];\n\treturn v2;\n}\n\n// Transposed direct-form II biquad on slot k (coefficients normalized by a0)\nfunction biquad(k: Int, x: number, b0: number, b1: number, b2: number, a1: number, a2: number): number {\n\tlet y = b0 * x + bq1[k];\n\tbq1[k] = b1 * x - a1 * y + bq2[k];\n\tbq2[k] = b2 * x - a2 * y;\n\treturn y;\n}\n\n// Nonlinear cone on channel ch; returns the acceleration (pressure)\nfunction cone(ch: Int, u: number, w: number, w2: number, damp: number, dt: number): number {\n\tlet x = conePos[ch];\n\tlet v = coneVel[ch];\n\tlet ex = clamp(x * w2, -50.0, 50.0);\n\tlet bl = 1.0 / (1.0 + 0.15 * ex * ex);\n\tlet f = bl * u - w2 * (1.0 + 0.3 * ex * ex) * x - damp * v;\n\tv = v + f * dt;\n\tx = x + v * dt;\n\tconeVel[ch] = v;\n\tconePos[ch] = x;\n\treturn f;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet dt = 1.0 / sr;\nlet xL = in1;\nlet xR = in2;\n\nlet c = clamp(closed_pct, 0.0, 100.0) * 0.01;\nlet w = 2.0 * pi * clamp(resonance_hz, 50.0, 150.0) * (1.0 + 0.4 * c);\nlet w2 = w * w;\nlet damp = w / (0.7 + 1.3 * c);\nlet G = dbtoa(clamp(excursion_db, 0.0, 30.0)) * 2.0;\n\n// --- Cone ----------------------------------------------------------------------\nlet pL = cone(0, G * xL, w, w2, damp, dt) / G;\nlet pR = cone(1, G * xR, w, w2, damp, dt) / G;\n\n// --- Box: open back = dipole cancellation below ~150 Hz ----------------------\nlet gD = tan(pi * 150.0 / sr);\nlet ggD = gD / (1.0 + gD);\nlet oL = pL - lp1(0, pL, ggD);\nlet oR = pR - lp1(1, pR, ggD);\npL = c * pL + (1.0 - c) * oL;\npR = c * pR + (1.0 - c) * oR;\n\n// --- Cone breakup: peak, then rolloff ------------------------------------------\nlet fB = minimum(clamp(breakup_hz, 1000.0, 5000.0), sr * 0.3);\nlet aP = pow(10.0, 6.0 / 40.0);\nlet wP = 2.0 * pi * fB / sr;\nlet cP = cos(wP);\nlet alP = sin(wP) / (2.0 * 1.5);\nlet a0P = 1.0 + alP / aP;\nlet pb0 = (1.0 + alP * aP) / a0P;\nlet pb1 = (0.0 - 2.0) * cP / a0P;\nlet pb2 = (1.0 - alP * aP) / a0P;\nlet pa2 = (1.0 - alP / aP) / a0P;\npL = biquad(0, pL, pb0, pb1, pb2, pb1, pa2);\npR = biquad(1, pR, pb0, pb1, pb2, pb1, pa2);\nlet gB = tan(pi * minimum(1.6 * fB, sr * 0.45) / sr);\npL = svfLp(0, pL, gB, 1.25);\npR = svfLp(1, pR, gB, 1.25);\n\n// --- Mic off-axis --------------------------------------------------------------\nlet gM = tan(pi * minimum(clamp(mic_hz, 2000.0, 10000.0), sr * 0.45) / sr);\nlet wetL = svfLp(2, pL, gM, 1.6666666666666667);\nlet wetR = svfLp(3, pR, gM, 1.6666666666666667);\n\nlet mx = clamp(mix, 0.0, 1.0);\nlet outGain = dbtoa(clamp(output_db, -36.0, 12.0));\nout1 = linearinterp(mx, xL, wetL) * outGain;\nout2 = linearinterp(mx, xR, wetR) * outGain;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 2,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "nocache": 0,
                                        "expr": "",
                                        "code": "// ============================================================================\n// cab_speaker_excursion.txt — guitar-cab speaker simulation with excursion\n//                             distortion: a nonlinear cone oscillator whose\n//                             motor force falls and whose suspension\n//                             stiffens with excursion (so low, loud notes\n//                             distort and compress while highs stay clean),\n//                             plus box, cone breakup and off-axis mic tone\n//\n// From: M. Karjalainen, \"Nonlinear Modeling of a Guitar Loudspeaker Cabinet\",\n//       DAFx-08 (2008 paper 17): §2.1 (linear driver: a mass-spring-damper\n//       driven by the voice-coil force; radiated pressure ~ cone\n//       acceleration, so the response rolls off at 12 dB/oct below the\n//       mechanical resonance), §2.2 (nonlinear behaviour at low frequencies\n//       and high levels: force factor Bl(x) and suspension stiffness K(x)\n//       vary with excursion x), §5.1 (model development: a low-frequency\n//       excursion-dependent nonlinearity plus linear filtering for the\n//       cabinet's upper response, cone breakup region included);\n//       J. Macak, J. Schimmel, DAFx-10 P12 §8 (the speaker cabinet as the\n//       last block of the amp chain).\n//\n// Cone (mass 1, normalized excursion e = x w^2; one oscillator per channel):\n//   F  = Bl(e) u - w^2 (1 + 0.3 e^2) x - (w / Q) v,  Bl(e) = 1 / (1 + 0.15 e^2)\n//   v += F dt,  x += v dt                    (semi-implicit Euler)\n//   p  = F                                   (pressure ~ acceleration)\n//   u  = x_in * dbtoa(excursion_db) * 2,  wet scaled by 1 / that gain\n//   w  = 2 pi resonance_hz (1 + 0.4 c),  Q = 0.7 + 1.3 c  (c = closed_pct/100:\n//        a sealed box's air spring raises resonance and Q)\n// Box: open back adds dipole cancellation, p_open = hp1(p, 150 Hz);\n//      p = c p + (1 - c) p_open\n// Cone breakup: +6 dB peak at breakup_hz (Q 1.5), 2-pole lowpass at\n//      1.6 breakup_hz (Q 0.8)\n// Mic: 2-pole lowpass at mic_hz (Q 0.6), off-axis darkening\n//\n// Inlets:\n//   in1 / in2: stereo tuba\n// Outlets:\n//   out1 / out2: stereo\n// No safety limiter, no metering.\n// ============================================================================\n\n// Speaker resonance (Hz)\n@param({ min: 50, max: 150 }) resonance_hz = 80;\n// Drive into the speaker (dB)\n@param({ min: 0, max: 30 }) excursion_db = 12;\n// Cone breakup (Hz)\n@param({ min: 1000, max: 5000, exponent: 2 }) breakup_hz = 2500;\n// Closed back (0 = open back)\n@param({ min: 0, max: 100 }) closed_pct = 70;\n// Mic off-axis lowpass (Hz)\n@param({ min: 2000, max: 10000, exponent: 2 }) mic_hz = 5000;\n// Dry/wet\n@param({ min: 0, max: 1 }) mix = 1;\n// Output gain (dB)\n@param({ min: -36, max: 12 }) output_db = 0;\n\n@state conePos = new FixedSampleArray(2);\n@state coneVel = new FixedSampleArray(2);\n// TPT one-pole states: 0/1 dipole high-pass\n@state zs = new FixedSampleArray(2);\n// SVF states: slot = 2 * filter + ch (0 breakup lp, 1 mic lp)\n@state ic1 = new FixedSampleArray(4);\n@state ic2 = new FixedSampleArray(4);\n// breakup peak biquad (TDF2)\n@state bq1 = new FixedSampleArray(2);\n@state bq2 = new FixedSampleArray(2);\n\n// TPT one-pole lowpass on state slot idx; gg = g / (1 + g)\nfunction lp1(idx: Int, x: number, gg: number): number {\n\tlet v = (x - zs[idx]) * gg;\n\tlet y = v + zs[idx];\n\tzs[idx] = y + v;\n\treturn y;\n}\n\n// Linear TPT state-variable lowpass on slot k (kd = 1/Q)\nfunction svfLp(k: Int, x: number, g: number, kd: number): number {\n\tlet a1 = 1.0 / (1.0 + g * (g + kd));\n\tlet a2 = g * a1;\n\tlet a3 = g * a2;\n\tlet v3 = x - ic2[k];\n\tlet v1 = a1 * ic1[k] + a2 * v3;\n\tlet v2 = ic2[k] + a2 * ic1[k] + a3 * v3;\n\tic1[k] = 2.0 * v1 - ic1[k];\n\tic2[k] = 2.0 * v2 - ic2[k];\n\treturn v2;\n}\n\n// Transposed direct-form II biquad on slot k (coefficients normalized by a0)\nfunction biquad(k: Int, x: number, b0: number, b1: number, b2: number, a1: number, a2: number): number {\n\tlet y = b0 * x + bq1[k];\n\tbq1[k] = b1 * x - a1 * y + bq2[k];\n\tbq2[k] = b2 * x - a2 * y;\n\treturn y;\n}\n\n// Nonlinear cone on channel ch; returns the acceleration (pressure)\nfunction cone(ch: Int, u: number, w: number, w2: number, damp: number, dt: number): number {\n\tlet x = conePos[ch];\n\tlet v = coneVel[ch];\n\tlet ex = clamp(x * w2, -50.0, 50.0);\n\tlet bl = 1.0 / (1.0 + 0.15 * ex * ex);\n\tlet f = bl * u - w2 * (1.0 + 0.3 * ex * ex) * x - damp * v;\n\tv = v + f * dt;\n\tx = x + v * dt;\n\tconeVel[ch] = v;\n\tconePos[ch] = x;\n\treturn f;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet dt = 1.0 / sr;\nlet xL = in1;\nlet xR = in2;\n\nlet c = clamp(closed_pct, 0.0, 100.0) * 0.01;\nlet w = 2.0 * pi * clamp(resonance_hz, 50.0, 150.0) * (1.0 + 0.4 * c);\nlet w2 = w * w;\nlet damp = w / (0.7 + 1.3 * c);\nlet G = dbtoa(clamp(excursion_db, 0.0, 30.0)) * 2.0;\n\n// --- Cone ----------------------------------------------------------------------\nlet pL = cone(0, G * xL, w, w2, damp, dt) / G;\nlet pR = cone(1, G * xR, w, w2, damp, dt) / G;\n\n// --- Box: open back = dipole cancellation below ~150 Hz ----------------------\nlet gD = tan(pi * 150.0 / sr);\nlet ggD = gD / (1.0 + gD);\nlet oL = pL - lp1(0, pL, ggD);\nlet oR = pR - lp1(1, pR, ggD);\npL = c * pL + (1.0 - c) * oL;\npR = c * pR + (1.0 - c) * oR;\n\n// --- Cone breakup: peak, then rolloff ------------------------------------------\nlet fB = minimum(clamp(breakup_hz, 1000.0, 5000.0), sr * 0.3);\nlet aP = pow(10.0, 6.0 / 40.0);\nlet wP = 2.0 * pi * fB / sr;\nlet cP = cos(wP);\nlet alP = sin(wP) / (2.0 * 1.5);\nlet a0P = 1.0 + alP / aP;\nlet pb0 = (1.0 + alP * aP) / a0P;\nlet pb1 = (0.0 - 2.0) * cP / a0P;\nlet pb2 = (1.0 - alP * aP) / a0P;\nlet pa2 = (1.0 - alP / aP) / a0P;\npL = biquad(0, pL, pb0, pb1, pb2, pb1, pa2);\npR = biquad(1, pR, pb0, pb1, pb2, pb1, pa2);\nlet gB = tan(pi * minimum(1.6 * fB, sr * 0.45) / sr);\npL = svfLp(0, pL, gB, 1.25);\npR = svfLp(1, pR, gB, 1.25);\n\n// --- Mic off-axis --------------------------------------------------------------\nlet gM = tan(pi * minimum(clamp(mic_hz, 2000.0, 10000.0), sr * 0.45) / sr);\nlet wetL = svfLp(2, pL, gM, 1.6666666666666667);\nlet wetR = svfLp(3, pR, gM, 1.6666666666666667);\n\nlet mx = clamp(mix, 0.0, 1.0);\nlet outGain = dbtoa(clamp(output_db, -36.0, 12.0));\nout1 = linearinterp(mx, xL, wetL) * outGain;\nout2 = linearinterp(mx, xR, wetR) * outGain;\n",
                                        "safemath": 1
                                    },
