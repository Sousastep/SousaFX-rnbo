            {
                "box": {
                    "id": "obj-15",
                    "maxclass": "newobj",
                    "numinlets": 2,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 2,
                            "revision": 0,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 1949.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "ai.rat_slew_hardclip",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// rat_slew_hardclip.txt — RAT-style distortion: a slow op amp whose bandwidth\n//                         shrinks as its gain rises and whose output\n//                         slew-limits, into hard silicon diodes to ground,\n//                         then a passive lowpass \"filter\" knob\n//\n// From: D. T. Yeh, J. S. Abel, J. O. Smith, \"Simplified, Physically-Informed\n//       Models of Distortion and Overdrive Guitar Effects Pedals\", DAFx-07\n//       p189: §3.3 (op amp gain stage: 1 + Zf/Zi with RC legs to ground, the\n//       closed-loop bandwidth falls as GBW / gain), §3.4 (diode clipper to\n//       ground after a series resistor), §3.5 (tone stage lowpass);\n//       D. T. Yeh, \"Simulation of the Diode Limiter in Guitar Distortion\n//       Circuits by Numerical Solution of ODEs\", DAFx-07 p197 §1.3 (the\n//       diode clipper equation: near-hard limiting at ~0.6 V);\n//       K. J. Werner, E. Azelborn, \"Antialiasing Piecewise Polynomial\n//       Waveshapers\", DAFx-23 paper 61 §3 (ADAA of piecewise-linear\n//       shapers: the hard clipper, F(u) = u^2/2 inside, |u| - 1/2 outside).\n//\n// Signal (volts, 1.0 digital = 1 V):\n//   v    = x + G * hp60(x)                     (G = dbtoa(drive_db) - 1)\n//   v    = lp(v, 1 MHz / (1 + G))              (gain-bandwidth limit)\n//   v    = 4.5 * tanh(v / 4.5)                 (+-4.5 V rails, 9 V battery)\n//   v    = slew(v, slew_v_us)                  (slew rate; 0.3 = LM308 spec)\n//   d    = 0.6 * hardclip_adaa(v / 0.6)        (1N914 pair to ground)\n//   wet  = lp(d, filter_hz) / 0.6 * 0.5        (filter knob, -6 dBFS peak)\n//\n// Inlets:\n//   in1 / in2: stereo tuba\n// Outlets:\n//   out1 / out2: stereo\n// No safety limiter, no metering.\n// ============================================================================\n\n// Distortion (dB of op-amp gain)\n@param({ min: 0, max: 60 }) drive_db = 36;\n// Op-amp slew rate (V/us)\n@param({ min: 0.001, max: 0.3, exponent: 3 }) slew_v_us = 0.005;\n// Filter lowpass (Hz)\n@param({ min: 400, max: 12000, exponent: 2 }) filter_hz = 3000;\n// Dry/wet\n@param({ min: 0, max: 1 }) mix = 1;\n// Output gain (dB)\n@param({ min: -36, max: 12 }) output_db = 0;\n\n// TPT one-pole states: 0/1 hp60, 2/3 gbw lp, 4/5 filter lp, 6/7 output coupling cap\n@state zs = new FixedSampleArray(8);\n@state prevU = new FixedSampleArray(2);\n@state slewY = new FixedSampleArray(2);\n\n// TPT one-pole lowpass on state slot idx; gg = g / (1 + g)\nfunction lp1(idx: Int, x: number, gg: number): number {\n\tlet v = (x - zs[idx]) * gg;\n\tlet y = v + zs[idx];\n\tzs[idx] = y + v;\n\treturn y;\n}\n\n// Antiderivative of the unit hard clipper\nfunction clipF(u: number): number {\n\tlet a = abs(u);\n\treturn (a <= 1.0) ? 0.5 * u * u : a - 0.5;\n}\n\n// First-order ADAA hard clip on channel ch\nfunction clipAdaa(ch: Int, u: number): number {\n\tlet u1 = prevU[ch];\n\tprevU[ch] = u;\n\tlet du = u - u1;\n\tlet y = 0.0;\n\tif (abs(du) < 0.00001) {\n\t\ty = clamp(0.5 * (u + u1), -1.0, 1.0);\n\t} else {\n\t\ty = (clipF(u) - clipF(u1)) / du;\n\t}\n\treturn y;\n}\n\n// Slew limiter on channel ch: step at most maxStep per sample\nfunction slew(ch: Int, v: number, maxStep: number): number {\n\tlet y = slewY[ch] + clamp(v - slewY[ch], 0.0 - maxStep, maxStep);\n\tslewY[ch] = y;\n\treturn y;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\n\nlet G = maximum(dbtoa(clamp(drive_db, 0.0, 60.0)) - 1.0, 0.0);\nlet gHp = tan(pi * 60.0 / sr);\nlet ggHp = gHp / (1.0 + gHp);\nlet fGbw = minimum(1000000.0 / (1.0 + G), sr * 0.45);\nlet gGbw = tan(pi * fGbw / sr);\nlet ggGbw = gGbw / (1.0 + gGbw);\nlet gFil = tan(pi * minimum(clamp(filter_hz, 400.0, 12000.0), sr * 0.45) / sr);\nlet ggFil = gFil / (1.0 + gFil);\nlet maxStep = clamp(slew_v_us, 0.001, 0.3) * 1000000.0 / sr;\n\n// --- Op amp: gain branch above 60 Hz, GBW lowpass, rails, slew ---------------\nlet vL = xL + G * (xL - lp1(0, xL, ggHp));\nlet vR = xR + G * (xR - lp1(1, xR, ggHp));\nvL = lp1(2, vL, ggGbw);\nvR = lp1(3, vR, ggGbw);\nvL = slew(0, 4.5 * tanh(vL / 4.5), maxStep);\nvR = slew(1, 4.5 * tanh(vR / 4.5), maxStep);\n\n// --- Diodes to ground --------------------------------------------------------\nlet dL = 0.6 * clipAdaa(0, vL / 0.6);\nlet dR = 0.6 * clipAdaa(1, vR / 0.6);\n\n// --- Filter knob, scale 0.6 V to -6 dBFS -------------------------------------\nlet wetL = lp1(4, dL, ggFil) * 0.8333333333;\nlet wetR = lp1(5, dR, ggFil) * 0.8333333333;\n\n// --- Output coupling cap (10 Hz): the clipper makes DC on asymmetric notes --\nlet gDc = tan(pi * 10.0 / sr);\nlet ggDc = gDc / (1.0 + gDc);\nwetL = wetL - lp1(6, wetL, ggDc);\nwetR = wetR - lp1(7, wetR, ggDc);\n\nlet w = clamp(mix, 0.0, 1.0);\nlet outGain = dbtoa(clamp(output_db, -36.0, 12.0));\nout1 = linearinterp(w, xL, wetL) * outGain;\nout2 = linearinterp(w, xR, wetR) * outGain;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 2,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "nocache": 0,
                                        "expr": "",
                                        "code": "// ============================================================================\n// rat_slew_hardclip.txt — RAT-style distortion: a slow op amp whose bandwidth\n//                         shrinks as its gain rises and whose output\n//                         slew-limits, into hard silicon diodes to ground,\n//                         then a passive lowpass \"filter\" knob\n//\n// From: D. T. Yeh, J. S. Abel, J. O. Smith, \"Simplified, Physically-Informed\n//       Models of Distortion and Overdrive Guitar Effects Pedals\", DAFx-07\n//       p189: §3.3 (op amp gain stage: 1 + Zf/Zi with RC legs to ground, the\n//       closed-loop bandwidth falls as GBW / gain), §3.4 (diode clipper to\n//       ground after a series resistor), §3.5 (tone stage lowpass);\n//       D. T. Yeh, \"Simulation of the Diode Limiter in Guitar Distortion\n//       Circuits by Numerical Solution of ODEs\", DAFx-07 p197 §1.3 (the\n//       diode clipper equation: near-hard limiting at ~0.6 V);\n//       K. J. Werner, E. Azelborn, \"Antialiasing Piecewise Polynomial\n//       Waveshapers\", DAFx-23 paper 61 §3 (ADAA of piecewise-linear\n//       shapers: the hard clipper, F(u) = u^2/2 inside, |u| - 1/2 outside).\n//\n// Signal (volts, 1.0 digital = 1 V):\n//   v    = x + G * hp60(x)                     (G = dbtoa(drive_db) - 1)\n//   v    = lp(v, 1 MHz / (1 + G))              (gain-bandwidth limit)\n//   v    = 4.5 * tanh(v / 4.5)                 (+-4.5 V rails, 9 V battery)\n//   v    = slew(v, slew_v_us)                  (slew rate; 0.3 = LM308 spec)\n//   d    = 0.6 * hardclip_adaa(v / 0.6)        (1N914 pair to ground)\n//   wet  = lp(d, filter_hz) / 0.6 * 0.5        (filter knob, -6 dBFS peak)\n//\n// Inlets:\n//   in1 / in2: stereo tuba\n// Outlets:\n//   out1 / out2: stereo\n// No safety limiter, no metering.\n// ============================================================================\n\n// Distortion (dB of op-amp gain)\n@param({ min: 0, max: 60 }) drive_db = 36;\n// Op-amp slew rate (V/us)\n@param({ min: 0.001, max: 0.3, exponent: 3 }) slew_v_us = 0.005;\n// Filter lowpass (Hz)\n@param({ min: 400, max: 12000, exponent: 2 }) filter_hz = 3000;\n// Dry/wet\n@param({ min: 0, max: 1 }) mix = 1;\n// Output gain (dB)\n@param({ min: -36, max: 12 }) output_db = 0;\n\n// TPT one-pole states: 0/1 hp60, 2/3 gbw lp, 4/5 filter lp, 6/7 output coupling cap\n@state zs = new FixedSampleArray(8);\n@state prevU = new FixedSampleArray(2);\n@state slewY = new FixedSampleArray(2);\n\n// TPT one-pole lowpass on state slot idx; gg = g / (1 + g)\nfunction lp1(idx: Int, x: number, gg: number): number {\n\tlet v = (x - zs[idx]) * gg;\n\tlet y = v + zs[idx];\n\tzs[idx] = y + v;\n\treturn y;\n}\n\n// Antiderivative of the unit hard clipper\nfunction clipF(u: number): number {\n\tlet a = abs(u);\n\treturn (a <= 1.0) ? 0.5 * u * u : a - 0.5;\n}\n\n// First-order ADAA hard clip on channel ch\nfunction clipAdaa(ch: Int, u: number): number {\n\tlet u1 = prevU[ch];\n\tprevU[ch] = u;\n\tlet du = u - u1;\n\tlet y = 0.0;\n\tif (abs(du) < 0.00001) {\n\t\ty = clamp(0.5 * (u + u1), -1.0, 1.0);\n\t} else {\n\t\ty = (clipF(u) - clipF(u1)) / du;\n\t}\n\treturn y;\n}\n\n// Slew limiter on channel ch: step at most maxStep per sample\nfunction slew(ch: Int, v: number, maxStep: number): number {\n\tlet y = slewY[ch] + clamp(v - slewY[ch], 0.0 - maxStep, maxStep);\n\tslewY[ch] = y;\n\treturn y;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\n\nlet G = maximum(dbtoa(clamp(drive_db, 0.0, 60.0)) - 1.0, 0.0);\nlet gHp = tan(pi * 60.0 / sr);\nlet ggHp = gHp / (1.0 + gHp);\nlet fGbw = minimum(1000000.0 / (1.0 + G), sr * 0.45);\nlet gGbw = tan(pi * fGbw / sr);\nlet ggGbw = gGbw / (1.0 + gGbw);\nlet gFil = tan(pi * minimum(clamp(filter_hz, 400.0, 12000.0), sr * 0.45) / sr);\nlet ggFil = gFil / (1.0 + gFil);\nlet maxStep = clamp(slew_v_us, 0.001, 0.3) * 1000000.0 / sr;\n\n// --- Op amp: gain branch above 60 Hz, GBW lowpass, rails, slew ---------------\nlet vL = xL + G * (xL - lp1(0, xL, ggHp));\nlet vR = xR + G * (xR - lp1(1, xR, ggHp));\nvL = lp1(2, vL, ggGbw);\nvR = lp1(3, vR, ggGbw);\nvL = slew(0, 4.5 * tanh(vL / 4.5), maxStep);\nvR = slew(1, 4.5 * tanh(vR / 4.5), maxStep);\n\n// --- Diodes to ground --------------------------------------------------------\nlet dL = 0.6 * clipAdaa(0, vL / 0.6);\nlet dR = 0.6 * clipAdaa(1, vR / 0.6);\n\n// --- Filter knob, scale 0.6 V to -6 dBFS -------------------------------------\nlet wetL = lp1(4, dL, ggFil) * 0.8333333333;\nlet wetR = lp1(5, dR, ggFil) * 0.8333333333;\n\n// --- Output coupling cap (10 Hz): the clipper makes DC on asymmetric notes --\nlet gDc = tan(pi * 10.0 / sr);\nlet ggDc = gDc / (1.0 + gDc);\nwetL = wetL - lp1(6, wetL, ggDc);\nwetR = wetR - lp1(7, wetR, ggDc);\n\nlet w = clamp(mix, 0.0, 1.0);\nlet outGain = dbtoa(clamp(output_db, -36.0, 12.0));\nout1 = linearinterp(w, xL, wetL) * outGain;\nout2 = linearinterp(w, xR, wetR) * outGain;\n",
                                        "safemath": 1
                                    },
