                        "exposeparams": 0,
                        "gencode": "Param target(0);\nParam mass(1);\nParam stiffness(1000);\nParam damping(2);\nParam thresh(0.0001);\nParam gate(1);\nHistory pos(0);\nHistory vel(0);\ndelta = 1 / samplerate;\nmass_safe = max(mass, 0.0001);\nstiff = max(stiffness, 0.0001);\ndamp = max(damping, 0);\nthresh_safe = max(thresh, 0.0001);\nerr = pos - target;\nacc = ((((-stiff) * err) - (damp * vel))) / (max(mass_safe, 1.0000000000000001e-09));\nvnext = vel + (acc * delta);\nxnext = pos + (vnext * delta);\nstopped = (((abs(err)) < thresh_safe)) * (((abs(vnext)) < thresh_safe));\nfreeze = clamp(stopped + (1 - gate), 0, 1);\nvel = ((1 - freeze)) * vnext;\npos = (freeze * pos) + (((1 - freeze)) * xnext);\ntmp_expr_1 = pos;\nout1 = tmp_expr_1;",
                        "geninlets": 1,
                        "genoutlets": 1
                    },
