            {
                "box": {
                    "id": "obj-129",
                    "maxclass": "newobj",
                    "numinlets": 2,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 2,
                            "revision": 0,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 1840.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "ai.comp_fairchild_6386_varimu",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// comp_fairchild_6386_varimu.txt\n// Stereo Fairchild 670 / 6386 Remote-Cutoff Triode Variable-Mu Feedback Limiter\n// Based on Raffensperger (DAFx-2012, \"Toward a Wave Digital Filter Model of\n// the Fairchild 670 Limiter\", Eqs. 1, 10-14, Fig. 8, Table 3)\n// Standalone Stereo RNBO codebox~ Effect (in1, in2 -> out1, out2)\n// ============================================================================\n\n@param({ min: -24.0, max: 36.0 }) input_gain_db = 0.0;\n@param({ min: 0.0, max: 24.0 }) drive_db = 8.0;\n@param({ min: 0.0, max: 1.0 }) ac_thresh = 0.55;\n@param({ min: 0.0, max: 1.0 }) dc_knee = 0.25;\n@param({ min: 1.0, max: 6.0 }) tc_mode = 5.0;\n@param({ min: 0.0, max: 1.0 }) tube_harmonics = 0.5;\n@param({ min: 0.0, max: 1.0 }) lat_vert_mode = 0.35;\n@param({ min: 0.0, max: 1.0 }) mix = 1.0;\n@param({ min: -24.0, max: 36.0 }) output_gain_db = 0.0;\n\n// Feedback output state (unit delay breaking feedback loop, Eq. 13)\n@state y_prev_L = 0.0;\n@state y_prev_R = 0.0;\n\n// 3-Capacitor sidechain network states (CT fast, CU medium, CV slow memory, Fig. 8)\n// Channel 1 (Left or Mid/Lateral)\n@state v_ct_1 = 0.0;\n@state v_cu_1 = 0.0;\n@state v_cv_1 = 0.0;\n\n// Channel 2 (Right or Side/Vertical)\n@state v_ct_2 = 0.0;\n@state v_cu_2 = 0.0;\n@state v_cv_2 = 0.0;\n\n// Transformer DC-blocking & high-frequency inductive roll-off states\n@state dc_x_L = 0.0;\n@state dc_y_L = 0.0;\n@state dc_x_R = 0.0;\n@state dc_y_R = 0.0;\n@state hf_lp_L = 0.0;\n@state hf_lp_R = 0.0;\n\n// Helper: Raffensperger Eq. 10 Class-B sidechain crossover nonlinearity\nfunction fairchild_stage1(vpot: number, phi_dc_prime: number): number {\n\tlet a = clamp(vpot - phi_dc_prime, -40.0, 40.0);\n\tlet b = clamp(-vpot - phi_dc_prime, -40.0, 40.0);\n\tlet num = log(1.0 + exp(a));\n\tlet den = log(1.0 + exp(b));\n\treturn num - den;\n}\n\n// Helper: Push-Pull 6386 remote-cutoff variable-mu triode amplifier (Raffensperger Sec. 2 & 6)\n// Models remote-cutoff variable transconductance and balanced odd-order harmonic saturation\n// that increases with gain reduction (Fig. 2, Fig. 12, Fig. 13)\nfunction varimu_6386_amp(x: number, v_sc: number, harm_amt: number): number {\n\t// Remote-cutoff 6386 transconductance curve: smooth variable-mu attenuation as grid bias goes negative\n\tlet gr_gain = pow(1.0 + 0.14 * v_sc + 0.008 * v_sc * v_sc, -1.35);\n\t// Raffensperger Sec. 6 Fig. 13: balanced push-pull cancels even harmonics, while 3rd-harmonic\n\t// distortion rises from -21 dB at light GR to -14 dB under heavy GR\n\tlet gr_depth = clamp(1.0 - gr_gain, 0.0, 1.0);\n\tlet u = x * gr_gain;\n\tlet drive_sat = 1.0 + harm_amt * (0.45 + 1.85 * gr_depth);\n\tlet u_driven = u * drive_sat;\n\t// Balanced push-pull soft-saturation (pure odd harmonics) normalized for unity small-signal gain\n\tlet sat_wave = tanh(u_driven) / drive_sat;\n\t// Add subtle 3rd-order triode curvature before transformer ceiling\n\tlet k3 = harm_amt * (0.08 + 0.22 * gr_depth);\n\treturn tanh(sat_wave + k3 * sat_wave * sat_wave * sat_wave);\n}\n\nlet sr_safe = maximum(samplerate(), 8000.0);\nlet dt = 1.0 / sr_safe;\n\n// Input trim (plain gain stage, ahead of the transformer/6386 drive)\nlet g_in = dbtoa(clamp(input_gain_db, -24.0, 36.0));\nlet dryL = in1 * g_in;\nlet dryR = ((abs(in2) > 0.0000001) ? in2 : in1) * g_in;\n\n// Input transformer step gain\nlet in_gain = dbtoa(clamp(drive_db, 0.0, 24.0));\nlet xL = dryL * in_gain;\nlet xR = dryR * in_gain;\n\n// Continuous blend between Left/Right (0) and Lateral/Vertical Mid-Side (1)\nlet lv = clamp(lat_vert_mode, 0.0, 1.0);\nlet inv_sqrt2 = 0.7071067811865475;\nlet mid_in = (xL + xR) * inv_sqrt2;\nlet side_in = (xL - xR) * inv_sqrt2;\n\nlet ch1_in = (1.0 - lv) * xL + lv * mid_in;\nlet ch2_in = (1.0 - lv) * xR + lv * side_in;\n\n// Feedback signals from previous sample (in L/R or M/S space)\nlet mid_prev = (y_prev_L + y_prev_R) * inv_sqrt2;\nlet side_prev = (y_prev_L - y_prev_R) * inv_sqrt2;\nlet fb1 = (1.0 - lv) * y_prev_L + lv * mid_prev;\nlet fb2 = (1.0 - lv) * y_prev_R + lv * side_prev;\n\n// Sidechain AC and DC threshold controls (Raffensperger Eq. 10, Fig. 9 & 12)\n// phi_dc sets Class-B crossover bias (soft vari-mu knee at 0 -> hard limiting knee at 1)\n// phi_ac scales the sidechain input potentiometer V_pot\nlet phi_ac = clamp(ac_thresh, 0.0, 1.0);\nlet phi_dc = clamp(dc_knee, 0.0, 1.0);\nlet phi_dc_prime = 1.2 + 9.5 * phi_dc;\nlet sc_scale = (1.5 + 22.0 * pow(phi_ac, 1.25)) * (1.0 + 0.55 * phi_dc);\n\n// Stage 1-3 sidechain voltage and germanium diode-bridge current (Raffensperger Eqs. 10-14)\n// Channel 1:\nlet v_st1_1 = fairchild_stage1(fb1 * sc_scale, phi_dc_prime);\nlet v_st3_1 = clamp(8.4 * v_st1_1, -100.0, 100.0);\nlet v_diff_1 = abs(v_st3_1) - v_ct_1;\nlet i_nom_1 = 0.008 * log(1.0 + exp(clamp(4.0 * v_diff_1 - 1.2, -20.0, 30.0)));\nlet i_sc_1 = clamp(i_nom_1, 0.0, 0.5);\n\n// Channel 2:\nlet v_st1_2 = fairchild_stage1(fb2 * sc_scale, phi_dc_prime);\nlet v_st3_2 = clamp(8.4 * v_st1_2, -100.0, 100.0);\nlet v_diff_2 = abs(v_st3_2) - v_ct_2;\nlet i_nom_2 = 0.008 * log(1.0 + exp(clamp(4.0 * v_diff_2 - 1.2, -20.0, 30.0)));\nlet i_sc_2 = clamp(i_nom_2, 0.0, 0.5);\n\n// Fairchild 670 6-position Time Constant network (Fig. 8 & Table 3)\n// Exact RC values from Table 3:\n//   Pos 1: CT=2uF, RT=51.9k  (tau_att=0.2ms, tau_rel=104ms)\n//   Pos 2: CT=2uF, RT=149.9k (tau_att=0.2ms, tau_rel=300ms)\n//   Pos 3: CT=4uF, RT=220k   (tau_att=0.4ms, tau_rel=880ms)\n//   Pos 4: CT=8uF, RT=220k   (tau_att=0.8ms, tau_rel=1760ms)\n//   Pos 5: CT=4uF, RT=220k, CU=8uF, RU=100k (dual program-dependent release)\n//   Pos 6: CT=2uF, RT=220k, CU=8uF, RU=100k, CV=20uF, RV=100k (triple program-dependent release)\nlet sel = clamp(tc_mode, 1.0, 6.0);\nlet c_t = 2.0;\nlet tau_rel_fast = 0.104;\nif (sel < 1.5) {\n\tc_t = 2.0;\n\ttau_rel_fast = 0.104;\n} else if (sel < 2.5) {\n\tc_t = 2.0;\n\ttau_rel_fast = 0.300;\n} else if (sel < 3.5) {\n\tc_t = 4.0;\n\ttau_rel_fast = 0.880;\n} else if (sel < 4.5) {\n\tc_t = 8.0;\n\ttau_rel_fast = 1.760;\n} else if (sel < 5.5) {\n\tc_t = 4.0;\n\ttau_rel_fast = 0.450;\n} else {\n\tc_t = 2.0;\n\ttau_rel_fast = 0.250;\n}\n\n// Fast attack charging rate (scaled by 1 / CT)\nlet charge_scale = 2800.0 / c_t;\nlet g_cu = (sel >= 4.5) ? (1.0 / (0.10 * c_t)) : 0.0;\nlet g_cv = (sel >= 5.5) ? (1.0 / (0.10 * c_t)) : 0.0;\n\n// Update 3-capacitor network for Channel 1 (Fig. 8)\nlet d_ct_1 = i_sc_1 * charge_scale - (v_ct_1 / tau_rel_fast) - g_cu * (v_ct_1 - v_cu_1) - g_cv * (v_ct_1 - v_cv_1);\nv_ct_1 = clamp(v_ct_1 + dt * d_ct_1, 0.0, 60.0);\nlet d_cu_1 = (sel >= 4.5) ? ((v_ct_1 - v_cu_1) / 0.80) : (0.0 - v_cu_1 / 1.50);\nv_cu_1 = clamp(v_cu_1 + dt * d_cu_1, 0.0, 60.0);\nlet d_cv_1 = (sel >= 5.5) ? ((v_ct_1 - v_cv_1) / 2.00) : (0.0 - v_cv_1 / 3.00);\nv_cv_1 = clamp(v_cv_1 + dt * d_cv_1, 0.0, 60.0);\n\n// Update 3-capacitor network for Channel 2 (Fig. 8)\nlet d_ct_2 = i_sc_2 * charge_scale - (v_ct_2 / tau_rel_fast) - g_cu * (v_ct_2 - v_cu_2) - g_cv * (v_ct_2 - v_cv_2);\nv_ct_2 = clamp(v_ct_2 + dt * d_ct_2, 0.0, 60.0);\nlet d_cu_2 = (sel >= 4.5) ? ((v_ct_2 - v_cu_2) / 0.80) : (0.0 - v_cu_2 / 1.50);\nv_cu_2 = clamp(v_cu_2 + dt * d_cu_2, 0.0, 60.0);\nlet d_cv_2 = (sel >= 5.5) ? ((v_ct_2 - v_cv_2) / 2.00) : (0.0 - v_cv_2 / 3.00);\nv_cv_2 = clamp(v_cv_2 + dt * d_cv_2, 0.0, 60.0);\n\n// Apply 6386 Push-Pull Variable-Mu Amplifier to Ch1 & Ch2\nlet harm = clamp(tube_harmonics, 0.0, 1.0);\nlet y_ch1 = varimu_6386_amp(ch1_in, v_ct_1, harm);\nlet y_ch2 = varimu_6386_amp(ch2_in, v_ct_2, harm);\n\n// Decode back from Lateral/Vertical (M/S) if engaged\nlet ms_out_L = (y_ch1 + y_ch2) * inv_sqrt2;\nlet ms_out_R = (y_ch1 - y_ch2) * inv_sqrt2;\nlet wetL = (1.0 - lv) * y_ch1 + lv * ms_out_L;\nlet wetR = (1.0 - lv) * y_ch2 + lv * ms_out_R;\n\n// Store feedback output state\ny_prev_L = wetL;\ny_prev_R = wetR;\n\n// Output transformer gentle high-frequency silk & DC block (using lowercase pi!)\nlet g_hf = 1.0 - exp(-2.0 * pi * 16500.0 / sr_safe);\nhf_lp_L = hf_lp_L + g_hf * (wetL - hf_lp_L);\nhf_lp_R = hf_lp_R + g_hf * (wetR - hf_lp_R);\n\n// Automatic makeup / output level trim so output stays controlled across drive & threshold\nlet out_comp = (1.0 + 0.55 * phi_ac) / pow(in_gain, 0.45 + 0.35 * (1.0 - phi_ac));\nlet procL = hf_lp_L * out_comp;\nlet procR = hf_lp_R * out_comp;\n\ndc_y_L = procL - dc_x_L + 0.9992 * dc_y_L;\ndc_x_L = procL;\ndc_y_R = procR - dc_x_R + 0.9992 * dc_y_R;\ndc_x_R = procR;\n\nlet m = clamp(mix, 0.0, 1.0);\n\n// Output trim (plain gain stage, after the sidechain feedback tap)\nlet g_out = dbtoa(clamp(output_gain_db, -24.0, 36.0));\nout1 = ((1.0 - m) * dryL + m * dc_y_L) * g_out;\nout2 = ((1.0 - m) * dryR + m * dc_y_R) * g_out;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 2,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "nocache": 0,
                                        "expr": "",
                                        "code": "// ============================================================================\n// comp_fairchild_6386_varimu.txt\n// Stereo Fairchild 670 / 6386 Remote-Cutoff Triode Variable-Mu Feedback Limiter\n// Based on Raffensperger (DAFx-2012, \"Toward a Wave Digital Filter Model of\n// the Fairchild 670 Limiter\", Eqs. 1, 10-14, Fig. 8, Table 3)\n// Standalone Stereo RNBO codebox~ Effect (in1, in2 -> out1, out2)\n// ============================================================================\n\n@param({ min: -24.0, max: 36.0 }) input_gain_db = 0.0;\n@param({ min: 0.0, max: 24.0 }) drive_db = 8.0;\n@param({ min: 0.0, max: 1.0 }) ac_thresh = 0.55;\n@param({ min: 0.0, max: 1.0 }) dc_knee = 0.25;\n@param({ min: 1.0, max: 6.0 }) tc_mode = 5.0;\n@param({ min: 0.0, max: 1.0 }) tube_harmonics = 0.5;\n@param({ min: 0.0, max: 1.0 }) lat_vert_mode = 0.35;\n@param({ min: 0.0, max: 1.0 }) mix = 1.0;\n@param({ min: -24.0, max: 36.0 }) output_gain_db = 0.0;\n\n// Feedback output state (unit delay breaking feedback loop, Eq. 13)\n@state y_prev_L = 0.0;\n@state y_prev_R = 0.0;\n\n// 3-Capacitor sidechain network states (CT fast, CU medium, CV slow memory, Fig. 8)\n// Channel 1 (Left or Mid/Lateral)\n@state v_ct_1 = 0.0;\n@state v_cu_1 = 0.0;\n@state v_cv_1 = 0.0;\n\n// Channel 2 (Right or Side/Vertical)\n@state v_ct_2 = 0.0;\n@state v_cu_2 = 0.0;\n@state v_cv_2 = 0.0;\n\n// Transformer DC-blocking & high-frequency inductive roll-off states\n@state dc_x_L = 0.0;\n@state dc_y_L = 0.0;\n@state dc_x_R = 0.0;\n@state dc_y_R = 0.0;\n@state hf_lp_L = 0.0;\n@state hf_lp_R = 0.0;\n\n// Helper: Raffensperger Eq. 10 Class-B sidechain crossover nonlinearity\nfunction fairchild_stage1(vpot: number, phi_dc_prime: number): number {\n\tlet a = clamp(vpot - phi_dc_prime, -40.0, 40.0);\n\tlet b = clamp(-vpot - phi_dc_prime, -40.0, 40.0);\n\tlet num = log(1.0 + exp(a));\n\tlet den = log(1.0 + exp(b));\n\treturn num - den;\n}\n\n// Helper: Push-Pull 6386 remote-cutoff variable-mu triode amplifier (Raffensperger Sec. 2 & 6)\n// Models remote-cutoff variable transconductance and balanced odd-order harmonic saturation\n// that increases with gain reduction (Fig. 2, Fig. 12, Fig. 13)\nfunction varimu_6386_amp(x: number, v_sc: number, harm_amt: number): number {\n\t// Remote-cutoff 6386 transconductance curve: smooth variable-mu attenuation as grid bias goes negative\n\tlet gr_gain = pow(1.0 + 0.14 * v_sc + 0.008 * v_sc * v_sc, -1.35);\n\t// Raffensperger Sec. 6 Fig. 13: balanced push-pull cancels even harmonics, while 3rd-harmonic\n\t// distortion rises from -21 dB at light GR to -14 dB under heavy GR\n\tlet gr_depth = clamp(1.0 - gr_gain, 0.0, 1.0);\n\tlet u = x * gr_gain;\n\tlet drive_sat = 1.0 + harm_amt * (0.45 + 1.85 * gr_depth);\n\tlet u_driven = u * drive_sat;\n\t// Balanced push-pull soft-saturation (pure odd harmonics) normalized for unity small-signal gain\n\tlet sat_wave = tanh(u_driven) / drive_sat;\n\t// Add subtle 3rd-order triode curvature before transformer ceiling\n\tlet k3 = harm_amt * (0.08 + 0.22 * gr_depth);\n\treturn tanh(sat_wave + k3 * sat_wave * sat_wave * sat_wave);\n}\n\nlet sr_safe = maximum(samplerate(), 8000.0);\nlet dt = 1.0 / sr_safe;\n\n// Input trim (plain gain stage, ahead of the transformer/6386 drive)\nlet g_in = dbtoa(clamp(input_gain_db, -24.0, 36.0));\nlet dryL = in1 * g_in;\nlet dryR = ((abs(in2) > 0.0000001) ? in2 : in1) * g_in;\n\n// Input transformer step gain\nlet in_gain = dbtoa(clamp(drive_db, 0.0, 24.0));\nlet xL = dryL * in_gain;\nlet xR = dryR * in_gain;\n\n// Continuous blend between Left/Right (0) and Lateral/Vertical Mid-Side (1)\nlet lv = clamp(lat_vert_mode, 0.0, 1.0);\nlet inv_sqrt2 = 0.7071067811865475;\nlet mid_in = (xL + xR) * inv_sqrt2;\nlet side_in = (xL - xR) * inv_sqrt2;\n\nlet ch1_in = (1.0 - lv) * xL + lv * mid_in;\nlet ch2_in = (1.0 - lv) * xR + lv * side_in;\n\n// Feedback signals from previous sample (in L/R or M/S space)\nlet mid_prev = (y_prev_L + y_prev_R) * inv_sqrt2;\nlet side_prev = (y_prev_L - y_prev_R) * inv_sqrt2;\nlet fb1 = (1.0 - lv) * y_prev_L + lv * mid_prev;\nlet fb2 = (1.0 - lv) * y_prev_R + lv * side_prev;\n\n// Sidechain AC and DC threshold controls (Raffensperger Eq. 10, Fig. 9 & 12)\n// phi_dc sets Class-B crossover bias (soft vari-mu knee at 0 -> hard limiting knee at 1)\n// phi_ac scales the sidechain input potentiometer V_pot\nlet phi_ac = clamp(ac_thresh, 0.0, 1.0);\nlet phi_dc = clamp(dc_knee, 0.0, 1.0);\nlet phi_dc_prime = 1.2 + 9.5 * phi_dc;\nlet sc_scale = (1.5 + 22.0 * pow(phi_ac, 1.25)) * (1.0 + 0.55 * phi_dc);\n\n// Stage 1-3 sidechain voltage and germanium diode-bridge current (Raffensperger Eqs. 10-14)\n// Channel 1:\nlet v_st1_1 = fairchild_stage1(fb1 * sc_scale, phi_dc_prime);\nlet v_st3_1 = clamp(8.4 * v_st1_1, -100.0, 100.0);\nlet v_diff_1 = abs(v_st3_1) - v_ct_1;\nlet i_nom_1 = 0.008 * log(1.0 + exp(clamp(4.0 * v_diff_1 - 1.2, -20.0, 30.0)));\nlet i_sc_1 = clamp(i_nom_1, 0.0, 0.5);\n\n// Channel 2:\nlet v_st1_2 = fairchild_stage1(fb2 * sc_scale, phi_dc_prime);\nlet v_st3_2 = clamp(8.4 * v_st1_2, -100.0, 100.0);\nlet v_diff_2 = abs(v_st3_2) - v_ct_2;\nlet i_nom_2 = 0.008 * log(1.0 + exp(clamp(4.0 * v_diff_2 - 1.2, -20.0, 30.0)));\nlet i_sc_2 = clamp(i_nom_2, 0.0, 0.5);\n\n// Fairchild 670 6-position Time Constant network (Fig. 8 & Table 3)\n// Exact RC values from Table 3:\n//   Pos 1: CT=2uF, RT=51.9k  (tau_att=0.2ms, tau_rel=104ms)\n//   Pos 2: CT=2uF, RT=149.9k (tau_att=0.2ms, tau_rel=300ms)\n//   Pos 3: CT=4uF, RT=220k   (tau_att=0.4ms, tau_rel=880ms)\n//   Pos 4: CT=8uF, RT=220k   (tau_att=0.8ms, tau_rel=1760ms)\n//   Pos 5: CT=4uF, RT=220k, CU=8uF, RU=100k (dual program-dependent release)\n//   Pos 6: CT=2uF, RT=220k, CU=8uF, RU=100k, CV=20uF, RV=100k (triple program-dependent release)\nlet sel = clamp(tc_mode, 1.0, 6.0);\nlet c_t = 2.0;\nlet tau_rel_fast = 0.104;\nif (sel < 1.5) {\n\tc_t = 2.0;\n\ttau_rel_fast = 0.104;\n} else if (sel < 2.5) {\n\tc_t = 2.0;\n\ttau_rel_fast = 0.300;\n} else if (sel < 3.5) {\n\tc_t = 4.0;\n\ttau_rel_fast = 0.880;\n} else if (sel < 4.5) {\n\tc_t = 8.0;\n\ttau_rel_fast = 1.760;\n} else if (sel < 5.5) {\n\tc_t = 4.0;\n\ttau_rel_fast = 0.450;\n} else {\n\tc_t = 2.0;\n\ttau_rel_fast = 0.250;\n}\n\n// Fast attack charging rate (scaled by 1 / CT)\nlet charge_scale = 2800.0 / c_t;\nlet g_cu = (sel >= 4.5) ? (1.0 / (0.10 * c_t)) : 0.0;\nlet g_cv = (sel >= 5.5) ? (1.0 / (0.10 * c_t)) : 0.0;\n\n// Update 3-capacitor network for Channel 1 (Fig. 8)\nlet d_ct_1 = i_sc_1 * charge_scale - (v_ct_1 / tau_rel_fast) - g_cu * (v_ct_1 - v_cu_1) - g_cv * (v_ct_1 - v_cv_1);\nv_ct_1 = clamp(v_ct_1 + dt * d_ct_1, 0.0, 60.0);\nlet d_cu_1 = (sel >= 4.5) ? ((v_ct_1 - v_cu_1) / 0.80) : (0.0 - v_cu_1 / 1.50);\nv_cu_1 = clamp(v_cu_1 + dt * d_cu_1, 0.0, 60.0);\nlet d_cv_1 = (sel >= 5.5) ? ((v_ct_1 - v_cv_1) / 2.00) : (0.0 - v_cv_1 / 3.00);\nv_cv_1 = clamp(v_cv_1 + dt * d_cv_1, 0.0, 60.0);\n\n// Update 3-capacitor network for Channel 2 (Fig. 8)\nlet d_ct_2 = i_sc_2 * charge_scale - (v_ct_2 / tau_rel_fast) - g_cu * (v_ct_2 - v_cu_2) - g_cv * (v_ct_2 - v_cv_2);\nv_ct_2 = clamp(v_ct_2 + dt * d_ct_2, 0.0, 60.0);\nlet d_cu_2 = (sel >= 4.5) ? ((v_ct_2 - v_cu_2) / 0.80) : (0.0 - v_cu_2 / 1.50);\nv_cu_2 = clamp(v_cu_2 + dt * d_cu_2, 0.0, 60.0);\nlet d_cv_2 = (sel >= 5.5) ? ((v_ct_2 - v_cv_2) / 2.00) : (0.0 - v_cv_2 / 3.00);\nv_cv_2 = clamp(v_cv_2 + dt * d_cv_2, 0.0, 60.0);\n\n// Apply 6386 Push-Pull Variable-Mu Amplifier to Ch1 & Ch2\nlet harm = clamp(tube_harmonics, 0.0, 1.0);\nlet y_ch1 = varimu_6386_amp(ch1_in, v_ct_1, harm);\nlet y_ch2 = varimu_6386_amp(ch2_in, v_ct_2, harm);\n\n// Decode back from Lateral/Vertical (M/S) if engaged\nlet ms_out_L = (y_ch1 + y_ch2) * inv_sqrt2;\nlet ms_out_R = (y_ch1 - y_ch2) * inv_sqrt2;\nlet wetL = (1.0 - lv) * y_ch1 + lv * ms_out_L;\nlet wetR = (1.0 - lv) * y_ch2 + lv * ms_out_R;\n\n// Store feedback output state\ny_prev_L = wetL;\ny_prev_R = wetR;\n\n// Output transformer gentle high-frequency silk & DC block (using lowercase pi!)\nlet g_hf = 1.0 - exp(-2.0 * pi * 16500.0 / sr_safe);\nhf_lp_L = hf_lp_L + g_hf * (wetL - hf_lp_L);\nhf_lp_R = hf_lp_R + g_hf * (wetR - hf_lp_R);\n\n// Automatic makeup / output level trim so output stays controlled across drive & threshold\nlet out_comp = (1.0 + 0.55 * phi_ac) / pow(in_gain, 0.45 + 0.35 * (1.0 - phi_ac));\nlet procL = hf_lp_L * out_comp;\nlet procR = hf_lp_R * out_comp;\n\ndc_y_L = procL - dc_x_L + 0.9992 * dc_y_L;\ndc_x_L = procL;\ndc_y_R = procR - dc_x_R + 0.9992 * dc_y_R;\ndc_x_R = procR;\n\nlet m = clamp(mix, 0.0, 1.0);\n\n// Output trim (plain gain stage, after the sidechain feedback tap)\nlet g_out = dbtoa(clamp(output_gain_db, -24.0, 36.0));\nout1 = ((1.0 - m) * dryL + m * dc_y_L) * g_out;\nout2 = ((1.0 - m) * dryR + m * dc_y_R) * g_out;\n"
                                    },
                                    "rnbo_serial": 1,
                                    "rnbo_uniqueid": "effect_code",
