                    "numoutlets": 0,
                    "patching_rect": [ 523.0, 383.0, 180.0, 93.0 ],
                    "text": "1. thru\n2. minishift\n3. bbd blep clock matrix\n4. supersaw waveform animator\n5. univibe optical throb\n6. bbd compander juno"
