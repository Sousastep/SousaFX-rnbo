                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 1735.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "ai.harmonizer_minishift_doubler",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// harmonizer_minishift_doubler.txt\n// Doubles the input with two mini-detuned voices for stereo width and\n// thickness.\n// From: M. Hoffman & P. Cook, \"Real-Time Dissonancizers: Two Dissonance-\n//       Augmenting Audio Effects\", DAFx-08, Paper 30, Sec. 3-4 (detuned\n//       spectral duplicates beat against the source and thicken it), and\n//       O. Das, \"An Open Source Stereo Widening Plugin\", DAFx-24, Paper 92,\n//       Sec. 1 (decorrelation between the channels is what creates width).\n//       The pitch engine is the PSOLA grain re-spacing of DAFx-11 Paper 52\n//       Sec. 4.1-4.2: two voices at +/- detune_cents, one per side.\n// in1/in2: stereo audio (in2 silent for 250 ms -> in1 is used for both)\n// in3: tuba f0 in Hz, used only for the grain length (no pitch tracking);\n//      0 (or anything outside 20..1200 Hz) holds the last valid value;\n//      fallback_hz is used live until the first valid value arrives\n// in4: one-bar phasor 0..1 -> detune breathing (exception to the Hz\n//      contract); 100 ms after in4 stops moving an internal 0.13 Hz\n//      oscillator drives the breathing (motion = 0 for a static minishift)\n// Latency of the doubled pair: pre_delay_ms + 0..1 f0 period (grains start\n// at the newest analysis mark)\n// out1/out2: stereo out\n// ============================================================================\n\n// Mini-detune per side, in cents\n@param({ min: 0.0, max: 40.0 }) detune_cents = 12.0;\n// Pre-delay of the doubled pair\n@param({ min: 0.0, max: 30.0 }) pre_delay_ms = 12.0;\n// Voice A left <-> voice B right\n@param({ min: 0.0, max: 100.0 }) width = 70.0;\n// Dry <-> doubled pair balance\n@param({ min: 0.0, max: 100.0 }) mix = 50.0;\n// Bar-rate breathing of the detune, in %\n@param({ min: 0.0, max: 100.0 }) motion = 20.0;\n// f0 used until in3 reports a pitch\n@param({ min: 40.0, max: 300.0 }) fallback_hz = 82.0;\n\n@state bufL = new FixedSampleArray(16384);\n@state bufR = new FixedSampleArray(16384);\n@state winTab = new FixedSampleArray(1025);\n@state aStart = new FixedIntArray(12);\n@state aAge = new FixedIntArray(12);\n@state aLen = new FixedIntArray(12);\n@state bStart = new FixedIntArray(12);\n@state bAge = new FixedIntArray(12);\n@state bLen = new FixedIntArray(12);\n@state wi: Int = 0;\n@state markIdx: Int = 0;\n@state gLenI: Int = 256;\n@state slotA: Int = 0;\n@state slotB: Int = 0;\n@state f0Hold = 0.0;\n@state haveF0: Int = 0;\n@state markAcc = 0.0;\n@state synA = 0.0;\n@state synB = 0.0;\n@state ratioA = 1.0;\n@state ratioB = 1.0;\n@state prevBarIn = 0.0;\n@state barHold = 0.0;\n@state in2Hold = 0.0;\n@state freeLfo = new phasor();\n@state srCached = 0.0;\n@state ratioK = 0.01;\n\nfunction init() {\n\tfor (let i = 0; i < 1025; i++) {\n\t\twinTab[i] = 0.5 - 0.5 * cos(2.0 * pi * i / 1024.0);\n\t}\n\tfor (let g = 0; g < 12; g++) {\n\t\taStart[g] = 0;\n\t\taAge[g] = 100000;\n\t\taLen[g] = 0;\n\t\tbStart[g] = 0;\n\t\tbAge[g] = 100000;\n\t\tbLen[g] = 0;\n\t}\n}\n\nlet sr = maximum(samplerate(), 1.0);\nif (srCached != sr) {\n\tsrCached = sr;\n\tratioK = 1.0 - exp(-1.0 / (0.03 * sr));\n}\n\nlet xL = in1;\n// in2 counts as patched for 250 ms after any non-zero sample (a per-sample test\n// would swap in xL for single samples at in2's zero crossings)\nif (abs(in2) > 0.0000001) {\n\tin2Hold = 0.25 * sr;\n} else if (in2Hold > 0.0) {\n\tin2Hold -= 1.0;\n}\nlet xR = (in2Hold > 0.0) ? in2 : xL;\nlet pIn = in3;\nlet barIn = in4;\n\n// --- 1. f0 conditioning: hold the last valid value, never divide by in3 ---\nif (pIn > 20.0 && pIn < 1200.0) {\n\tf0Hold = pIn;\n\thaveF0 = 1;\n}\nlet f0 = haveF0 ? f0Hold : clamp(fallback_hz, 40.0, 300.0);\nlet period = sr / clamp(f0, 40.0, 1200.0);\n\n// --- 2. opposite detunes; motion breathes the spread between them ---\n// Bar phasor counts as active for 100 ms after it last moved (a constant in4 must not freeze the breathing)\nif (abs(barIn - prevBarIn) > 0.000001) {\n\tbarHold = 0.1 * sr;\n} else if (barHold > 0.0) {\n\tbarHold -= 1.0;\n}\nprevBarIn = barIn;\nlet freePh = freeLfo.next(0.13);\nlet driftPhase = (barHold > 0.0) ? wrap(barIn, 0.0, 1.0) : freePh;\nlet det = clamp(detune_cents, 0.0, 40.0);\nlet wob = 0.01 * clamp(motion, 0.0, 100.0) * det * sin(2.0 * pi * driftPhase);\nlet spread = det + wob;\nlet rA = exp2(spread / 1200.0);\nlet rB = exp2((0.0 - spread) / 1200.0);\nratioA += (rA - ratioA) * ratioK;\nratioB += (rB - ratioB) * ratioK;\n\nlet hopA = maximum(period / maximum(ratioA, 0.25), 8.0);\nlet hopB = maximum(period / maximum(ratioB, 0.25), 8.0);\nlet lf = 2.0 * maximum(period, maximum(hopA, hopB)) + 0.05 * period;\nlf = clamp(lf, 64.0, 10000.0);\nlet lInt: Int = floor(lf);\ngLenI = lInt;\n\nlet preSamps: Int = floor(clamp(pre_delay_ms, 0.0, 30.0) * 0.001 * sr);\n\n// --- 3. analysis marks every tuba period; two synthesis grain streams ---\n// A grain reads forward at unity speed, so it may start at the newest mark\n// (start <= write index is all that is required); each grain keeps the\n// length it was born with so a note change never truncates a live window.\nbufL[wi] = xL;\nbufR[wi] = xR;\n\nmarkAcc += 1.0;\nif (markAcc >= period) {\n\tmarkAcc -= period;\n\tmarkIdx = wi;\n}\n\nsynA += 1.0;\nif (synA >= hopA) {\n\tsynA -= hopA;\n\taStart[slotA] = (markIdx - preSamps + 16384) & 16383;\n\taAge[slotA] = 0;\n\taLen[slotA] = gLenI;\n\tslotA = (slotA + 1) % 12;\n}\n\nsynB += 1.0;\nif (synB >= hopB) {\n\tsynB -= hopB;\n\tbStart[slotB] = (markIdx - preSamps + 16384) & 16383;\n\tbAge[slotB] = 0;\n\tbLen[slotB] = gLenI;\n\tslotB = (slotB + 1) % 12;\n}\n\n// --- 4. voice A: Hann overlap-add normalised by its window sum ---\nlet accA = 0.0;\nlet accB = 0.0;\nlet wsumA = 0.0;\nlet wsumB = 0.0;\nfor (let g = 0; g < 12; g++) {\n\tlet ag = aAge[g];\n\tlet gl = aLen[g];\n\tif (ag < gl) {\n\t\tlet xi: Int = floor(ag * 1024.0 / gl);\n\t\tif (xi > 1024) { xi = 1024; }\n\t\tlet wv = winTab[xi];\n\t\tlet idx = (aStart[g] + ag) & 16383;\n\t\taccA += wv * bufL[idx];\n\t\twsumA += wv;\n\t\taAge[g] = ag + 1;\n\t}\n}\n\n// --- 5. voice B ---\nfor (let g = 0; g < 12; g++) {\n\tlet ag = bAge[g];\n\tlet gl = bLen[g];\n\tif (ag < gl) {\n\t\tlet xi: Int = floor(ag * 1024.0 / gl);\n\t\tif (xi > 1024) { xi = 1024; }\n\t\tlet wv = winTab[xi];\n\t\tlet idx = (bStart[g] + ag) & 16383;\n\t\taccB += wv * bufR[idx];\n\t\twsumB += wv;\n\t\tbAge[g] = ag + 1;\n\t}\n}\nwi = (wi + 1) & 16383;\n\n// --- 6. voice A left / voice B right, through a mono-safe mid/side ---\nlet vA = 0.0;\nlet vB = 0.0;\nif (wsumA > 0.000001) { vA = accA / wsumA; }\nif (wsumB > 0.000001) { vB = accB / wsumB; }\nlet mid = 0.5 * (vA + vB);\nlet side = 0.5 * (vA - vB);\nlet wide = clamp(width / 100.0, 0.0, 1.0);\nlet wetL = mid + wide * side;\nlet wetR = mid - wide * side;\n\nlet w = clamp(mix / 100.0, 0.0, 1.0);\nout1 = linearinterp(w, xL, wetL);\nout2 = linearinterp(w, xR, wetR);\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "nocache": 0,
                                        "expr": "",
                                        "safemath": 1,
                                        "code": "// ============================================================================\n// harmonizer_minishift_doubler.txt\n// Doubles the input with two mini-detuned voices for stereo width and\n// thickness.\n// From: M. Hoffman & P. Cook, \"Real-Time Dissonancizers: Two Dissonance-\n//       Augmenting Audio Effects\", DAFx-08, Paper 30, Sec. 3-4 (detuned\n//       spectral duplicates beat against the source and thicken it), and\n//       O. Das, \"An Open Source Stereo Widening Plugin\", DAFx-24, Paper 92,\n//       Sec. 1 (decorrelation between the channels is what creates width).\n//       The pitch engine is the PSOLA grain re-spacing of DAFx-11 Paper 52\n//       Sec. 4.1-4.2: two voices at +/- detune_cents, one per side.\n// in1/in2: stereo audio (in2 silent for 250 ms -> in1 is used for both)\n// in3: tuba f0 in Hz, used only for the grain length (no pitch tracking);\n//      0 (or anything outside 20..1200 Hz) holds the last valid value;\n//      fallback_hz is used live until the first valid value arrives\n// in4: one-bar phasor 0..1 -> detune breathing (exception to the Hz\n//      contract); 100 ms after in4 stops moving an internal 0.13 Hz\n//      oscillator drives the breathing (motion = 0 for a static minishift)\n// Latency of the doubled pair: pre_delay_ms + 0..1 f0 period (grains start\n// at the newest analysis mark)\n// out1/out2: stereo out\n// ============================================================================\n\n// Mini-detune per side, in cents\n@param({ min: 0.0, max: 40.0 }) detune_cents = 12.0;\n// Pre-delay of the doubled pair\n@param({ min: 0.0, max: 30.0 }) pre_delay_ms = 12.0;\n// Voice A left <-> voice B right\n@param({ min: 0.0, max: 100.0 }) width = 70.0;\n// Dry <-> doubled pair balance\n@param({ min: 0.0, max: 100.0 }) mix = 50.0;\n// Bar-rate breathing of the detune, in %\n@param({ min: 0.0, max: 100.0 }) motion = 20.0;\n// f0 used until in3 reports a pitch\n@param({ min: 40.0, max: 300.0 }) fallback_hz = 82.0;\n\n@state bufL = new FixedSampleArray(16384);\n@state bufR = new FixedSampleArray(16384);\n@state winTab = new FixedSampleArray(1025);\n@state aStart = new FixedIntArray(12);\n@state aAge = new FixedIntArray(12);\n@state aLen = new FixedIntArray(12);\n@state bStart = new FixedIntArray(12);\n@state bAge = new FixedIntArray(12);\n@state bLen = new FixedIntArray(12);\n@state wi: Int = 0;\n@state markIdx: Int = 0;\n@state gLenI: Int = 256;\n@state slotA: Int = 0;\n@state slotB: Int = 0;\n@state f0Hold = 0.0;\n@state haveF0: Int = 0;\n@state markAcc = 0.0;\n@state synA = 0.0;\n@state synB = 0.0;\n@state ratioA = 1.0;\n@state ratioB = 1.0;\n@state prevBarIn = 0.0;\n@state barHold = 0.0;\n@state in2Hold = 0.0;\n@state freeLfo = new phasor();\n@state srCached = 0.0;\n@state ratioK = 0.01;\n\nfunction init() {\n\tfor (let i = 0; i < 1025; i++) {\n\t\twinTab[i] = 0.5 - 0.5 * cos(2.0 * pi * i / 1024.0);\n\t}\n\tfor (let g = 0; g < 12; g++) {\n\t\taStart[g] = 0;\n\t\taAge[g] = 100000;\n\t\taLen[g] = 0;\n\t\tbStart[g] = 0;\n\t\tbAge[g] = 100000;\n\t\tbLen[g] = 0;\n\t}\n}\n\nlet sr = maximum(samplerate(), 1.0);\nif (srCached != sr) {\n\tsrCached = sr;\n\tratioK = 1.0 - exp(-1.0 / (0.03 * sr));\n}\n\nlet xL = in1;\n// in2 counts as patched for 250 ms after any non-zero sample (a per-sample test\n// would swap in xL for single samples at in2's zero crossings)\nif (abs(in2) > 0.0000001) {\n\tin2Hold = 0.25 * sr;\n} else if (in2Hold > 0.0) {\n\tin2Hold -= 1.0;\n}\nlet xR = (in2Hold > 0.0) ? in2 : xL;\nlet pIn = in3;\nlet barIn = in4;\n\n// --- 1. f0 conditioning: hold the last valid value, never divide by in3 ---\nif (pIn > 20.0 && pIn < 1200.0) {\n\tf0Hold = pIn;\n\thaveF0 = 1;\n}\nlet f0 = haveF0 ? f0Hold : clamp(fallback_hz, 40.0, 300.0);\nlet period = sr / clamp(f0, 40.0, 1200.0);\n\n// --- 2. opposite detunes; motion breathes the spread between them ---\n// Bar phasor counts as active for 100 ms after it last moved (a constant in4 must not freeze the breathing)\nif (abs(barIn - prevBarIn) > 0.000001) {\n\tbarHold = 0.1 * sr;\n} else if (barHold > 0.0) {\n\tbarHold -= 1.0;\n}\nprevBarIn = barIn;\nlet freePh = freeLfo.next(0.13);\nlet driftPhase = (barHold > 0.0) ? wrap(barIn, 0.0, 1.0) : freePh;\nlet det = clamp(detune_cents, 0.0, 40.0);\nlet wob = 0.01 * clamp(motion, 0.0, 100.0) * det * sin(2.0 * pi * driftPhase);\nlet spread = det + wob;\nlet rA = exp2(spread / 1200.0);\nlet rB = exp2((0.0 - spread) / 1200.0);\nratioA += (rA - ratioA) * ratioK;\nratioB += (rB - ratioB) * ratioK;\n\nlet hopA = maximum(period / maximum(ratioA, 0.25), 8.0);\nlet hopB = maximum(period / maximum(ratioB, 0.25), 8.0);\nlet lf = 2.0 * maximum(period, maximum(hopA, hopB)) + 0.05 * period;\nlf = clamp(lf, 64.0, 10000.0);\nlet lInt: Int = floor(lf);\ngLenI = lInt;\n\nlet preSamps: Int = floor(clamp(pre_delay_ms, 0.0, 30.0) * 0.001 * sr);\n\n// --- 3. analysis marks every tuba period; two synthesis grain streams ---\n// A grain reads forward at unity speed, so it may start at the newest mark\n// (start <= write index is all that is required); each grain keeps the\n// length it was born with so a note change never truncates a live window.\nbufL[wi] = xL;\nbufR[wi] = xR;\n\nmarkAcc += 1.0;\nif (markAcc >= period) {\n\tmarkAcc -= period;\n\tmarkIdx = wi;\n}\n\nsynA += 1.0;\nif (synA >= hopA) {\n\tsynA -= hopA;\n\taStart[slotA] = (markIdx - preSamps + 16384) & 16383;\n\taAge[slotA] = 0;\n\taLen[slotA] = gLenI;\n\tslotA = (slotA + 1) % 12;\n}\n\nsynB += 1.0;\nif (synB >= hopB) {\n\tsynB -= hopB;\n\tbStart[slotB] = (markIdx - preSamps + 16384) & 16383;\n\tbAge[slotB] = 0;\n\tbLen[slotB] = gLenI;\n\tslotB = (slotB + 1) % 12;\n}\n\n// --- 4. voice A: Hann overlap-add normalised by its window sum ---\nlet accA = 0.0;\nlet accB = 0.0;\nlet wsumA = 0.0;\nlet wsumB = 0.0;\nfor (let g = 0; g < 12; g++) {\n\tlet ag = aAge[g];\n\tlet gl = aLen[g];\n\tif (ag < gl) {\n\t\tlet xi: Int = floor(ag * 1024.0 / gl);\n\t\tif (xi > 1024) { xi = 1024; }\n\t\tlet wv = winTab[xi];\n\t\tlet idx = (aStart[g] + ag) & 16383;\n\t\taccA += wv * bufL[idx];\n\t\twsumA += wv;\n\t\taAge[g] = ag + 1;\n\t}\n}\n\n// --- 5. voice B ---\nfor (let g = 0; g < 12; g++) {\n\tlet ag = bAge[g];\n\tlet gl = bLen[g];\n\tif (ag < gl) {\n\t\tlet xi: Int = floor(ag * 1024.0 / gl);\n\t\tif (xi > 1024) { xi = 1024; }\n\t\tlet wv = winTab[xi];\n\t\tlet idx = (bStart[g] + ag) & 16383;\n\t\taccB += wv * bufR[idx];\n\t\twsumB += wv;\n\t\tbAge[g] = ag + 1;\n\t}\n}\nwi = (wi + 1) & 16383;\n\n// --- 6. voice A left / voice B right, through a mono-safe mid/side ---\nlet vA = 0.0;\nlet vB = 0.0;\nif (wsumA > 0.000001) { vA = accA / wsumA; }\nif (wsumB > 0.000001) { vB = accB / wsumB; }\nlet mid = 0.5 * (vA + vB);\nlet side = 0.5 * (vA - vB);\nlet wide = clamp(width / 100.0, 0.0, 1.0);\nlet wetL = mid + wide * side;\nlet wetR = mid - wide * side;\n\nlet w = clamp(mix / 100.0, 0.0, 1.0);\nout1 = linearinterp(w, xL, wetL);\nout2 = linearinterp(w, xR, wetR);\n"
                                    },
