        "classnamespace": "rnbo",
        "rect": [ 100.0, 100.0, 1989.0, 780.0 ],
        "default_fontname": "Lato",
        "title": "untitled",
        "boxes": [
            {
                "box": {
                    "code": "// ============================================================================\n// chorus_velvet_noise_ensemble.txt\n// Standalone Stereo Chorus Effect: Logarithmically-Spaced Segmented Velvet-Noise\n// Decorrelation & Micro-Modulated Tap Ensemble\n// Implements Benoit Alary, Archontis Politis & Vesa Valimaki (DAFx-17, Paper 96):\n// \"Velvet-Noise Decorrelator\" (Sections 2.1, 2.2 & 3.1-3.3, Eq. 1-12, Fig. 1-4).\n// Convolves the stereo input with two mutually orthogonal, sparse {-1, 0, +1}\n// Velvet-Noise Sequences (VNS) concentrated at the beginning of a <30 ms delay\n// buffer via Logarithmic Impulse Distribution (Sec 3.3, Eq. 11-12, Fig. 4) with\n// a 4-Segment Staircase Decay Envelope (Sec 3.2, Eq. 10, Fig. 3) to achieve\n// maximum stereo widening (low Interaural Cross-Correlation) WITHOUT smearing\n// sharp tuba tongue transients or coloring the spectrum with regular comb notches!\n// Extends the static VND into a lush stereo ensemble by gently modulating the\n// velvet impulse tap locations with quadrature LFOs (`tap_shimmer_depth`).\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: Optional Transient Ducking Envelope [0..1] (tightens decay on hard attacks)\n//   in4: Optional 1-Bar Phasor [0..1]\n// Outlets:\n//   out1: Left Velvet-Noise Ensemble Chorus Output\n//   out2: Right Velvet-Noise Ensemble Chorus Output\n\n@param({ min: 5.0, max: 35.0 }) sequence_length_ms = 22.0;\n@param({ min: 0.0, max: 1.0 }) log_tap_concentration = 0.65;\n@param({ min: 3.0, max: 24.0 }) segment_decay_db = 12.0;\n@param({ min: 0.0, max: 1.0 }) tap_shimmer_depth = 0.45;\n@param({ min: 0.1, max: 4.0 }) shimmer_rate_hz = 0.75;\n@param({ min: 0.0, max: 1.0 }) stereo_decorrelation = 1.0;\n@param({ min: 0.0, max: 1.0 }) dry_wet_mix = 0.55;\n\n// Stereo circular delay buffers (2048 samples -> up to 42.6 ms at 48 kHz)\n@state vndBufL = new FixedSampleArray(2048);\n@state vndBufR = new FixedSampleArray(2048);\n@state writeIdx: Int = 0;\n\n@state lfoPh1 = new phasor();\n@state lfoPh2 = new phasor();\n@state prevBarIn = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = (abs(in2) > 0.0000001) ? in2 : xL;\nlet transEnv = clamp(in3, 0.0, 1.0);\nlet barIn = in4;\n\nvndBufL[writeIdx] = xL;\nvndBufR[writeIdx] = xR;\n\n// --- 1. Total Velvet Sequence Length Ls & 4-Segment Decay Gains (DAFx-17 Sec 3.1-3.2, Eq. 7, 10) ---\nlet lenMs = clamp(sequence_length_ms, 5.0, 35.0) * (1.0 - 0.35 * transEnv);\nlet totalSamps = clamp(mstosamps(lenMs), 64.0, 1950.0);\n\nlet decayDb = clamp(segment_decay_db, 3.0, 24.0);\n// 4 Staircase Segments (I = 4, Sec 3.2 Fig. 3): s_0 = 1.0, s_1, s_2, s_3\nlet s0 = 1.0;\nlet s1 = dbtoa(-decayDb * 0.333);\nlet s2 = dbtoa(-decayDb * 0.667);\nlet s3 = dbtoa(-decayDb);\n\n// --- 2. Quadrature Shimmer LFOs for Velvet Tap Micro-Modulation ---\nlet rate = clamp(shimmer_rate_hz, 0.1, 4.0);\nlet barActive = (abs(barIn - prevBarIn) > 0.000001 || (barIn > 0.001 && barIn < 0.999)) ? 1.0 : 0.0;\nprevBarIn = barIn;\n\nlet ph1 = barActive ? wrap(barIn, 0.0, 1.0) : lfoPh1.next(rate);\nlet ph2 = lfoPh2.next(rate * 1.31);\nlet shimSamps = clamp(tap_shimmer_depth, 0.0, 1.0) * mstosamps(1.25);\n\nlet logConc = clamp(log_tap_concentration, 0.0, 1.0);\nlet stDecorr = clamp(stereo_decorrelation, 0.0, 1.0);\n\n// --- 3. 16-Tap Sparse Velvet-Noise Convolution (4 Segments x 4 Impulses, Eq. 4, 10, 11-12) ---\n// Pre-computed orthogonal Golden-Ratio / Prime jittered offsets r2[m] in (0, 1) and balanced signs s(m) in {-1, +1}\nlet accSeg0L = 0.0; let accSeg1L = 0.0; let accSeg2L = 0.0; let accSeg3L = 0.0;\nlet accSeg0R = 0.0; let accSeg1R = 0.0; let accSeg2R = 0.0; let accSeg3R = 0.0;\n\nfor (let m: Int = 0; m < 16; m++) {\n\t// Normalized impulse index u in (0.04 .. 0.98)\n\tlet r2L = wrap((m + 1) * 0.6180339887, 0.1, 0.9);\n\tlet r2R = wrap((m + 1) * 0.3819660112 + 0.23, 0.1, 0.9);\n\n\tlet uLinL = (m + r2L) / 16.0;\n\tlet uLinR = (m + linearinterp(stDecorr, r2L, r2R)) / 16.0;\n\n\t// Sec 3.3 Eq. 11-12: Logarithmic impulse distribution concentrates taps near beginning\n\t// of sequence so early impulses thicken without smearing transients!\n\tlet uLogL = pow(uLinL, 1.85);\n\tlet uLogR = pow(uLinR, 1.85);\n\n\tlet normPosL = linearinterp(logConc, uLinL, uLogL);\n\tlet normPosR = linearinterp(logConc, uLinR, uLogR);\n\n\t// Subtle per-tap quadrature shimmer\n\tlet tapLfoL = sin(2.0 * pi * ph1 + m * 0.785398) * shimSamps;\n\tlet tapLfoR = cos(2.0 * pi * ph2 + m * 0.785398) * shimSamps;\n\n\tlet delL = clamp(2.0 + normPosL * totalSamps + tapLfoL, 2.0, 2040.0);\n\tlet delR = clamp(2.0 + normPosR * totalSamps + tapLfoR, 2.0, 2040.0);\n\n\t// Balanced pseudorandom signs s(m) in {-1, +1} (orthogonal between L and R when stDecorr = 1)\n\tlet signL = (((m * 7 + 3) & 2) == 0) ? 1.0 : -1.0;\n\tlet signROrtho = (((m * 5 + 1) & 2) == 0) ? 1.0 : -1.0;\n\tlet signR = (stDecorr > 0.5) ? signROrtho : signL;\n\n\tlet rpValL = writeIdx - clamp(delL, 1.0, 2042.0);\n\twhile (rpValL < 0.0) { rpValL += 2048.0; }\n\tlet iValL: Int = floor(rpValL);\n\tlet valL = signL * cubicinterp(rpValL - iValL, vndBufL[(iValL - 1 + 2048) & 2047], vndBufL[iValL & 2047], vndBufL[(iValL + 1) & 2047], vndBufL[(iValL + 2) & 2047]);\n\n\tlet rpValR = writeIdx - clamp(delR, 1.0, 2042.0);\n\twhile (rpValR < 0.0) { rpValR += 2048.0; }\n\tlet iValR: Int = floor(rpValR);\n\tlet valR = signR * cubicinterp(rpValR - iValR, vndBufR[(iValR - 1 + 2048) & 2047], vndBufR[iValR & 2047], vndBufR[(iValR + 1) & 2047], vndBufR[(iValR + 2) & 2047]);\n\n\tif (m < 4) {\n\t\taccSeg0L += valL; accSeg0R += valR;\n\t} else if (m < 8) {\n\t\taccSeg1L += valL; accSeg1R += valR;\n\t} else if (m < 12) {\n\t\taccSeg2L += valL; accSeg2R += valR;\n\t} else {\n\t\taccSeg3L += valL; accSeg3R += valR;\n\t}\n}\n\nwriteIdx = (writeIdx + 1) & 2047;\n\n// Eq. 10: Segmented Velvet-Noise Convolution sum_i s_i * (sum x[n - k_+[m]] - sum x[n - k_-[m]])\nlet normEnergy = 1.0 / sqrt(4.0 * (s0 * s0 + s1 * s1 + s2 * s2 + s3 * s3));\nlet vndOutL = (s0 * accSeg0L + s1 * accSeg1L + s2 * accSeg2L + s3 * accSeg3L) * normEnergy;\nlet vndOutR = (s0 * accSeg0R + s1 * accSeg1R + s2 * accSeg2R + s3 * accSeg3R) * normEnergy;\n\nlet mix = clamp(dry_wet_mix, 0.0, 1.0);\nout1 = cos(mix * 0.5 * pi) * xL + sin(mix * 0.5 * pi) * vndOutL;\nout2 = cos(mix * 0.5 * pi) * xR + sin(mix * 0.5 * pi) * vndOutR;\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-2",
                    "maxclass": "codebox~",
                    "numinlets": 4,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                    "rnbo_classname": "codebox~",
                    "rnbo_extra_attributes": {
                        "safemath": 1,
                        "expr": "",
                        "nocache": 0,
                        "code": "// ============================================================================\n// chorus_velvet_noise_ensemble.txt\n// Standalone Stereo Chorus Effect: Logarithmically-Spaced Segmented Velvet-Noise\n// Decorrelation & Micro-Modulated Tap Ensemble\n// Implements Benoit Alary, Archontis Politis & Vesa Valimaki (DAFx-17, Paper 96):\n// \"Velvet-Noise Decorrelator\" (Sections 2.1, 2.2 & 3.1-3.3, Eq. 1-12, Fig. 1-4).\n// Convolves the stereo input with two mutually orthogonal, sparse {-1, 0, +1}\n// Velvet-Noise Sequences (VNS) concentrated at the beginning of a <30 ms delay\n// buffer via Logarithmic Impulse Distribution (Sec 3.3, Eq. 11-12, Fig. 4) with\n// a 4-Segment Staircase Decay Envelope (Sec 3.2, Eq. 10, Fig. 3) to achieve\n// maximum stereo widening (low Interaural Cross-Correlation) WITHOUT smearing\n// sharp tuba tongue transients or coloring the spectrum with regular comb notches!\n// Extends the static VND into a lush stereo ensemble by gently modulating the\n// velvet impulse tap locations with quadrature LFOs (`tap_shimmer_depth`).\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: Optional Transient Ducking Envelope [0..1] (tightens decay on hard attacks)\n//   in4: Optional 1-Bar Phasor [0..1]\n// Outlets:\n//   out1: Left Velvet-Noise Ensemble Chorus Output\n//   out2: Right Velvet-Noise Ensemble Chorus Output\n\n@param({ min: 5.0, max: 35.0 }) sequence_length_ms = 22.0;\n@param({ min: 0.0, max: 1.0 }) log_tap_concentration = 0.65;\n@param({ min: 3.0, max: 24.0 }) segment_decay_db = 12.0;\n@param({ min: 0.0, max: 1.0 }) tap_shimmer_depth = 0.45;\n@param({ min: 0.1, max: 4.0 }) shimmer_rate_hz = 0.75;\n@param({ min: 0.0, max: 1.0 }) stereo_decorrelation = 1.0;\n@param({ min: 0.0, max: 1.0 }) dry_wet_mix = 0.55;\n\n// Stereo circular delay buffers (2048 samples -> up to 42.6 ms at 48 kHz)\n@state vndBufL = new FixedSampleArray(2048);\n@state vndBufR = new FixedSampleArray(2048);\n@state writeIdx: Int = 0;\n\n@state lfoPh1 = new phasor();\n@state lfoPh2 = new phasor();\n@state prevBarIn = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = (abs(in2) > 0.0000001) ? in2 : xL;\nlet transEnv = clamp(in3, 0.0, 1.0);\nlet barIn = in4;\n\nvndBufL[writeIdx] = xL;\nvndBufR[writeIdx] = xR;\n\n// --- 1. Total Velvet Sequence Length Ls & 4-Segment Decay Gains (DAFx-17 Sec 3.1-3.2, Eq. 7, 10) ---\nlet lenMs = clamp(sequence_length_ms, 5.0, 35.0) * (1.0 - 0.35 * transEnv);\nlet totalSamps = clamp(mstosamps(lenMs), 64.0, 1950.0);\n\nlet decayDb = clamp(segment_decay_db, 3.0, 24.0);\n// 4 Staircase Segments (I = 4, Sec 3.2 Fig. 3): s_0 = 1.0, s_1, s_2, s_3\nlet s0 = 1.0;\nlet s1 = dbtoa(-decayDb * 0.333);\nlet s2 = dbtoa(-decayDb * 0.667);\nlet s3 = dbtoa(-decayDb);\n\n// --- 2. Quadrature Shimmer LFOs for Velvet Tap Micro-Modulation ---\nlet rate = clamp(shimmer_rate_hz, 0.1, 4.0);\nlet barActive = (abs(barIn - prevBarIn) > 0.000001 || (barIn > 0.001 && barIn < 0.999)) ? 1.0 : 0.0;\nprevBarIn = barIn;\n\nlet ph1 = barActive ? wrap(barIn, 0.0, 1.0) : lfoPh1.next(rate);\nlet ph2 = lfoPh2.next(rate * 1.31);\nlet shimSamps = clamp(tap_shimmer_depth, 0.0, 1.0) * mstosamps(1.25);\n\nlet logConc = clamp(log_tap_concentration, 0.0, 1.0);\nlet stDecorr = clamp(stereo_decorrelation, 0.0, 1.0);\n\n// --- 3. 16-Tap Sparse Velvet-Noise Convolution (4 Segments x 4 Impulses, Eq. 4, 10, 11-12) ---\n// Pre-computed orthogonal Golden-Ratio / Prime jittered offsets r2[m] in (0, 1) and balanced signs s(m) in {-1, +1}\nlet accSeg0L = 0.0; let accSeg1L = 0.0; let accSeg2L = 0.0; let accSeg3L = 0.0;\nlet accSeg0R = 0.0; let accSeg1R = 0.0; let accSeg2R = 0.0; let accSeg3R = 0.0;\n\nfor (let m: Int = 0; m < 16; m++) {\n\t// Normalized impulse index u in (0.04 .. 0.98)\n\tlet r2L = wrap((m + 1) * 0.6180339887, 0.1, 0.9);\n\tlet r2R = wrap((m + 1) * 0.3819660112 + 0.23, 0.1, 0.9);\n\n\tlet uLinL = (m + r2L) / 16.0;\n\tlet uLinR = (m + linearinterp(stDecorr, r2L, r2R)) / 16.0;\n\n\t// Sec 3.3 Eq. 11-12: Logarithmic impulse distribution concentrates taps near beginning\n\t// of sequence so early impulses thicken without smearing transients!\n\tlet uLogL = pow(uLinL, 1.85);\n\tlet uLogR = pow(uLinR, 1.85);\n\n\tlet normPosL = linearinterp(logConc, uLinL, uLogL);\n\tlet normPosR = linearinterp(logConc, uLinR, uLogR);\n\n\t// Subtle per-tap quadrature shimmer\n\tlet tapLfoL = sin(2.0 * pi * ph1 + m * 0.785398) * shimSamps;\n\tlet tapLfoR = cos(2.0 * pi * ph2 + m * 0.785398) * shimSamps;\n\n\tlet delL = clamp(2.0 + normPosL * totalSamps + tapLfoL, 2.0, 2040.0);\n\tlet delR = clamp(2.0 + normPosR * totalSamps + tapLfoR, 2.0, 2040.0);\n\n\t// Balanced pseudorandom signs s(m) in {-1, +1} (orthogonal between L and R when stDecorr = 1)\n\tlet signL = (((m * 7 + 3) & 2) == 0) ? 1.0 : -1.0;\n\tlet signROrtho = (((m * 5 + 1) & 2) == 0) ? 1.0 : -1.0;\n\tlet signR = (stDecorr > 0.5) ? signROrtho : signL;\n\n\tlet rpValL = writeIdx - clamp(delL, 1.0, 2042.0);\n\twhile (rpValL < 0.0) { rpValL += 2048.0; }\n\tlet iValL: Int = floor(rpValL);\n\tlet valL = signL * cubicinterp(rpValL - iValL, vndBufL[(iValL - 1 + 2048) & 2047], vndBufL[iValL & 2047], vndBufL[(iValL + 1) & 2047], vndBufL[(iValL + 2) & 2047]);\n\n\tlet rpValR = writeIdx - clamp(delR, 1.0, 2042.0);\n\twhile (rpValR < 0.0) { rpValR += 2048.0; }\n\tlet iValR: Int = floor(rpValR);\n\tlet valR = signR * cubicinterp(rpValR - iValR, vndBufR[(iValR - 1 + 2048) & 2047], vndBufR[iValR & 2047], vndBufR[(iValR + 1) & 2047], vndBufR[(iValR + 2) & 2047]);\n\n\tif (m < 4) {\n\t\taccSeg0L += valL; accSeg0R += valR;\n\t} else if (m < 8) {\n\t\taccSeg1L += valL; accSeg1R += valR;\n\t} else if (m < 12) {\n\t\taccSeg2L += valL; accSeg2R += valR;\n\t} else {\n\t\taccSeg3L += valL; accSeg3R += valR;\n\t}\n}\n\nwriteIdx = (writeIdx + 1) & 2047;\n\n// Eq. 10: Segmented Velvet-Noise Convolution sum_i s_i * (sum x[n - k_+[m]] - sum x[n - k_-[m]])\nlet normEnergy = 1.0 / sqrt(4.0 * (s0 * s0 + s1 * s1 + s2 * s2 + s3 * s3));\nlet vndOutL = (s0 * accSeg0L + s1 * accSeg1L + s2 * accSeg2L + s3 * accSeg3L) * normEnergy;\nlet vndOutR = (s0 * accSeg0R + s1 * accSeg1R + s2 * accSeg2R + s3 * accSeg3R) * normEnergy;\n\nlet mix = clamp(dry_wet_mix, 0.0, 1.0);\nout1 = cos(mix * 0.5 * pi) * xL + sin(mix * 0.5 * pi) * vndOutL;\nout2 = cos(mix * 0.5 * pi) * xR + sin(mix * 0.5 * pi) * vndOutR;\n"
                    },
