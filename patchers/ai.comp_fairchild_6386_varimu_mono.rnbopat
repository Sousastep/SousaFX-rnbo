        "title": "untitled",
        "boxes": [
            {
                "box": {
                    "code": "// ============================================================================\n// comp_fairchild_6386_varimu_mono.txt\n// Mono (single-channel) Fairchild 670 / 6386 Remote-Cutoff Triode Variable-Mu\n// Feedback Limiter — same model as comp_fairchild_6386_varimu without the\n// Lateral/Vertical matrix: one sidechain, one 6386 stage.\n// Based on Raffensperger (DAFx-2012, \"Toward a Wave Digital Filter Model of\n// the Fairchild 670 Limiter\", Eqs. 1, 10-14, Fig. 8, Table 3)\n// Standalone Mono RNBO codebox~ Effect (in1, in3, in4 -> out1, out2)\n// in1: mono in; in3: pitch (Hz); in4: mod (Hz); out1/out2: processed mono\n// ============================================================================\n\n@param({ min: -24.0, max: 36.0 }) input_gain_db = 0.0;\n@param({ min: 0.0, max: 24.0 }) drive_db = 8.0;\n@param({ min: 0.0, max: 1.0 }) ac_thresh = 0.55;\n@param({ min: 0.0, max: 1.0 }) dc_knee = 0.25;\n@param({ min: 1.0, max: 6.0 }) tc_mode = 5.0;\n@param({ min: 0.0, max: 1.0 }) tube_harmonics = 0.5;\n@param({ min: 0.0, max: 1.0 }) mix = 1.0;\n@param({ min: -24.0, max: 36.0 }) output_gain_db = 0.0;\n\n// Feedback output state (unit delay breaking feedback loop, Eq. 13)\n@state y_prev = 0.0;\n\n// 3-Capacitor sidechain network states (CT fast, CU medium, CV slow memory, Fig. 8)\n@state v_ct = 0.0;\n@state v_cu = 0.0;\n@state v_cv = 0.0;\n\n// Transformer DC-blocking & high-frequency inductive roll-off states\n@state dc_x = 0.0;\n@state dc_y = 0.0;\n@state hf_lp = 0.0;\n\n// Helper: Raffensperger Eq. 10 Class-B sidechain crossover nonlinearity\nfunction fairchild_stage1(vpot: number, phi_dc_prime: number): number {\n\tlet a = clamp(vpot - phi_dc_prime, -40.0, 40.0);\n\tlet b = clamp(-vpot - phi_dc_prime, -40.0, 40.0);\n\tlet num = log(1.0 + exp(a));\n\tlet den = log(1.0 + exp(b));\n\treturn num - den;\n}\n\n// Helper: Push-Pull 6386 remote-cutoff variable-mu triode amplifier (Raffensperger Sec. 2 & 6)\n// Models remote-cutoff variable transconductance and balanced odd-order harmonic saturation\n// that increases with gain reduction (Fig. 2, Fig. 12, Fig. 13)\nfunction varimu_6386_amp(x: number, v_sc: number, harm_amt: number): number {\n\t// Remote-cutoff 6386 transconductance curve: smooth variable-mu attenuation as grid bias goes negative\n\tlet gr_gain = pow(1.0 + 0.14 * v_sc + 0.008 * v_sc * v_sc, -1.35);\n\t// Raffensperger Sec. 6 Fig. 13: balanced push-pull cancels even harmonics, while 3rd-harmonic\n\t// distortion rises from -21 dB at light GR to -14 dB under heavy GR\n\tlet gr_depth = clamp(1.0 - gr_gain, 0.0, 1.0);\n\tlet u = x * gr_gain;\n\tlet drive_sat = 1.0 + harm_amt * (0.45 + 1.85 * gr_depth);\n\tlet u_driven = u * drive_sat;\n\t// Balanced push-pull soft-saturation (pure odd harmonics) normalized for unity small-signal gain\n\tlet sat_wave = tanh(u_driven) / drive_sat;\n\t// Add subtle 3rd-order triode curvature before transformer ceiling\n\tlet k3 = harm_amt * (0.08 + 0.22 * gr_depth);\n\treturn tanh(sat_wave + k3 * sat_wave * sat_wave * sat_wave);\n}\n\nlet sr_safe = maximum(samplerate(), 8000.0);\nlet dt = 1.0 / sr_safe;\n\n// Input trim (plain gain stage, ahead of the transformer/6386 drive)\nlet g_in = dbtoa(clamp(input_gain_db, -24.0, 36.0));\nlet dry = in1 * g_in;\n\n// Input transformer step gain\nlet in_gain = dbtoa(clamp(drive_db, 0.0, 24.0));\nlet x = dry * in_gain;\n\n// Feedback signal from previous sample\nlet fb = y_prev;\n\n// Sidechain AC and DC threshold controls (Raffensperger Eq. 10, Fig. 9 & 12)\n// phi_dc sets Class-B crossover bias (soft vari-mu knee at 0 -> hard limiting knee at 1)\n// phi_ac scales the sidechain input potentiometer V_pot\nlet phi_ac = clamp(ac_thresh, 0.0, 1.0);\nlet phi_dc = clamp(dc_knee, 0.0, 1.0);\nlet phi_dc_prime = 1.2 + 9.5 * phi_dc;\nlet sc_scale = (1.5 + 22.0 * pow(phi_ac, 1.25)) * (1.0 + 0.55 * phi_dc);\n\n// Stage 1-3 sidechain voltage and germanium diode-bridge current (Raffensperger Eqs. 10-14)\nlet v_st1 = fairchild_stage1(fb * sc_scale, phi_dc_prime);\nlet v_st3 = clamp(8.4 * v_st1, -100.0, 100.0);\nlet v_diff = abs(v_st3) - v_ct;\nlet i_nom = 0.008 * log(1.0 + exp(clamp(4.0 * v_diff - 1.2, -20.0, 30.0)));\nlet i_sc = clamp(i_nom, 0.0, 0.5);\n\n// Fairchild 670 6-position Time Constant network (Fig. 8 & Table 3)\n// Exact RC values from Table 3:\n//   Pos 1: CT=2uF, RT=51.9k  (tau_att=0.2ms, tau_rel=104ms)\n//   Pos 2: CT=2uF, RT=149.9k (tau_att=0.2ms, tau_rel=300ms)\n//   Pos 3: CT=4uF, RT=220k   (tau_att=0.4ms, tau_rel=880ms)\n//   Pos 4: CT=8uF, RT=220k   (tau_att=0.8ms, tau_rel=1760ms)\n//   Pos 5: CT=4uF, RT=220k, CU=8uF, RU=100k (dual program-dependent release)\n//   Pos 6: CT=2uF, RT=220k, CU=8uF, RU=100k, CV=20uF, RV=100k (triple program-dependent release)\nlet sel = clamp(tc_mode, 1.0, 6.0);\nlet c_t = 2.0;\nlet tau_rel_fast = 0.104;\nif (sel < 1.5) {\n\tc_t = 2.0;\n\ttau_rel_fast = 0.104;\n} else if (sel < 2.5) {\n\tc_t = 2.0;\n\ttau_rel_fast = 0.300;\n} else if (sel < 3.5) {\n\tc_t = 4.0;\n\ttau_rel_fast = 0.880;\n} else if (sel < 4.5) {\n\tc_t = 8.0;\n\ttau_rel_fast = 1.760;\n} else if (sel < 5.5) {\n\tc_t = 4.0;\n\ttau_rel_fast = 0.450;\n} else {\n\tc_t = 2.0;\n\ttau_rel_fast = 0.250;\n}\n\n// Fast attack charging rate (scaled by 1 / CT)\nlet charge_scale = 2800.0 / c_t;\nlet g_cu = (sel >= 4.5) ? (1.0 / (0.10 * c_t)) : 0.0;\nlet g_cv = (sel >= 5.5) ? (1.0 / (0.10 * c_t)) : 0.0;\n\n// Update 3-capacitor network (Fig. 8)\nlet d_ct = i_sc * charge_scale - (v_ct / tau_rel_fast) - g_cu * (v_ct - v_cu) - g_cv * (v_ct - v_cv);\nv_ct = clamp(v_ct + dt * d_ct, 0.0, 60.0);\nlet d_cu = (sel >= 4.5) ? ((v_ct - v_cu) / 0.80) : (0.0 - v_cu / 1.50);\nv_cu = clamp(v_cu + dt * d_cu, 0.0, 60.0);\nlet d_cv = (sel >= 5.5) ? ((v_ct - v_cv) / 2.00) : (0.0 - v_cv / 3.00);\nv_cv = clamp(v_cv + dt * d_cv, 0.0, 60.0);\n\n// Apply 6386 Push-Pull Variable-Mu Amplifier\nlet harm = clamp(tube_harmonics, 0.0, 1.0);\nlet wet = varimu_6386_amp(x, v_ct, harm);\n\n// Store feedback output state\ny_prev = wet;\n\n// Output transformer gentle high-frequency silk & DC block (using lowercase pi!)\nlet g_hf = 1.0 - exp(-2.0 * pi * 16500.0 / sr_safe);\nhf_lp = hf_lp + g_hf * (wet - hf_lp);\n\n// Automatic makeup / output level trim so output stays controlled across drive & threshold\nlet out_comp = (1.0 + 0.55 * phi_ac) / pow(in_gain, 0.45 + 0.35 * (1.0 - phi_ac));\nlet proc = hf_lp * out_comp;\n\ndc_y = proc - dc_x + 0.9992 * dc_y;\ndc_x = proc;\n\nlet m = clamp(mix, 0.0, 1.0);\n\n// Output trim (plain gain stage, after the sidechain feedback tap)\nlet g_out = dbtoa(clamp(output_gain_db, -24.0, 36.0));\nlet out_mono = ((1.0 - m) * dry + m * dc_y) * g_out;\nout1 = out_mono;\nout2 = out_mono;\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-2",
                    "maxclass": "codebox~",
                    "numinlets": 1,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                    "rnbo_classname": "codebox~",
                    "rnbo_extra_attributes": {
                        "safemath": 1,
                        "expr": "",
                        "nocache": 0,
                        "code": "// ============================================================================\n// comp_fairchild_6386_varimu_mono.txt\n// Mono (single-channel) Fairchild 670 / 6386 Remote-Cutoff Triode Variable-Mu\n// Feedback Limiter — same model as comp_fairchild_6386_varimu without the\n// Lateral/Vertical matrix: one sidechain, one 6386 stage.\n// Based on Raffensperger (DAFx-2012, \"Toward a Wave Digital Filter Model of\n// the Fairchild 670 Limiter\", Eqs. 1, 10-14, Fig. 8, Table 3)\n// Standalone Mono RNBO codebox~ Effect (in1, in3, in4 -> out1, out2)\n// in1: mono in; in3: pitch (Hz); in4: mod (Hz); out1/out2: processed mono\n// ============================================================================\n\n@param({ min: -24.0, max: 36.0 }) input_gain_db = 0.0;\n@param({ min: 0.0, max: 24.0 }) drive_db = 8.0;\n@param({ min: 0.0, max: 1.0 }) ac_thresh = 0.55;\n@param({ min: 0.0, max: 1.0 }) dc_knee = 0.25;\n@param({ min: 1.0, max: 6.0 }) tc_mode = 5.0;\n@param({ min: 0.0, max: 1.0 }) tube_harmonics = 0.5;\n@param({ min: 0.0, max: 1.0 }) mix = 1.0;\n@param({ min: -24.0, max: 36.0 }) output_gain_db = 0.0;\n\n// Feedback output state (unit delay breaking feedback loop, Eq. 13)\n@state y_prev = 0.0;\n\n// 3-Capacitor sidechain network states (CT fast, CU medium, CV slow memory, Fig. 8)\n@state v_ct = 0.0;\n@state v_cu = 0.0;\n@state v_cv = 0.0;\n\n// Transformer DC-blocking & high-frequency inductive roll-off states\n@state dc_x = 0.0;\n@state dc_y = 0.0;\n@state hf_lp = 0.0;\n\n// Helper: Raffensperger Eq. 10 Class-B sidechain crossover nonlinearity\nfunction fairchild_stage1(vpot: number, phi_dc_prime: number): number {\n\tlet a = clamp(vpot - phi_dc_prime, -40.0, 40.0);\n\tlet b = clamp(-vpot - phi_dc_prime, -40.0, 40.0);\n\tlet num = log(1.0 + exp(a));\n\tlet den = log(1.0 + exp(b));\n\treturn num - den;\n}\n\n// Helper: Push-Pull 6386 remote-cutoff variable-mu triode amplifier (Raffensperger Sec. 2 & 6)\n// Models remote-cutoff variable transconductance and balanced odd-order harmonic saturation\n// that increases with gain reduction (Fig. 2, Fig. 12, Fig. 13)\nfunction varimu_6386_amp(x: number, v_sc: number, harm_amt: number): number {\n\t// Remote-cutoff 6386 transconductance curve: smooth variable-mu attenuation as grid bias goes negative\n\tlet gr_gain = pow(1.0 + 0.14 * v_sc + 0.008 * v_sc * v_sc, -1.35);\n\t// Raffensperger Sec. 6 Fig. 13: balanced push-pull cancels even harmonics, while 3rd-harmonic\n\t// distortion rises from -21 dB at light GR to -14 dB under heavy GR\n\tlet gr_depth = clamp(1.0 - gr_gain, 0.0, 1.0);\n\tlet u = x * gr_gain;\n\tlet drive_sat = 1.0 + harm_amt * (0.45 + 1.85 * gr_depth);\n\tlet u_driven = u * drive_sat;\n\t// Balanced push-pull soft-saturation (pure odd harmonics) normalized for unity small-signal gain\n\tlet sat_wave = tanh(u_driven) / drive_sat;\n\t// Add subtle 3rd-order triode curvature before transformer ceiling\n\tlet k3 = harm_amt * (0.08 + 0.22 * gr_depth);\n\treturn tanh(sat_wave + k3 * sat_wave * sat_wave * sat_wave);\n}\n\nlet sr_safe = maximum(samplerate(), 8000.0);\nlet dt = 1.0 / sr_safe;\n\n// Input trim (plain gain stage, ahead of the transformer/6386 drive)\nlet g_in = dbtoa(clamp(input_gain_db, -24.0, 36.0));\nlet dry = in1 * g_in;\n\n// Input transformer step gain\nlet in_gain = dbtoa(clamp(drive_db, 0.0, 24.0));\nlet x = dry * in_gain;\n\n// Feedback signal from previous sample\nlet fb = y_prev;\n\n// Sidechain AC and DC threshold controls (Raffensperger Eq. 10, Fig. 9 & 12)\n// phi_dc sets Class-B crossover bias (soft vari-mu knee at 0 -> hard limiting knee at 1)\n// phi_ac scales the sidechain input potentiometer V_pot\nlet phi_ac = clamp(ac_thresh, 0.0, 1.0);\nlet phi_dc = clamp(dc_knee, 0.0, 1.0);\nlet phi_dc_prime = 1.2 + 9.5 * phi_dc;\nlet sc_scale = (1.5 + 22.0 * pow(phi_ac, 1.25)) * (1.0 + 0.55 * phi_dc);\n\n// Stage 1-3 sidechain voltage and germanium diode-bridge current (Raffensperger Eqs. 10-14)\nlet v_st1 = fairchild_stage1(fb * sc_scale, phi_dc_prime);\nlet v_st3 = clamp(8.4 * v_st1, -100.0, 100.0);\nlet v_diff = abs(v_st3) - v_ct;\nlet i_nom = 0.008 * log(1.0 + exp(clamp(4.0 * v_diff - 1.2, -20.0, 30.0)));\nlet i_sc = clamp(i_nom, 0.0, 0.5);\n\n// Fairchild 670 6-position Time Constant network (Fig. 8 & Table 3)\n// Exact RC values from Table 3:\n//   Pos 1: CT=2uF, RT=51.9k  (tau_att=0.2ms, tau_rel=104ms)\n//   Pos 2: CT=2uF, RT=149.9k (tau_att=0.2ms, tau_rel=300ms)\n//   Pos 3: CT=4uF, RT=220k   (tau_att=0.4ms, tau_rel=880ms)\n//   Pos 4: CT=8uF, RT=220k   (tau_att=0.8ms, tau_rel=1760ms)\n//   Pos 5: CT=4uF, RT=220k, CU=8uF, RU=100k (dual program-dependent release)\n//   Pos 6: CT=2uF, RT=220k, CU=8uF, RU=100k, CV=20uF, RV=100k (triple program-dependent release)\nlet sel = clamp(tc_mode, 1.0, 6.0);\nlet c_t = 2.0;\nlet tau_rel_fast = 0.104;\nif (sel < 1.5) {\n\tc_t = 2.0;\n\ttau_rel_fast = 0.104;\n} else if (sel < 2.5) {\n\tc_t = 2.0;\n\ttau_rel_fast = 0.300;\n} else if (sel < 3.5) {\n\tc_t = 4.0;\n\ttau_rel_fast = 0.880;\n} else if (sel < 4.5) {\n\tc_t = 8.0;\n\ttau_rel_fast = 1.760;\n} else if (sel < 5.5) {\n\tc_t = 4.0;\n\ttau_rel_fast = 0.450;\n} else {\n\tc_t = 2.0;\n\ttau_rel_fast = 0.250;\n}\n\n// Fast attack charging rate (scaled by 1 / CT)\nlet charge_scale = 2800.0 / c_t;\nlet g_cu = (sel >= 4.5) ? (1.0 / (0.10 * c_t)) : 0.0;\nlet g_cv = (sel >= 5.5) ? (1.0 / (0.10 * c_t)) : 0.0;\n\n// Update 3-capacitor network (Fig. 8)\nlet d_ct = i_sc * charge_scale - (v_ct / tau_rel_fast) - g_cu * (v_ct - v_cu) - g_cv * (v_ct - v_cv);\nv_ct = clamp(v_ct + dt * d_ct, 0.0, 60.0);\nlet d_cu = (sel >= 4.5) ? ((v_ct - v_cu) / 0.80) : (0.0 - v_cu / 1.50);\nv_cu = clamp(v_cu + dt * d_cu, 0.0, 60.0);\nlet d_cv = (sel >= 5.5) ? ((v_ct - v_cv) / 2.00) : (0.0 - v_cv / 3.00);\nv_cv = clamp(v_cv + dt * d_cv, 0.0, 60.0);\n\n// Apply 6386 Push-Pull Variable-Mu Amplifier\nlet harm = clamp(tube_harmonics, 0.0, 1.0);\nlet wet = varimu_6386_amp(x, v_ct, harm);\n\n// Store feedback output state\ny_prev = wet;\n\n// Output transformer gentle high-frequency silk & DC block (using lowercase pi!)\nlet g_hf = 1.0 - exp(-2.0 * pi * 16500.0 / sr_safe);\nhf_lp = hf_lp + g_hf * (wet - hf_lp);\n\n// Automatic makeup / output level trim so output stays controlled across drive & threshold\nlet out_comp = (1.0 + 0.55 * phi_ac) / pow(in_gain, 0.45 + 0.35 * (1.0 - phi_ac));\nlet proc = hf_lp * out_comp;\n\ndc_y = proc - dc_x + 0.9992 * dc_y;\ndc_x = proc;\n\nlet m = clamp(mix, 0.0, 1.0);\n\n// Output trim (plain gain stage, after the sidechain feedback tap)\nlet g_out = dbtoa(clamp(output_gain_db, -24.0, 36.0));\nlet out_mono = ((1.0 - m) * dry + m * dc_y) * g_out;\nout1 = out_mono;\nout2 = out_mono;\n"
                    },
