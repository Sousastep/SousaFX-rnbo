        "boxes": [
            {
                "box": {
                    "code": "/* ClipOnly3 — standalone RNBO codebox~ port\n * in1/in2: left/right; out1/out2: left/right.\n * Controls use original normalized VST values (0..1).\n * Double-precision DSP path; no added output dither.\n * Paste this entire file into codebox~ inside rnbo~.\n * MIT License\n * \n * Copyright (c) 2018 Chris Johnson\n * \n * Permission is hereby granted, free of charge, to any person obtaining a copy\n * of this software and associated documentation files (the \"Software\"), to deal\n * in the Software without restriction, including without limitation the rights\n * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n * copies of the Software, and to permit persons to whom the Software is\n * furnished to do so, subject to the following conditions:\n * \n * The above copyright notice and this permission notice shall be included in all\n * copies or substantial portions of the Software.\n * \n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n * SOFTWARE.\n * \n */\n\n@state lastSampleL = 0;\n@state intermediateL = new FixedFloat64Array(18);\n@state slewL = new FixedFloat64Array(34);\n@state wasPosClipL = 0;\n@state wasNegClipL = 0;\n@state lastSampleR = 0;\n@state intermediateR = new FixedFloat64Array(18);\n@state slewR = new FixedFloat64Array(34);\n@state wasPosClipR = 0;\n@state wasNegClipR = 0;\n@state fpdL = 305419896.0;\n@state fpdR = 2271560481.0;\n@state overallscale = 0;\n@state spacing: Int = 0;\n@state frame: Int = 0;\n// Xorshift32 with explicit unsigned wrapping (fixed, reproducible seeds).\nfunction unsigned32(x) {\n    return x - floor(x / 4294967296.0) * 4294967296.0;\n}\nfunction advanceRandom(x) {\n    let a: Int = x;\n    let left: Int = unsigned32(x * 8192.0);\n    let b: Int = unsigned32(a ^ left);\n    let shifted: Int = floor(b / 131072.0);\n    let c: Int = unsigned32(b ^ shifted);\n    left = unsigned32(c * 32.0);\n    return unsigned32(c ^ left);\n}\nfunction toIndex(x) {\n    let result: Int = trunc(x);\n    return result;\n}\n\nfunction init() {\n\n\tlastSampleL = 0.0;\n\twasPosClipL = 0;\n\twasNegClipL = 0;\n\tlastSampleR = 0.0;\n\twasPosClipR = 0;\n\twasNegClipR = 0;\n\tfor (let x: Int = 0; x < 17; x++) {intermediateL[x] = 0.0; intermediateR[x] = 0.0;}\n\tfor (let x: Int = 0; x < 33; x++) {slewL[x] = 0.0; slewR[x] = 0.0;}\n\n}\nfunction dspsetup() { frame = 0; }\n\nif (frame == 0) {\noverallscale = 1.0;\n\toverallscale /= 44100.0;\n\toverallscale *= samplerate();\n\tspacing = floor(overallscale); \n\tif (spacing < 1) spacing = 1; if (spacing > 16) spacing = 16;\n\n}\nlet sampleFrames = vectorsize() - frame - 1;\nlet inFramesToProcess = vectorsize();\n\n\t\tlet inputSampleL = in1;\n\t\tlet inputSampleR = in2;\n\n\t\tlet noise = 1.0-(((fpdL)/4294967295.0)*0.076);\n\t\tif (wasPosClipL == 1) { \n\t\t\tif (inputSampleL<lastSampleL) lastSampleL=(0.9085097*noise)+(inputSampleL*(1.0-noise));\n\t\t\telse lastSampleL = 0.94; \n\t\t} wasPosClipL = 0;\n\t\tif (inputSampleL>0.9085097) {wasPosClipL=1;inputSampleL=(0.9085097*noise)+(lastSampleL*(1.0-noise));}\n\t\tif (wasNegClipL == 1) { \n\t\t\tif (inputSampleL > lastSampleL) lastSampleL=(-0.9085097*noise)+(inputSampleL*(1.0-noise));\n\t\t\telse lastSampleL = -0.94;\n\t\t} wasNegClipL = 0;\n\t\tif (inputSampleL<-0.9085097) {wasNegClipL=1;inputSampleL=(-0.9085097*noise)+(lastSampleL*(1.0-noise));}\n\t\tslewL[spacing*2] = abs(lastSampleL-inputSampleL);\n\t\tfor (let x: Int = spacing*2; x > 0; x--) slewL[x-1] = slewL[x];\n\t\tintermediateL[spacing] = inputSampleL; inputSampleL = lastSampleL;\n\t\t\n\t\tfor (let x: Int = spacing; x > 0; x--) {intermediateL[x-1] = intermediateL[x];} lastSampleL = intermediateL[0];\n\t\tif (wasPosClipL || wasNegClipL) {\n\t\t\tfor (let x: Int = spacing; x > 0; x--) lastSampleL += intermediateL[x];\n\t\t\tlastSampleL /= spacing;\n\t\t} let finalSlew = 0.0;\n\t\tfor (let x: Int = spacing*2; x >= 0; x--) if (finalSlew < slewL[x]) finalSlew = slewL[x];\n\t\tlet postclip = 0.94 / (1.0+(finalSlew*1.3986013));\n\t\tif (inputSampleL > postclip) inputSampleL = postclip; if (inputSampleL < -postclip) inputSampleL = -postclip;\n\t\t\n\t\tnoise = 1.0-(((fpdR)/4294967295.0)*0.076);\n\t\tif (wasPosClipR == 1) { \n\t\t\tif (inputSampleR<lastSampleR) lastSampleR=(0.9085097*noise)+(inputSampleR*(1.0-noise));\n\t\t\telse lastSampleR = 0.94; \n\t\t} wasPosClipR = 0;\n\t\tif (inputSampleR>0.9085097) {wasPosClipR=1;inputSampleR=(0.9085097*noise)+(lastSampleR*(1.0-noise));}\n\t\tif (wasNegClipR == 1) { \n\t\t\tif (inputSampleR > lastSampleR) lastSampleR=(-0.9085097*noise)+(inputSampleR*(1.0-noise));\n\t\t\telse lastSampleR = -0.94;\n\t\t} wasNegClipR = 0;\n\t\tif (inputSampleR<-0.9085097) {wasNegClipR=1;inputSampleR=(-0.9085097*noise)+(lastSampleR*(1.0-noise));}\n\t\tslewR[spacing*2] = abs(lastSampleR-inputSampleR);\n\t\tfor (let x: Int = spacing*2; x > 0; x--) slewR[x-1] = slewR[x];\n\t\tintermediateR[spacing] = inputSampleR; inputSampleR = lastSampleR;\n\t\t\n\t\tfor (let x: Int = spacing; x > 0; x--) {intermediateR[x-1] = intermediateR[x];} lastSampleR = intermediateR[0];\n\t\tif (wasPosClipR || wasNegClipR) {\n\t\t\tfor (let x: Int = spacing; x > 0; x--) lastSampleR += intermediateR[x];\n\t\t\tlastSampleR /= spacing;\n\t\t} finalSlew = 0.0;\n\t\tfor (let x: Int = spacing*2; x >= 0; x--) if (finalSlew < slewR[x]) finalSlew = slewR[x];\n\t\tpostclip = 0.94 / (1.0+(finalSlew*1.3986013));\n\t\tif (inputSampleR > postclip) inputSampleR = postclip; if (inputSampleR < -postclip) inputSampleR = -postclip;\n\n\t\tfpdL = advanceRandom(fpdL);\n\n\t\tfpdR = advanceRandom(fpdR);\n\nout1 = inputSampleL;\nout2 = inputSampleR;\nframe++;\nif (frame >= vectorsize()) frame = 0;\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-2",
                    "maxclass": "codebox~",
                    "numinlets": 2,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                    "rnbo_classname": "codebox~",
                    "rnbo_extra_attributes": {
                        "nocache": 0,
                        "code": "/* ClipOnly3 — standalone RNBO codebox~ port\n * in1/in2: left/right; out1/out2: left/right.\n * Controls use original normalized VST values (0..1).\n * Double-precision DSP path; no added output dither.\n * Paste this entire file into codebox~ inside rnbo~.\n * MIT License\n * \n * Copyright (c) 2018 Chris Johnson\n * \n * Permission is hereby granted, free of charge, to any person obtaining a copy\n * of this software and associated documentation files (the \"Software\"), to deal\n * in the Software without restriction, including without limitation the rights\n * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n * copies of the Software, and to permit persons to whom the Software is\n * furnished to do so, subject to the following conditions:\n * \n * The above copyright notice and this permission notice shall be included in all\n * copies or substantial portions of the Software.\n * \n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n * SOFTWARE.\n * \n */\n\n@state lastSampleL = 0;\n@state intermediateL = new FixedFloat64Array(18);\n@state slewL = new FixedFloat64Array(34);\n@state wasPosClipL = 0;\n@state wasNegClipL = 0;\n@state lastSampleR = 0;\n@state intermediateR = new FixedFloat64Array(18);\n@state slewR = new FixedFloat64Array(34);\n@state wasPosClipR = 0;\n@state wasNegClipR = 0;\n@state fpdL = 305419896.0;\n@state fpdR = 2271560481.0;\n@state overallscale = 0;\n@state spacing: Int = 0;\n@state frame: Int = 0;\n// Xorshift32 with explicit unsigned wrapping (fixed, reproducible seeds).\nfunction unsigned32(x) {\n    return x - floor(x / 4294967296.0) * 4294967296.0;\n}\nfunction advanceRandom(x) {\n    let a: Int = x;\n    let left: Int = unsigned32(x * 8192.0);\n    let b: Int = unsigned32(a ^ left);\n    let shifted: Int = floor(b / 131072.0);\n    let c: Int = unsigned32(b ^ shifted);\n    left = unsigned32(c * 32.0);\n    return unsigned32(c ^ left);\n}\nfunction toIndex(x) {\n    let result: Int = trunc(x);\n    return result;\n}\n\nfunction init() {\n\n\tlastSampleL = 0.0;\n\twasPosClipL = 0;\n\twasNegClipL = 0;\n\tlastSampleR = 0.0;\n\twasPosClipR = 0;\n\twasNegClipR = 0;\n\tfor (let x: Int = 0; x < 17; x++) {intermediateL[x] = 0.0; intermediateR[x] = 0.0;}\n\tfor (let x: Int = 0; x < 33; x++) {slewL[x] = 0.0; slewR[x] = 0.0;}\n\n}\nfunction dspsetup() { frame = 0; }\n\nif (frame == 0) {\noverallscale = 1.0;\n\toverallscale /= 44100.0;\n\toverallscale *= samplerate();\n\tspacing = floor(overallscale); \n\tif (spacing < 1) spacing = 1; if (spacing > 16) spacing = 16;\n\n}\nlet sampleFrames = vectorsize() - frame - 1;\nlet inFramesToProcess = vectorsize();\n\n\t\tlet inputSampleL = in1;\n\t\tlet inputSampleR = in2;\n\n\t\tlet noise = 1.0-(((fpdL)/4294967295.0)*0.076);\n\t\tif (wasPosClipL == 1) { \n\t\t\tif (inputSampleL<lastSampleL) lastSampleL=(0.9085097*noise)+(inputSampleL*(1.0-noise));\n\t\t\telse lastSampleL = 0.94; \n\t\t} wasPosClipL = 0;\n\t\tif (inputSampleL>0.9085097) {wasPosClipL=1;inputSampleL=(0.9085097*noise)+(lastSampleL*(1.0-noise));}\n\t\tif (wasNegClipL == 1) { \n\t\t\tif (inputSampleL > lastSampleL) lastSampleL=(-0.9085097*noise)+(inputSampleL*(1.0-noise));\n\t\t\telse lastSampleL = -0.94;\n\t\t} wasNegClipL = 0;\n\t\tif (inputSampleL<-0.9085097) {wasNegClipL=1;inputSampleL=(-0.9085097*noise)+(lastSampleL*(1.0-noise));}\n\t\tslewL[spacing*2] = abs(lastSampleL-inputSampleL);\n\t\tfor (let x: Int = spacing*2; x > 0; x--) slewL[x-1] = slewL[x];\n\t\tintermediateL[spacing] = inputSampleL; inputSampleL = lastSampleL;\n\t\t\n\t\tfor (let x: Int = spacing; x > 0; x--) {intermediateL[x-1] = intermediateL[x];} lastSampleL = intermediateL[0];\n\t\tif (wasPosClipL || wasNegClipL) {\n\t\t\tfor (let x: Int = spacing; x > 0; x--) lastSampleL += intermediateL[x];\n\t\t\tlastSampleL /= spacing;\n\t\t} let finalSlew = 0.0;\n\t\tfor (let x: Int = spacing*2; x >= 0; x--) if (finalSlew < slewL[x]) finalSlew = slewL[x];\n\t\tlet postclip = 0.94 / (1.0+(finalSlew*1.3986013));\n\t\tif (inputSampleL > postclip) inputSampleL = postclip; if (inputSampleL < -postclip) inputSampleL = -postclip;\n\t\t\n\t\tnoise = 1.0-(((fpdR)/4294967295.0)*0.076);\n\t\tif (wasPosClipR == 1) { \n\t\t\tif (inputSampleR<lastSampleR) lastSampleR=(0.9085097*noise)+(inputSampleR*(1.0-noise));\n\t\t\telse lastSampleR = 0.94; \n\t\t} wasPosClipR = 0;\n\t\tif (inputSampleR>0.9085097) {wasPosClipR=1;inputSampleR=(0.9085097*noise)+(lastSampleR*(1.0-noise));}\n\t\tif (wasNegClipR == 1) { \n\t\t\tif (inputSampleR > lastSampleR) lastSampleR=(-0.9085097*noise)+(inputSampleR*(1.0-noise));\n\t\t\telse lastSampleR = -0.94;\n\t\t} wasNegClipR = 0;\n\t\tif (inputSampleR<-0.9085097) {wasNegClipR=1;inputSampleR=(-0.9085097*noise)+(lastSampleR*(1.0-noise));}\n\t\tslewR[spacing*2] = abs(lastSampleR-inputSampleR);\n\t\tfor (let x: Int = spacing*2; x > 0; x--) slewR[x-1] = slewR[x];\n\t\tintermediateR[spacing] = inputSampleR; inputSampleR = lastSampleR;\n\t\t\n\t\tfor (let x: Int = spacing; x > 0; x--) {intermediateR[x-1] = intermediateR[x];} lastSampleR = intermediateR[0];\n\t\tif (wasPosClipR || wasNegClipR) {\n\t\t\tfor (let x: Int = spacing; x > 0; x--) lastSampleR += intermediateR[x];\n\t\t\tlastSampleR /= spacing;\n\t\t} finalSlew = 0.0;\n\t\tfor (let x: Int = spacing*2; x >= 0; x--) if (finalSlew < slewR[x]) finalSlew = slewR[x];\n\t\tpostclip = 0.94 / (1.0+(finalSlew*1.3986013));\n\t\tif (inputSampleR > postclip) inputSampleR = postclip; if (inputSampleR < -postclip) inputSampleR = -postclip;\n\n\t\tfpdL = advanceRandom(fpdL);\n\n\t\tfpdR = advanceRandom(fpdR);\n\nout1 = inputSampleL;\nout2 = inputSampleR;\nframe++;\nif (frame >= vectorsize()) frame = 0;\n",
