        "boxes": [
            {
                "box": {
                    "code": "// ============================================================================\n// chorus_bbd_blep_clock_matrix.txt\n// Standalone Stereo Chorus Effect: Asynchronous Clock-Stepped BBD Chorus with PolyBLEP\n// Synthesizes 2 DAFx BBD Clock & Aliasing Papers:\n//   1. Leonardo Gabrielli, Stefano D'Angelo & Stefano Squartini (DAFx-25, Paper 29):\n//      \"Antialiasing in BBD Chips Using BLEP\" (Sections 2.1, 3 & 4.3, Alg. 1, Eq. 1-2).\n//      Distinguishes authentic BBD-Generated Aliasing (BGA, the musical sample-and-hold\n//      foldback images at k * F_CLK +/- f0 when F_CLK drops into the audio band) from\n//      harsh digital Simulation-Generated Aliasing (SGA) by clocking a discrete bucket\n//      chain at F_CLK(t) = F_CLK0 * (1 + m*LFO) and applying a continuous-time PolyBLEP\n//      residual across every sample-and-hold output step!\n//   2. Jaromir Macak (DAFx-16, Paper 59, Sections 2.1 & 2.2, Eq. 8-11, Fig. 2-3):\n//      Models the nonlinear RC astable comparator clock generator\n//      T_clock = -2 * tau * ln((U_Max - U_THD(t)) / U_Max) that warps a lowpass-filtered\n//      triangle LFO into the iconic asymmetric sweep of vintage Electro-Harmonix BBDs.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: Optional Envelope Modulator [0..1] (modulates astable threshold U_THD on attacks)\n//   in4: Optional 1-Bar Phasor [0..1] (syncs LFO when patched)\n// Outlets:\n//   out1: Left PolyBLEP Clock-Stepped BBD Chorus Output\n//   out2: Right PolyBLEP Clock-Stepped BBD Chorus Output\n\n@param({ min: 0.08, max: 5.0 }) lfo_rate_hz = 0.45;\n@param({ min: 0.0, max: 1.0 }) sweep_depth = 0.55;\n@param({ min: 4.0, max: 48.0 }) bbd_clock_khz = 18.0;\n@param({ min: 0.0, max: 1.0 }) astable_curve = 0.55;\n@param({ min: -0.85, max: 0.85 }) matrix_feedback = 0.30;\n@param({ min: 1500.0, max: 18000.0 }) recon_filter_hz = 7500.0;\n@param({ min: 0.0, max: 1.0 }) dry_wet_mix = 0.50;\n\n// Fixed-bucket circular queues (N/2 = 256 active charge buckets per channel, DAFx-25 Alg. 1)\n@state bucketL = new FixedSampleArray(512);\n@state bucketR = new FixedSampleArray(512);\n@state rIdxL: Int = 0;\n@state rIdxR: Int = 0;\n\n// BBD asynchronous clock phase accumulators t in [0, 1) & sample-and-hold states (Alg. 1)\n@state clkPhL = 0.0; @state clkPhR = 0.0;\n@state prevInL = 0.0; @state prevInR = 0.0;\n@state holdCurrL = 0.0; @state holdPrevL = 0.0;\n@state holdCurrR = 0.0; @state holdPrevR = 0.0;\n@state lastStepFracL = 1.0; @state lastStepFracR = 1.0;\n\n// Feedback & Reconstruction filter states\n@state fbSampleL = 0.0; @state fbSampleR = 0.0;\n@state lfoFilterL = new onepole(); @state lfoFilterR = new onepole();\n@state recLp1L = new onepole(); @state recLp2L = new onepole();\n@state recLp1R = new onepole(); @state recLp2R = new onepole();\n@state lfoPhasor = new phasor();\n@state prevBarIn = 0.0;\n\n// PolyBLEP residual for smoothing asynchronous BBD sample-and-hold steps (DAFx-25 Sec 3, Eq. 1)\nfunction polyBlepStep(tFrac: number, dt: number): number {\n\tif (tFrac < dt && dt > 0.0001) {\n\t\tlet u = tFrac / dt;\n\t\treturn u + u - u * u - 1.0;\n\t}\n\treturn 0.0;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = (abs(in2) > 0.0000001) ? in2 : xL;\nlet envMod = clamp(in3, 0.0, 1.0);\nlet barIn = in4;\n\n// --- 1. LFO & Macak Nonlinear Astable RC Clock Generator (DAFx-16 Sec 2.1-2.2, Eq. 7-11) ---\nlet rate = clamp(lfo_rate_hz, 0.08, 5.0);\nlet barActive = (abs(barIn - prevBarIn) > 0.000001 || (barIn > 0.001 && barIn < 0.999)) ? 1.0 : 0.0;\nprevBarIn = barIn;\n\nlet ph = barActive ? wrap(barIn, 0.0, 1.0) : lfoPhasor.next(rate);\nlet rawTriL = 2.0 * triangle(ph, 0.5) - 1.0;\nlet rawTriR = 2.0 * triangle(wrap(ph + 0.5, 0.0, 1.0), 0.5) - 1.0;\n\n// IC1 Lowpass filter rounding the triangle LFO corners (DAFx-16 Eq. 7)\nlet smoothTriL = lfoFilterL.next(rawTriL, maximum(rate * 3.5, 1.0));\nlet smoothTriR = lfoFilterR.next(rawTriR, maximum(rate * 3.5, 1.0));\n\n// Macak Eq. 9: T_clock = -2 * tau * ln((U_Max - U_THD) / U_Max)\n// As U_THD approaches U_Max, charging time lengthens logarithmically!\nlet depth = clamp(sweep_depth, 0.0, 1.0);\nlet curve = clamp(astable_curve, 0.0, 1.0);\nlet uThdL = clamp(0.5 + 0.42 * depth * (smoothTriL + 0.35 * envMod), 0.06, 0.94);\nlet uThdR = clamp(0.5 + 0.42 * depth * (smoothTriR - 0.35 * envMod), 0.06, 0.94);\n\nlet logPeriodL = -log(1.0 - uThdL) / log(2.0); // Normalized to 1.0 at uThd = 0.5\nlet logPeriodR = -log(1.0 - uThdR) / log(2.0);\nlet linPeriodL = 1.0 + 0.75 * depth * smoothTriL;\nlet linPeriodR = 1.0 + 0.75 * depth * smoothTriR;\n\nlet periodMultL = clamp(linearinterp(curve, linPeriodL, logPeriodL), 0.25, 3.5);\nlet periodMultR = clamp(linearinterp(curve, linPeriodR, logPeriodR), 0.25, 3.5);\n\nlet baseClkHz = clamp(bbd_clock_khz, 4.0, 48.0) * 1000.0;\nlet fClkL = clamp(baseClkHz / periodMultL, 2500.0, sr * 1.8);\nlet fClkR = clamp(baseClkHz / periodMultR, 2500.0, sr * 1.8);\n\n// --- 2. Discrete-Time BBD Clocking & PolyBLEP Step Correction (DAFx-25 Alg. 1 & Sec 3) ---\nlet fb = clamp(matrix_feedback, -0.85, 0.85);\nlet uInL = tanh(xL + fb * fbSampleL);\nlet uInR = tanh(xR + fb * fbSampleR);\n\n// Left BBD Channel (N/2 = 256 active buckets -> delay = 256 / F_CLK seconds)\nlet dtL = fClkL / sr;\nclkPhL += dtL;\nlet steppedL = 0.0;\nwhile (clkPhL >= 1.0) {\n\t// Linear interpolation of input at exact clock firing instant d (Alg. 1 lines 9-10)\n\tlet dL = clamp(1.0 - (clkPhL - 1.0) / maximum(dtL, 0.0001), 0.0, 1.0);\n\tlet sampInL = prevInL + dL * (uInL - prevInL);\n\tholdPrevL = holdCurrL;\n\tholdCurrL = bucketL[rIdxL];\n\tbucketL[rIdxL] = sampInL;\n\trIdxL = (rIdxL + 1) & 255;\n\tclkPhL -= 1.0;\n\tlastStepFracL = clkPhL;\n\tsteppedL = 1.0;\n}\nprevInL = uInL;\n\n// Apply PolyBLEP residual across the sample-and-hold step (DAFx-25 Eq. 1, Fig. 1)\nlet blepCorrL = (steppedL > 0.5) ? ((holdCurrL - holdPrevL) * polyBlepStep(lastStepFracL, dtL)) : 0.0;\nlet rawBbdOutL = holdCurrL - blepCorrL;\n\n// Right BBD Channel\nlet dtR = fClkR / sr;\nclkPhR += dtR;\nlet steppedR = 0.0;\nwhile (clkPhR >= 1.0) {\n\tlet dR = clamp(1.0 - (clkPhR - 1.0) / maximum(dtR, 0.0001), 0.0, 1.0);\n\tlet sampInR = prevInR + dR * (uInR - prevInR);\n\tholdPrevR = holdCurrR;\n\tholdCurrR = bucketR[rIdxR];\n\tbucketR[rIdxR] = sampInR;\n\trIdxR = (rIdxR + 1) & 255;\n\tclkPhR -= 1.0;\n\tlastStepFracR = clkPhR;\n\tsteppedR = 1.0;\n}\nprevInR = uInR;\n\nlet blepCorrR = (steppedR > 0.5) ? ((holdCurrR - holdPrevR) * polyBlepStep(lastStepFracR, dtR)) : 0.0;\nlet rawBbdOutR = holdCurrR - blepCorrR;\n\n// --- 3. Post-BBD Reconstruction Filter & Matrix Feedback ---\nlet recCut = clamp(recon_filter_hz, 1500.0, 18000.0);\nlet wetL = recLp2L.next(recLp1L.next(rawBbdOutL, recCut), recCut);\nlet wetR = recLp2R.next(recLp1R.next(rawBbdOutR, recCut), recCut);\n\nfbSampleL = wetL;\nfbSampleR = wetR;\n\nlet mix = clamp(dry_wet_mix, 0.0, 1.0);\nout1 = cos(mix * 0.5 * pi) * xL + sin(mix * 0.5 * pi) * wetL;\nout2 = cos(mix * 0.5 * pi) * xR + sin(mix * 0.5 * pi) * wetR;\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-2",
                    "maxclass": "codebox~",
                    "numinlets": 4,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
