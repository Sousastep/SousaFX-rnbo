            {
                "box": {
                    "code": "// ============================================================================\n// chorus_leslie_doppler_sdf.txt\n// Standalone Stereo Chorus Effect: Dual-Rotor Leslie Rotating Speaker Chorus\n// Synthesizes 3 DAFx Rotary Speaker Papers into one stereo effect:\n//   1. Julius O. Smith, Stefania Serafin, Jonathan Abel & David Berners (DAFx-02):\n//      \"Doppler Simulation and the Leslie\" (Sections 3.2, 3.6 & 4.1, Eq. 10-20, Fig. 2-3)\n//      + Sascha Disch & Udo Zoelzer (DAFx-99, Sec 4, Eq. 12-13, Fig. 8-9):\n//      Models the 180-degree opposite dual rotating horns with exact circular Doppler\n//      delay modulation (~0.5 ms depth), synchronous directional radiation AM, and\n//      stereo 0.7 cross-reflection cabinet mixing (DAFx-99 Fig. 9).\n//   2. Jussi Pekonen, Tapani Pihlajamaki & Vesa Valimaki (DAFx-11, Paper 49):\n//      \"Computationally Efficient Hammond Organ Synthesis\" (Sections 3.1 & 3.2,\n//      Eq. 1-5, Fig. 2, Table 1):\n//      Splits the signal at an 800 Hz crossover into Treble Horn and Bass Drum pathways,\n//      applying time-varying Spectral Delay Filters (SDFs: 4-stage Treble with Mb = -0.75,\n//      Ms = 0.20; 3-stage Bass with Mb = -0.92, Ms = 0.04) and independent motor inertia\n//      with 0.1 Hz treble/bass motor mistuning!\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: Optional Speed Brake/Throw Switch or Envelope [0..1] (0 = Chorale, 1 = Tremolo)\n//   in4: Optional 1-Bar Phasor [0..1]\n// Outlets:\n//   out1: Left Stereo Leslie Cabinet Chorus Output\n//   out2: Right Stereo Leslie Cabinet Chorus Output\n\n@param({ min: 0.0, max: 1.0 }) speed_chorale_tremolo = 0.25;\n@param({ min: 0.0, max: 1.0 }) doppler_horn_depth = 0.65;\n@param({ min: 0.0, max: 1.0 }) sdf_dispersion_depth = 0.70;\n@param({ min: 0.0, max: 1.0 }) directional_am_depth = 0.55;\n@param({ min: 0.0, max: 18.0 }) tube_amp_growl_db = 4.5;\n@param({ min: 0.0, max: 1.0 }) cabinet_stereo_width = 0.80;\n@param({ min: 0.0, max: 1.0 }) dry_wet_mix = 1.0;\n\n// 800 Hz Crossover Filters (DAFx-11 Sec 3.2: 2-stage cascaded one-poles per channel)\n@state xLp1L = new onepole(); @state xLp2L = new onepole();\n@state xLp1R = new onepole(); @state xLp2R = new onepole();\n\n// Dual-Horn Interpolated Doppler Delay Buffers (512 samples per horn, DAFx-02 Sec 4.1)\n@state hornBufL = new FixedSampleArray(512);\n@state hornBufR = new FixedSampleArray(512);\n@state writeIdx: Int = 0;\n\n// Spectral Delay Filter (SDF) Allpass Chains (DAFx-11 Table 1: Treble N=4, Bass N=3)\n@state sdfTrebXL = new FixedSampleArray(4); @state sdfTrebYL = new FixedSampleArray(4);\n@state sdfTrebXR = new FixedSampleArray(4); @state sdfTrebYR = new FixedSampleArray(4);\n@state sdfBassXL = new FixedSampleArray(3); @state sdfBassYL = new FixedSampleArray(3);\n@state sdfBassXR = new FixedSampleArray(3); @state sdfBassYR = new FixedSampleArray(3);\n\n// Independent Treble Horn & Bass Drum Motor Phasors + Inertia Smoothers (DAFx-11 Sec 3.2)\n@state hornPhasor = new phasor();\n@state drumPhasor = new phasor();\n@state smoothHornHz = 1.8;\n@state smoothDrumHz = 1.7;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = (abs(in2) > 0.0000001) ? in2 : xL;\nlet throwIn = clamp(in3, 0.0, 1.0);\n\n// --- 1. Leslie Tube Amplifier Soft Overdrive (\"Growl\", DAFx-02 Sec 1) ---\nlet growlGain = dbtoa(clamp(tube_amp_growl_db, 0.0, 18.0));\nlet normGrowl = 1.0 / tanh(maximum(growlGain * 0.7, 0.8));\nlet ampL = tanh(xL * growlGain * 0.7) * normGrowl;\nlet ampR = tanh(xR * growlGain * 0.7) * normGrowl;\n\n// --- 2. 800 Hz Cabinet Crossover into Bass Drum & Treble Horn (DAFx-11 Sec 3.2) ---\nlet bassInL = xLp2L.next(xLp1L.next(ampL, 800.0), 800.0);\nlet bassInR = xLp2R.next(xLp1R.next(ampR, 800.0), 800.0);\nlet trebInL = ampL - bassInL;\nlet trebInR = ampR - bassInR;\n\n// --- 3. Dual Motor Speeds with Physical Acceleration Inertia (DAFx-11 Sec 3.2) ---\n// Slow (Chorale) ~ 0.8..2.0 Hz, Fast (Tremolo) ~ 6.0..6.8 Hz, with 0.1 Hz mistuning\nlet speedCtrl = clamp(speed_chorale_tremolo + throwIn, 0.0, 1.0);\nlet targetHornHz = 0.85 + 5.35 * speedCtrl;\nlet targetDrumHz = 0.75 + 5.05 * speedCtrl; // 0.1-0.3 Hz mistuning (Henricksen / Pekonen Sec 3.2)\n\n// Treble horn accelerates in ~0.8s; heavy wooden bass drum takes ~2.5s!\nlet hornSlew = 1.0 - exp(-1.0 / (0.18 * sr));\nlet drumSlew = 1.0 - exp(-1.0 / (0.55 * sr));\nsmoothHornHz += (targetHornHz - smoothHornHz) * hornSlew;\nsmoothDrumHz += (targetDrumHz - smoothDrumHz) * drumSlew;\n\nlet phHorn = hornPhasor.next(smoothHornHz);\nlet phDrum = drumPhasor.next(smoothDrumHz);\n\n// Quadrature & 180-deg opposite horn modulators (DAFx-99 Fig. 8-9, DAFx-02 Eq. 15-20)\nlet sinHornA = sin(2.0 * pi * phHorn);\nlet cosHornA = cos(2.0 * pi * phHorn);\nlet sinHornB = 0.0 - sinHornA; // Opposite horn B (180 degrees out of phase)\nlet cosHornB = 0.0 - cosHornA;\n\nlet sinDrumL = sin(2.0 * pi * phDrum);\nlet sinDrumR = cos(2.0 * pi * phDrum);\n\n// --- 4. Treble Pathway: Dual-Horn Interpolated Doppler + 4-Stage SDF (DAFx-02 & DAFx-11) ---\nhornBufL[writeIdx] = trebInL;\nhornBufR[writeIdx] = trebInR;\n\n// DAFx-99 Sec 4: Horn Doppler modulation depth is ~0.5 ms around 1.2 ms center delay\nlet dopDepthSamps = mstosamps(0.55 * clamp(doppler_horn_depth, 0.0, 1.0));\nlet centerSamps = mstosamps(1.2);\n\nlet delHornA = centerSamps + dopDepthSamps * sinHornA;\nlet rpHornA = writeIdx - clamp(delHornA, 2.0, 506.0);\nwhile (rpHornA < 0.0) { rpHornA += 512.0; }\nlet iHornA: Int = floor(rpHornA);\nlet hornAL = cubicinterp(rpHornA - iHornA, hornBufL[(iHornA - 1 + 512) & 511], hornBufL[iHornA & 511], hornBufL[(iHornA + 1) & 511], hornBufL[(iHornA + 2) & 511]);\n\nlet delHornB = centerSamps + dopDepthSamps * sinHornB;\nlet rpHornB = writeIdx - clamp(delHornB, 2.0, 506.0);\nwhile (rpHornB < 0.0) { rpHornB += 512.0; }\nlet iHornB: Int = floor(rpHornB);\nlet hornBR = cubicinterp(rpHornB - iHornB, hornBufR[(iHornB - 1 + 512) & 511], hornBufR[iHornB & 511], hornBufR[(iHornB + 1) & 511], hornBufR[(iHornB + 2) & 511]);\nwriteIdx = (writeIdx + 1) & 511;\n\n// DAFx-11 Table 1 Treble SDF: N = 4 stages, Mb = -0.75, Ms = 0.20 * sdf_dispersion_depth\nlet sdfDepth = clamp(sdf_dispersion_depth, 0.0, 1.0);\nlet mTrebL = clamp(-0.75 + 0.20 * sdfDepth * sinHornA, -0.96, 0.96);\nlet mTrebR = clamp(-0.75 + 0.20 * sdfDepth * sinHornB, -0.96, 0.96);\n\nlet tSigL = hornAL;\nlet tSigR = hornBR;\nfor (let k: Int = 0; k < 4; k++) {\n\tlet yL = mTrebL * tSigL + sdfTrebXL[k] - mTrebL * sdfTrebYL[k];\n\tsdfTrebXL[k] = tSigL; sdfTrebYL[k] = yL; tSigL = yL;\n\n\tlet yR = mTrebR * tSigR + sdfTrebXR[k] - mTrebR * sdfTrebYR[k];\n\tsdfTrebXR[k] = tSigR; sdfTrebYR[k] = yR; tSigR = yR;\n}\n\n// --- 5. Bass Pathway: 3-Stage Time-Varying SDF (DAFx-11 Table 1: N = 3, Mb = -0.92, Ms = 0.04) ---\nlet mBassL = clamp(-0.92 + 0.055 * sdfDepth * sinDrumL, -0.97, -0.50);\nlet mBassR = clamp(-0.92 + 0.055 * sdfDepth * sinDrumR, -0.97, -0.50);\n\nlet bSigL = bassInL;\nlet bSigR = bassInR;\nfor (let k: Int = 0; k < 3; k++) {\n\tlet yL = mBassL * bSigL + sdfBassXL[k] - mBassL * sdfBassYL[k];\n\tsdfBassXL[k] = bSigL; sdfBassYL[k] = yL; bSigL = yL;\n\n\tlet yR = mBassR * bSigR + sdfBassXR[k] - mBassR * sdfBassYR[k];\n\tsdfBassXR[k] = bSigR; sdfBassYR[k] = yR; bSigR = yR;\n}\n\n// --- 6. Synchronous Directional Horn/Drum AM & Cabinet Cross-Mixing (DAFx-99 Fig. 8-9) ---\nlet amAmt = clamp(directional_am_depth, 0.0, 1.0) * 0.45;\nlet hornModL = tSigL * (1.0 + amAmt * cosHornA);\nlet hornModR = tSigR * (1.0 + amAmt * cosHornB);\nlet drumModL = bSigL * (1.0 + amAmt * 0.7 * sinDrumL);\nlet drumModR = bSigR * (1.0 + amAmt * 0.7 * sinDrumR);\n\n// DAFx-99 Fig. 9: 0.7 cross-mixing of opposite horns inside the wooden cabinet\nlet crossMix = 1.0 - 0.65 * clamp(cabinet_stereo_width, 0.0, 1.0);\nlet cabL = (hornModL + crossMix * hornModR) * 0.75 + (drumModL + crossMix * drumModR) * 0.75;\nlet cabR = (hornModR + crossMix * hornModL) * 0.75 + (drumModR + crossMix * drumModL) * 0.75;\n\nlet mix = clamp(dry_wet_mix, 0.0, 1.0);\nout1 = linearinterp(mix, xL, cabL);\nout2 = linearinterp(mix, xR, cabR);\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-2",
                    "maxclass": "codebox~",
                    "numinlets": 3,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                    "rnbo_classname": "codebox~",
                    "rnbo_extra_attributes": {
                        "safemath": 1,
                        "expr": "",
                        "nocache": 0,
                        "code": "// ============================================================================\n// chorus_leslie_doppler_sdf.txt\n// Standalone Stereo Chorus Effect: Dual-Rotor Leslie Rotating Speaker Chorus\n// Synthesizes 3 DAFx Rotary Speaker Papers into one stereo effect:\n//   1. Julius O. Smith, Stefania Serafin, Jonathan Abel & David Berners (DAFx-02):\n//      \"Doppler Simulation and the Leslie\" (Sections 3.2, 3.6 & 4.1, Eq. 10-20, Fig. 2-3)\n//      + Sascha Disch & Udo Zoelzer (DAFx-99, Sec 4, Eq. 12-13, Fig. 8-9):\n//      Models the 180-degree opposite dual rotating horns with exact circular Doppler\n//      delay modulation (~0.5 ms depth), synchronous directional radiation AM, and\n//      stereo 0.7 cross-reflection cabinet mixing (DAFx-99 Fig. 9).\n//   2. Jussi Pekonen, Tapani Pihlajamaki & Vesa Valimaki (DAFx-11, Paper 49):\n//      \"Computationally Efficient Hammond Organ Synthesis\" (Sections 3.1 & 3.2,\n//      Eq. 1-5, Fig. 2, Table 1):\n//      Splits the signal at an 800 Hz crossover into Treble Horn and Bass Drum pathways,\n//      applying time-varying Spectral Delay Filters (SDFs: 4-stage Treble with Mb = -0.75,\n//      Ms = 0.20; 3-stage Bass with Mb = -0.92, Ms = 0.04) and independent motor inertia\n//      with 0.1 Hz treble/bass motor mistuning!\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: Optional Speed Brake/Throw Switch or Envelope [0..1] (0 = Chorale, 1 = Tremolo)\n//   in4: Optional 1-Bar Phasor [0..1]\n// Outlets:\n//   out1: Left Stereo Leslie Cabinet Chorus Output\n//   out2: Right Stereo Leslie Cabinet Chorus Output\n\n@param({ min: 0.0, max: 1.0 }) speed_chorale_tremolo = 0.25;\n@param({ min: 0.0, max: 1.0 }) doppler_horn_depth = 0.65;\n@param({ min: 0.0, max: 1.0 }) sdf_dispersion_depth = 0.70;\n@param({ min: 0.0, max: 1.0 }) directional_am_depth = 0.55;\n@param({ min: 0.0, max: 18.0 }) tube_amp_growl_db = 4.5;\n@param({ min: 0.0, max: 1.0 }) cabinet_stereo_width = 0.80;\n@param({ min: 0.0, max: 1.0 }) dry_wet_mix = 1.0;\n\n// 800 Hz Crossover Filters (DAFx-11 Sec 3.2: 2-stage cascaded one-poles per channel)\n@state xLp1L = new onepole(); @state xLp2L = new onepole();\n@state xLp1R = new onepole(); @state xLp2R = new onepole();\n\n// Dual-Horn Interpolated Doppler Delay Buffers (512 samples per horn, DAFx-02 Sec 4.1)\n@state hornBufL = new FixedSampleArray(512);\n@state hornBufR = new FixedSampleArray(512);\n@state writeIdx: Int = 0;\n\n// Spectral Delay Filter (SDF) Allpass Chains (DAFx-11 Table 1: Treble N=4, Bass N=3)\n@state sdfTrebXL = new FixedSampleArray(4); @state sdfTrebYL = new FixedSampleArray(4);\n@state sdfTrebXR = new FixedSampleArray(4); @state sdfTrebYR = new FixedSampleArray(4);\n@state sdfBassXL = new FixedSampleArray(3); @state sdfBassYL = new FixedSampleArray(3);\n@state sdfBassXR = new FixedSampleArray(3); @state sdfBassYR = new FixedSampleArray(3);\n\n// Independent Treble Horn & Bass Drum Motor Phasors + Inertia Smoothers (DAFx-11 Sec 3.2)\n@state hornPhasor = new phasor();\n@state drumPhasor = new phasor();\n@state smoothHornHz = 1.8;\n@state smoothDrumHz = 1.7;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = (abs(in2) > 0.0000001) ? in2 : xL;\nlet throwIn = clamp(in3, 0.0, 1.0);\n\n// --- 1. Leslie Tube Amplifier Soft Overdrive (\"Growl\", DAFx-02 Sec 1) ---\nlet growlGain = dbtoa(clamp(tube_amp_growl_db, 0.0, 18.0));\nlet normGrowl = 1.0 / tanh(maximum(growlGain * 0.7, 0.8));\nlet ampL = tanh(xL * growlGain * 0.7) * normGrowl;\nlet ampR = tanh(xR * growlGain * 0.7) * normGrowl;\n\n// --- 2. 800 Hz Cabinet Crossover into Bass Drum & Treble Horn (DAFx-11 Sec 3.2) ---\nlet bassInL = xLp2L.next(xLp1L.next(ampL, 800.0), 800.0);\nlet bassInR = xLp2R.next(xLp1R.next(ampR, 800.0), 800.0);\nlet trebInL = ampL - bassInL;\nlet trebInR = ampR - bassInR;\n\n// --- 3. Dual Motor Speeds with Physical Acceleration Inertia (DAFx-11 Sec 3.2) ---\n// Slow (Chorale) ~ 0.8..2.0 Hz, Fast (Tremolo) ~ 6.0..6.8 Hz, with 0.1 Hz mistuning\nlet speedCtrl = clamp(speed_chorale_tremolo + throwIn, 0.0, 1.0);\nlet targetHornHz = 0.85 + 5.35 * speedCtrl;\nlet targetDrumHz = 0.75 + 5.05 * speedCtrl; // 0.1-0.3 Hz mistuning (Henricksen / Pekonen Sec 3.2)\n\n// Treble horn accelerates in ~0.8s; heavy wooden bass drum takes ~2.5s!\nlet hornSlew = 1.0 - exp(-1.0 / (0.18 * sr));\nlet drumSlew = 1.0 - exp(-1.0 / (0.55 * sr));\nsmoothHornHz += (targetHornHz - smoothHornHz) * hornSlew;\nsmoothDrumHz += (targetDrumHz - smoothDrumHz) * drumSlew;\n\nlet phHorn = hornPhasor.next(smoothHornHz);\nlet phDrum = drumPhasor.next(smoothDrumHz);\n\n// Quadrature & 180-deg opposite horn modulators (DAFx-99 Fig. 8-9, DAFx-02 Eq. 15-20)\nlet sinHornA = sin(2.0 * pi * phHorn);\nlet cosHornA = cos(2.0 * pi * phHorn);\nlet sinHornB = 0.0 - sinHornA; // Opposite horn B (180 degrees out of phase)\nlet cosHornB = 0.0 - cosHornA;\n\nlet sinDrumL = sin(2.0 * pi * phDrum);\nlet sinDrumR = cos(2.0 * pi * phDrum);\n\n// --- 4. Treble Pathway: Dual-Horn Interpolated Doppler + 4-Stage SDF (DAFx-02 & DAFx-11) ---\nhornBufL[writeIdx] = trebInL;\nhornBufR[writeIdx] = trebInR;\n\n// DAFx-99 Sec 4: Horn Doppler modulation depth is ~0.5 ms around 1.2 ms center delay\nlet dopDepthSamps = mstosamps(0.55 * clamp(doppler_horn_depth, 0.0, 1.0));\nlet centerSamps = mstosamps(1.2);\n\nlet delHornA = centerSamps + dopDepthSamps * sinHornA;\nlet rpHornA = writeIdx - clamp(delHornA, 2.0, 506.0);\nwhile (rpHornA < 0.0) { rpHornA += 512.0; }\nlet iHornA: Int = floor(rpHornA);\nlet hornAL = cubicinterp(rpHornA - iHornA, hornBufL[(iHornA - 1 + 512) & 511], hornBufL[iHornA & 511], hornBufL[(iHornA + 1) & 511], hornBufL[(iHornA + 2) & 511]);\n\nlet delHornB = centerSamps + dopDepthSamps * sinHornB;\nlet rpHornB = writeIdx - clamp(delHornB, 2.0, 506.0);\nwhile (rpHornB < 0.0) { rpHornB += 512.0; }\nlet iHornB: Int = floor(rpHornB);\nlet hornBR = cubicinterp(rpHornB - iHornB, hornBufR[(iHornB - 1 + 512) & 511], hornBufR[iHornB & 511], hornBufR[(iHornB + 1) & 511], hornBufR[(iHornB + 2) & 511]);\nwriteIdx = (writeIdx + 1) & 511;\n\n// DAFx-11 Table 1 Treble SDF: N = 4 stages, Mb = -0.75, Ms = 0.20 * sdf_dispersion_depth\nlet sdfDepth = clamp(sdf_dispersion_depth, 0.0, 1.0);\nlet mTrebL = clamp(-0.75 + 0.20 * sdfDepth * sinHornA, -0.96, 0.96);\nlet mTrebR = clamp(-0.75 + 0.20 * sdfDepth * sinHornB, -0.96, 0.96);\n\nlet tSigL = hornAL;\nlet tSigR = hornBR;\nfor (let k: Int = 0; k < 4; k++) {\n\tlet yL = mTrebL * tSigL + sdfTrebXL[k] - mTrebL * sdfTrebYL[k];\n\tsdfTrebXL[k] = tSigL; sdfTrebYL[k] = yL; tSigL = yL;\n\n\tlet yR = mTrebR * tSigR + sdfTrebXR[k] - mTrebR * sdfTrebYR[k];\n\tsdfTrebXR[k] = tSigR; sdfTrebYR[k] = yR; tSigR = yR;\n}\n\n// --- 5. Bass Pathway: 3-Stage Time-Varying SDF (DAFx-11 Table 1: N = 3, Mb = -0.92, Ms = 0.04) ---\nlet mBassL = clamp(-0.92 + 0.055 * sdfDepth * sinDrumL, -0.97, -0.50);\nlet mBassR = clamp(-0.92 + 0.055 * sdfDepth * sinDrumR, -0.97, -0.50);\n\nlet bSigL = bassInL;\nlet bSigR = bassInR;\nfor (let k: Int = 0; k < 3; k++) {\n\tlet yL = mBassL * bSigL + sdfBassXL[k] - mBassL * sdfBassYL[k];\n\tsdfBassXL[k] = bSigL; sdfBassYL[k] = yL; bSigL = yL;\n\n\tlet yR = mBassR * bSigR + sdfBassXR[k] - mBassR * sdfBassYR[k];\n\tsdfBassXR[k] = bSigR; sdfBassYR[k] = yR; bSigR = yR;\n}\n\n// --- 6. Synchronous Directional Horn/Drum AM & Cabinet Cross-Mixing (DAFx-99 Fig. 8-9) ---\nlet amAmt = clamp(directional_am_depth, 0.0, 1.0) * 0.45;\nlet hornModL = tSigL * (1.0 + amAmt * cosHornA);\nlet hornModR = tSigR * (1.0 + amAmt * cosHornB);\nlet drumModL = bSigL * (1.0 + amAmt * 0.7 * sinDrumL);\nlet drumModR = bSigR * (1.0 + amAmt * 0.7 * sinDrumR);\n\n// DAFx-99 Fig. 9: 0.7 cross-mixing of opposite horns inside the wooden cabinet\nlet crossMix = 1.0 - 0.65 * clamp(cabinet_stereo_width, 0.0, 1.0);\nlet cabL = (hornModL + crossMix * hornModR) * 0.75 + (drumModL + crossMix * drumModR) * 0.75;\nlet cabR = (hornModR + crossMix * hornModL) * 0.75 + (drumModR + crossMix * drumModL) * 0.75;\n\nlet mix = clamp(dry_wet_mix, 0.0, 1.0);\nout1 = linearinterp(mix, xL, cabL);\nout2 = linearinterp(mix, xR, cabR);\n"
                    },
