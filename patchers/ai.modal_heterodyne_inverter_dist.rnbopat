{
    "patcher": {
        "fileversion": 1,
        "appversion": {
            "major": 9,
            "minor": 2,
            "revision": 0,
            "architecture": "x64",
            "modernui": 1
        },
        "classnamespace": "rnbo",
        "rect": [ 100.0, 100.0, 1884.0, 780.0 ],
        "default_fontname": "Lato",
        "title": "untitled",
        "boxes": [
            {
                "box": {
                    "code": "// ============================================================================\n// modal_heterodyne_inverter_dist.txt\n// Unix-Style Stereo Effect: 4-Mode Heterodyne-Smooth-Modulate Spectral Inverter & Distihu\n// Implements Jonathan S. Abel & Kurt James Werner (DAFx-15, Paper 72):\n// \"Distortion and Pitch Processing Using a Modal Reverberator Architecture\"\n// (Sections 2, 3.3 & 3.4, Eq. 5-8, 13-14, Fig. 2, 8, 11, 12).\n// Implements 4 pitch-tracked harmonic modes (m = 1, 2, 3, 4 at w_m = m * w_0) as\n// cascades of complex heterodyning to DC (e^(-j*w_m*t)), two-stage complex\n// exponential smoothing (bandwidth / modal sustain), per-mode memoryless\n// distortion d_m(.) FREE of intermodulation products (Fig. 12), and re-modulation\n// at a transformed frequency e^(j*nu_m*t):\n//   - Normal / Shifted Harmonics: nu_m = m * w_0 * 2^(shift/12)  (Eq. 13)\n//   - Spectral Inversion (Eq. 14, Fig. 11): nu_m = w_c^2 / w_m -> flips the harmonic\n//     series upside down around pivot 2*f0 so harmonic 1 <-> 4 and harmonic 2 <-> 3!\n//   - Stereo output takes the Real part on Left and Imaginary part on Right (Sec 2)!\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: Tracked Fundamental Pitch f0 in Hz (from 00_tuba_freq_tracker; fallback ZC if <=0)\n//   in4: Optional Gate / Freeze or 1-Bar Phasor [0..1] (modulates inversion morph)\n// Outlets:\n//   out1: Left Modal Processor Output (Real Part of Complex Modes)\n//   out2: Right Modal Processor Output (Imaginary Part / Quadrature Stereo Modes)\n\n@param({ min: 5.0, max: 600.0 }) mode_decay_ms = 45.0;\n@param({ min: 0.0, max: 24.0 }) mode_drive_db = 9.0;\n@param({ min: 0.0, max: 1.0 }) spectral_invert = 0.0;\n@param({ min: -12.0, max: 12.0 }) pitch_shift_semi = 0.0;\n@param({ min: 0.0, max: 1.0 }) odd_even_mode_tilt = 0.0;\n@param({ min: 0.0, max: 1.0 }) mix = 0.85;\n\n// 4 Complex Heterodyne Analysis & Synthesis Phase Accumulators (modes m = 1, 2, 3, 4)\n@state anaPh = new FixedSampleArray(4);\n@state synPh = new FixedSampleArray(4);\n\n// 2-Stage Complex Baseband Smoothing Filters per mode (eliminates beating, Sec 3.2 & 3.3)\n@state bbRe1 = new FixedSampleArray(4); @state bbIm1 = new FixedSampleArray(4);\n@state bbRe2 = new FixedSampleArray(4); @state bbIm2 = new FixedSampleArray(4);\n\n// Fallback ZC pitch tracker & smoothing\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 58.27;\n@state smoothF0 = 58.27;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = (abs(in2) > 0.0000001) ? in2 : xL;\nlet pitchIn = in3;\n\n// --- 1. Pitch Conditioning ---\nlet mono = 0.5 * (xL + xR);\nlet monoLow = lpTrack.next(mono, 190.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slew = 1.0 - exp(-1.0 / (0.006 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slew;\nlet f0 = clamp(smoothF0, 24.0, 1000.0);\n\n// --- 2. Baseband Smoothing Coefficient (Paper Eq. 4 & 8: gamma * e^(-alpha_m * t)) ---\nlet decaySec = clamp(mode_decay_ms, 5.0, 600.0) * 0.001;\nlet alphaCoeff = 1.0 - exp(-6.907755 / (decaySec * sr)); // T60 decay rate\nlet drive = dbtoa(clamp(mode_drive_db, 0.0, 24.0));\nlet invAmt = clamp(spectral_invert, 0.0, 1.0);\nlet shiftRatio = pow(2.0, clamp(pitch_shift_semi, -12.0, 12.0) / 12.0);\nlet tilt = clamp(odd_even_mode_tilt, -1.0, 1.0);\n\nlet sumRe = 0.0;\nlet sumIm = 0.0;\n\n// --- 3. 4-Mode Heterodyne -> Smooth -> Distort -> Re-Modulate Pipeline (Fig. 2, 8, 12) ---\nfor (let m: Int = 0; m < 4; m++) {\n\tlet harmNum = m + 1.0;\n\tlet fAna = clamp(f0 * harmNum, 20.0, sr * 0.45);\n\n\t// Advance heterodyne analysis phase e^(-j * w_m * t)\n\tlet phA = wrap(anaPh[m] + fAna / sr, 0.0, 1.0);\n\tanaPh[m] = phA;\n\n\tlet hetRe = mono * cos(2.0 * pi * phA);\n\tlet hetIm = -mono * sin(2.0 * pi * phA);\n\n\t// 2-stage complex exponential baseband smoother (Paper Sec 3.2)\n\tbbRe1[m] += (hetRe - bbRe1[m]) * alphaCoeff;\n\tbbIm1[m] += (hetIm - bbIm1[m]) * alphaCoeff;\n\tbbRe2[m] += (bbRe1[m] - bbRe2[m]) * alphaCoeff;\n\tbbIm2[m] += (bbIm1[m] - bbIm2[m]) * alphaCoeff;\n\n\t// Extract complex mode envelope & phase at DC baseband\n\tlet envRe = bbRe2[m] * 3.5;\n\tlet envIm = bbIm2[m] * 3.5;\n\n\t// Paper Sec 3.3 Eq. 14: Spectral Inversion about pivot f_c = 2 * f0\n\t// Maps harmonic {1, 2, 3, 4} -> {4, 2, 1.333, 1} (or inverted order {4, 3, 2, 1})\n\tlet invHarm = 5.0 - harmNum;\n\tlet targetHarm = linearinterp(invAmt, harmNum, invHarm);\n\tlet fSyn = clamp(f0 * targetHarm * shiftRatio, 20.0, sr * 0.45);\n\n\tlet phS = wrap(synPh[m] + fSyn / sr, 0.0, 1.0);\n\tsynPh[m] = phS;\n\n\t// Re-modulate complex baseband mode back to audio frequency e^(j * nu_m * t)\n\tlet modCos = cos(2.0 * pi * phS);\n\tlet modSin = sin(2.0 * pi * phS);\n\tlet modeRe = envRe * modCos - envIm * modSin;\n\tlet modeIm = envRe * modSin + envIm * modCos;\n\n\t// Paper Sec 3.4 Fig. 12: Distort each narrowband mode INDIVIDUALLY before summing!\n\t// Zero intermodulation products between harmonics, plus Nyquist-aware harmonic order\n\tlet distRe = tanh(modeRe * drive);\n\tlet distIm = tanh(modeIm * drive);\n\n\t// Odd/Even mode weighting\n\tlet isEven = ((m & 1) == 1) ? 1.0 : 0.0;\n\tlet weight = isEven ? (1.0 + 0.6 * tilt) : (1.0 - 0.6 * tilt);\n\n\tsumRe += distRe * weight;\n\tsumIm += distIm * weight;\n}\n\n// Paper Sec 2 (p. 2): Real part -> Left channel, Imaginary part -> Right channel for 90-deg stereo\nlet wetL = sumRe * 0.45;\nlet wetR = sumIm * 0.45;\n\nlet mMix = clamp(mix, 0.0, 1.0);\nout1 = linearinterp(mMix, xL, wetL);\nout2 = linearinterp(mMix, xR, wetR);\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-2",
                    "maxclass": "codebox~",
                    "numinlets": 3,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                    "rnbo_classname": "codebox~",
                    "rnbo_extra_attributes": {
                        "safemath": 1,
                        "expr": "",
                        "nocache": 0,
                        "code": "// ============================================================================\n// modal_heterodyne_inverter_dist.txt\n// Unix-Style Stereo Effect: 4-Mode Heterodyne-Smooth-Modulate Spectral Inverter & Distihu\n// Implements Jonathan S. Abel & Kurt James Werner (DAFx-15, Paper 72):\n// \"Distortion and Pitch Processing Using a Modal Reverberator Architecture\"\n// (Sections 2, 3.3 & 3.4, Eq. 5-8, 13-14, Fig. 2, 8, 11, 12).\n// Implements 4 pitch-tracked harmonic modes (m = 1, 2, 3, 4 at w_m = m * w_0) as\n// cascades of complex heterodyning to DC (e^(-j*w_m*t)), two-stage complex\n// exponential smoothing (bandwidth / modal sustain), per-mode memoryless\n// distortion d_m(.) FREE of intermodulation products (Fig. 12), and re-modulation\n// at a transformed frequency e^(j*nu_m*t):\n//   - Normal / Shifted Harmonics: nu_m = m * w_0 * 2^(shift/12)  (Eq. 13)\n//   - Spectral Inversion (Eq. 14, Fig. 11): nu_m = w_c^2 / w_m -> flips the harmonic\n//     series upside down around pivot 2*f0 so harmonic 1 <-> 4 and harmonic 2 <-> 3!\n//   - Stereo output takes the Real part on Left and Imaginary part on Right (Sec 2)!\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: Tracked Fundamental Pitch f0 in Hz (from 00_tuba_freq_tracker; fallback ZC if <=0)\n//   in4: Optional Gate / Freeze or 1-Bar Phasor [0..1] (modulates inversion morph)\n// Outlets:\n//   out1: Left Modal Processor Output (Real Part of Complex Modes)\n//   out2: Right Modal Processor Output (Imaginary Part / Quadrature Stereo Modes)\n\n@param({ min: 5.0, max: 600.0 }) mode_decay_ms = 45.0;\n@param({ min: 0.0, max: 24.0 }) mode_drive_db = 9.0;\n@param({ min: 0.0, max: 1.0 }) spectral_invert = 0.0;\n@param({ min: -12.0, max: 12.0 }) pitch_shift_semi = 0.0;\n@param({ min: 0.0, max: 1.0 }) odd_even_mode_tilt = 0.0;\n@param({ min: 0.0, max: 1.0 }) mix = 0.85;\n\n// 4 Complex Heterodyne Analysis & Synthesis Phase Accumulators (modes m = 1, 2, 3, 4)\n@state anaPh = new FixedSampleArray(4);\n@state synPh = new FixedSampleArray(4);\n\n// 2-Stage Complex Baseband Smoothing Filters per mode (eliminates beating, Sec 3.2 & 3.3)\n@state bbRe1 = new FixedSampleArray(4); @state bbIm1 = new FixedSampleArray(4);\n@state bbRe2 = new FixedSampleArray(4); @state bbIm2 = new FixedSampleArray(4);\n\n// Fallback ZC pitch tracker & smoothing\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 58.27;\n@state smoothF0 = 58.27;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = (abs(in2) > 0.0000001) ? in2 : xL;\nlet pitchIn = in3;\n\n// --- 1. Pitch Conditioning ---\nlet mono = 0.5 * (xL + xR);\nlet monoLow = lpTrack.next(mono, 190.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slew = 1.0 - exp(-1.0 / (0.006 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slew;\nlet f0 = clamp(smoothF0, 24.0, 1000.0);\n\n// --- 2. Baseband Smoothing Coefficient (Paper Eq. 4 & 8: gamma * e^(-alpha_m * t)) ---\nlet decaySec = clamp(mode_decay_ms, 5.0, 600.0) * 0.001;\nlet alphaCoeff = 1.0 - exp(-6.907755 / (decaySec * sr)); // T60 decay rate\nlet drive = dbtoa(clamp(mode_drive_db, 0.0, 24.0));\nlet invAmt = clamp(spectral_invert, 0.0, 1.0);\nlet shiftRatio = pow(2.0, clamp(pitch_shift_semi, -12.0, 12.0) / 12.0);\nlet tilt = clamp(odd_even_mode_tilt, -1.0, 1.0);\n\nlet sumRe = 0.0;\nlet sumIm = 0.0;\n\n// --- 3. 4-Mode Heterodyne -> Smooth -> Distort -> Re-Modulate Pipeline (Fig. 2, 8, 12) ---\nfor (let m: Int = 0; m < 4; m++) {\n\tlet harmNum = m + 1.0;\n\tlet fAna = clamp(f0 * harmNum, 20.0, sr * 0.45);\n\n\t// Advance heterodyne analysis phase e^(-j * w_m * t)\n\tlet phA = wrap(anaPh[m] + fAna / sr, 0.0, 1.0);\n\tanaPh[m] = phA;\n\n\tlet hetRe = mono * cos(2.0 * pi * phA);\n\tlet hetIm = -mono * sin(2.0 * pi * phA);\n\n\t// 2-stage complex exponential baseband smoother (Paper Sec 3.2)\n\tbbRe1[m] += (hetRe - bbRe1[m]) * alphaCoeff;\n\tbbIm1[m] += (hetIm - bbIm1[m]) * alphaCoeff;\n\tbbRe2[m] += (bbRe1[m] - bbRe2[m]) * alphaCoeff;\n\tbbIm2[m] += (bbIm1[m] - bbIm2[m]) * alphaCoeff;\n\n\t// Extract complex mode envelope & phase at DC baseband\n\tlet envRe = bbRe2[m] * 3.5;\n\tlet envIm = bbIm2[m] * 3.5;\n\n\t// Paper Sec 3.3 Eq. 14: Spectral Inversion about pivot f_c = 2 * f0\n\t// Maps harmonic {1, 2, 3, 4} -> {4, 2, 1.333, 1} (or inverted order {4, 3, 2, 1})\n\tlet invHarm = 5.0 - harmNum;\n\tlet targetHarm = linearinterp(invAmt, harmNum, invHarm);\n\tlet fSyn = clamp(f0 * targetHarm * shiftRatio, 20.0, sr * 0.45);\n\n\tlet phS = wrap(synPh[m] + fSyn / sr, 0.0, 1.0);\n\tsynPh[m] = phS;\n\n\t// Re-modulate complex baseband mode back to audio frequency e^(j * nu_m * t)\n\tlet modCos = cos(2.0 * pi * phS);\n\tlet modSin = sin(2.0 * pi * phS);\n\tlet modeRe = envRe * modCos - envIm * modSin;\n\tlet modeIm = envRe * modSin + envIm * modCos;\n\n\t// Paper Sec 3.4 Fig. 12: Distort each narrowband mode INDIVIDUALLY before summing!\n\t// Zero intermodulation products between harmonics, plus Nyquist-aware harmonic order\n\tlet distRe = tanh(modeRe * drive);\n\tlet distIm = tanh(modeIm * drive);\n\n\t// Odd/Even mode weighting\n\tlet isEven = ((m & 1) == 1) ? 1.0 : 0.0;\n\tlet weight = isEven ? (1.0 + 0.6 * tilt) : (1.0 - 0.6 * tilt);\n\n\tsumRe += distRe * weight;\n\tsumIm += distIm * weight;\n}\n\n// Paper Sec 2 (p. 2): Real part -> Left channel, Imaginary part -> Right channel for 90-deg stereo\nlet wetL = sumRe * 0.45;\nlet wetR = sumIm * 0.45;\n\nlet mMix = clamp(mix, 0.0, 1.0);\nout1 = linearinterp(mMix, xL, wetL);\nout2 = linearinterp(mMix, xR, wetR);\n"
                    },
