                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "in 1 @comment input",
                                        "patching_rect": [ 15.0, 15.0, 122.0, 22.0 ],
                                        "numoutlets": 1,
                                        "outlettype": [ "" ],
