                            },
                            "classnamespace": "dsp.gen",
                            "rect": [ 444.0, 100.0, 755.0, 766.0 ],
                            "boxes": [
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "in 4 @comment \"gain (dB)\"",
                                        "patching_rect": [ 566.0, 15.0, 153.0, 22.0 ],
                                        "numinlets": 0,
                                        "id": "obj-35",
                                        "numoutlets": 1,
                                        "outlettype": [ "" ]
                                    }
                                },
                                {
