                                        "destination": [ "obj-5", 3 ]
                                    }
                                },
                                {
                                    "patchline": {
                                        "source": [ "obj-21", 0 ],
                                        "destination": [ "obj-5", 2 ]
                                    }
                                }
                            ]
                        }
                    },
                    "id": "obj-81",
