        },
        "classnamespace": "rnbo",
        "rect": [ 100.0, 100.0, 1847.0, 780.0 ],
        "default_fontname": "Lato",
        "title": "untitled",
        "boxes": [
            {
                "box": {
                    "code": "// ============================================================================\n// 09_pitch_tracked_comb_resonator.txt\n// Unix-Style Effect 9: Pitch-Tracked Stereo Metallic Comb Filter\n// Tunes a stereo pair of interpolated feedback/feedforward comb filters to an\n// exact harmonic/sub-harmonic ratio of the tuba's pitch (or a fixed frequency)\n// with internal damping and tanh saturation in the feedback loop.\n// Produces the hollow, metallic \"pipe / flange / robot\" timbre essential to\n// modern riddim and tearout dubstep.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input\n//   in2: Right Audio Input\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n// Outlets:\n//   out1: Left Comb-Filtered Audio Output\n//   out2: Right Comb-Filtered Audio Output\n\n@param({ min: 0.5, max: 16.0 }) tune_ratio = 2.0;\n@param({ min: -0.98, max: 0.98 }) feedback = 0.82;\n@param({ min: 0.0, max: 1.0 }) damp_bright = 0.7;\n@param({ min: 0.0, max: 1.0 }) stereo_detune = 0.25;\n\n// Circular delay buffers (4096 samples -> down to ~11 Hz at 44.1 kHz)\n@state combBufL = new FixedSampleArray(4096);\n@state combBufR = new FixedSampleArray(4096);\n@state writeIdx: Int = 0;\n\n// Feedback damping one-pole lowpass states & DC blockers\n@state dampL = new onepole();\n@state dampR = new onepole();\n@state dcXL = 0.0; @state dcYL = 0.0;\n@state dcXR = 0.0; @state dcYR = 0.0;\n\n// Fallback ZC pitch tracker & smoothing\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothDelayL = 200.0;\n@state smoothDelayR = 200.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\n\n// --- 1. Pitch Conditioning ---\nlet monoLow = lpTrack.next(0.5 * (xL + xR), 180.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet f0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet baseCombHz = clamp(f0 * clamp(tune_ratio, 0.5, 16.0), 18.0, 4000.0);\n\n// Stereo detune up to +/- 7 semitones (fifth) at max, concentrated in fine cents at low values\nlet detSemis = pow(clamp(stereo_detune, 0.0, 1.0), 1.8) * 7.0;\nlet detFactor = pow(2.0, detSemis / 12.0);\n\nlet targetDelL = clamp(sr / (baseCombHz / detFactor), 4.0, 4090.0);\nlet targetDelR = clamp(sr / (baseCombHz * detFactor), 4.0, 4090.0);\n\n// Smooth delay times to produce musical pitch-glide waveguides without clicks\nlet delSlew = 1.0 - exp(-1.0 / (0.012 * sr));\nsmoothDelayL += (targetDelL - smoothDelayL) * delSlew;\nsmoothDelayR += (targetDelR - smoothDelayR) * delSlew;\n\n// --- 2. Cubic Interpolated Comb Delay Read ---\nlet rPosL = writeIdx - smoothDelayL;\nwhile (rPosL < 0.0) { rPosL += 4096.0; }\nlet iL0: Int = floor(rPosL);\nlet fracL = rPosL - iL0;\nlet delOutL = cubicinterp(fracL,\n\tcombBufL[(iL0 - 1 + 4096) % 4096],\n\tcombBufL[iL0 % 4096],\n\tcombBufL[(iL0 + 1) % 4096],\n\tcombBufL[(iL0 + 2) % 4096]\n);\n\nlet rPosR = writeIdx - smoothDelayR;\nwhile (rPosR < 0.0) { rPosR += 4096.0; }\nlet iR0: Int = floor(rPosR);\nlet fracR = rPosR - iR0;\nlet delOutR = cubicinterp(fracR,\n\tcombBufR[(iR0 - 1 + 4096) % 4096],\n\tcombBufR[iR0 % 4096],\n\tcombBufR[(iR0 + 1) % 4096],\n\tcombBufR[(iR0 + 2) % 4096]\n);\n\n// --- 3. Feedback Loop Damping & Soft Clipping ---\n// damp_bright (0..1) maps exponentially from 400 Hz (dark tube) to 18 kHz (icy metallic riddim)\nlet dampHz = 400.0 * pow(45.0, clamp(damp_bright, 0.0, 1.0));\nlet filtFbL = dampL.next(delOutL, dampHz);\nlet filtFbR = dampR.next(delOutR, dampHz);\n\n// Musical taper on feedback so resolution near +/- 0.98 is finer\nlet fbSign = (feedback >= 0.0) ? 1.0 : -1.0;\nlet fbMag = 1.0 - pow(1.0 - abs(clamp(feedback, -0.98, 0.98)), 1.4);\nlet fbGain = fbSign * clamp(fbMag, 0.0, 0.985);\n\n// Write back with soft saturation and DC block in loop\nlet loopInL = tanh(xL + fbGain * filtFbL);\nlet loopInR = tanh(xR + fbGain * filtFbR);\n\nlet dcCoeff = 1.0 - (2.0 * pi * 15.0 / sr);\nlet cleanLoopL = loopInL - dcXL + dcCoeff * dcYL;\ndcXL = loopInL; dcYL = cleanLoopL;\n\nlet cleanLoopR = loopInR - dcXR + dcCoeff * dcYR;\ndcXR = loopInR; dcYR = cleanLoopR;\n\ncombBufL[writeIdx] = cleanLoopL;\ncombBufR[writeIdx] = cleanLoopR;\nwriteIdx = (writeIdx + 1) % 4096;\n\n// Output combines input + resonant comb tail with automatic headroom trim\nlet outGain = 1.0 / (1.0 + 0.5 * abs(fbGain));\nout1 = (xL + fbGain * delOutL) * outGain;\nout2 = (xR + fbGain * delOutR) * outGain;\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-2",
                    "maxclass": "codebox~",
                    "numinlets": 3,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                    "rnbo_classname": "codebox~",
                    "rnbo_extra_attributes": {
                        "safemath": 1,
                        "expr": "",
                        "nocache": 0,
                        "code": "// ============================================================================\n// 09_pitch_tracked_comb_resonator.txt\n// Unix-Style Effect 9: Pitch-Tracked Stereo Metallic Comb Filter\n// Tunes a stereo pair of interpolated feedback/feedforward comb filters to an\n// exact harmonic/sub-harmonic ratio of the tuba's pitch (or a fixed frequency)\n// with internal damping and tanh saturation in the feedback loop.\n// Produces the hollow, metallic \"pipe / flange / robot\" timbre essential to\n// modern riddim and tearout dubstep.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input\n//   in2: Right Audio Input\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n// Outlets:\n//   out1: Left Comb-Filtered Audio Output\n//   out2: Right Comb-Filtered Audio Output\n\n@param({ min: 0.5, max: 16.0 }) tune_ratio = 2.0;\n@param({ min: -0.98, max: 0.98 }) feedback = 0.82;\n@param({ min: 0.0, max: 1.0 }) damp_bright = 0.7;\n@param({ min: 0.0, max: 1.0 }) stereo_detune = 0.25;\n\n// Circular delay buffers (4096 samples -> down to ~11 Hz at 44.1 kHz)\n@state combBufL = new FixedSampleArray(4096);\n@state combBufR = new FixedSampleArray(4096);\n@state writeIdx: Int = 0;\n\n// Feedback damping one-pole lowpass states & DC blockers\n@state dampL = new onepole();\n@state dampR = new onepole();\n@state dcXL = 0.0; @state dcYL = 0.0;\n@state dcXR = 0.0; @state dcYR = 0.0;\n\n// Fallback ZC pitch tracker & smoothing\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothDelayL = 200.0;\n@state smoothDelayR = 200.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\n\n// --- 1. Pitch Conditioning ---\nlet monoLow = lpTrack.next(0.5 * (xL + xR), 180.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet f0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet baseCombHz = clamp(f0 * clamp(tune_ratio, 0.5, 16.0), 18.0, 4000.0);\n\n// Stereo detune up to +/- 7 semitones (fifth) at max, concentrated in fine cents at low values\nlet detSemis = pow(clamp(stereo_detune, 0.0, 1.0), 1.8) * 7.0;\nlet detFactor = pow(2.0, detSemis / 12.0);\n\nlet targetDelL = clamp(sr / (baseCombHz / detFactor), 4.0, 4090.0);\nlet targetDelR = clamp(sr / (baseCombHz * detFactor), 4.0, 4090.0);\n\n// Smooth delay times to produce musical pitch-glide waveguides without clicks\nlet delSlew = 1.0 - exp(-1.0 / (0.012 * sr));\nsmoothDelayL += (targetDelL - smoothDelayL) * delSlew;\nsmoothDelayR += (targetDelR - smoothDelayR) * delSlew;\n\n// --- 2. Cubic Interpolated Comb Delay Read ---\nlet rPosL = writeIdx - smoothDelayL;\nwhile (rPosL < 0.0) { rPosL += 4096.0; }\nlet iL0: Int = floor(rPosL);\nlet fracL = rPosL - iL0;\nlet delOutL = cubicinterp(fracL,\n\tcombBufL[(iL0 - 1 + 4096) % 4096],\n\tcombBufL[iL0 % 4096],\n\tcombBufL[(iL0 + 1) % 4096],\n\tcombBufL[(iL0 + 2) % 4096]\n);\n\nlet rPosR = writeIdx - smoothDelayR;\nwhile (rPosR < 0.0) { rPosR += 4096.0; }\nlet iR0: Int = floor(rPosR);\nlet fracR = rPosR - iR0;\nlet delOutR = cubicinterp(fracR,\n\tcombBufR[(iR0 - 1 + 4096) % 4096],\n\tcombBufR[iR0 % 4096],\n\tcombBufR[(iR0 + 1) % 4096],\n\tcombBufR[(iR0 + 2) % 4096]\n);\n\n// --- 3. Feedback Loop Damping & Soft Clipping ---\n// damp_bright (0..1) maps exponentially from 400 Hz (dark tube) to 18 kHz (icy metallic riddim)\nlet dampHz = 400.0 * pow(45.0, clamp(damp_bright, 0.0, 1.0));\nlet filtFbL = dampL.next(delOutL, dampHz);\nlet filtFbR = dampR.next(delOutR, dampHz);\n\n// Musical taper on feedback so resolution near +/- 0.98 is finer\nlet fbSign = (feedback >= 0.0) ? 1.0 : -1.0;\nlet fbMag = 1.0 - pow(1.0 - abs(clamp(feedback, -0.98, 0.98)), 1.4);\nlet fbGain = fbSign * clamp(fbMag, 0.0, 0.985);\n\n// Write back with soft saturation and DC block in loop\nlet loopInL = tanh(xL + fbGain * filtFbL);\nlet loopInR = tanh(xR + fbGain * filtFbR);\n\nlet dcCoeff = 1.0 - (2.0 * pi * 15.0 / sr);\nlet cleanLoopL = loopInL - dcXL + dcCoeff * dcYL;\ndcXL = loopInL; dcYL = cleanLoopL;\n\nlet cleanLoopR = loopInR - dcXR + dcCoeff * dcYR;\ndcXR = loopInR; dcYR = cleanLoopR;\n\ncombBufL[writeIdx] = cleanLoopL;\ncombBufR[writeIdx] = cleanLoopR;\nwriteIdx = (writeIdx + 1) % 4096;\n\n// Output combines input + resonant comb tail with automatic headroom trim\nlet outGain = 1.0 / (1.0 + 0.5 * abs(fbGain));\nout1 = (xL + fbGain * delOutL) * outGain;\nout2 = (xR + fbGain * delOutR) * outGain;\n"
                    },
                    "rnbo_serial": 1,
                    "rnbo_uniqueid": "effect_code",
