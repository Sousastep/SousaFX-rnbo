            {
                "box": {
                    "code": "// Inverse of: y = (value == 0) ? 0 : pow(1.93, 10 * (value - 1));\n//             out = clip(y * 9694 + 6, 6, 9700)\n\nlet x = in1;\n\n// Undo the clip, scale, and offset\nlet c = clamp(x, 6.0, 9700.0);\nlet y = (c - 6.0) / 9694.0;\n\n// Undo the exponential\n// 10 * log(1.93) = 6.575...\nlet k = 10.0 * log(1.93);\n\nif (y <= 0.0) {\n    out1 = 0.0;\n} else {\n    out1 = 1.0 + log(y) / k;\n}",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-551",
                    "maxclass": "codebox~",
                    "numinlets": 1,
                    "numoutlets": 1,
                    "outlettype": [ "signal" ],
                    "patching_rect": [ 1685.0, 6258.0, 242.0, 200.0 ],
                    "rnbo_classname": "codebox~",
                    "rnbo_extra_attributes": {
                        "code": "// Inverse of: y = (value == 0) ? 0 : pow(1.93, 10 * (value - 1));\n//             out = clip(y * 9694 + 6, 6, 9700)\n\nlet x = in1;\n\n// Undo the clip, scale, and offset\nlet c = clamp(x, 6.0, 9700.0);\nlet y = (c - 6.0) / 9694.0;\n\n// Undo the exponential\n// 10 * log(1.93) = 6.575...\nlet k = 10.0 * log(1.93);\n\nif (y <= 0.0) {\n    out1 = 0.0;\n} else {\n    out1 = 1.0 + log(y) / k;\n}",
                        "safemath": 1,
                        "expr": "",
                        "nocache": 0
