                            {
                                "box": {
                                    "id": "obj-15",
                                    "maxclass": "newobj",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patcher": {
                                        "fileversion": 1,
                                        "appversion": {
                                            "major": 9,
                                            "minor": 2,
                                            "revision": 1,
                                            "architecture": "x64",
                                            "modernui": 1
                                        },
                                        "classnamespace": "rnbo",
                                        "rect": [ 100.0, 100.0, 1557.0, 780.0 ],
                                        "default_fontname": "Lato",
                                        "title": "ai.yoi_cascade_formants",
                                        "boxes": [
                                            {
                                                "box": {
                                                    "code": "// ============================================================================\n// yoi_cascade_formants.txt — five two-pole formant resonators in series\n//                            (all-pole cascade, unity gain at DC) following\n//                            U -> O -> I as in3 rises: a vowel with the\n//                            natural formant tilt of a vocal tract\n//\n// From: P. R. Cook, \"Toward the Perfect Audio Morph? Singing Voice Synthesis\n//       and Processing\", DAFx-98 COO62 (formants as the longitudinal modes\n//       of the vocal tract tube below ~4 kHz; all-pole formant filter);\n//       C. Traube, N. D'Alessandro, DAFx-05 P_104 §1.5 (vowels in the\n//       (F1, F2) plane, Fig. 8 / Fig. 11).\n//\n// Signal (per channel):\n//   v      = clamp(log2(f_in3 / 200) / 4, 0, 1)    200 Hz U, 800 O, 3200 I\n//   F1..3  = log-interpolated  U (300, 870, 2240) -> O (570, 840, 2410)\n//                              -> I (270, 2290, 3010) Hz; F4 3300, F5 3750\n//            (all x formant shift)\n//   y      = R5(R4(R3(R2(R1(x)))))     R = TPT SVF lowpass\n//                                      w^2 / (s^2 + (w/Q) s + w^2):\n//                                      unity at DC, peak ~Q at its formant\n//   Q      = 2 * 15^in4 (2 .. 30)\n//   out    = y * 0.7 * (Q / 2)^-0.4     (the tuba's low end passes at unity,\n//                                       only the formant peaks grow)\n//\n// Inlets:\n//   in1 / in2: stereo audio\n//   in3: vowel position as a frequency in Hz (held when <= 1 Hz; 800 Hz = O\n//        at start)\n//   in4: resonance 0..1 (formant sharpness)\n// Outlets:\n//   out1 / out2: stereo (mono sum = plain stereo filter, see width)\n// No safety limiter, no metering.\n// ============================================================================\n\n// Moves all five formants (semitones): - = bigger mouth, + = smaller\n@param({ min: -12, max: 12 }) formant_shift_st = 0;\n// Vowel position offset from in3 (semitones; 24 st = U to O)\n@param({ min: -36, max: 36 }) freq_offset_st = 0;\n// Width (%): formant-shifted side copy, cancels exactly in mono\n@param({ min: 0, max: 100 }) width = 50;\n\n// resonator states: slot = channel * 5 + formant (0 L, 1 R, 2 side copy)\n@state ic1 = new FixedSampleArray(15);\n@state ic2 = new FixedSampleArray(15);\n@state fHold = 800.0;\n@state fSm = 800.0;\n@state resSm = 0.0;\n\n// TPT SVF lowpass (unity DC, damping kd = 1/Q) on slot idx\nfunction svfLp(idx: Int, x: number, g: number, kd: number): number {\n\tlet a1 = 1.0 / (1.0 + g * (g + kd));\n\tlet a2 = g * a1;\n\tlet a3 = g * a2;\n\tlet v3 = x - ic2[idx];\n\tlet v1 = a1 * ic1[idx] + a2 * v3;\n\tlet v2 = ic2[idx] + a2 * ic1[idx] + a3 * v3;\n\tic1[idx] = 2.0 * v1 - ic1[idx];\n\tic2[idx] = 2.0 * v2 - ic2[idx];\n\treturn v2;\n}\n\n// Prewarped TPT gain for formant frequency 2^l2f Hz\nfunction tptG(l2f: number, sr: number): number {\n\treturn tan(pi * clamp(exp2(l2f), 20.0, sr * 0.45) / sr);\n}\n\n// Five formants in series, channel ch (log2 frequencies l1..l5)\nfunction cascade(ch: Int, x: number, l1: number, l2: number, l3: number, l4: number, l5: number, kd: number, sr: number): number {\n\tlet b: Int = ch * 5;\n\tlet y = svfLp(b, x, tptG(l1, sr), kd);\n\ty = svfLp(b + 1, y, tptG(l2, sr), kd);\n\ty = svfLp(b + 2, y, tptG(l3, sr), kd);\n\ty = svfLp(b + 3, y, tptG(l4, sr), kd);\n\treturn svfLp(b + 4, y, tptG(l5, sr), kd);\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet aSm = 1.0 - exp(-200.0 / sr);\n\n// --- Controls: in3 vowel position (held), in4 resonance, 5 ms smoothing ------\nif (in3 > 1.0) {\n\tfHold = in3;\n}\nlet fTarget = clamp(fHold * exp2(clamp(freq_offset_st, -36.0, 36.0) / 12.0), 20.0, 20000.0);\nfSm = fSm + (fTarget - fSm) * aSm;\nresSm = resSm + (clamp(in4, 0.0, 1.0) - resSm) * aSm;\n\n// --- Vowel path U -> O -> I, interpolated in log2(Hz) ------------------------\nlet v = clamp(log2(fSm / 200.0) * 0.25, 0.0, 1.0);\nlet lo = (v < 0.5) ? 1.0 : 0.0;\nlet t = (v < 0.5) ? 2.0 * v : 2.0 * v - 1.0;\nlet shift = clamp(formant_shift_st, -12.0, 12.0) / 12.0;\nlet l1 = shift + lo * linearinterp(t, 8.2288, 9.1548) + (1.0 - lo) * linearinterp(t, 9.1548, 8.0768);\nlet l2 = shift + lo * linearinterp(t, 9.7649, 9.7142) + (1.0 - lo) * linearinterp(t, 9.7142, 11.1611);\nlet l3 = shift + lo * linearinterp(t, 11.1293, 11.2348) + (1.0 - lo) * linearinterp(t, 11.2348, 11.5555);\n// F4 3300 Hz, F5 3750 Hz\nlet l4 = shift + 11.6883;\nlet l5 = shift + 11.8727;\n\nlet q = 2.0 * pow(15.0, resSm);\nlet kd = 1.0 / q;\nlet makeup = 0.7 * pow(q * 0.5, -0.4);\nlet wd = clamp(width, 0.0, 100.0) * 0.01;\n\n// --- Filter: L, R, and a side copy on the mono sum shifted up to +1 octave --\nlet yL = cascade(0, xL, l1, l2, l3, l4, l5, kd, sr);\nlet yR = cascade(1, xR, l1, l2, l3, l4, l5, kd, sr);\nlet yD = cascade(2, 0.5 * (xL + xR), l1 + wd, l2 + wd, l3 + wd, l4 + wd, l5 + wd, kd, sr);\nlet side = wd * (yD - 0.5 * (yL + yR));\n\nout1 = (yL + side) * makeup;\nout2 = (yR - side) * makeup;\n",
                                                    "fontface": 0,
                                                    "fontname": "<Monospaced>",
                                                    "fontsize": 12.0,
                                                    "id": "obj-2",
                                                    "maxclass": "codebox~",
                                                    "numinlets": 4,
                                                    "numoutlets": 2,
                                                    "outlettype": [ "signal", "signal" ],
                                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                                    "rnbo_classname": "codebox~",
                                                    "rnbo_extra_attributes": {
                                                        "code": "// ============================================================================\n// yoi_cascade_formants.txt — five two-pole formant resonators in series\n//                            (all-pole cascade, unity gain at DC) following\n//                            U -> O -> I as in3 rises: a vowel with the\n//                            natural formant tilt of a vocal tract\n//\n// From: P. R. Cook, \"Toward the Perfect Audio Morph? Singing Voice Synthesis\n//       and Processing\", DAFx-98 COO62 (formants as the longitudinal modes\n//       of the vocal tract tube below ~4 kHz; all-pole formant filter);\n//       C. Traube, N. D'Alessandro, DAFx-05 P_104 §1.5 (vowels in the\n//       (F1, F2) plane, Fig. 8 / Fig. 11).\n//\n// Signal (per channel):\n//   v      = clamp(log2(f_in3 / 200) / 4, 0, 1)    200 Hz U, 800 O, 3200 I\n//   F1..3  = log-interpolated  U (300, 870, 2240) -> O (570, 840, 2410)\n//                              -> I (270, 2290, 3010) Hz; F4 3300, F5 3750\n//            (all x formant shift)\n//   y      = R5(R4(R3(R2(R1(x)))))     R = TPT SVF lowpass\n//                                      w^2 / (s^2 + (w/Q) s + w^2):\n//                                      unity at DC, peak ~Q at its formant\n//   Q      = 2 * 15^in4 (2 .. 30)\n//   out    = y * 0.7 * (Q / 2)^-0.4     (the tuba's low end passes at unity,\n//                                       only the formant peaks grow)\n//\n// Inlets:\n//   in1 / in2: stereo audio\n//   in3: vowel position as a frequency in Hz (held when <= 1 Hz; 800 Hz = O\n//        at start)\n//   in4: resonance 0..1 (formant sharpness)\n// Outlets:\n//   out1 / out2: stereo (mono sum = plain stereo filter, see width)\n// No safety limiter, no metering.\n// ============================================================================\n\n// Moves all five formants (semitones): - = bigger mouth, + = smaller\n@param({ min: -12, max: 12 }) formant_shift_st = 0;\n// Vowel position offset from in3 (semitones; 24 st = U to O)\n@param({ min: -36, max: 36 }) freq_offset_st = 0;\n// Width (%): formant-shifted side copy, cancels exactly in mono\n@param({ min: 0, max: 100 }) width = 50;\n\n// resonator states: slot = channel * 5 + formant (0 L, 1 R, 2 side copy)\n@state ic1 = new FixedSampleArray(15);\n@state ic2 = new FixedSampleArray(15);\n@state fHold = 800.0;\n@state fSm = 800.0;\n@state resSm = 0.0;\n\n// TPT SVF lowpass (unity DC, damping kd = 1/Q) on slot idx\nfunction svfLp(idx: Int, x: number, g: number, kd: number): number {\n\tlet a1 = 1.0 / (1.0 + g * (g + kd));\n\tlet a2 = g * a1;\n\tlet a3 = g * a2;\n\tlet v3 = x - ic2[idx];\n\tlet v1 = a1 * ic1[idx] + a2 * v3;\n\tlet v2 = ic2[idx] + a2 * ic1[idx] + a3 * v3;\n\tic1[idx] = 2.0 * v1 - ic1[idx];\n\tic2[idx] = 2.0 * v2 - ic2[idx];\n\treturn v2;\n}\n\n// Prewarped TPT gain for formant frequency 2^l2f Hz\nfunction tptG(l2f: number, sr: number): number {\n\treturn tan(pi * clamp(exp2(l2f), 20.0, sr * 0.45) / sr);\n}\n\n// Five formants in series, channel ch (log2 frequencies l1..l5)\nfunction cascade(ch: Int, x: number, l1: number, l2: number, l3: number, l4: number, l5: number, kd: number, sr: number): number {\n\tlet b: Int = ch * 5;\n\tlet y = svfLp(b, x, tptG(l1, sr), kd);\n\ty = svfLp(b + 1, y, tptG(l2, sr), kd);\n\ty = svfLp(b + 2, y, tptG(l3, sr), kd);\n\ty = svfLp(b + 3, y, tptG(l4, sr), kd);\n\treturn svfLp(b + 4, y, tptG(l5, sr), kd);\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet aSm = 1.0 - exp(-200.0 / sr);\n\n// --- Controls: in3 vowel position (held), in4 resonance, 5 ms smoothing ------\nif (in3 > 1.0) {\n\tfHold = in3;\n}\nlet fTarget = clamp(fHold * exp2(clamp(freq_offset_st, -36.0, 36.0) / 12.0), 20.0, 20000.0);\nfSm = fSm + (fTarget - fSm) * aSm;\nresSm = resSm + (clamp(in4, 0.0, 1.0) - resSm) * aSm;\n\n// --- Vowel path U -> O -> I, interpolated in log2(Hz) ------------------------\nlet v = clamp(log2(fSm / 200.0) * 0.25, 0.0, 1.0);\nlet lo = (v < 0.5) ? 1.0 : 0.0;\nlet t = (v < 0.5) ? 2.0 * v : 2.0 * v - 1.0;\nlet shift = clamp(formant_shift_st, -12.0, 12.0) / 12.0;\nlet l1 = shift + lo * linearinterp(t, 8.2288, 9.1548) + (1.0 - lo) * linearinterp(t, 9.1548, 8.0768);\nlet l2 = shift + lo * linearinterp(t, 9.7649, 9.7142) + (1.0 - lo) * linearinterp(t, 9.7142, 11.1611);\nlet l3 = shift + lo * linearinterp(t, 11.1293, 11.2348) + (1.0 - lo) * linearinterp(t, 11.2348, 11.5555);\n// F4 3300 Hz, F5 3750 Hz\nlet l4 = shift + 11.6883;\nlet l5 = shift + 11.8727;\n\nlet q = 2.0 * pow(15.0, resSm);\nlet kd = 1.0 / q;\nlet makeup = 0.7 * pow(q * 0.5, -0.4);\nlet wd = clamp(width, 0.0, 100.0) * 0.01;\n\n// --- Filter: L, R, and a side copy on the mono sum shifted up to +1 octave --\nlet yL = cascade(0, xL, l1, l2, l3, l4, l5, kd, sr);\nlet yR = cascade(1, xR, l1, l2, l3, l4, l5, kd, sr);\nlet yD = cascade(2, 0.5 * (xL + xR), l1 + wd, l2 + wd, l3 + wd, l4 + wd, l5 + wd, kd, sr);\nlet side = wd * (yD - 0.5 * (yL + yR));\n\nout1 = (yL + side) * makeup;\nout2 = (yR - side) * makeup;\n",
                                                        "safemath": 1,
