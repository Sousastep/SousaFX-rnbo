                            },
                            {
                                "box": {
                                    "id": "obj-8",
                                    "maxclass": "newobj",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patcher": {
                                        "fileversion": 1,
                                        "appversion": {
                                            "major": 9,
                                            "minor": 2,
                                            "revision": 1,
                                            "architecture": "x64",
                                            "modernui": 1
                                        },
                                        "classnamespace": "rnbo",
                                        "rect": [ 100.0, 100.0, 1743.0, 780.0 ],
                                        "default_fontname": "Lato",
                                        "title": "ai.comb_tanh_scream",
                                        "boxes": [
                                            {
                                                "box": {
                                                    "code": "// ============================================================================\n// comb_tanh_scream.txt — feedback comb with a tanh saturator inside the\n//                        loop: below unity loop gain a resonant comb that\n//                        grits up as it rings, above it a bounded,\n//                        screaming self-oscillation locked to in3\n//\n// From: J. Chowdhury, \"Stable Structures for Nonlinear Biquad Filters\",\n//       DAFx-20 paper 3: §2.2 Eq. 10-11 (saturating base nonlinearity,\n//       slope <= 1), §4 (nonlinear feedback structure: a saturator in the\n//       feedback path keeps the state bounded; large states pull the\n//       effective loop gain down);\n//       V. Norilo, \"Exploring the Vectored Time Variant Comb Filter\",\n//       DAFx-14 §3 (comb filters with nonlinear feedback as a family of\n//       modulation-delay effects).\n//\n// Signal (per channel):\n//   v   = x + tanh(drive * c * LP(AP(v[n - N]))) / drive\n//   c   = 1.08 * in4 * polarity             (|c| > 1 self-oscillates; the\n//                                            tanh bounds it at 1/drive)\n//   N   = sr / f for polarity >= 0 (peaks f, 2f, 3f ...)\n//         sr / 2f for polarity < 0 (negative feedback: peaks f, 3f, 5f ...)\n//   out = v * (1 - cm)^0.3 * (1 + cm)^0.25, cm = min(|c|, 0.95): half the\n//         plain-comb makeup exponents, since the tanh caps the feedback\n//\n// Inlets:\n//   in1 / in2: stereo audio\n//   in3: comb pitch in Hz (held when <= 1 Hz; 600 Hz until the first)\n//   in4: resonance 0..1 (above ~0.93 the loop self-oscillates)\n// Outlets:\n//   out1 / out2: stereo (mono sum = plain stereo comb, see width)\n// No safety limiter, no metering.\n// ============================================================================\n\n// Feedback polarity: -1 odd harmonics (hollow), +1 all harmonics\n@param({ min: -1, max: 1 }) polarity = 1;\n// Loop saturation drive (dB): more = grittier ring, quieter scream\n@param({ min: 0, max: 24 }) drive_db = 12;\n// Comb pitch offset from in3 (semitones)\n@param({ min: -36, max: 36 }) freq_offset_st = 0;\n// Width (%): detuned side copy, cancels exactly in mono\n@param({ min: 0, max: 100 }) width = 50;\n\n// ring buffers: 3 x 10000 samples (0 L, 1 R, 2 side copy)\n@state buf = new FixedSampleArray(30000);\n@state wpos: Int = 0;\n@state apX1 = new FixedSampleArray(3);\n@state apY1 = new FixedSampleArray(3);\n@state lpS = new FixedSampleArray(3);\n@state fHold = 600.0;\n@state fSm = 600.0;\n@state resSm = 0.0;\n\n// Saturated comb, channel ch: loop delay d samples, loop coefficient c, LP pole p\nfunction scomb(ch: Int, x: number, d: number, c: number, p: number, drv: number): number {\n\tlet n: Int = clamp(trunc(d - 0.5), 1, 9990);\n\tlet fr = clamp(d - n, 0.0, 1.5);\n\tlet a = (1.0 - fr) / (1.0 + fr);\n\tlet base: Int = ch * 10000;\n\tlet tap = buf[base + ((wpos - n + 10000) % 10000)];\n\tlet ap = a * tap + apX1[ch] - a * apY1[ch];\n\tapX1[ch] = tap;\n\tapY1[ch] = ap;\n\tlpS[ch] = (1.0 - p) * ap + p * lpS[ch];\n\tlet v = x + tanh(drv * c * lpS[ch]) / drv;\n\tbuf[base + wpos] = v;\n\treturn v;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet aSm = 1.0 - exp(-200.0 / sr);\n\n// --- Controls: in3 pitch (held), in4 resonance, 5 ms smoothing ---------------\nif (in3 > 1.0) {\n\tfHold = in3;\n}\nlet fMin = sr / 9990.0;\nlet fTarget = clamp(fHold * exp2(clamp(freq_offset_st, -36.0, 36.0) / 12.0), fMin, sr * 0.125);\nfSm = fSm + (fTarget - fSm) * aSm;\nresSm = resSm + (clamp(in4, 0.0, 1.0) - resSm) * aSm;\n\nlet pol = clamp(polarity, -1.0, 1.0);\nlet c = 1.08 * resSm * pol;\nlet cm = minimum(abs(c), 0.95);\nlet makeup = pow(1.0 - cm, 0.3) * pow(1.0 + cm, 0.25);\nlet drv = dbtoa(clamp(drive_db, 0.0, 24.0));\n// fixed loop lowpass (6 kHz) and its phase delay at the comb pitch\nlet p = exp(-2.0 * pi * minimum(6000.0, sr * 0.45) / sr);\nlet wd = clamp(width, 0.0, 100.0) * 0.01;\n\n// --- Loop delays: full period (positive) or half period (negative) ----------\nlet half = (pol < 0.0) ? 0.5 : 1.0;\nlet w = 2.0 * pi * fSm / sr;\nlet d = half * sr / fSm - atan2(p * sin(w), 1.0 - p * cos(w)) / w;\nlet fD = minimum(fSm * exp2(wd), sr * 0.125);\nlet wD = 2.0 * pi * fD / sr;\nlet dD = half * sr / fD - atan2(p * sin(wD), 1.0 - p * cos(wD)) / wD;\n\n// --- Comb: L, R, and a side copy on the mono sum tuned up to +1 octave ------\nlet yL = scomb(0, xL, d, c, p, drv);\nlet yR = scomb(1, xR, d, c, p, drv);\nlet yD = scomb(2, 0.5 * (xL + xR), dD, c, p, drv);\nwpos = (wpos + 1) % 10000;\nlet side = wd * (yD - 0.5 * (yL + yR));\n\nout1 = (yL + side) * makeup;\nout2 = (yR - side) * makeup;\n",
                                                    "fontface": 0,
                                                    "fontname": "<Monospaced>",
                                                    "fontsize": 12.0,
                                                    "id": "obj-2",
                                                    "maxclass": "codebox~",
                                                    "numinlets": 4,
                                                    "numoutlets": 2,
                                                    "outlettype": [ "signal", "signal" ],
                                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                                    "rnbo_classname": "codebox~",
                                                    "rnbo_extra_attributes": {
                                                        "code": "// ============================================================================\n// comb_tanh_scream.txt — feedback comb with a tanh saturator inside the\n//                        loop: below unity loop gain a resonant comb that\n//                        grits up as it rings, above it a bounded,\n//                        screaming self-oscillation locked to in3\n//\n// From: J. Chowdhury, \"Stable Structures for Nonlinear Biquad Filters\",\n//       DAFx-20 paper 3: §2.2 Eq. 10-11 (saturating base nonlinearity,\n//       slope <= 1), §4 (nonlinear feedback structure: a saturator in the\n//       feedback path keeps the state bounded; large states pull the\n//       effective loop gain down);\n//       V. Norilo, \"Exploring the Vectored Time Variant Comb Filter\",\n//       DAFx-14 §3 (comb filters with nonlinear feedback as a family of\n//       modulation-delay effects).\n//\n// Signal (per channel):\n//   v   = x + tanh(drive * c * LP(AP(v[n - N]))) / drive\n//   c   = 1.08 * in4 * polarity             (|c| > 1 self-oscillates; the\n//                                            tanh bounds it at 1/drive)\n//   N   = sr / f for polarity >= 0 (peaks f, 2f, 3f ...)\n//         sr / 2f for polarity < 0 (negative feedback: peaks f, 3f, 5f ...)\n//   out = v * (1 - cm)^0.3 * (1 + cm)^0.25, cm = min(|c|, 0.95): half the\n//         plain-comb makeup exponents, since the tanh caps the feedback\n//\n// Inlets:\n//   in1 / in2: stereo audio\n//   in3: comb pitch in Hz (held when <= 1 Hz; 600 Hz until the first)\n//   in4: resonance 0..1 (above ~0.93 the loop self-oscillates)\n// Outlets:\n//   out1 / out2: stereo (mono sum = plain stereo comb, see width)\n// No safety limiter, no metering.\n// ============================================================================\n\n// Feedback polarity: -1 odd harmonics (hollow), +1 all harmonics\n@param({ min: -1, max: 1 }) polarity = 1;\n// Loop saturation drive (dB): more = grittier ring, quieter scream\n@param({ min: 0, max: 24 }) drive_db = 12;\n// Comb pitch offset from in3 (semitones)\n@param({ min: -36, max: 36 }) freq_offset_st = 0;\n// Width (%): detuned side copy, cancels exactly in mono\n@param({ min: 0, max: 100 }) width = 50;\n\n// ring buffers: 3 x 10000 samples (0 L, 1 R, 2 side copy)\n@state buf = new FixedSampleArray(30000);\n@state wpos: Int = 0;\n@state apX1 = new FixedSampleArray(3);\n@state apY1 = new FixedSampleArray(3);\n@state lpS = new FixedSampleArray(3);\n@state fHold = 600.0;\n@state fSm = 600.0;\n@state resSm = 0.0;\n\n// Saturated comb, channel ch: loop delay d samples, loop coefficient c, LP pole p\nfunction scomb(ch: Int, x: number, d: number, c: number, p: number, drv: number): number {\n\tlet n: Int = clamp(trunc(d - 0.5), 1, 9990);\n\tlet fr = clamp(d - n, 0.0, 1.5);\n\tlet a = (1.0 - fr) / (1.0 + fr);\n\tlet base: Int = ch * 10000;\n\tlet tap = buf[base + ((wpos - n + 10000) % 10000)];\n\tlet ap = a * tap + apX1[ch] - a * apY1[ch];\n\tapX1[ch] = tap;\n\tapY1[ch] = ap;\n\tlpS[ch] = (1.0 - p) * ap + p * lpS[ch];\n\tlet v = x + tanh(drv * c * lpS[ch]) / drv;\n\tbuf[base + wpos] = v;\n\treturn v;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet aSm = 1.0 - exp(-200.0 / sr);\n\n// --- Controls: in3 pitch (held), in4 resonance, 5 ms smoothing ---------------\nif (in3 > 1.0) {\n\tfHold = in3;\n}\nlet fMin = sr / 9990.0;\nlet fTarget = clamp(fHold * exp2(clamp(freq_offset_st, -36.0, 36.0) / 12.0), fMin, sr * 0.125);\nfSm = fSm + (fTarget - fSm) * aSm;\nresSm = resSm + (clamp(in4, 0.0, 1.0) - resSm) * aSm;\n\nlet pol = clamp(polarity, -1.0, 1.0);\nlet c = 1.08 * resSm * pol;\nlet cm = minimum(abs(c), 0.95);\nlet makeup = pow(1.0 - cm, 0.3) * pow(1.0 + cm, 0.25);\nlet drv = dbtoa(clamp(drive_db, 0.0, 24.0));\n// fixed loop lowpass (6 kHz) and its phase delay at the comb pitch\nlet p = exp(-2.0 * pi * minimum(6000.0, sr * 0.45) / sr);\nlet wd = clamp(width, 0.0, 100.0) * 0.01;\n\n// --- Loop delays: full period (positive) or half period (negative) ----------\nlet half = (pol < 0.0) ? 0.5 : 1.0;\nlet w = 2.0 * pi * fSm / sr;\nlet d = half * sr / fSm - atan2(p * sin(w), 1.0 - p * cos(w)) / w;\nlet fD = minimum(fSm * exp2(wd), sr * 0.125);\nlet wD = 2.0 * pi * fD / sr;\nlet dD = half * sr / fD - atan2(p * sin(wD), 1.0 - p * cos(wD)) / wD;\n\n// --- Comb: L, R, and a side copy on the mono sum tuned up to +1 octave ------\nlet yL = scomb(0, xL, d, c, p, drv);\nlet yR = scomb(1, xR, d, c, p, drv);\nlet yD = scomb(2, 0.5 * (xL + xR), dD, c, p, drv);\nwpos = (wpos + 1) % 10000;\nlet side = wd * (yD - 0.5 * (yL + yR));\n\nout1 = (yL + side) * makeup;\nout2 = (yR - side) * makeup;\n",
                                                        "safemath": 1,
