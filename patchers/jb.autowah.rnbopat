                            {
                                "box": {
                                    "id": "obj-18",
                                    "linecount": 5,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 102.0, 73.0, 154.0, 78.0 ],
                                    "text": "1. Simper SVF, Moog Q dip.\n2. comb tanh scream\n3. svf ladder\n4. lp pole mixing ota\n5. yoi cascade formants"
