        "rect": [ 100.0, 100.0, 1800.0, 780.0 ],
        "default_fontname": "Lato",
        "title": "untitled",
        "boxes": [
            {
                "box": {
                    "code": "// ============================================================================\n// heterodyne_pd_shaper.txt\n// Unix-Style Stereo Effect: Hilbert Quadrature Heterodyne Phase Distortion\n// Implements Lazzarini, Timoney, Pekonen & Valimaki (DAFx-09, Paper 12):\n// \"Adaptive Phase Distortion Synthesis\" (Section 3.2 & 4.2, Eq. 5-6, 17, Fig. 8-9, 18-20).\n// Places the arbitrary stereo tuba signal in quadrature (s_re, s_im) via a 4-stage\n// IIR Hilbert network and computes exact general-purpose Phase Distortion via:\n//   y(t) = s_im(t) * sin(idx * 2*pi * g(phi_m)) - s_re(t) * cos(idx * 2*pi * g(phi_m))\n// where g(x) morphs between single-inflection sawtooth PD (Eq. 6) and double-\n// inflection square/odd-harmonic PD (Fig. 18), with unbounded PM index (> pi).\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba or 01_harmonic_isolator)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: Tracked Fundamental Pitch f0 in Hz (from 00_tuba_freq_tracker; fallback ZC if <=0)\n//   in4: Optional 1-Bar Phasor [0..1] (sweeps inflection point d if mod_depth > 0)\n// Outlets:\n//   out1: Left Heterodyne Phase-Distorted Output\n//   out2: Right Heterodyne Phase-Distorted Output\n\n@param({ min: 0.25, max: 4.0 }) pd_ratio = 1.0;\n@param({ min: 0.02, max: 0.98 }) inflection_d = 0.15;\n@param({ min: 0.0, max: 5.0 }) pd_index = 1.25;\n@param({ min: 0.0, max: 1.0 }) saw_square = 0.0;\n@param({ min: 0.0, max: 1.0 }) mod_depth = 0.0;\n@param({ min: 0.0, max: 1.0 }) mix = 1.0;\n\n// Stereo 4-stage IIR Hilbert transform allpass states (Left & Right channels)\n@state lReX = new FixedSampleArray(4); @state lReY = new FixedSampleArray(4);\n@state lImX = new FixedSampleArray(4); @state lImY = new FixedSampleArray(4);\n@state lDelRe = 0.0;\n\n@state rReX = new FixedSampleArray(4); @state rReY = new FixedSampleArray(4);\n@state rImX = new FixedSampleArray(4); @state rImY = new FixedSampleArray(4);\n@state rDelRe = 0.0;\n\n// Pitch-tracked PD modulator phasor + fallback bar LFO\n@state modPhasor = new phasor();\n@state barFallback = new phasor();\n@state prevBarIn = 0.0;\n\n// Internal fallback zero-crossing pitch tracker & smoothing\n@state lpTrack = new onepole();\n@state prevTrackSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 58.27;\n@state smoothF0 = 58.27;\n@state smoothD = 0.15;\n@state smoothIdx = 1.25;\n\n// Single-inflection PD phase modulation function g_saw(x, d) (Paper Eq. 6)\nfunction pdSawG(x: number, d: number): number {\n\tlet sd = clamp(d, 0.02, 0.98);\n\tlet g = 0.0;\n\tif (x < sd) {\n\t\tg = x * (0.5 / sd - 1.0);\n\t} else {\n\t\tg = 0.5 + (x - sd) / (2.0 * (1.0 - sd)) - x;\n\t}\n\treturn g;\n}\n\n// Double-inflection PD phase modulation function g_sq(x, d) (Paper Fig. 18: odd harmonics)\nfunction pdSquareG(x: number, d: number): number {\n\tlet halfX = wrap(x * 2.0, 0.0, 1.0);\n\treturn 0.5 * pdSawG(halfX, d);\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = (abs(in2) > 0.0000001) ? in2 : xL;\nlet pitchIn = in3;\nlet barIn = in4;\n\n// --- 1. Pitch Conditioning (External Tracker on in3 or Fallback ZC) ---\nlet monoLow = lpTrack.next(0.5 * (xL + xR), 180.0);\nzcCount += 1.0;\nif (prevTrackSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevTrackSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slew = 1.0 - exp(-1.0 / (0.006 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slew;\nlet f0 = clamp(smoothF0, 24.0, 1000.0);\n\n// --- 2. 1-Bar Phasor Detection & Parameter Smoothing ---\nlet barActive = (abs(barIn - prevBarIn) > 0.000001 || (barIn > 0.001 && barIn < 0.999)) ? 1.0 : 0.0;\nprevBarIn = barIn;\nlet barPh = barActive ? wrap(barIn, 0.0, 1.0) : barFallback.next(0.5);\nlet lfoBi = sin(2.0 * pi * barPh);\n\nsmoothD += (clamp(inflection_d, 0.02, 0.98) - smoothD) * slew;\nlet idxTaper = pow(clamp(pd_index / 5.0, 0.0, 1.0), 1.3) * 5.0;\nsmoothIdx += (idxTaper - smoothIdx) * slew;\n\n// Stereo inflection spread + bar LFO modulation\nlet mDepth = clamp(mod_depth, 0.0, 1.0) * 0.38;\nlet dL = clamp(smoothD + mDepth * lfoBi - 0.025, 0.02, 0.98);\nlet dR = clamp(smoothD - mDepth * lfoBi + 0.025, 0.02, 0.98);\n\n// --- 3. Stereo 4-Stage Quadrature IIR Hilbert Transform ---\nlet cR0 = 0.4794008656; let cR1 = 0.8762184935; let cR2 = 0.9765975895; let cR3 = 0.9974992559;\nlet cI0 = 0.1617584983; let cI1 = 0.7330289323; let cI2 = 0.9453497003; let cI3 = 0.9905991567;\n\n// Left Hilbert pair\nlet reL = xL;\nlet t = cR0 * (reL + lReY[0]) - lReX[0]; lReX[0] = reL; lReY[0] = t; reL = t;\nt = cR1 * (reL + lReY[1]) - lReX[1]; lReX[1] = reL; lReY[1] = t; reL = t;\nt = cR2 * (reL + lReY[2]) - lReX[2]; lReX[2] = reL; lReY[2] = t; reL = t;\nt = cR3 * (reL + lReY[3]) - lReX[3]; lReX[3] = reL; lReY[3] = t; reL = t;\nlet sReL = lDelRe;\nlDelRe = reL;\n\nlet imL = xL;\nt = cI0 * (imL + lImY[0]) - lImX[0]; lImX[0] = imL; lImY[0] = t; imL = t;\nt = cI1 * (imL + lImY[1]) - lImX[1]; lImX[1] = imL; lImY[1] = t; imL = t;\nt = cI2 * (imL + lImY[2]) - lImX[2]; lImX[2] = imL; lImY[2] = t; imL = t;\nt = cI3 * (imL + lImY[3]) - lImX[3]; lImX[3] = imL; lImY[3] = t; imL = t;\nlet sImL = imL;\n\n// Right Hilbert pair\nlet reR = xR;\nt = cR0 * (reR + rReY[0]) - rReX[0]; rReX[0] = reR; rReY[0] = t; reR = t;\nt = cR1 * (reR + rReY[1]) - rReX[1]; rReX[1] = reR; rReY[1] = t; reR = t;\nt = cR2 * (reR + rReY[2]) - rReX[2]; rReX[2] = reR; rReY[2] = t; reR = t;\nt = cR3 * (reR + rReY[3]) - rReX[3]; rReX[3] = reR; rReY[3] = t; reR = t;\nlet sReR = rDelRe;\nrDelRe = reR;\n\nlet imR = xR;\nt = cI0 * (imR + rImY[0]) - rImX[0]; rImX[0] = imR; rImY[0] = t; imR = t;\nt = cI1 * (imR + rImY[1]) - rImX[1]; rImX[1] = imR; rImY[1] = t; imR = t;\nt = cI2 * (imR + rImY[2]) - rImX[2]; rImX[2] = imR; rImY[2] = t; imR = t;\nt = cI3 * (imR + rImY[3]) - rImX[3]; rImX[3] = imR; rImY[3] = t; imR = t;\nlet sImR = imR;\n\n// --- 4. Heterodyne Phase Distortion (Paper Eq. 17, Fig. 9) ---\nlet fm = clamp(f0 * clamp(pd_ratio, 0.25, 4.0), 8.0, sr * 0.22);\nlet phL = modPhasor.next(fm);\nlet phR = wrap(phL + 0.04, 0.0, 1.0);\n\nlet sqMorph = clamp(saw_square, 0.0, 1.0);\nlet gL = linearinterp(sqMorph, pdSawG(phL, dL), pdSquareG(phL, dL));\nlet gR = linearinterp(sqMorph, pdSawG(phR, dR), pdSquareG(phR, dR));\n\n// Scale phase modulation by smoothIdx (1.0 = classic Casio CZ PD; >1.0 = extended PM formants, Fig. 17)\nlet psiL = 2.0 * pi * smoothIdx * gL;\nlet psiR = 2.0 * pi * smoothIdx * gR;\n\n// Note: At smoothIdx = 0, cos(0)=1, sin(0)=0 -> wet = sRe * cos(psi) - sIm * sin(psi) preserves polarity cleanly\nlet wetL = sReL * cos(psiL) - sImL * sin(psiL);\nlet wetR = sReR * cos(psiR) - sImR * sin(psiR);\n\nlet m = clamp(mix, 0.0, 1.0);\nout1 = linearinterp(m, sReL, wetL);\nout2 = linearinterp(m, sReR, wetR);\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-2",
                    "maxclass": "codebox~",
                    "numinlets": 4,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                    "rnbo_classname": "codebox~",
                    "rnbo_extra_attributes": {
                        "safemath": 1,
                        "expr": "",
                        "nocache": 0,
                        "code": "// ============================================================================\n// heterodyne_pd_shaper.txt\n// Unix-Style Stereo Effect: Hilbert Quadrature Heterodyne Phase Distortion\n// Implements Lazzarini, Timoney, Pekonen & Valimaki (DAFx-09, Paper 12):\n// \"Adaptive Phase Distortion Synthesis\" (Section 3.2 & 4.2, Eq. 5-6, 17, Fig. 8-9, 18-20).\n// Places the arbitrary stereo tuba signal in quadrature (s_re, s_im) via a 4-stage\n// IIR Hilbert network and computes exact general-purpose Phase Distortion via:\n//   y(t) = s_im(t) * sin(idx * 2*pi * g(phi_m)) - s_re(t) * cos(idx * 2*pi * g(phi_m))\n// where g(x) morphs between single-inflection sawtooth PD (Eq. 6) and double-\n// inflection square/odd-harmonic PD (Fig. 18), with unbounded PM index (> pi).\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba or 01_harmonic_isolator)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: Tracked Fundamental Pitch f0 in Hz (from 00_tuba_freq_tracker; fallback ZC if <=0)\n//   in4: Optional 1-Bar Phasor [0..1] (sweeps inflection point d if mod_depth > 0)\n// Outlets:\n//   out1: Left Heterodyne Phase-Distorted Output\n//   out2: Right Heterodyne Phase-Distorted Output\n\n@param({ min: 0.25, max: 4.0 }) pd_ratio = 1.0;\n@param({ min: 0.02, max: 0.98 }) inflection_d = 0.15;\n@param({ min: 0.0, max: 5.0 }) pd_index = 1.25;\n@param({ min: 0.0, max: 1.0 }) saw_square = 0.0;\n@param({ min: 0.0, max: 1.0 }) mod_depth = 0.0;\n@param({ min: 0.0, max: 1.0 }) mix = 1.0;\n\n// Stereo 4-stage IIR Hilbert transform allpass states (Left & Right channels)\n@state lReX = new FixedSampleArray(4); @state lReY = new FixedSampleArray(4);\n@state lImX = new FixedSampleArray(4); @state lImY = new FixedSampleArray(4);\n@state lDelRe = 0.0;\n\n@state rReX = new FixedSampleArray(4); @state rReY = new FixedSampleArray(4);\n@state rImX = new FixedSampleArray(4); @state rImY = new FixedSampleArray(4);\n@state rDelRe = 0.0;\n\n// Pitch-tracked PD modulator phasor + fallback bar LFO\n@state modPhasor = new phasor();\n@state barFallback = new phasor();\n@state prevBarIn = 0.0;\n\n// Internal fallback zero-crossing pitch tracker & smoothing\n@state lpTrack = new onepole();\n@state prevTrackSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 58.27;\n@state smoothF0 = 58.27;\n@state smoothD = 0.15;\n@state smoothIdx = 1.25;\n\n// Single-inflection PD phase modulation function g_saw(x, d) (Paper Eq. 6)\nfunction pdSawG(x: number, d: number): number {\n\tlet sd = clamp(d, 0.02, 0.98);\n\tlet g = 0.0;\n\tif (x < sd) {\n\t\tg = x * (0.5 / sd - 1.0);\n\t} else {\n\t\tg = 0.5 + (x - sd) / (2.0 * (1.0 - sd)) - x;\n\t}\n\treturn g;\n}\n\n// Double-inflection PD phase modulation function g_sq(x, d) (Paper Fig. 18: odd harmonics)\nfunction pdSquareG(x: number, d: number): number {\n\tlet halfX = wrap(x * 2.0, 0.0, 1.0);\n\treturn 0.5 * pdSawG(halfX, d);\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = (abs(in2) > 0.0000001) ? in2 : xL;\nlet pitchIn = in3;\nlet barIn = in4;\n\n// --- 1. Pitch Conditioning (External Tracker on in3 or Fallback ZC) ---\nlet monoLow = lpTrack.next(0.5 * (xL + xR), 180.0);\nzcCount += 1.0;\nif (prevTrackSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevTrackSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slew = 1.0 - exp(-1.0 / (0.006 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slew;\nlet f0 = clamp(smoothF0, 24.0, 1000.0);\n\n// --- 2. 1-Bar Phasor Detection & Parameter Smoothing ---\nlet barActive = (abs(barIn - prevBarIn) > 0.000001 || (barIn > 0.001 && barIn < 0.999)) ? 1.0 : 0.0;\nprevBarIn = barIn;\nlet barPh = barActive ? wrap(barIn, 0.0, 1.0) : barFallback.next(0.5);\nlet lfoBi = sin(2.0 * pi * barPh);\n\nsmoothD += (clamp(inflection_d, 0.02, 0.98) - smoothD) * slew;\nlet idxTaper = pow(clamp(pd_index / 5.0, 0.0, 1.0), 1.3) * 5.0;\nsmoothIdx += (idxTaper - smoothIdx) * slew;\n\n// Stereo inflection spread + bar LFO modulation\nlet mDepth = clamp(mod_depth, 0.0, 1.0) * 0.38;\nlet dL = clamp(smoothD + mDepth * lfoBi - 0.025, 0.02, 0.98);\nlet dR = clamp(smoothD - mDepth * lfoBi + 0.025, 0.02, 0.98);\n\n// --- 3. Stereo 4-Stage Quadrature IIR Hilbert Transform ---\nlet cR0 = 0.4794008656; let cR1 = 0.8762184935; let cR2 = 0.9765975895; let cR3 = 0.9974992559;\nlet cI0 = 0.1617584983; let cI1 = 0.7330289323; let cI2 = 0.9453497003; let cI3 = 0.9905991567;\n\n// Left Hilbert pair\nlet reL = xL;\nlet t = cR0 * (reL + lReY[0]) - lReX[0]; lReX[0] = reL; lReY[0] = t; reL = t;\nt = cR1 * (reL + lReY[1]) - lReX[1]; lReX[1] = reL; lReY[1] = t; reL = t;\nt = cR2 * (reL + lReY[2]) - lReX[2]; lReX[2] = reL; lReY[2] = t; reL = t;\nt = cR3 * (reL + lReY[3]) - lReX[3]; lReX[3] = reL; lReY[3] = t; reL = t;\nlet sReL = lDelRe;\nlDelRe = reL;\n\nlet imL = xL;\nt = cI0 * (imL + lImY[0]) - lImX[0]; lImX[0] = imL; lImY[0] = t; imL = t;\nt = cI1 * (imL + lImY[1]) - lImX[1]; lImX[1] = imL; lImY[1] = t; imL = t;\nt = cI2 * (imL + lImY[2]) - lImX[2]; lImX[2] = imL; lImY[2] = t; imL = t;\nt = cI3 * (imL + lImY[3]) - lImX[3]; lImX[3] = imL; lImY[3] = t; imL = t;\nlet sImL = imL;\n\n// Right Hilbert pair\nlet reR = xR;\nt = cR0 * (reR + rReY[0]) - rReX[0]; rReX[0] = reR; rReY[0] = t; reR = t;\nt = cR1 * (reR + rReY[1]) - rReX[1]; rReX[1] = reR; rReY[1] = t; reR = t;\nt = cR2 * (reR + rReY[2]) - rReX[2]; rReX[2] = reR; rReY[2] = t; reR = t;\nt = cR3 * (reR + rReY[3]) - rReX[3]; rReX[3] = reR; rReY[3] = t; reR = t;\nlet sReR = rDelRe;\nrDelRe = reR;\n\nlet imR = xR;\nt = cI0 * (imR + rImY[0]) - rImX[0]; rImX[0] = imR; rImY[0] = t; imR = t;\nt = cI1 * (imR + rImY[1]) - rImX[1]; rImX[1] = imR; rImY[1] = t; imR = t;\nt = cI2 * (imR + rImY[2]) - rImX[2]; rImX[2] = imR; rImY[2] = t; imR = t;\nt = cI3 * (imR + rImY[3]) - rImX[3]; rImX[3] = imR; rImY[3] = t; imR = t;\nlet sImR = imR;\n\n// --- 4. Heterodyne Phase Distortion (Paper Eq. 17, Fig. 9) ---\nlet fm = clamp(f0 * clamp(pd_ratio, 0.25, 4.0), 8.0, sr * 0.22);\nlet phL = modPhasor.next(fm);\nlet phR = wrap(phL + 0.04, 0.0, 1.0);\n\nlet sqMorph = clamp(saw_square, 0.0, 1.0);\nlet gL = linearinterp(sqMorph, pdSawG(phL, dL), pdSquareG(phL, dL));\nlet gR = linearinterp(sqMorph, pdSawG(phR, dR), pdSquareG(phR, dR));\n\n// Scale phase modulation by smoothIdx (1.0 = classic Casio CZ PD; >1.0 = extended PM formants, Fig. 17)\nlet psiL = 2.0 * pi * smoothIdx * gL;\nlet psiR = 2.0 * pi * smoothIdx * gR;\n\n// Note: At smoothIdx = 0, cos(0)=1, sin(0)=0 -> wet = sRe * cos(psi) - sIm * sin(psi) preserves polarity cleanly\nlet wetL = sReL * cos(psiL) - sImL * sin(psiL);\nlet wetR = sReR * cos(psiR) - sImR * sin(psiR);\n\nlet m = clamp(mix, 0.0, 1.0);\nout1 = linearinterp(m, sReL, wetL);\nout2 = linearinterp(m, sReR, wetR);\n"
                    },
                    "rnbo_serial": 1,
