                        "code": "/* ToTape9 — standalone RNBO codebox~ port\n * in1/in2: left/right; out1/out2: left/right.\n * Controls use original normalized VST values (0..1).\n * Double-precision DSP path; no added output dither.\n * Paste this entire file into codebox~ inside rnbo~.\n * MIT License\n * \n * Copyright (c) 2018 Chris Johnson\n * \n * Permission is hereby granted, free of charge, to any person obtaining a copy\n * of this software and associated documentation files (the \"Software\"), to deal\n * in the Software without restriction, including without limitation the rights\n * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n * copies of the Software, and to permit persons to whom the Software is\n * furnished to do so, subject to the following conditions:\n * \n * The above copyright notice and this permission notice shall be included in all\n * copies or substantial portions of the Software.\n * \n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n * SOFTWARE.\n * \n */\n\n// VST A: Input\n@param({ min: 0, max: 1 }) p_input = 0.5;\n// VST B: Tilt\n@param({ min: 0, max: 1 }) p_tilt = 0.5;\n// VST C: Shape\n@param({ min: 0, max: 1 }) p_shape = 0.5;\n// VST D: Flutter\n@param({ min: 0, max: 1 }) p_flutter = 0.5;\n// VST E: FlutSpd\n@param({ min: 0, max: 1 }) p_flutspd = 0.5;\n// VST F: Bias\n@param({ min: 0, max: 1 }) p_bias = 0.5;\n// VST G: HeadBmp\n@param({ min: 0, max: 1 }) p_headbmp = 0.5;\n// VST H: HeadFrq\n@param({ min: 0, max: 1 }) p_headfrq = 0.5;\n// VST I: Output\n@param({ min: 0, max: 1 }) p_output = 0.5;\n\nconst prevSampL1 = 0;\nconst prevSampR1 = 1;\nconst threshold1 = 2;\nconst prevSampL2 = 3;\nconst prevSampR2 = 4;\nconst threshold2 = 5;\nconst prevSampL3 = 6;\nconst prevSampR3 = 7;\nconst threshold3 = 8;\nconst prevSampL4 = 9;\nconst prevSampR4 = 10;\nconst threshold4 = 11;\nconst prevSampL5 = 12;\nconst prevSampR5 = 13;\nconst threshold5 = 14;\nconst prevSampL6 = 15;\nconst prevSampR6 = 16;\nconst threshold6 = 17;\nconst prevSampL7 = 18;\nconst prevSampR7 = 19;\nconst threshold7 = 20;\nconst prevSampL8 = 21;\nconst prevSampR8 = 22;\nconst threshold8 = 23;\nconst prevSampL9 = 24;\nconst prevSampR9 = 25;\nconst threshold9 = 26;\nconst gslew_total = 27;\nconst hdb_freq = 0;\nconst hdb_reso = 1;\nconst hdb_a0 = 2;\nconst hdb_a1 = 3;\nconst hdb_a2 = 4;\nconst hdb_b1 = 5;\nconst hdb_b2 = 6;\nconst hdb_sL1 = 7;\nconst hdb_sL2 = 8;\nconst hdb_sR1 = 9;\nconst hdb_sR2 = 10;\nconst hdb_total = 11;\n@state iirEncL = 0;\n@state iirDecL = 0;\n@state compEncL = 0;\n@state compDecL = 0;\n@state avgEncL = 0;\n@state avgDecL = 0;\n@state iirEncR = 0;\n@state iirDecR = 0;\n@state compEncR = 0;\n@state compDecR = 0;\n@state avgEncR = 0;\n@state avgDecR = 0;\n@state dL = new FixedFloat64Array(1002);\n@state dR = new FixedFloat64Array(1002);\n@state sweepL = 0;\n@state sweepR = 0;\n@state nextmaxL = 0;\n@state nextmaxR = 0;\n@state gcount: Int = 0;\n@state gslew = new FixedFloat64Array(gslew_total);\n@state hysteresisL = 0;\n@state hysteresisR = 0;\n@state headBumpL = 0;\n@state headBumpR = 0;\n@state hdbA = new FixedFloat64Array(hdb_total);\n@state hdbB = new FixedFloat64Array(hdb_total);\n@state avg32L = new FixedFloat64Array(33);\n@state avg32R = new FixedFloat64Array(33);\n@state avg16L = new FixedFloat64Array(17);\n@state avg16R = new FixedFloat64Array(17);\n@state avg8L = new FixedFloat64Array(9);\n@state avg8R = new FixedFloat64Array(9);\n@state avg4L = new FixedFloat64Array(5);\n@state avg4R = new FixedFloat64Array(5);\n@state avg2L = new FixedFloat64Array(3);\n@state avg2R = new FixedFloat64Array(3);\n@state post32L = new FixedFloat64Array(33);\n@state post32R = new FixedFloat64Array(33);\n@state post16L = new FixedFloat64Array(17);\n@state post16R = new FixedFloat64Array(17);\n@state post8L = new FixedFloat64Array(9);\n@state post8R = new FixedFloat64Array(9);\n@state post4L = new FixedFloat64Array(5);\n@state post4R = new FixedFloat64Array(5);\n@state post2L = new FixedFloat64Array(3);\n@state post2R = new FixedFloat64Array(3);\n@state lastDarkL = 0;\n@state lastDarkR = 0;\n@state avgPos: Int = 0;\n@state lastSampleL = 0;\n@state intermediateL = new FixedFloat64Array(18);\n@state slewL = new FixedFloat64Array(34);\n@state wasPosClipL = 0;\n@state wasNegClipL = 0;\n@state lastSampleR = 0;\n@state intermediateR = new FixedFloat64Array(18);\n@state slewR = new FixedFloat64Array(34);\n@state wasPosClipR = 0;\n@state wasNegClipR = 0;\n@state fpdL = 305419896.0;\n@state fpdR = 2271560481.0;\n@state overallscale = 0;\n@state spacing: Int = 0;\n@state slewsing: Int = 0;\n@state inputGain = 0;\n@state dublyAmount = 0;\n@state outlyAmount = 0;\n@state iirEncFreq = 0;\n@state iirDecFreq = 0;\n@state flutDepth = 0;\n@state flutFrequency = 0;\n@state bias = 0;\n@state underBias = 0;\n@state overBias = 0;\n@state headBumpDrive = 0;\n@state headBumpMix = 0;\n@state K = 0;\n@state norm = 0;\n@state outputGain = 0;\n@state frame: Int = 0;\n// Xorshift32 with explicit unsigned wrapping (fixed, reproducible seeds).\nfunction unsigned32(x) {\n    return x - floor(x / 4294967296.0) * 4294967296.0;\n}\nfunction advanceRandom(x) {\n    let a: Int = x;\n    let left: Int = unsigned32(x * 8192.0);\n    let b: Int = unsigned32(a ^ left);\n    let shifted: Int = floor(b / 131072.0);\n    let c: Int = unsigned32(b ^ shifted);\n    left = unsigned32(c * 32.0);\n    return unsigned32(c ^ left);\n}\nfunction toIndex(x) {\n    let result: Int = trunc(x);\n    return result;\n}\n\n@state floatCast = new FixedFloat32Array(1);\nfunction asFloat32(x) { floatCast[0] = x; return floatCast[0]; }\n\nfunction init() {\n\n\tiirEncL = 0.0; iirDecL = 0.0;\n\tcompEncL = 1.0; compDecL = 1.0;\n\tavgEncL = 0.0; avgDecL = 0.0;\n\t\n\tiirEncR = 0.0; iirDecR = 0.0;\n\tcompEncR = 1.0; compDecR = 1.0;\n\tavgEncR = 0.0; avgDecR = 0.0;\n\t\n\tfor (let temp: Int = 0; temp < 1001; temp++) {dL[temp] = 0.0;dR[temp] = 0.0;}\n\tsweepL = PI;\n\tsweepR = PI;\n\tnextmaxL = 0.5;\t\n\tnextmaxR = 0.5;\n\tgcount = 0;\t\n\t\n\tfor (let x: Int = 0; x < gslew_total; x++) gslew[x] = 0.0;\n\t\n\thysteresisL = 0.0;\n\thysteresisR = 0.0;\n\t\n\theadBumpL = 0.0;\n\theadBumpR = 0.0;\n\tfor (let x: Int = 0; x < hdb_total; x++) {hdbA[x] = 0.0;hdbB[x] = 0.0;}\n\n\tfor (let x: Int = 0; x < 33; x++) {avg32L[x] = 0.0; post32L[x] = 0.0; avg32R[x] = 0.0; post32R[x] = 0.0;}\n\tfor (let x: Int = 0; x < 17; x++) {avg16L[x] = 0.0; post16L[x] = 0.0; avg16R[x] = 0.0; post16R[x] = 0.0;}\n\tfor (let x: Int = 0; x < 9; x++) {avg8L[x] = 0.0; post8L[x] = 0.0; avg8R[x] = 0.0; post8R[x] = 0.0;}\n\tfor (let x: Int = 0; x < 5; x++) {avg4L[x] = 0.0; post4L[x] = 0.0; avg4R[x] = 0.0; post4R[x] = 0.0;}\n\tfor (let x: Int = 0; x < 3; x++) {avg2L[x] = 0.0; post2L[x] = 0.0; avg2R[x] = 0.0; post2R[x] = 0.0;}\n\tavgPos = 0;\n\tlastDarkL = 0.0; lastDarkR = 0.0;\n\n\tlastSampleL = 0.0;\n\twasPosClipL = 0;\n\twasNegClipL = 0;\n\tlastSampleR = 0.0;\n\twasPosClipR = 0;\n\twasNegClipR = 0;\n\tfor (let x: Int = 0; x < 17; x++) {intermediateL[x] = 0.0; intermediateR[x] = 0.0;}\n\tfor (let x: Int = 0; x < 33; x++) {slewL[x] = 0.0; slewR[x] = 0.0;}\n\n}\nfunction dspsetup() { frame = 0; }\n\nif (frame == 0) {\noverallscale = 1.0;\n\toverallscale /= 44100.0;\n\toverallscale *= samplerate();\n\t\n\tspacing = floor(overallscale); \n\tif (spacing < 1) spacing = 1; if (spacing > 16) spacing = 16;\n\tslewsing = floor(overallscale*2.0);\n\tif (slewsing < 2) slewsing = 2; if (slewsing > 32) slewsing = 32;\n\t\n\tinputGain = pow(p_input*2.0,2.0);\n\t\n\tdublyAmount = p_tilt*2.0;\n\toutlyAmount = (1.0-p_tilt)*-2.0;\n\tif (outlyAmount < -1.0) outlyAmount = -1.0;\n\tiirEncFreq = (1.0-p_shape)/overallscale;\n\tiirDecFreq = p_shape/overallscale;\n\t\n\tflutDepth = pow(p_flutter,6)*overallscale*50;\n\tif (flutDepth > 498.0) flutDepth = 498.0;\n\tflutFrequency = (0.02*pow(p_flutspd,3))/overallscale;\n\tbias = (p_bias*2.0)-1.0;\n\tunderBias = (pow(bias,4)*0.25)/overallscale;\n\toverBias = pow(1.0-bias,3)/overallscale;\n\tif (bias > 0.0) underBias = 0.0;\n\tif (bias < 0.0) overBias = 1.0/overallscale;\n\t\n\tgslew[threshold9] = overBias;\n\toverBias *= 1.618033988749894848204586;\n\tgslew[threshold8] = overBias;\n\toverBias *= 1.618033988749894848204586;\n\tgslew[threshold7] = overBias;\n\toverBias *= 1.618033988749894848204586;\n\tgslew[threshold6] = overBias;\n\toverBias *= 1.618033988749894848204586;\n\tgslew[threshold5] = overBias;\n\toverBias *= 1.618033988749894848204586;\n\tgslew[threshold4] = overBias;\n\toverBias *= 1.618033988749894848204586;\n\tgslew[threshold3] = overBias;\n\toverBias *= 1.618033988749894848204586;\n\tgslew[threshold2] = overBias;\n\toverBias *= 1.618033988749894848204586;\n\tgslew[threshold1] = overBias;\n\toverBias *= 1.618033988749894848204586;\n\t\n\theadBumpDrive = (p_headbmp*0.1)/overallscale;\n\theadBumpMix = p_headbmp*0.5;\n\t\n\thdbA[hdb_freq] = ((asFloat32(p_headfrq*p_headfrq)*175.0)+25.0)/samplerate();\n\thdbB[hdb_freq] = hdbA[hdb_freq]*0.9375;\n\thdbB[hdb_reso] = hdbA[hdb_reso] = 0.618033988749894848204586;\n\thdbB[hdb_a1] = hdbA[hdb_a1] = 0.0;\n\t\n\tK = tan(PI * hdbA[hdb_freq]);\n\tnorm = 1.0 / (1.0 + K / hdbA[hdb_reso] + K * K);\n\thdbA[hdb_a0] = K / hdbA[hdb_reso] * norm;\n\thdbA[hdb_a2] = -hdbA[hdb_a0];\n\thdbA[hdb_b1] = 2.0 * (K * K - 1.0) * norm;\n\thdbA[hdb_b2] = (1.0 - K / hdbA[hdb_reso] + K * K) * norm;\n\tK = tan(PI * hdbB[hdb_freq]);\n\tnorm = 1.0 / (1.0 + K / hdbB[hdb_reso] + K * K);\n\thdbB[hdb_a0] = K / hdbB[hdb_reso] * norm;\n\thdbB[hdb_a2] = -hdbB[hdb_a0];\n\thdbB[hdb_b1] = 2.0 * (K * K - 1.0) * norm;\n\thdbB[hdb_b2] = (1.0 - K / hdbB[hdb_reso] + K * K) * norm;\n\t\n\toutputGain = p_output*2.0;\n\n}\nlet sampleFrames = vectorsize() - frame - 1;\nlet inFramesToProcess = vectorsize();\n\n\t\tlet inputSampleL = in1;\n\t\tlet inputSampleR = in2;\n\t\tif (abs(inputSampleL)<1.18e-23) inputSampleL = fpdL * 1.18e-17;\n\t\tif (abs(inputSampleR)<1.18e-23) inputSampleR = fpdR * 1.18e-17;\n\t\t\n\t\tif (inputGain != 1.0) {\n\t\t\tinputSampleL *= inputGain;\n\t\t\tinputSampleR *= inputGain;\n\t\t}\n\n\t\tiirEncL = (iirEncL * (1.0 - iirEncFreq)) + (inputSampleL * iirEncFreq);\n\t\tlet highPart = ((inputSampleL-iirEncL)*2.848);\n\t\thighPart += avgEncL; avgEncL = (inputSampleL-iirEncL)*1.152;\n\t\tif (highPart > 1.0) highPart = 1.0; if (highPart < -1.0) highPart = -1.0;\n\t\tlet dubly = abs(highPart);\n\t\tif (dubly > 0.0) {\n\t\t\tlet adjust = log(1.0+(255.0*dubly))/2.40823996531;\n\t\t\tif (adjust > 0.0) dubly /= adjust;\n\t\t\tcompEncL = (compEncL*(1.0-iirEncFreq))+(dubly*iirEncFreq);\n\t\t\tinputSampleL += ((highPart*compEncL)*dublyAmount);\n\t\t} \n\t\tiirEncR = (iirEncR * (1.0 - iirEncFreq)) + (inputSampleR * iirEncFreq);\n\t\thighPart = ((inputSampleR-iirEncR)*2.848);\n\t\thighPart += avgEncR; avgEncR = (inputSampleR-iirEncR)*1.152;\n\t\tif (highPart > 1.0) highPart = 1.0; if (highPart < -1.0) highPart = -1.0;\n\t\tdubly = abs(highPart);\n\t\tif (dubly > 0.0) {\n\t\t\tlet adjust = log(1.0+(255.0*dubly))/2.40823996531;\n\t\t\tif (adjust > 0.0) dubly /= adjust;\n\t\t\tcompEncR = (compEncR*(1.0-iirEncFreq))+(dubly*iirEncFreq);\n\t\t\tinputSampleR += ((highPart*compEncR)*dublyAmount);\n\t\t} \n\n\t\tif (flutDepth > 0.0) {\n\t\t\tif (gcount < 0 || gcount > 999) gcount = 999;\n\t\t\tdL[gcount] = inputSampleL;\n\t\t\tlet count: Int = gcount;\n\t\t\tlet offset = flutDepth + (flutDepth * sin(sweepL));\n\t\t\tsweepL += nextmaxL * flutFrequency;\n\t\t\tif (sweepL > (PI*2.0)) {\n\t\t\t\tsweepL -= PI*2.0;\n\t\t\t\tlet flutA = 0.24 + (fpdL / 4294967295.0 * 0.74);\n\t\t\t\tfpdL = advanceRandom(fpdL);\n\t\t\t\tlet flutB = 0.24 + (fpdL / 4294967295.0 * 0.74);\n\t\t\t\tif (abs(flutA-sin(sweepR+nextmaxR))<abs(flutB-sin(sweepR+nextmaxR))) nextmaxL = flutA; else nextmaxL = flutB;\n\t\t\t}\n\t\t\tcount += toIndex(floor(offset));\n\t\t\tinputSampleL = (dL[count-((count > 999)?1000:0)] * (1-(offset-floor(offset))));\n\t\t\tinputSampleL += (dL[count+1-((count+1 > 999)?1000:0)] * (offset-floor(offset)));\n\t\t\tdR[gcount] = inputSampleR;\n\t\t\tcount = gcount;\n\t\t\toffset = flutDepth + (flutDepth * sin(sweepR));\n\t\t\tsweepR += nextmaxR * flutFrequency;\n\t\t\tif (sweepR > (PI*2.0)) {\n\t\t\t\tsweepR -= PI*2.0;\n\t\t\t\tlet flutA = 0.24 + (fpdR / 4294967295.0 * 0.74);\n\t\t\t\tfpdR = advanceRandom(fpdR);\n\t\t\t\tlet flutB = 0.24 + (fpdR / 4294967295.0 * 0.74);\n\t\t\t\tif (abs(flutA-sin(sweepL+nextmaxL))<abs(flutB-sin(sweepL+nextmaxL))) nextmaxR = flutA; else nextmaxR = flutB;\n\t\t\t}\n\t\t\tcount += toIndex(floor(offset));\n\t\t\tinputSampleR = (dR[count-((count > 999)?1000:0)] * (1-(offset-floor(offset))));\n\t\t\tinputSampleR += (dR[count+1-((count+1 > 999)?1000:0)] * (offset-floor(offset)));\n\t\t\tgcount--;\n\t\t}\n\n\t\tif (abs(bias) > 0.001) {\n\t\t\tfor (let x: Int = 0; x < gslew_total; x += 3) {\n\t\t\t\tif (underBias > 0.0) {\n\t\t\t\t\tlet stuck = abs(inputSampleL - (gslew[x]/0.975)) / underBias;\n\t\t\t\t\tif (stuck < 1.0) inputSampleL = (inputSampleL * stuck) + ((gslew[x]/0.975)*(1.0-stuck));\n\t\t\t\t\tstuck =  abs(inputSampleR - (gslew[x+1]/0.975)) / underBias;\n\t\t\t\t\tif (stuck < 1.0) inputSampleR = (inputSampleR * stuck) + ((gslew[x+1]/0.975)*(1.0-stuck));\n\t\t\t\t}\n\t\t\t\tif ((inputSampleL - gslew[x]) > gslew[x+2]) inputSampleL = gslew[x] + gslew[x+2];\n\t\t\t\tif (-(inputSampleL - gslew[x]) > gslew[x+2]) inputSampleL = gslew[x] - gslew[x+2];\n\t\t\t\tgslew[x] = inputSampleL * 0.975;\n\t\t\t\tif ((inputSampleR - gslew[x+1]) > gslew[x+2]) inputSampleR = gslew[x+1] + gslew[x+2];\n\t\t\t\tif (-(inputSampleR - gslew[x+1]) > gslew[x+2]) inputSampleR = gslew[x+1] - gslew[x+2];\n\t\t\t\tgslew[x+1] = inputSampleR * 0.975;\n\t\t\t}\n\t\t}\n\n\t\tlet applyHysteresis = (1.0-abs(inputSampleL))*(1.0-abs(inputSampleL))*0.012;\n\t\thysteresisL = maximum(minimum(hysteresisL+((inputSampleL*abs(inputSampleL))),0.011449),-0.011449)*0.999;\n\t\tinputSampleL += (hysteresisL*applyHysteresis);\n\t\tapplyHysteresis = (1.0-abs(inputSampleR))*(1.0-abs(inputSampleR))*0.012;\n\t\thysteresisR = maximum(minimum(hysteresisR+((inputSampleR*abs(inputSampleR))),0.011449),-0.011449)*0.999;\n\t\tinputSampleR += (hysteresisR*applyHysteresis);\n\n\t\tlet darkSampleL = inputSampleL;\n\t\tlet darkSampleR = inputSampleR;\n\t\tif (avgPos > 31) avgPos = 0;\n\t\tif (slewsing > 31) {\n\t\t\tavg32L[avgPos] = darkSampleL; avg32R[avgPos] = darkSampleR;\n\t\t\tdarkSampleL = 0.0; darkSampleR = 0.0;\n\t\t\tfor (let x: Int = 0; x < 32; x++) {darkSampleL += avg32L[x]; darkSampleR += avg32R[x];}\n\t\t\tdarkSampleL /= 32.0; darkSampleR /= 32.0;\n\t\t} if (slewsing > 15) {\n\t\t\tavg16L[avgPos%16] = darkSampleL; avg16R[avgPos%16] = darkSampleR;\n\t\t\tdarkSampleL = 0.0; darkSampleR = 0.0;\n\t\t\tfor (let x: Int = 0; x < 16; x++) {darkSampleL += avg16L[x]; darkSampleR += avg16R[x];}\n\t\t\tdarkSampleL /= 16.0; darkSampleR /= 16.0;\n\t\t} if (slewsing > 7) {\n\t\t\tavg8L[avgPos%8] = darkSampleL; avg8R[avgPos%8] = darkSampleR;\n\t\t\tdarkSampleL = 0.0; darkSampleR = 0.0;\n\t\t\tfor (let x: Int = 0; x < 8; x++) {darkSampleL += avg8L[x]; darkSampleR += avg8R[x];}\n\t\t\tdarkSampleL /= 8.0; darkSampleR /= 8.0;\n\t\t} if (slewsing > 3) {\n\t\t\tavg4L[avgPos%4] = darkSampleL; avg4R[avgPos%4] = darkSampleR;\n\t\t\tdarkSampleL = 0.0; darkSampleR = 0.0;\n\t\t\tfor (let x: Int = 0; x < 4; x++) {darkSampleL += avg4L[x]; darkSampleR += avg4R[x];}\n\t\t\tdarkSampleL /= 4.0; darkSampleR /= 4.0;\n\t\t} if (slewsing > 1) {\n\t\t\tavg2L[avgPos%2] = darkSampleL; avg2R[avgPos%2] = darkSampleR;\n\t\t\tdarkSampleL = 0.0; darkSampleR = 0.0;\n\t\t\tfor (let x: Int = 0; x < 2; x++) {d