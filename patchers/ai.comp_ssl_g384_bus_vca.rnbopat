        "default_fontname": "Lato",
        "title": "untitled",
        "boxes": [
            {
                "box": {
                    "code": "// ============================================================================\n// comp_ssl_g384_bus_vca.txt\n// Stereo SSL Logic FX G384 / 4000 G-Bus VCA Glue Compressor\n// Based on Thompson & Heilemann (DAFx-2026, \"Evaluating Dynamic Range\n// Compressor Models Using Control-Voltage Measurements\", Sec. 3, 4.1)\n// Standalone Stereo RNBO codebox~ Effect (in1, in2 -> out1, out2)\n// ============================================================================\n\n@param({ min: -24.0, max: 36.0 }) input_gain_db = 0.0;\n@param({ min: -36.0, max: 0.0 }) thresh_db = -18.0;\n@param({ min: 2.0, max: 10.0 }) ratio_mode = 4.0;\n@param({ min: 0.1, max: 30.0 }) attack_ms = 10.0;\n@param({ min: 0.05, max: 1.5 }) release_s = 0.30;\n@param({ min: 0.0, max: 1.0 }) auto_release = 0.65;\n@param({ min: 20.0, max: 350.0 }) sc_hpf_hz = 85.0;\n@param({ min: 0.0, max: 1.0 }) vca_harmonics = 0.35;\n@param({ min: 0.0, max: 1.0 }) mix = 1.0;\n@param({ min: -24.0, max: 36.0 }) output_gain_db = 0.0;\n\n// Sidechain high-pass filter state (prevents sub-bass kick from over-pumping mix)\n@state sc_lp_L = 0.0;\n@state sc_lp_R = 0.0;\n\n// Two-pole SSL AUTO release + attack ballistics states (Thompson & Heilemann Sec. 3)\n@state cv_fast_db = 0.0;\n@state cv_slow_db = 0.0;\n@state cv_att_db = 0.0;\n\n// Helper: Ratio-dependent knee static gain computer (SSL G384 DBX 2151 sidechain VCA)\n// At 2:1 knee is wide & gentle; at 4:1 moderate; at 10:1 tight hard knee\nfunction ssl_static_gr_db(x_db: number, T: number, R: number): number {\n    let r_clamped = clamp(R, 1.5, 20.0);\n    // Knee width narrows as ratio increases from 2:1 to 10:1 (DAFx-2026 Sec. 3)\n    let knee_w = clamp(14.0 - 1.25 * (r_clamped - 2.0), 1.5, 14.0);\n    let diff = x_db - T;\n    let slope = (1.0 / r_clamped) - 1.0;\n    if (2.0 * diff < -knee_w) {\n        return 0.0;\n    } else if (2.0 * abs(diff) <= knee_w) {\n        let u = diff + 0.5 * knee_w;\n        return slope * (u * u) / max(2.0 * knee_w, 0.001);\n    } else {\n        return slope * diff;\n    }\n}\n\n// Helper: THAT 202 VCA subtle odd/even interstage saturation\nfunction that202_vca_sat(x: number, cv_atten_db: number, drive: number): number {\n    let d = clamp(drive, 0.0, 1.0);\n    if (d <= 0.0001) {\n        return x;\n    }\n    let mod = 1.0 + 0.04 * cv_atten_db;\n    let k2 = 0.045 * d * mod;\n    let k3 = 0.120 * d * mod;\n    let y = x + k2 * x * abs(x) - k3 * (x * x * x) / (1.0 + 0.4 * x * x);\n    return y;\n}\n\nlet sr_safe = max(samplerate(), 8000.0);\n\n// Input trim (plain gain stage, outside the detector)\nlet g_in = dbtoa(clamp(input_gain_db, -24.0, 36.0));\nlet dryL = in1 * g_in;\nlet dryR = ((abs(in2) > 1e-18) ? in2 : in1) * g_in;\n\n// 1st-order sidechain high-pass filter (20 Hz to 350 Hz)\nlet fc_sc = clamp(sc_hpf_hz, 20.0, 350.0);\nlet g_sc = 1.0 - exp(-2.0 * PI * fc_sc / sr_safe);\nsc_lp_L = sc_lp_L + g_sc * (dryL - sc_lp_L);\nsc_lp_R = sc_lp_R + g_sc * (dryR - sc_lp_R);\nlet scL = dryL - sc_lp_L;\nlet scR = dryR - sc_lp_R;\n\n// Peak-sensing shared stereo sidechain VCA (Thompson & Heilemann DAFx-2026 Sec. 3)\nlet sc_peak = max(abs(scL), abs(scR));\nlet x_db = atodb(max(sc_peak, 1e-6));\n\nlet T = clamp(thresh_db, -36.0, 0.0);\nlet R = clamp(ratio_mode, 2.0, 10.0);\nlet raw_gr_db = ssl_static_gr_db(x_db, T, R);\nlet target_atten_db = 0.0 - raw_gr_db; // positive attenuation in dB\n\n// Attack & dual-pole AUTO release ballistics\nlet tau_att = clamp(attack_ms, 0.1, 30.0) * 0.001;\nlet tau_rel_manual = clamp(release_s, 0.05, 1.5);\nlet alpha_att = 1.0 - exp(-1.0 / (tau_att * sr_safe));\nlet alpha_rel_man = 1.0 - exp(-1.0 / (tau_rel_manual * sr_safe));\n\n// Two-pole SSL AUTO release network: fast transient recovery pole (75 ms)\n// coupled to slow program-sustained recovery pole (1.25 s)\nlet alpha_rel_fast = 1.0 - exp(-1.0 / (0.075 * sr_safe));\nlet alpha_rel_slow = 1.0 - exp(-1.0 / (1.250 * sr_safe));\nlet alpha_charge_slow = 1.0 - exp(-1.0 / (0.180 * sr_safe));\n\nif (target_atten_db > cv_fast_db) {\n    cv_fast_db = cv_fast_db + alpha_att * (target_atten_db - cv_fast_db);\n} else {\n    let a_r = (1.0 - auto_release) * alpha_rel_man + auto_release * alpha_rel_fast;\n    cv_fast_db = cv_fast_db + a_r * (target_atten_db - cv_fast_db);\n}\n\nif (target_atten_db > cv_slow_db) {\n    cv_slow_db = cv_slow_db + alpha_charge_slow * (target_atten_db - cv_slow_db);\n} else {\n    cv_slow_db = cv_slow_db + alpha_rel_slow * (target_atten_db - cv_slow_db);\n}\n\n// In AUTO mode, the effective release voltage is the max/blend of fast and slow RC poles\nlet auto_blend = clamp(auto_release, 0.0, 1.0);\nlet dual_pole_db = max(cv_fast_db, 0.68 * cv_slow_db);\ncv_att_db = (1.0 - auto_blend) * cv_fast_db + auto_blend * dual_pole_db;\n\n// Automatic makeup gain proportional to threshold and ratio so bus level stays hot\nlet auto_makeup_db = -0.48 * T * (1.0 - 1.0 / R);\nlet total_gain = dbtoa(-cv_att_db + auto_makeup_db);\n\nlet vcaL = that202_vca_sat(dryL * total_gain, cv_att_db, vca_harmonics);\nlet vcaR = that202_vca_sat(dryR * total_gain, cv_att_db, vca_harmonics);\n\nlet m = clamp(mix, 0.0, 1.0);\n\n// Output trim (plain gain stage, after the sidechain tap)\nlet g_out = dbtoa(clamp(output_gain_db, -24.0, 36.0));\nout1 = ((1.0 - m) * dryL + m * vcaL) * g_out;\nout2 = ((1.0 - m) * dryR + m * vcaR) * g_out;\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-2",
                    "maxclass": "codebox~",
                    "numinlets": 2,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                    "rnbo_classname": "codebox~",
                    "rnbo_extra_attributes": {
                        "safemath": 1,
                        "expr": "",
                        "nocache": 0,
                        "code": "// ============================================================================\n// comp_ssl_g384_bus_vca.txt\n// Stereo SSL Logic FX G384 / 4000 G-Bus VCA Glue Compressor\n// Based on Thompson & Heilemann (DAFx-2026, \"Evaluating Dynamic Range\n// Compressor Models Using Control-Voltage Measurements\", Sec. 3, 4.1)\n// Standalone Stereo RNBO codebox~ Effect (in1, in2 -> out1, out2)\n// ============================================================================\n\n@param({ min: -24.0, max: 36.0 }) input_gain_db = 0.0;\n@param({ min: -36.0, max: 0.0 }) thresh_db = -18.0;\n@param({ min: 2.0, max: 10.0 }) ratio_mode = 4.0;\n@param({ min: 0.1, max: 30.0 }) attack_ms = 10.0;\n@param({ min: 0.05, max: 1.5 }) release_s = 0.30;\n@param({ min: 0.0, max: 1.0 }) auto_release = 0.65;\n@param({ min: 20.0, max: 350.0 }) sc_hpf_hz = 85.0;\n@param({ min: 0.0, max: 1.0 }) vca_harmonics = 0.35;\n@param({ min: 0.0, max: 1.0 }) mix = 1.0;\n@param({ min: -24.0, max: 36.0 }) output_gain_db = 0.0;\n\n// Sidechain high-pass filter state (prevents sub-bass kick from over-pumping mix)\n@state sc_lp_L = 0.0;\n@state sc_lp_R = 0.0;\n\n// Two-pole SSL AUTO release + attack ballistics states (Thompson & Heilemann Sec. 3)\n@state cv_fast_db = 0.0;\n@state cv_slow_db = 0.0;\n@state cv_att_db = 0.0;\n\n// Helper: Ratio-dependent knee static gain computer (SSL G384 DBX 2151 sidechain VCA)\n// At 2:1 knee is wide & gentle; at 4:1 moderate; at 10:1 tight hard knee\nfunction ssl_static_gr_db(x_db: number, T: number, R: number): number {\n    let r_clamped = clamp(R, 1.5, 20.0);\n    // Knee width narrows as ratio increases from 2:1 to 10:1 (DAFx-2026 Sec. 3)\n    let knee_w = clamp(14.0 - 1.25 * (r_clamped - 2.0), 1.5, 14.0);\n    let diff = x_db - T;\n    let slope = (1.0 / r_clamped) - 1.0;\n    if (2.0 * diff < -knee_w) {\n        return 0.0;\n    } else if (2.0 * abs(diff) <= knee_w) {\n        let u = diff + 0.5 * knee_w;\n        return slope * (u * u) / max(2.0 * knee_w, 0.001);\n    } else {\n        return slope * diff;\n    }\n}\n\n// Helper: THAT 202 VCA subtle odd/even interstage saturation\nfunction that202_vca_sat(x: number, cv_atten_db: number, drive: number): number {\n    let d = clamp(drive, 0.0, 1.0);\n    if (d <= 0.0001) {\n        return x;\n    }\n    let mod = 1.0 + 0.04 * cv_atten_db;\n    let k2 = 0.045 * d * mod;\n    let k3 = 0.120 * d * mod;\n    let y = x + k2 * x * abs(x) - k3 * (x * x * x) / (1.0 + 0.4 * x * x);\n    return y;\n}\n\nlet sr_safe = max(samplerate(), 8000.0);\n\n// Input trim (plain gain stage, outside the detector)\nlet g_in = dbtoa(clamp(input_gain_db, -24.0, 36.0));\nlet dryL = in1 * g_in;\nlet dryR = ((abs(in2) > 1e-18) ? in2 : in1) * g_in;\n\n// 1st-order sidechain high-pass filter (20 Hz to 350 Hz)\nlet fc_sc = clamp(sc_hpf_hz, 20.0, 350.0);\nlet g_sc = 1.0 - exp(-2.0 * PI * fc_sc / sr_safe);\nsc_lp_L = sc_lp_L + g_sc * (dryL - sc_lp_L);\nsc_lp_R = sc_lp_R + g_sc * (dryR - sc_lp_R);\nlet scL = dryL - sc_lp_L;\nlet scR = dryR - sc_lp_R;\n\n// Peak-sensing shared stereo sidechain VCA (Thompson & Heilemann DAFx-2026 Sec. 3)\nlet sc_peak = max(abs(scL), abs(scR));\nlet x_db = atodb(max(sc_peak, 1e-6));\n\nlet T = clamp(thresh_db, -36.0, 0.0);\nlet R = clamp(ratio_mode, 2.0, 10.0);\nlet raw_gr_db = ssl_static_gr_db(x_db, T, R);\nlet target_atten_db = 0.0 - raw_gr_db; // positive attenuation in dB\n\n// Attack & dual-pole AUTO release ballistics\nlet tau_att = clamp(attack_ms, 0.1, 30.0) * 0.001;\nlet tau_rel_manual = clamp(release_s, 0.05, 1.5);\nlet alpha_att = 1.0 - exp(-1.0 / (tau_att * sr_safe));\nlet alpha_rel_man = 1.0 - exp(-1.0 / (tau_rel_manual * sr_safe));\n\n// Two-pole SSL AUTO release network: fast transient recovery pole (75 ms)\n// coupled to slow program-sustained recovery pole (1.25 s)\nlet alpha_rel_fast = 1.0 - exp(-1.0 / (0.075 * sr_safe));\nlet alpha_rel_slow = 1.0 - exp(-1.0 / (1.250 * sr_safe));\nlet alpha_charge_slow = 1.0 - exp(-1.0 / (0.180 * sr_safe));\n\nif (target_atten_db > cv_fast_db) {\n    cv_fast_db = cv_fast_db + alpha_att * (target_atten_db - cv_fast_db);\n} else {\n    let a_r = (1.0 - auto_release) * alpha_rel_man + auto_release * alpha_rel_fast;\n    cv_fast_db = cv_fast_db + a_r * (target_atten_db - cv_fast_db);\n}\n\nif (target_atten_db > cv_slow_db) {\n    cv_slow_db = cv_slow_db + alpha_charge_slow * (target_atten_db - cv_slow_db);\n} else {\n    cv_slow_db = cv_slow_db + alpha_rel_slow * (target_atten_db - cv_slow_db);\n}\n\n// In AUTO mode, the effective release voltage is the max/blend of fast and slow RC poles\nlet auto_blend = clamp(auto_release, 0.0, 1.0);\nlet dual_pole_db = max(cv_fast_db, 0.68 * cv_slow_db);\ncv_att_db = (1.0 - auto_blend) * cv_fast_db + auto_blend * dual_pole_db;\n\n// Automatic makeup gain proportional to threshold and ratio so bus level stays hot\nlet auto_makeup_db = -0.48 * T * (1.0 - 1.0 / R);\nlet total_gain = dbtoa(-cv_att_db + auto_makeup_db);\n\nlet vcaL = that202_vca_sat(dryL * total_gain, cv_att_db, vca_harmonics);\nlet vcaR = that202_vca_sat(dryR * total_gain, cv_att_db, vca_harmonics);\n\nlet m = clamp(mix, 0.0, 1.0);\n\n// Output trim (plain gain stage, after the sidechain tap)\nlet g_out = dbtoa(clamp(output_gain_db, -24.0, 36.0));\nout1 = ((1.0 - m) * dryL + m * vcaL) * g_out;\nout2 = ((1.0 - m) * dryR + m * vcaR) * g_out;\n"
                    },
