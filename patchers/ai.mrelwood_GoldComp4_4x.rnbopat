0;\n@state s_in1_y1_indb = 0;\n@state s_in1_y1_indbmax = 0;\n@state s_in1_y1_indbo = 0;\n@state s_in1_y1_negg = 0;\n@state s_in1_y1_neggdb = 0;\n@state s_in1_y1_negin = 0;\n@state s_in1_y1_negovr = 0;\n@state s_in1_y1_opt = 0;\n@state s_in1_y1_ovr = 0;\n@state s_in1_y1_pk = 0;\n@state s_in1_y1_pkc = 0;\n@state s_in1_y1_pkcin1 = 0;\n@state s_in1_y1_pkcin2 = 0;\n@state s_in1_y1_pkcin2dir = 0;\n@state s_in1_y1_pkcin2o = 0;\n@state s_in1_y1_pkdir = 0;\n@state s_in1_y1_pkg = 0;\n@state s_in1_y1_pkgac = 0;\n@state s_in1_y1_pkgrc = 0;\n@state s_in1_y1_pkgtgt = 0;\n@state s_in1_y1_pkgtgtdir = 0;\n@state s_in1_y1_pkgtgto = 0;\n@state s_in1_y1_pknear = 0;\n@state s_in1_y1_pko = 0;\n@state s_in1_y1_pkovr = 0;\n@state s_in1_y1_pktgt = 0;\n@state s_in1_y1_rc = 0;\n@state s_in1_y1_rc2 = 0;\n@state s_in1_y1_sc = 0;\n@state s_in1_y1_slo = 0;\n@state s_in1_y1_sloin = 0;\n@state s_in1_y1_stgt = 0;\n@state s_in2 = 0;\n@state s_in2_os2_x0 = 0;\n@state s_in2_os2_x1 = 0;\n@state s_in2_os2_x2 = 0;\n@state s_in2_os2_x3 = 0;\n@state s_in2_os2_x4 = 0;\n@state s_in2_os2_x5 = 0;\n@state s_in2_os2_x6 = 0;\n@state s_in2_os2_x7 = 0;\n@state s_in2_os2_x8 = 0;\n@state s_in2_os2_x9 = 0;\n@state s_in2_os2_y0 = 0;\n@state s_in2_os2_y1 = 0;\n@state s_in2_os2_y10 = 0;\n@state s_in2_os2_y11 = 0;\n@state s_in2_os2_y12 = 0;\n@state s_in2_os2_y13 = 0;\n@state s_in2_os2_y14 = 0;\n@state s_in2_os2_y15 = 0;\n@state s_in2_os2_y16 = 0;\n@state s_in2_os2_y17 = 0;\n@state s_in2_os2_y18 = 0;\n@state s_in2_os2_y2 = 0;\n@state s_in2_os2_y3 = 0;\n@state s_in2_os2_y4 = 0;\n@state s_in2_os2_y5 = 0;\n@state s_in2_os2_y6 = 0;\n@state s_in2_os2_y7 = 0;\n@state s_in2_os2_y8 = 0;\n@state s_in2_os2_y9 = 0;\n@state s_in2_os4_x0 = 0;\n@state s_in2_os4_x1 = 0;\n@state s_in2_os4_x2 = 0;\n@state s_in2_os4_x3 = 0;\n@state s_in2_os4_x4 = 0;\n@state s_in2_os4_x5 = 0;\n@state s_in2_os4_x6 = 0;\n@state s_in2_os4_x7 = 0;\n@state s_in2_os4_x8 = 0;\n@state s_in2_os4_x9 = 0;\n@state s_in2_os4_y0 = 0;\n@state s_in2_os4_y1 = 0;\n@state s_in2