{
    "patcher": {
        "fileversion": 1,
        "appversion": {
            "major": 9,
            "minor": 2,
            "revision": 0,
            "architecture": "x64",
            "modernui": 1
        },
        "classnamespace": "rnbo",
        "rect": [ 100.0, 100.0, 1957.0, 780.0 ],
        "default_fontname": "Lato",
        "title": "untitled",
        "boxes": [
            {
                "box": {
                    "code": "// ============================================================================\n// barberpole_comb_ssb_flanger.txt\n// Unix-Style Stereo Effect: Endless Barberpole Dual-Comb & SSB Spectral-Delay Flanger\n// Implements Fabian Esqueda, Vesa Valimaki & Julian Parker (DAFx-15, Paper 67):\n// \"Barberpole Phasing and Flanging Illusions\" (Sections 3, 4 & 4.1, Eq. 9-14, Fig. 7-12).\n// Combines BOTH time-domain/hybrid barberpole comb engines from the paper:\n//   1. Synchronized Dual Flanger (Sec 3, Fig. 7-8): Two cubic-interpolated comb\n//      delay lines modulated by 90-degree-offset sawtooth ramps (Eq. 9) and\n//      seamlessly crossfaded by synchronized triangular window gains so comb\n//      notches sweep infinitely upward or downward without reset clicks!\n//   2. Single-Sideband (SSB) Spectral-Delay Barberpole (Sec 4 & 4.1, Fig. 10):\n//      Hilbert SSB frequency shifting mixed with a dispersive 6-stage allpass\n//      spectral delay chain to warp the moving comb notches logarithmically!\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: Optional Tracked Pitch f0 in Hz (if > 20 Hz, tunes comb sweep range around f0)\n//   in4: Optional 1-Bar Phasor [0..1] (syncs barberpole sweep cycle to host tempo)\n// Outlets:\n//   out1: Left Endless Barberpole Comb/SSB Output\n//   out2: Right Endless Barberpole Comb/SSB Output\n\n@param({ min: -16.0, max: 16.0 }) sweep_rate_hz = 3;\n@param({ min: 0.4, max: 12.0 }) center_delay_ms = 2.2;\n@param({ min: -0.92, max: 0.92 }) feedback = 0.72;\n@param({ min: 0.0, max: 1.0 }) dual_to_ssb_mode = 0.4;\n@param({ min: -0.8, max: 0.8 }) notch_warp_a1 = -0.5;\n@param({ min: 0.0, max: 1.0 }) stereo_counter_dir = 0.5;\n\n// Circular delay buffers for Dual Barberpole Flanger (2048 samples per channel)\n@state flgBufL = new FixedSampleArray(2048);\n@state flgBufR = new FixedSampleArray(2048);\n@state writeIdx: Int = 0;\n\n// 4-stage Quadrature IIR Hilbert states for SSB Barberpole (Paper Sec 4, Fig. 10)\n@state lReX = new FixedSampleArray(4); @state lReY = new FixedSampleArray(4);\n@state lImX = new FixedSampleArray(4); @state lImY = new FixedSampleArray(4);\n@state lDelRe = 0.0;\n\n@state rReX = new FixedSampleArray(4); @state rReY = new FixedSampleArray(4);\n@state rImX = new FixedSampleArray(4); @state rImY = new FixedSampleArray(4);\n@state rDelRe = 0.0;\n\n// 6-stage First-Order Allpass Spectral Delay Chain for Log-Warped Notches (Sec 4.1)\n@state apXL = new FixedSampleArray(6); @state apYL = new FixedSampleArray(6);\n@state apXR = new FixedSampleArray(6); @state apYR = new FixedSampleArray(6);\n\n// Feedback states & LFO phasor\n@state fbStateL = 0.0;\n@state fbStateR = 0.0;\n@state prevBarIn = 0.0;\n@state smoothCenterMs = 2.2;\n@state sweepPhase = 0.0;\n@state smoothRate = 0.0;\n@state prevBarActive = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = (abs(in2) > 0.0000001) ? in2 : xL;\nlet pitchIn = in3;\nlet barIn = in4;\n\nlet slew = 1.0 - exp(-1.0 / (0.006 * sr));\nsmoothCenterMs += (clamp(center_delay_ms, 0.4, 12.0) - smoothCenterMs) * slew;\n\n// If pitch tracker is connected on in3, bias center delay toward 1/(2*f0)\nlet baseDelaySamps = mstosamps(smoothCenterMs);\nif (pitchIn > 25.0 && pitchIn < 1000.0) {\n\tbaseDelaySamps = linearinterp(0.5, baseDelaySamps, clamp(sr / (2.0 * pitchIn), 15.0, 1200.0));\n}\n\n// Per DAFx-15 Sec 3 (p. 5): D_min should be > 0.5 * D_max to hide resets cleanly\nlet dMin = clamp(baseDelaySamps * 0.68, 4.0, 1200.0);\nlet dMax = clamp(baseDelaySamps * 1.32, 8.0, 1800.0);\n\n// --- 1. Barberpole Sweep Phase (signed integration: continuous through 0 Hz) ---\nlet rateTarget = clamp(sweep_rate_hz, -16.0, 16.0);\nlet rateSlew = 1.0 - exp(-1.0 / (0.02 * sr));\nsmoothRate += (rateTarget - smoothRate) * rateSlew;\n\nlet barActive = (abs(barIn - prevBarIn) > 0.000001 || (barIn > 0.001 && barIn < 0.999)) ? 1.0 : 0.0;\n\nif (barActive > 0.5) {\n\t// Tempo-synced: advance by the signed change in the bar phasor (cycles per bar = rounded |rate|)\n\tif (prevBarActive > 0.5) {\n\t\tlet d = barIn - prevBarIn;\n\t\td = d - floor(d + 0.5); // wrap delta to [-0.5, 0.5)\n\t\tlet cyc = maximum(floor(abs(smoothRate) + 0.5), 1.0);\n\t\tlet sgn = (smoothRate >= 0.0) ? 1.0 : -1.0;\n\t\tsweepPhase = wrap(sweepPhase + d * cyc * sgn, 0.0, 1.0);\n\t}\n} else {\n\t// Free-running: signed rate, so the phase simply slows, stops and reverses\n\tsweepPhase = wrap(sweepPhase + smoothRate / sr, 0.0, 1.0);\n}\nprevBarIn = barIn;\nprevBarActive = barActive;\n\nlet phL = sweepPhase;\n// Stereo counter-direction option: Right channel sweeps opposite direction when stereo_counter_dir > 0.5\nlet counter = clamp(stereo_counter_dir, 0.0, 1.0);\nlet phR = (counter > 0.5) ? (1.0 - phL) : wrap(phL + 0.25 * counter, 0.0, 1.0);\n\nlet fb = clamp(feedback, -0.92, 0.92);\nlet uL = tanh(xL + fb * fbStateL);\nlet uR = tanh(xR + fb * fbStateR);\n\nflgBufL[writeIdx] = uL;\nflgBufR[writeIdx] = uR;\n\n// --- 2. Engine A: Synchronized Dual Flanger (Paper Sec 3, Eq. 9, Fig. 7-8) ---\n// Two sawtooth LFOs offset by 0.5 cycle (so reset of one falls at midpoint of the other)\n// with complementary raised-triangle/cosine crossfade gains g1 + g2 = 1.0\nlet ph1L = phL;\nlet ph2L = wrap(phL + 0.5, 0.0, 1.0);\nlet del1L = dMin + (dMax - dMin) * ph1L;\nlet del2L = dMin + (dMax - dMin) * ph2L;\nlet g1L = triangle(ph1L, 0.5);\nlet g2L = 1.0 - g1L;\nlet rpC1L = writeIdx - clamp(del1L, 2.0, 2042.0);\nwhile (rpC1L < 0.0) { rpC1L += 2048.0; }\nlet iC1L: Int = floor(rpC1L);\nlet c1L = cubicinterp(rpC1L - iC1L, flgBufL[(iC1L - 1 + 2048) & 2047], flgBufL[iC1L & 2047], flgBufL[(iC1L + 1) & 2047], flgBufL[(iC1L + 2) & 2047]);\nlet rpC2L = writeIdx - clamp(del2L, 2.0, 2042.0);\nwhile (rpC2L < 0.0) { rpC2L += 2048.0; }\nlet iC2L: Int = floor(rpC2L);\nlet c2L = cubicinterp(rpC2L - iC2L, flgBufL[(iC2L - 1 + 2048) & 2047], flgBufL[iC2L & 2047], flgBufL[(iC2L + 1) & 2047], flgBufL[(iC2L + 2) & 2047]);\nlet dualCombL = 0.5 * (uL + g1L * c1L + g2L * c2L);\n\nlet ph1R = phR;\nlet ph2R = wrap(phR + 0.5, 0.0, 1.0);\nlet del1R = dMin + (dMax - dMin) * ph1R;\nlet del2R = dMin + (dMax - dMin) * ph2R;\nlet g1R = triangle(ph1R, 0.5);\nlet g2R = 1.0 - g1R;\nlet rpC1R = writeIdx - clamp(del1R, 2.0, 2042.0);\nwhile (rpC1R < 0.0) { rpC1R += 2048.0; }\nlet iC1R: Int = floor(rpC1R);\nlet c1R = cubicinterp(rpC1R - iC1R, flgBufR[(iC1R - 1 + 2048) & 2047], flgBufR[iC1R & 2047], flgBufR[(iC1R + 1) & 2047], flgBufR[(iC1R + 2) & 2047]);\nlet rpC2R = writeIdx - clamp(del2R, 2.0, 2042.0);\nwhile (rpC2R < 0.0) { rpC2R += 2048.0; }\nlet iC2R: Int = floor(rpC2R);\nlet c2R = cubicinterp(rpC2R - iC2R, flgBufR[(iC2R - 1 + 2048) & 2047], flgBufR[iC2R & 2047], flgBufR[(iC2R + 1) & 2047], flgBufR[(iC2R + 2) & 2047]);\nlet dualCombR = 0.5 * (uR + g1R * c1R + g2R * c2R);\n\n// --- 3. Engine B: SSB + Spectral-Delay Warped Barberpole (Paper Sec 4 & 4.1, Fig. 10) ---\nlet cR0 = 0.4794008656; let cR1 = 0.8762184935; let cR2 = 0.9765975895; let cR3 = 0.9974992559;\nlet cI0 = 0.1617584983; let cI1 = 0.7330289323; let cI2 = 0.9453497003; let cI3 = 0.9905991567;\n\nlet reL = uL;\nlet t = cR0 * (reL + lReY[0]) - lReX[0]; lReX[0] = reL; lReY[0] = t; reL = t;\nt = cR1 * (reL + lReY[1]) - lReX[1]; lReX[1] = reL; lReY[1] = t; reL = t;\nt = cR2 * (reL + lReY[2]) - lReX[2]; lReX[2] = reL; lReY[2] = t; reL = t;\nt = cR3 * (reL + lReY[3]) - lReX[3]; lReX[3] = reL; lReY[3] = t; reL = t;\nlet sReL = lDelRe; lDelRe = reL;\n\nlet imL = uL;\nt = cI0 * (imL + lImY[0]) - lImX[0]; lImX[0] = imL; lImY[0] = t; imL = t;\nt = cI1 * (imL + lImY[1]) - lImX[1]; lImX[1] = imL; lImY[1] = t; imL = t;\nt = cI2 * (imL + lImY[2]) - lImX[2]; lImX[2] = imL; lImY[2] = t; imL = t;\nt = cI3 * (imL + lImY[3]) - lImX[3]; lImX[3] = imL; lImY[3] = t; imL = t;\nlet sImL = imL;\n\nlet reR = uR;\nt = cR0 * (reR + rReY[0]) - rReX[0]; rReX[0] = reR; rReY[0] = t; reR = t;\nt = cR1 * (reR + rReY[1]) - rReX[1]; rReX[1] = reR; rReY[1] = t; reR = t;\nt = cR2 * (reR + rReY[2]) - rReX[2]; rReX[2] = reR; rReY[2] = t; reR = t;\nt = cR3 * (reR + rReY[3]) - rReX[3]; rReX[3] = reR; rReY[3] = t; reR = t;\nlet sReR = rDelRe; rDelRe = reR;\n\nlet imR = uR;\nt = cI0 * (imR + rImY[0]) - rImX[0]; rImX[0] = imR; rImY[0] = t; imR = t;\nt = cI1 * (imR + rImY[1]) - rImX[1]; rImX[1] = imR; rImY[1] = t; imR = t;\nt = cI2 * (imR + rImY[2]) - rImX[2]; rImX[2] = imR; rImY[2] = t; imR = t;\nt = cI3 * (imR + rImY[3]) - rImX[3]; rImX[3] = imR; rImY[3] = t; imR = t;\nlet sImR = imR;\n\n// Quadrature SSB shift by phL / phR\nlet ssbL = sReL * cos(2.0 * pi * phL) - sImL * sin(2.0 * pi * phL);\nlet ssbR = sReR * cos(2.0 * pi * phR) - sImR * sin(2.0 * pi * phR);\n\n// Pass delayed SSB signal through 6-stage allpass spectral delay to warp notch spacing (Sec 4.1)\nlet a1 = clamp(notch_warp_a1, -0.8, 0.8);\nlet rpDspL = writeIdx - clamp(baseDelaySamps * 0.5, 2.0, 2042.0);\nwhile (rpDspL < 0.0) { rpDspL += 2048.0; }\nlet iDspL: Int = floor(rpDspL);\nlet dispL = cubicinterp(rpDspL - iDspL, flgBufL[(iDspL - 1 + 2048) & 2047], flgBufL[iDspL & 2047], flgBufL[(iDspL + 1) & 2047], flgBufL[(iDspL + 2) & 2047]);\n\nlet rpDspR = writeIdx - clamp(baseDelaySamps * 0.5, 2.0, 2042.0);\nwhile (rpDspR < 0.0) { rpDspR += 2048.0; }\nlet iDspR: Int = floor(rpDspR);\nlet dispR = cubicinterp(rpDspR - iDspR, flgBufR[(iDspR - 1 + 2048) & 2047], flgBufR[iDspR & 2047], flgBufR[(iDspR + 1) & 2047], flgBufR[(iDspR + 2) & 2047]);\n\nfor (let k: Int = 0; k < 6; k++) {\n\tlet ynL = a1 * dispL + apXL[k] - a1 * apYL[k];\n\tapXL[k] = dispL; apYL[k] = ynL; dispL = ynL;\n\n\tlet ynR = a1 * dispR + apXR[k] - a1 * apYR[k];\n\tapXR[k] = dispR; apYR[k] = ynR; dispR = ynR;\n}\n\nlet ssbCombL = 0.5 * (ssbL + dispL);\nlet ssbCombR = 0.5 * (ssbR + dispR);\n\n// --- 4. Blend Dual-Comb Flanger & SSB Spectral-Delay Barberpole ---\nlet mode = clamp(dual_to_ssb_mode, 0.0, 1.0);\nlet outL = linearinterp(mode, dualCombL, ssbCombL);\nlet outR = linearinterp(mode, dualCombR, ssbCombR);\n\nfbStateL = outL;\nfbStateR = outR;\nwriteIdx = (writeIdx + 1) & 2047;\n\nout1 = outL;\nout2 = outR;\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-2",
                    "maxclass": "codebox~",
                    "numinlets": 4,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                    "rnbo_classname": "codebox~",
                    "rnbo_extra_attributes": {
                        "safemath": 1,
                        "expr": "",
                        "nocache": 0,
                        "code": "// ============================================================================\n// barberpole_comb_ssb_flanger.txt\n// Unix-Style Stereo Effect: Endless Barberpole Dual-Comb & SSB Spectral-Delay Flanger\n// Implements Fabian Esqueda, Vesa Valimaki & Julian Parker (DAFx-15, Paper 67):\n// \"Barberpole Phasing and Flanging Illusions\" (Sections 3, 4 & 4.1, Eq. 9-14, Fig. 7-12).\n// Combines BOTH time-domain/hybrid barberpole comb engines from the paper:\n//   1. Synchronized Dual Flanger (Sec 3, Fig. 7-8): Two cubic-interpolated comb\n//      delay lines modulated by 90-degree-offset sawtooth ramps (Eq. 9) and\n//      seamlessly crossfaded by synchronized triangular window gains so comb\n//      notches sweep infinitely upward or downward without reset clicks!\n//   2. Single-Sideband (SSB) Spectral-Delay Barberpole (Sec 4 & 4.1, Fig. 10):\n//      Hilbert SSB frequency shifting mixed with a dispersive 6-stage allpass\n//      spectral delay chain to warp the moving comb notches logarithmically!\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: Optional Tracked Pitch f0 in Hz (if > 20 Hz, tunes comb sweep range around f0)\n//   in4: Optional 1-Bar Phasor [0..1] (syncs barberpole sweep cycle to host tempo)\n// Outlets:\n//   out1: Left Endless Barberpole Comb/SSB Output\n//   out2: Right Endless Barberpole Comb/SSB Output\n\n@param({ min: -16.0, max: 16.0 }) sweep_rate_hz = 3;\n@param({ min: 0.4, max: 12.0 }) center_delay_ms = 2.2;\n@param({ min: -0.92, max: 0.92 }) feedback = 0.72;\n@param({ min: 0.0, max: 1.0 }) dual_to_ssb_mode = 0.4;\n@param({ min: -0.8, max: 0.8 }) notch_warp_a1 = -0.5;\n@param({ min: 0.0, max: 1.0 }) stereo_counter_dir = 0.5;\n\n// Circular delay buffers for Dual Barberpole Flanger (2048 samples per channel)\n@state flgBufL = new FixedSampleArray(2048);\n@state flgBufR = new FixedSampleArray(2048);\n@state writeIdx: Int = 0;\n\n// 4-stage Quadrature IIR Hilbert states for SSB Barberpole (Paper Sec 4, Fig. 10)\n@state lReX = new FixedSampleArray(4); @state lReY = new FixedSampleArray(4);\n@state lImX = new FixedSampleArray(4); @state lImY = new FixedSampleArray(4);\n@state lDelRe = 0.0;\n\n@state rReX = new FixedSampleArray(4); @state rReY = new FixedSampleArray(4);\n@state rImX = new FixedSampleArray(4); @state rImY = new FixedSampleArray(4);\n@state rDelRe = 0.0;\n\n// 6-stage First-Order Allpass Spectral Delay Chain for Log-Warped Notches (Sec 4.1)\n@state apXL = new FixedSampleArray(6); @state apYL = new FixedSampleArray(6);\n@state apXR = new FixedSampleArray(6); @state apYR = new FixedSampleArray(6);\n\n// Feedback states & LFO phasor\n@state fbStateL = 0.0;\n@state fbStateR = 0.0;\n@state prevBarIn = 0.0;\n@state smoothCenterMs = 2.2;\n@state sweepPhase = 0.0;\n@state smoothRate = 0.0;\n@state prevBarActive = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = (abs(in2) > 0.0000001) ? in2 : xL;\nlet pitchIn = in3;\nlet barIn = in4;\n\nlet slew = 1.0 - exp(-1.0 / (0.006 * sr));\nsmoothCenterMs += (clamp(center_delay_ms, 0.4, 12.0) - smoothCenterMs) * slew;\n\n// If pitch tracker is connected on in3, bias center delay toward 1/(2*f0)\nlet baseDelaySamps = mstosamps(smoothCenterMs);\nif (pitchIn > 25.0 && pitchIn < 1000.0) {\n\tbaseDelaySamps = linearinterp(0.5, baseDelaySamps, clamp(sr / (2.0 * pitchIn), 15.0, 1200.0));\n}\n\n// Per DAFx-15 Sec 3 (p. 5): D_min should be > 0.5 * D_max to hide resets cleanly\nlet dMin = clamp(baseDelaySamps * 0.68, 4.0, 1200.0);\nlet dMax = clamp(baseDelaySamps * 1.32, 8.0, 1800.0);\n\n// --- 1. Barberpole Sweep Phase (signed integration: continuous through 0 Hz) ---\nlet rateTarget = clamp(sweep_rate_hz, -16.0, 16.0);\nlet rateSlew = 1.0 - exp(-1.0 / (0.02 * sr));\nsmoothRate += (rateTarget - smoothRate) * rateSlew;\n\nlet barActive = (abs(barIn - prevBarIn) > 0.000001 || (barIn > 0.001 && barIn < 0.999)) ? 1.0 : 0.0;\n\nif (barActive > 0.5) {\n\t// Tempo-synced: advance by the signed change in the bar phasor (cycles per bar = rounded |rate|)\n\tif (prevBarActive > 0.5) {\n\t\tlet d = barIn - prevBarIn;\n\t\td = d - floor(d + 0.5); // wrap delta to [-0.5, 0.5)\n\t\tlet cyc = maximum(floor(abs(smoothRate) + 0.5), 1.0);\n\t\tlet sgn = (smoothRate >= 0.0) ? 1.0 : -1.0;\n\t\tsweepPhase = wrap(sweepPhase + d * cyc * sgn, 0.0, 1.0);\n\t}\n} else {\n\t// Free-running: signed rate, so the phase simply slows, stops and reverses\n\tsweepPhase = wrap(sweepPhase + smoothRate / sr, 0.0, 1.0);\n}\nprevBarIn = barIn;\nprevBarActive = barActive;\n\nlet phL = sweepPhase;\n// Stereo counter-direction option: Right channel sweeps opposite direction when stereo_counter_dir > 0.5\nlet counter = clamp(stereo_counter_dir, 0.0, 1.0);\nlet phR = (counter > 0.5) ? (1.0 - phL) : wrap(phL + 0.25 * counter, 0.0, 1.0);\n\nlet fb = clamp(feedback, -0.92, 0.92);\nlet uL = tanh(xL + fb * fbStateL);\nlet uR = tanh(xR + fb * fbStateR);\n\nflgBufL[writeIdx] = uL;\nflgBufR[writeIdx] = uR;\n\n// --- 2. Engine A: Synchronized Dual Flanger (Paper Sec 3, Eq. 9, Fig. 7-8) ---\n// Two sawtooth LFOs offset by 0.5 cycle (so reset of one falls at midpoint of the other)\n// with complementary raised-triangle/cosine crossfade gains g1 + g2 = 1.0\nlet ph1L = phL;\nlet ph2L = wrap(phL + 0.5, 0.0, 1.0);\nlet del1L = dMin + (dMax - dMin) * ph1L;\nlet del2L = dMin + (dMax - dMin) * ph2L;\nlet g1L = triangle(ph1L, 0.5);\nlet g2L = 1.0 - g1L;\nlet rpC1L = writeIdx - clamp(del1L, 2.0, 2042.0);\nwhile (rpC1L < 0.0) { rpC1L += 2048.0; }\nlet iC1L: Int = floor(rpC1L);\nlet c1L = cubicinterp(rpC1L - iC1L, flgBufL[(iC1L - 1 + 2048) & 2047], flgBufL[iC1L & 2047], flgBufL[(iC1L + 1) & 2047], flgBufL[(iC1L + 2) & 2047]);\nlet rpC2L = writeIdx - clamp(del2L, 2.0, 2042.0);\nwhile (rpC2L < 0.0) { rpC2L += 2048.0; }\nlet iC2L: Int = floor(rpC2L);\nlet c2L = cubicinterp(rpC2L - iC2L, flgBufL[(iC2L - 1 + 2048) & 2047], flgBufL[iC2L & 2047], flgBufL[(iC2L + 1) & 2047], flgBufL[(iC2L + 2) & 2047]);\nlet dualCombL = 0.5 * (uL + g1L * c1L + g2L * c2L);\n\nlet ph1R = phR;\nlet ph2R = wrap(phR + 0.5, 0.0, 1.0);\nlet del1R = dMin + (dMax - dMin) * ph1R;\nlet del2R = dMin + (dMax - dMin) * ph2R;\nlet g1R = triangle(ph1R, 0.5);\nlet g2R = 1.0 - g1R;\nlet rpC1R = writeIdx - clamp(del1R, 2.0, 2042.0);\nwhile (rpC1R < 0.0) { rpC1R += 2048.0; }\nlet iC1R: Int = floor(rpC1R);\nlet c1R = cubicinterp(rpC1R - iC1R, flgBufR[(iC1R - 1 + 2048) & 2047], flgBufR[iC1R & 2047], flgBufR[(iC1R + 1) & 2047], flgBufR[(iC1R + 2) & 2047]);\nlet rpC2R = writeIdx - clamp(del2R, 2.0, 2042.0);\nwhile (rpC2R < 0.0) { rpC2R += 2048.0; }\nlet iC2R: Int = floor(rpC2R);\nlet c2R = cubicinterp(rpC2R - iC2R, flgBufR[(iC2R - 1 + 2048) & 2047], flgBufR[iC2R & 2047], flgBufR[(iC2R + 1) & 2047], flgBufR[(iC2R + 2) & 2047]);\nlet dualCombR = 0.5 * (uR + g1R * c1R + g2R * c2R);\n\n// --- 3. Engine B: SSB + Spectral-Delay Warped Barberpole (Paper Sec 4 & 4.1, Fig. 10) ---\nlet cR0 = 0.4794008656; let cR1 = 0.8762184935; let cR2 = 0.9765975895; let cR3 = 0.9974992559;\nlet cI0 = 0.1617584983; let cI1 = 0.7330289323; let cI2 = 0.9453497003; let cI3 = 0.9905991567;\n\nlet reL = uL;\nlet t = cR0 * (reL + lReY[0]) - lReX[0]; lReX[0] = reL; lReY[0] = t; reL = t;\nt = cR1 * (reL + lReY[1]) - lReX[1]; lReX[1] = reL; lReY[1] = t; reL = t;\nt = cR2 * (reL + lReY[2]) - lReX[2]; lReX[2] = reL; lReY[2] = t; reL = t;\nt = cR3 * (reL + lReY[3]) - lReX[3]; lReX[3] = reL; lReY[3] = t; reL = t;\nlet sReL = lDelRe; lDelRe = reL;\n\nlet imL = uL;\nt = cI0 * (imL + lImY[0]) - lImX[0]; lImX[0] = imL; lImY[0] = t; imL = t;\nt = cI1 * (imL + lImY[1]) - lImX[1]; lImX[1] = imL; lImY[1] = t; imL = t;\nt = cI2 * (imL + lImY[2]) - lImX[2]; lImX[2] = imL; lImY[2] = t; imL = t;\nt = cI3 * (imL + lImY[3]) - lImX[3]; lImX[3] = imL; lImY[3] = t; imL = t;\nlet sImL = imL;\n\nlet reR = uR;\nt = cR0 * (reR + rReY[0]) - rReX[0]; rReX[0] = reR; rReY[0] = t; reR = t;\nt = cR1 * (reR + rReY[1]) - rReX[1]; rReX[1] = reR; rReY[1] = t; reR = t;\nt = cR2 * (reR + rReY[2]) - rReX[2]; rReX[2] = reR; rReY[2] = t; reR = t;\nt = cR3 * (reR + rReY[3]) - rReX[3]; rReX[3] = reR; rReY[3] = t; reR = t;\nlet sReR = rDelRe; rDelRe = reR;\n\nlet imR = uR;\nt = cI0 * (imR + rImY[0]) - rImX[0]; rImX[0] = imR; rImY[0] = t; imR = t;\nt = cI1 * (imR + rImY[1]) - rImX[1]; rImX[1] = imR; rImY[1] = t; imR = t;\nt = cI2 * (imR + rImY[2]) - rImX[2]; rImX[2] = imR; rImY[2] = t; imR = t;\nt = cI3 * (imR + rImY[3]) - rImX[3]; rImX[3] = imR; rImY[3] = t; imR = t;\nlet sImR = imR;\n\n// Quadrature SSB shift by phL / phR\nlet ssbL = sReL * cos(2.0 * pi * phL) - sImL * sin(2.0 * pi * phL);\nlet ssbR = sReR * cos(2.0 * pi * phR) - sImR * sin(2.0 * pi * phR);\n\n// Pass delayed SSB signal through 6-stage allpass spectral delay to warp notch spacing (Sec 4.1)\nlet a1 = clamp(notch_warp_a1, -0.8, 0.8);\nlet rpDspL = writeIdx - clamp(baseDelaySamps * 0.5, 2.0, 2042.0);\nwhile (rpDspL < 0.0) { rpDspL += 2048.0; }\nlet iDspL: Int = floor(rpDspL);\nlet dispL = cubicinterp(rpDspL - iDspL, flgBufL[(iDspL - 1 + 2048) & 2047], flgBufL[iDspL & 2047], flgBufL[(iDspL + 1) & 2047], flgBufL[(iDspL + 2) & 2047]);\n\nlet rpDspR = writeIdx - clamp(baseDelaySamps * 0.5, 2.0, 2042.0);\nwhile (rpDspR < 0.0) { rpDspR += 2048.0; }\nlet iDspR: Int = floor(rpDspR);\nlet dispR = cubicinterp(rpDspR - iDspR, flgBufR[(iDspR - 1 + 2048) & 2047], flgBufR[iDspR & 2047], flgBufR[(iDspR + 1) & 2047], flgBufR[(iDspR + 2) & 2047]);\n\nfor (let k: Int = 0; k < 6; k++) {\n\tlet ynL = a1 * dispL + apXL[k] - a1 * apYL[k];\n\tapXL[k] = dispL; apYL[k] = ynL; dispL = ynL;\n\n\tlet ynR = a1 * dispR + apXR[k] - a1 * apYR[k];\n\tapXR[k] = dispR; apYR[k] = ynR; dispR = ynR;\n}\n\nlet ssbCombL = 0.5 * (ssbL + dispL);\nlet ssbCombR = 0.5 * (ssbR + dispR);\n\n// --- 4. Blend Dual-Comb Flanger & SSB Spectral-Delay Barberpole ---\nlet mode = clamp(dual_to_ssb_mode, 0.0, 1.0);\nlet outL = linearinterp(mode, dualCombL, ssbCombL);\nlet outR = linearinterp(mode, dualCombR, ssbCombR);\n\nfbStateL = outL;\nfbStateR = outR;\nwriteIdx = (writeIdx + 1) & 2047;\n\nout1 = outL;\nout2 = outR;\n"
                    },
