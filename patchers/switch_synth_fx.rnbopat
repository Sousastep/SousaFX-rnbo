                        "gencode": "eq_bell(xin, cf, q, gain) {\n\tHistory y0(0);\n\tHistory y1(0);\n\tHistory a1(0);\n\tHistory a2(0);\n\tHistory a3(0);\n\tA = pow(10, gain / 40);\n\tg = tan(((cf * pi)) / samplerate);\n\tr = 1 / ((q * A));\n\ta1 = 1 / ((1 + (g * ((g + r)))));\n\ta2 = g * a1;\n\ta3 = g * a2;\n\tm1 = r * (((A * A) - 1));\n\tv3 = xin - y1;\n\tv1 = (a1 * y0) + (a2 * v3);\n\tv2 = ((y1 + (a2 * y0))) + (a3 * v3);\n\ty0 = (2 * v1) - y0;\n\ty1 = (2 * v2) - y1;\n\treturn xin + (m1 * v1);\n}\n\ntmp_eq_bell_1(xin, cf, q, gain) {\n\tHistory y0(0);\n\tHistory y1(0);\n\tHistory a1(0);\n\tHistory a2(0);\n\tHistory a3(0);\n\tA = pow(10, gain / 40);\n\tg = tan(((cf * pi)) / samplerate);\n\tr = 1 / ((q * A));\n\ta1 = 1 / ((1 + (g * ((g + r)))));\n\ta2 = g * a1;\n\ta3 = g * a2;\n\tm1 = r * (((A * A) - 1));\n\tv3 = xin - y1;\n\tv1 = (a1 * y0) + (a2 * v3);\n\tv2 = ((y1 + (a2 * y0))) + (a3 * v3);\n\ty0 = (2 * v1) - y0;\n\ty1 = (2 * v2) - y1;\n\treturn xin + (m1 * v1);\n}\n\nHistory tmp_history_2(0);\nHistory tmp_history_3(0);\nHistory tmp_history_4(0);\nHistory tmp_history_5(0);\ntmp_float_6 = float(0.79);\ntmp_int_7 = int(12);\ntmp_float_8 = float(0.79);\ntmp_int_9 = int(12);\ntmp_slide_10 = slide(in3, 480, 480);\nlimit = samplerate / 2;\ncf = clip(tmp_slide_10, 0, limit);\nq = (pow(10, (clip(tmp_float_6, 0, 1)) * 2)) * 0.10000000000000001;\ngain = clip(tmp_int_7, -60, 60);\ntmp_expr_11 = eq_bell(in2, cf, q, gain);\ntmp_gen_12 = tmp_expr_11;\ntmp_limit_13 = samplerate / 2;\ntmp_cf_14 = clip(tmp_slide_10, 0, tmp_limit_13);\ntmp_q_15 = (pow(10, (clip(tmp_float_8, 0, 1)) * 2)) * 0.10000000000000001;\ntmp_gain_16 = clip(tmp_int_9, -60, 60);\ntmp_expr_17 = tmp_eq_bell_1(in1, tmp_cf_14, tmp_q_15, tmp_gain_16);\ntmp_gen_18 = tmp_expr_17;\ntmp_int_19 = int(-3);\ntmp_dbtoa_20 = dbtoa(tmp_int_19);\ntmp_mul_21 = tmp_int_7 * -1;\ntmp_dbtoa_22 = dbtoa(tmp_mul_21);\ntmp_mul_23 = tmp_gen_12 * tmp_dbtoa_22;\ntmp_mul_24 = tmp_int_9 * -1;\ntmp_dbtoa_25 = dbtoa(tmp_mul_24);\ntmp_mul_26 = tmp_gen_18 * tmp_dbtoa_25;\ntmp_ftom_27 = ftom(tmp_slide_10, 440);\ntmp_add_28 = tmp_ftom_27 + 24;\ntmp_mtof_29 = mtof(tmp_add_28, 440);\ntmp_cycle_30, tmp_cycleindex_31 = cycle(tmp_mtof_29);\ntmp_mtof_32 = mtof(tmp_add_28, 440);\ntmp_cycle_33, tmp_cycleindex_34 = cycle(tmp_mtof_32);\ntmp_add_35 = tmp_add_28 + 0.25;\ntmp_mtof_36 = mtof(tmp_add_35, 440);\ntmp_cycle_37, tmp_cycleindex_38 = cycle(tmp_mtof_36);\ntmp_clamp_39 = clamp(tmp_cycle_37, -1, 1);\ntmp_mul_40 = tmp_history_2 * tmp_clamp_39;\ntmp_add_41 = tmp_cycle_30 + tmp_mul_40;\ntmp_neg_42 = -tmp_clamp_39;\ntmp_mul_43 = tmp_add_41 * tmp_neg_42;\ntmp_add_44 = tmp_history_2 + tmp_mul_43;\ntmp_gen_45 = tmp_add_44;\ntmp_tmp_history_46_next_47 = fixdenorm(tmp_add_41);\ntmp_clamp_48 = clamp(tmp_gen_45, -1, 1);\ntmp_mul_49 = tmp_history_3 * tmp_clamp_48;\ntmp_add_50 = tmp_mul_26 + tmp_mul_49;\ntmp_neg_51 = -tmp_clamp_48;\ntmp_mul_52 = tmp_add_50 * tmp_neg_51;\ntmp_add_53 = tmp_history_3 + tmp_mul_52;\ntmp_gen_54 = tmp_add_53;\ntmp_tmp_history_55_next_56 = fixdenorm(tmp_add_50);\ntmp_mul_57 = tmp_gen_54 * tmp_dbtoa_20;\nout1 = tmp_mul_57;\ntmp_add_58 = tmp_add_28 + 0.24;\ntmp_mtof_59 = mtof(tmp_add_58, 440);\ntmp_cycle_60, tmp_cycleindex_61 = cycle(tmp_mtof_59);\ntmp_clamp_62 = clamp(tmp_cycle_60, -1, 1);\ntmp_mul_63 = tmp_history_4 * tmp_clamp_62;\ntmp_add_64 = tmp_cycle_33 + tmp_mul_63;\ntmp_neg_65 = -tmp_clamp_62;\ntmp_mul_66 = tmp_add_64 * tmp_neg_65;\ntmp_add_67 = tmp_history_4 + tmp_mul_66;\ntmp_gen_68 = tmp_add_67;\ntmp_tmp_history_69_next_70 = fixdenorm(tmp_add_64);\ntmp_clamp_71 = clamp(tmp_gen_68, -1, 1);\ntmp_mul_72 = tmp_history_5 * tmp_clamp_71;\ntmp_add_73 = tmp_mul_23 + tmp_mul_72;\ntmp_neg_74 = -tmp_clamp_71;\ntmp_mul_75 = tmp_add_73 * tmp_neg_74;\ntmp_add_76 = tmp_history_5 + tmp_mul_75;\ntmp_gen_77 = tmp_add_76;\ntmp_tmp_history_78_next_79 = fixdenorm(tmp_add_73);\ntmp_mul_80 = tmp_gen_77 * tmp_dbtoa_20;\nout2 = tmp_mul_80;\ntmp_history_2 = tmp_tmp_history_46_next_47;\ntmp_history_5 = tmp_tmp_history_78_next_79;\ntmp_history_4 = tmp_tmp_history_69_next_70;\ntmp_history_3 = tmp_tmp_history_55_next_56;",
                        "geninlets": 3,
                        "genoutlets": 2
                    },
