            {
                "box": {
                    "id": "obj-8",
                    "maxclass": "newobj",
                    "numinlets": 5,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 2,
                            "revision": 1,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 1793.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "ai.sideband_sub_growl",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// sideband_sub_growl.txt — lower-sideband sub-harmonic growl: adaptive\n//                          split-sideband FM of the horn, the bar morphing\n//                          between lower (sub) and upper (screech) sidebands\n//\n// From: V. Lazzarini, J. Timoney, T. Lysaght, \"Asymmetric-Spectra Methods\n//       for Adaptive FM Synthesis\", DAFx-08 paper 42: §3.1 eq. 5-14 (split\n//       sidebands: cos(I sin wt) carries the even sidebands, sin(I sin wt)\n//       the odd ones; single-sideband products with the analytic carrier\n//       separate upper from lower), §3.2 eq. 15-20 (adaptive SpSB: the\n//       carrier is the input signal), §4.3 (sub-harmonic multiphonics from\n//       lower sidebands, screech from upper sidebands).\n// Parent: ai_freq_mod_phase_dist/15_inst_split_sideband_morph_synth and\n//         07_adaptive_split_sideband (5 and 4 stars).\n//\n// Implementation: e^(jI sin t) = sum_n J_n(I) e^(jnt) (J_-n = (-1)^n J_n).\n// Each sideband n gets an upper/lower weight and an odd/even weight; the\n// output is Re{z * m(t)}, z the analytic horn. With every weight at 1 this is\n// exactly PM of the horn. J_0..J_10 come from Miller's backward recurrence,\n// updated every 32 samples.\n// Dry/wet: the dry is the real branch of the same Hilbert pair, so the blend\n// does not comb.\n//\n// Inlets:\n//   in1 / in2: stereo tuba\n//   in3: f0 in Hz. > 0 = tracked pitch (clamped 20..1000 Hz);\n//        0 = disconnected -> fixed 55 Hz. No zero-crossing fallback.\n//   in4: 0..1 one-bar phasor (sideband morph). Held (no movement for\n//        100 ms) -> internal 2 s bar (120 BPM 4/4).\n//   in5: smoothed tuba volume envelope 0..1 (opens the index). Static ->\n//        internal envelope follower.\n// Outlets:\n//   out1 / out2: stereo\n// No safety limiter, no metering.\n// ============================================================================\n\n// Carrier:modulator ratio (fm = f0 / ratio)\n@param({ min: 0.5, max: 4 }) cm_ratio = 2;\n// FM index\n@param({ min: 0, max: 6 }) index = 2;\n// Lower (-) / upper (+) sidebands\n@param({ min: -100, max: 100 }) low_high = 100;\n// Odd (-) / even (+) sidebands\n@param({ min: -100, max: 100 }) odd_even = -100;\n// Bar morph of low/high\n@param({ min: 0, max: 100 }) bar_morph = 0;\n// Morphs per bar\n@param({ min: 1, max: 16 }) morph_div = 2;\n// Dry/wet (phase-aligned dry)\n@param({ min: 0, max: 100 }) blend = 80;\n// Output gain\n@param({ min: -24, max: 12 }) out_gain_db = 0;\n\n@state f0Smooth = 55.0;\n\n@state prevBarIn = 0.0;\n@state barLast = 0.0;\n@state barHold = 0.0;\n@state freeBar = 0.0;\n\n@state prevEnvIn = 0.0;\n@state envHold = 0.0;\n@state envInt = 0.0;\n\n@state modPh = 0.0;\n@state lhSm = -0.6;\n@state oeSm = 0.0;\n@state ctlCount: Int = 0;\n@state jn = new FixedSampleArray(11);\n\n@state reX = new FixedSampleArray(2, 4);\n@state reY = new FixedSampleArray(2, 4);\n@state imX = new FixedSampleArray(2, 4);\n@state imY = new FixedSampleArray(2, 4);\n@state reDel = new FixedSampleArray(2);\n\n@state dcBlkL = new onepole();\n@state dcBlkR = new onepole();\n\n// Real branch of the 4-stage quadrature pair, plus one sample of delay to\n// line it up with the imaginary branch. y = c*(x + y1) - x1 per stage.\nfunction hilbRe(ch: Int, x: number): number {\n\tlet s = x;\n\tlet c = 0.0;\n\tfor (let i: Int = 0; i < 4; i++) {\n\t\tc = (i == 0) ? 0.4794008656 : ((i == 1) ? 0.8762184935 : ((i == 2) ? 0.9765975895 : 0.9974992559));\n\t\tlet y = c * (s + reY[ch][i]) - reX[ch][i];\n\t\treX[ch][i] = s;\n\t\treY[ch][i] = y;\n\t\ts = y;\n\t}\n\tlet out = reDel[ch];\n\treDel[ch] = s;\n\treturn out;\n}\n\n// Imaginary branch; this coefficient order gives the negative Hilbert, so negate.\nfunction hilbIm(ch: Int, x: number): number {\n\tlet s = x;\n\tlet c = 0.0;\n\tfor (let i: Int = 0; i < 4; i++) {\n\t\tc = (i == 0) ? 0.1617584983 : ((i == 1) ? 0.7330289323 : ((i == 2) ? 0.9453497003 : 0.9905991567));\n\t\tlet y = c * (s + imY[ch][i]) - imX[ch][i];\n\t\timX[ch][i] = s;\n\t\timY[ch][i] = y;\n\t\ts = y;\n\t}\n\treturn 0.0 - s;\n}\n\n// J_0..J_10 of x into jn[] (Miller backward recurrence, normalised by\n// J_0 + 2 sum J_2k = 1).\nfunction besselAll(x: number) {\n\tif (x < 0.000001) {\n\t\tfor (let n: Int = 0; n < 11; n++) {\n\t\t\tjn[n] = (n == 0) ? 1.0 : 0.0;\n\t\t}\n\t} else {\n\t\tlet jp1 = 0.0;\n\t\tlet jc = 1.0e-30;\n\t\tlet sum = 0.0;\n\t\tfor (let k: Int = 40; k > 0; k--) {\n\t\t\tlet jm1 = (2.0 * k / x) * jc - jp1;\n\t\t\tjp1 = jc;\n\t\t\tjc = jm1;\n\t\t\tif (abs(jc) > 1.0e10) {\n\t\t\t\tjc *= 1.0e-10;\n\t\t\t\tjp1 *= 1.0e-10;\n\t\t\t\tsum *= 1.0e-10;\n\t\t\t\tfor (let r: Int = 0; r < 11; r++) {\n\t\t\t\t\tjn[r] = jn[r] * 1.0e-10;\n\t\t\t\t}\n\t\t\t}\n\t\t\tlet n: Int = k - 1;\n\t\t\tif (n < 11) {\n\t\t\t\tjn[n] = jc;\n\t\t\t}\n\t\t\tif (n > 0 && (n % 2) == 0) {\n\t\t\t\tsum += 2.0 * jc;\n\t\t\t}\n\t\t}\n\t\tsum += jc;\n\t\tfor (let n: Int = 0; n < 11; n++) {\n\t\t\tjn[n] = jn[n] / sum;\n\t\t}\n\t}\n}\n\n// Re{(re + j im) * m(t)} with the weighted split-sideband modulator m.\nfunction splitPM(re: number, im: number, th: number, wU: number, wL: number, wO: number, wE: number): number {\n\tlet mRe = jn[0];\n\tlet mIm = 0.0;\n\tlet c1 = cos(th);\n\tlet s1 = sin(th);\n\tlet pc = 1.0;\n\tlet ps = 0.0;\n\tfor (let n: Int = 1; n < 11; n++) {\n\t\tlet t = pc * c1 - ps * s1;\n\t\tps = pc * s1 + ps * c1;\n\t\tpc = t;\n\t\tlet odd = (n % 2) == 1;\n\t\tlet wp = odd ? wO : wE;\n\t\tlet u = wU * wp * jn[n];\n\t\tlet l = wL * wp * jn[n] * (odd ? -1.0 : 1.0);\n\t\tmRe += (u + l) * pc;\n\t\tmIm += (u - l) * ps;\n\t}\n\treturn re * mRe - im * mIm;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\nlet envIn = in5;\n\n// --- f0: in3 > 0 is the pitch; 0 = disconnected -> fixed 55 Hz --------------\nlet f0Target = (pitchIn > 0.0) ? clamp(pitchIn, 20.0, 1000.0) : 55.0;\nf0Smooth += (f0Target - f0Smooth) * (1.0 - exp(-1.0 / (0.004 * sr)));\nlet f0 = clamp(f0Smooth, 20.0, 1000.0);\n\n// --- Bar phase: in4 while it moves, else internal 2 s bar -------------------\nif (abs(barIn - prevBarIn) > 0.0000001) {\n\tbarLast = barIn;\n\tbarHold = 0.1 * sr;\n} else if (barHold > 0.0) {\n\tbarHold -= 1.0;\n}\nprevBarIn = barIn;\nfreeBar = wrap(freeBar + 0.5 / sr, 0.0, 1.0);\nlet barPh = (barHold > 0.0) ? wrap(barLast, 0.0, 1.0) : freeBar;\n\n// --- Envelope: in5 while it moves, else internal follower ------------------\nlet absMono = 0.5 * (abs(xL) + abs(xR));\nlet atk = 1.0 - exp(-1.0 / (0.005 * sr));\nlet rel = 1.0 - exp(-1.0 / (0.120 * sr));\nenvInt += (absMono - envInt) * ((absMono > envInt) ? atk : rel);\nif (abs(envIn - prevEnvIn) > 0.0000001) {\n\tenvHold = 0.1 * sr;\n} else if (envHold > 0.0) {\n\tenvHold -= 1.0;\n}\nprevEnvIn = envIn;\nlet env = (envHold > 0.0) ? clamp(envIn, 0.0, 1.0) : clamp(sqrt(maximum(envInt, 0.0)) * 1.6, 0.0, 1.0);\n\n// --- Control rate: index -> Bessel table every 32 samples --------------------\nif (ctlCount <= 0) {\n\tbesselAll(clamp(index, 0.0, 6.0) * (0.4 + 0.6 * env));\n\tctlCount = 32;\n}\nctlCount -= 1;\n\n// --- Sideband weights: low/high + bar morph, odd/even ------------------------\nlet div = round(clamp(morph_div, 1.0, 16.0));\nlet lhT = clamp(clamp(low_high, -100.0, 100.0) * 0.01 + clamp(bar_morph, 0.0, 100.0) * 0.01 * sin(2.0 * pi * wrap(barPh * div, 0.0, 1.0)), -1.0, 1.0);\nlet ctl = 1.0 - exp(-1.0 / (0.01 * sr));\nlhSm += (lhT - lhSm) * ctl;\noeSm += (clamp(odd_even, -100.0, 100.0) * 0.01 - oeSm) * ctl;\nlet wU = minimum(1.0, 1.0 + lhSm);\nlet wL = minimum(1.0, 1.0 - lhSm);\nlet wE = minimum(1.0, 1.0 + oeSm);\nlet wO = minimum(1.0, 1.0 - oeSm);\n\n// --- Modulator -------------------------------------------------------------\nlet fm = clamp(f0 / clamp(cm_ratio, 0.5, 4.0), 5.0, sr * 0.1);\nmodPh = wrap(modPh + fm / sr, 0.0, 1.0);\nlet thL = 2.0 * pi * modPh;\nlet thR = 2.0 * pi * wrap(modPh + 0.06, 0.0, 1.0);\n\n// --- Analytic horn x split-sideband modulator ---------------------------------\nlet reL = hilbRe(0, xL);\nlet imL = hilbIm(0, xL);\nlet reR = hilbRe(1, xR);\nlet imR = hilbIm(1, xR);\nlet spL = splitPM(reL, imL, thL, wU, wL, wO, wE);\nlet spR = splitPM(reR, imR, thR, wU, wL, wO, wE);\n// makeup: sum of J_n^2 over all n is 1, so the kept power is known exactly\nlet kept = jn[0] * jn[0];\nfor (let n: Int = 1; n < 11; n++) {\n\tlet wp = ((n % 2) == 1) ? wO : wE;\n\tkept += (wU * wU + wL * wL) * wp * wp * jn[n] * jn[n];\n}\nlet makeup = 1.0 / sqrt(maximum(kept, 0.1));\n// lower sidebands of the fundamental can reach 0 Hz: block DC\nlet wetL = (spL - dcBlkL.next(spL, 10.0)) * makeup;\nlet wetR = (spR - dcBlkR.next(spR, 10.0)) * makeup;\n\n// --- Dry/wet (dry = Hilbert real branch) ------------------------------------\nlet b = clamp(blend, 0.0, 100.0) * 0.01;\nlet oL = linearinterp(b, reL, wetL);\nlet oR = linearinterp(b, reR, wetR);\n\n// --- Output gain (last stage) -----------------------------------------------\nlet outGain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = oL * outGain;\nout2 = oR * outGain;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 5,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "nocache": 0,
                                        "expr": "",
                                        "safemath": 1,
                                        "code": "// ============================================================================\n// sideband_sub_growl.txt — lower-sideband sub-harmonic growl: adaptive\n//                          split-sideband FM of the horn, the bar morphing\n//                          between lower (sub) and upper (screech) sidebands\n//\n// From: V. Lazzarini, J. Timoney, T. Lysaght, \"Asymmetric-Spectra Methods\n//       for Adaptive FM Synthesis\", DAFx-08 paper 42: §3.1 eq. 5-14 (split\n//       sidebands: cos(I sin wt) carries the even sidebands, sin(I sin wt)\n//       the odd ones; single-sideband products with the analytic carrier\n//       separate upper from lower), §3.2 eq. 15-20 (adaptive SpSB: the\n//       carrier is the input signal), §4.3 (sub-harmonic multiphonics from\n//       lower sidebands, screech from upper sidebands).\n// Parent: ai_freq_mod_phase_dist/15_inst_split_sideband_morph_synth and\n//         07_adaptive_split_sideband (5 and 4 stars).\n//\n// Implementation: e^(jI sin t) = sum_n J_n(I) e^(jnt) (J_-n = (-1)^n J_n).\n// Each sideband n gets an upper/lower weight and an odd/even weight; the\n// output is Re{z * m(t)}, z the analytic horn. With every weight at 1 this is\n// exactly PM of the horn. J_0..J_10 come from Miller's backward recurrence,\n// updated every 32 samples.\n// Dry/wet: the dry is the real branch of the same Hilbert pair, so the blend\n// does not comb.\n//\n// Inlets:\n//   in1 / in2: stereo tuba\n//   in3: f0 in Hz. > 0 = tracked pitch (clamped 20..1000 Hz);\n//        0 = disconnected -> fixed 55 Hz. No zero-crossing fallback.\n//   in4: 0..1 one-bar phasor (sideband morph). Held (no movement for\n//        100 ms) -> internal 2 s bar (120 BPM 4/4).\n//   in5: smoothed tuba volume envelope 0..1 (opens the index). Static ->\n//        internal envelope follower.\n// Outlets:\n//   out1 / out2: stereo\n// No safety limiter, no metering.\n// ============================================================================\n\n// Carrier:modulator ratio (fm = f0 / ratio)\n@param({ min: 0.5, max: 4 }) cm_ratio = 2;\n// FM index\n@param({ min: 0, max: 6 }) index = 2;\n// Lower (-) / upper (+) sidebands\n@param({ min: -100, max: 100 }) low_high = 100;\n// Odd (-) / even (+) sidebands\n@param({ min: -100, max: 100 }) odd_even = -100;\n// Bar morph of low/high\n@param({ min: 0, max: 100 }) bar_morph = 0;\n// Morphs per bar\n@param({ min: 1, max: 16 }) morph_div = 2;\n// Dry/wet (phase-aligned dry)\n@param({ min: 0, max: 100 }) blend = 80;\n// Output gain\n@param({ min: -24, max: 12 }) out_gain_db = 0;\n\n@state f0Smooth = 55.0;\n\n@state prevBarIn = 0.0;\n@state barLast = 0.0;\n@state barHold = 0.0;\n@state freeBar = 0.0;\n\n@state prevEnvIn = 0.0;\n@state envHold = 0.0;\n@state envInt = 0.0;\n\n@state modPh = 0.0;\n@state lhSm = -0.6;\n@state oeSm = 0.0;\n@state ctlCount: Int = 0;\n@state jn = new FixedSampleArray(11);\n\n@state reX = new FixedSampleArray(2, 4);\n@state reY = new FixedSampleArray(2, 4);\n@state imX = new FixedSampleArray(2, 4);\n@state imY = new FixedSampleArray(2, 4);\n@state reDel = new FixedSampleArray(2);\n\n@state dcBlkL = new onepole();\n@state dcBlkR = new onepole();\n\n// Real branch of the 4-stage quadrature pair, plus one sample of delay to\n// line it up with the imaginary branch. y = c*(x + y1) - x1 per stage.\nfunction hilbRe(ch: Int, x: number): number {\n\tlet s = x;\n\tlet c = 0.0;\n\tfor (let i: Int = 0; i < 4; i++) {\n\t\tc = (i == 0) ? 0.4794008656 : ((i == 1) ? 0.8762184935 : ((i == 2) ? 0.9765975895 : 0.9974992559));\n\t\tlet y = c * (s + reY[ch][i]) - reX[ch][i];\n\t\treX[ch][i] = s;\n\t\treY[ch][i] = y;\n\t\ts = y;\n\t}\n\tlet out = reDel[ch];\n\treDel[ch] = s;\n\treturn out;\n}\n\n// Imaginary branch; this coefficient order gives the negative Hilbert, so negate.\nfunction hilbIm(ch: Int, x: number): number {\n\tlet s = x;\n\tlet c = 0.0;\n\tfor (let i: Int = 0; i < 4; i++) {\n\t\tc = (i == 0) ? 0.1617584983 : ((i == 1) ? 0.7330289323 : ((i == 2) ? 0.9453497003 : 0.9905991567));\n\t\tlet y = c * (s + imY[ch][i]) - imX[ch][i];\n\t\timX[ch][i] = s;\n\t\timY[ch][i] = y;\n\t\ts = y;\n\t}\n\treturn 0.0 - s;\n}\n\n// J_0..J_10 of x into jn[] (Miller backward recurrence, normalised by\n// J_0 + 2 sum J_2k = 1).\nfunction besselAll(x: number) {\n\tif (x < 0.000001) {\n\t\tfor (let n: Int = 0; n < 11; n++) {\n\t\t\tjn[n] = (n == 0) ? 1.0 : 0.0;\n\t\t}\n\t} else {\n\t\tlet jp1 = 0.0;\n\t\tlet jc = 1.0e-30;\n\t\tlet sum = 0.0;\n\t\tfor (let k: Int = 40; k > 0; k--) {\n\t\t\tlet jm1 = (2.0 * k / x) * jc - jp1;\n\t\t\tjp1 = jc;\n\t\t\tjc = jm1;\n\t\t\tif (abs(jc) > 1.0e10) {\n\t\t\t\tjc *= 1.0e-10;\n\t\t\t\tjp1 *= 1.0e-10;\n\t\t\t\tsum *= 1.0e-10;\n\t\t\t\tfor (let r: Int = 0; r < 11; r++) {\n\t\t\t\t\tjn[r] = jn[r] * 1.0e-10;\n\t\t\t\t}\n\t\t\t}\n\t\t\tlet n: Int = k - 1;\n\t\t\tif (n < 11) {\n\t\t\t\tjn[n] = jc;\n\t\t\t}\n\t\t\tif (n > 0 && (n % 2) == 0) {\n\t\t\t\tsum += 2.0 * jc;\n\t\t\t}\n\t\t}\n\t\tsum += jc;\n\t\tfor (let n: Int = 0; n < 11; n++) {\n\t\t\tjn[n] = jn[n] / sum;\n\t\t}\n\t}\n}\n\n// Re{(re + j im) * m(t)} with the weighted split-sideband modulator m.\nfunction splitPM(re: number, im: number, th: number, wU: number, wL: number, wO: number, wE: number): number {\n\tlet mRe = jn[0];\n\tlet mIm = 0.0;\n\tlet c1 = cos(th);\n\tlet s1 = sin(th);\n\tlet pc = 1.0;\n\tlet ps = 0.0;\n\tfor (let n: Int = 1; n < 11; n++) {\n\t\tlet t = pc * c1 - ps * s1;\n\t\tps = pc * s1 + ps * c1;\n\t\tpc = t;\n\t\tlet odd = (n % 2) == 1;\n\t\tlet wp = odd ? wO : wE;\n\t\tlet u = wU * wp * jn[n];\n\t\tlet l = wL * wp * jn[n] * (odd ? -1.0 : 1.0);\n\t\tmRe += (u + l) * pc;\n\t\tmIm += (u - l) * ps;\n\t}\n\treturn re * mRe - im * mIm;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\nlet envIn = in5;\n\n// --- f0: in3 > 0 is the pitch; 0 = disconnected -> fixed 55 Hz --------------\nlet f0Target = (pitchIn > 0.0) ? clamp(pitchIn, 20.0, 1000.0) : 55.0;\nf0Smooth += (f0Target - f0Smooth) * (1.0 - exp(-1.0 / (0.004 * sr)));\nlet f0 = clamp(f0Smooth, 20.0, 1000.0);\n\n// --- Bar phase: in4 while it moves, else internal 2 s bar -------------------\nif (abs(barIn - prevBarIn) > 0.0000001) {\n\tbarLast = barIn;\n\tbarHold = 0.1 * sr;\n} else if (barHold > 0.0) {\n\tbarHold -= 1.0;\n}\nprevBarIn = barIn;\nfreeBar = wrap(freeBar + 0.5 / sr, 0.0, 1.0);\nlet barPh = (barHold > 0.0) ? wrap(barLast, 0.0, 1.0) : freeBar;\n\n// --- Envelope: in5 while it moves, else internal follower ------------------\nlet absMono = 0.5 * (abs(xL) + abs(xR));\nlet atk = 1.0 - exp(-1.0 / (0.005 * sr));\nlet rel = 1.0 - exp(-1.0 / (0.120 * sr));\nenvInt += (absMono - envInt) * ((absMono > envInt) ? atk : rel);\nif (abs(envIn - prevEnvIn) > 0.0000001) {\n\tenvHold = 0.1 * sr;\n} else if (envHold > 0.0) {\n\tenvHold -= 1.0;\n}\nprevEnvIn = envIn;\nlet env = (envHold > 0.0) ? clamp(envIn, 0.0, 1.0) : clamp(sqrt(maximum(envInt, 0.0)) * 1.6, 0.0, 1.0);\n\n// --- Control rate: index -> Bessel table every 32 samples --------------------\nif (ctlCount <= 0) {\n\tbesselAll(clamp(index, 0.0, 6.0) * (0.4 + 0.6 * env));\n\tctlCount = 32;\n}\nctlCount -= 1;\n\n// --- Sideband weights: low/high + bar morph, odd/even ------------------------\nlet div = round(clamp(morph_div, 1.0, 16.0));\nlet lhT = clamp(clamp(low_high, -100.0, 100.0) * 0.01 + clamp(bar_morph, 0.0, 100.0) * 0.01 * sin(2.0 * pi * wrap(barPh * div, 0.0, 1.0)), -1.0, 1.0);\nlet ctl = 1.0 - exp(-1.0 / (0.01 * sr));\nlhSm += (lhT - lhSm) * ctl;\noeSm += (clamp(odd_even, -100.0, 100.0) * 0.01 - oeSm) * ctl;\nlet wU = minimum(1.0, 1.0 + lhSm);\nlet wL = minimum(1.0, 1.0 - lhSm);\nlet wE = minimum(1.0, 1.0 + oeSm);\nlet wO = minimum(1.0, 1.0 - oeSm);\n\n// --- Modulator -------------------------------------------------------------\nlet fm = clamp(f0 / clamp(cm_ratio, 0.5, 4.0), 5.0, sr * 0.1);\nmodPh = wrap(modPh + fm / sr, 0.0, 1.0);\nlet thL = 2.0 * pi * modPh;\nlet thR = 2.0 * pi * wrap(modPh + 0.06, 0.0, 1.0);\n\n// --- Analytic horn x split-sideband modulator ---------------------------------\nlet reL = hilbRe(0, xL);\nlet imL = hilbIm(0, xL);\nlet reR = hilbRe(1, xR);\nlet imR = hilbIm(1, xR);\nlet spL = splitPM(reL, imL, thL, wU, wL, wO, wE);\nlet spR = splitPM(reR, imR, thR, wU, wL, wO, wE);\n// makeup: sum of J_n^2 over all n is 1, so the kept power is known exactly\nlet kept = jn[0] * jn[0];\nfor (let n: Int = 1; n < 11; n++) {\n\tlet wp = ((n % 2) == 1) ? wO : wE;\n\tkept += (wU * wU + wL * wL) * wp * wp * jn[n] * jn[n];\n}\nlet makeup = 1.0 / sqrt(maximum(kept, 0.1));\n// lower sidebands of the fundamental can reach 0 Hz: block DC\nlet wetL = (spL - dcBlkL.next(spL, 10.0)) * makeup;\nlet wetR = (spR - dcBlkR.next(spR, 10.0)) * makeup;\n\n// --- Dry/wet (dry = Hilbert real branch) ------------------------------------\nlet b = clamp(blend, 0.0, 100.0) * 0.01;\nlet oL = linearinterp(b, reL, wetL);\nlet oR = linearinterp(b, reR, wetR);\n\n// --- Output gain (last stage) -----------------------------------------------\nlet outGain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = oL * outGain;\nout2 = oR * outGain;\n"
                                    },
                                    "rnbo_serial": 7,
                                    "rnbo_uniqueid": "effect_code",
                                    "rnboinfo": {
