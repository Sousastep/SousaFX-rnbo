            {
                "box": {
                    "id": "obj-16",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "signal" ],
                    "patching_rect": [ 488.0, 412.0, 61.0, 23.0 ],
                    "rnbo_classname": "r~",
                    "rnbo_serial": 5,
                    "rnbo_uniqueid": "r~_obj-16",
                    "text": "r~ lfo_env"
                }
            },
            {
                "box": {
                    "id": "obj-15",
                    "maxclass": "newobj",
                    "numinlets": 4,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 2,
                            "revision": 1,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 2023.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "ai.quadrature_chebyshev_shaper",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// quadrature_chebyshev_shaper.txt\n// Unix-Style Stereo Effect: Phase-Quadrature Chebyshev T_k & U_k Waveshaper\n// Implements Timoney, Lazzarini, Gibney & Pekonen (DAFx-10, Paper P65):\n// \"Digital Emulation of Distortion Effects by Wave and Phase Shaping Methods\"\n// (Section 2.1, Eq. 5-15).\n// Classical Chebyshev waveshaping T_k(cos(w*t)) = cos(k*w*t) only controls\n// harmonic magnitudes with fixed 0-degree phase. By extracting the quadrature\n// signal pair (x_I = cos(w*t), x_Q = sin(w*t)) via a 4-stage Hilbert network and\n// combining Chebyshev polynomials of the FIRST kind T_k(x_I) with Chebyshev\n// polynomials of the SECOND kind x_Q * U_{k-1}(x_I) = sin(k*w*t) (Eq. 11-15):\n//   y(t) = sum_k a_k * [ cos(phi_k) * T_k(x_I) + sin(phi_k) * x_Q * U_{k-1}(x_I) ]\n// you gain independent control over BOTH harmonic amplitudes AND harmonic phase\n// angles phi_k (even continuously rotating harmonic phases at audio/LFO rates)!\n// T_k(x_I) = cos(k*w*t) only holds on the unit circle, so the analytic pair is\n// normalised to unit magnitude first and the level is restored afterwards from an\n// envelope follower; drive_db acts on the envelope-normalised magnitude, so the\n// harmonic content no longer depends on how loud the tuba is (before, at real tuba\n// levels the polynomials saw r ~ 0.1 and mostly returned the fundamental).\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (prefer 01_harmonic_isolator or raw tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: Optional Mod Envelope [-2..2] (dynamically rotates harmonic phase angles phi_k;\n//        anything outside that range, such as the rig's pitch in Hz, is ignored)\n//   in4: Optional 1-Bar Phasor [0..1] (drives continuous per-harmonic Shepard/Barberpole\n//        phase rotation when phase_spin > 0)\n// Outlets:\n//   out1: Left Quadrature Chebyshev Output\n//   out2: Right Quadrature Chebyshev Output\n\n@param({ min: 0.0, max: 18.0 }) drive_db = 6.0;\n@param({ min: 0.0, max: 1.0 }) even_harmonics = 0.55;\n@param({ min: 0.0, max: 1.0 }) odd_harmonics = 0.75;\n@param({ min: 0.0, max: 1.0 }) high_order_tilt = 0.5;\n@param({ min: -3.14159, max: 3.14159 }) quad_phase_angle = 0.785;\n@param({ min: 0.0, max: 1.0 }) phase_spin = 0.35;\n@param({ min: 0.0, max: 1.0 }) stereo_quad_spread = 0.5;\n\n// Stereo 4-stage IIR Hilbert transform states for Quadrature (x_I, x_Q) extraction\n@state lReX = new FixedSampleArray(4); @state lReY = new FixedSampleArray(4);\n@state lImX = new FixedSampleArray(4); @state lImY = new FixedSampleArray(4);\n@state lDelRe = 0.0;\n\n@state rReX = new FixedSampleArray(4); @state rReY = new FixedSampleArray(4);\n@state rImX = new FixedSampleArray(4); @state rImY = new FixedSampleArray(4);\n@state rDelRe = 0.0;\n\n// Warm lowpass pre-conditioning so Chebyshev polynomials shape the fundamental + low brass body cleanly\n@state preLpL = new onepole();\n@state preLpR = new onepole();\n\n// Glitch-free bar phasor hold & smoothers\n@state barFallback = new phasor();\n@state prevBarIn = 0.0;\n@state barHold = 0.0;\n@state smoothEnvMod = 0.0;\n@state ampEnvL = 0.0;\n@state spinAcc = 0.0;\n@state prevSpinPh = 0.0;\n@state ampEnvR = 0.0;\n@state in2Hold = 0.0;\n@state dcXL = 0.0; @state dcYL = 0.0;\n@state dcXR = 0.0; @state dcYR = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\n// Mono fallback: in2 counts as patched for 250 ms after its last non-zero sample\nif (abs(in2) > 0.0000001) {\n\tin2Hold = 0.25 * sr;\n} else if (in2Hold > 0.0) {\n\tin2Hold -= 1.0;\n}\nlet xR = (in2Hold > 0.0) ? in2 : xL;\nlet envMod = (in3 > -2.0 && in3 < 2.0) ? in3 : 0.0;\nlet barIn = in4;\n\n// Smooth in3 modulation to prevent clicks\nlet modSlew = 1.0 - exp(-1.0 / (0.005 * sr));\nsmoothEnvMod += (envMod - smoothEnvMod) * modSlew;\n\n// --- 1. Stereo 4-Stage Hilbert Quadrature Extraction (x_I = cos, x_Q = sin) ---\n// Pre-condition high brass fizz slightly so 6th-order Chebyshev recurrences don't intermodulate harshly\nlet cleanL = 0.75 * preLpL.next(xL, 450.0) + 0.25 * xL;\nlet cleanR = 0.75 * preLpR.next(xR, 450.0) + 0.25 * xR;\n\nlet cR0 = 0.4794008656; let cR1 = 0.8762184935; let cR2 = 0.9765975895; let cR3 = 0.9974992559;\nlet cI0 = 0.1617584983; let cI1 = 0.7330289323; let cI2 = 0.9453497003; let cI3 = 0.9905991567;\n\n// Quadrature allpass: y[n] = c * (x[n] + y[n-1]) - x[n-1] (H = (c - z^-1)/(1 - c z^-1))\n// This cR/cI order is the negative Hilbert; the imaginary branch is negated below.\nlet reL = cleanL;\nlet t = cR0 * (reL + lReY[0]) - lReX[0]; lReX[0] = reL; lReY[0] = t; reL = t;\nt = cR1 * (reL + lReY[1]) - lReX[1]; lReX[1] = reL; lReY[1] = t; reL = t;\nt = cR2 * (reL + lReY[2]) - lReX[2]; lReX[2] = reL; lReY[2] = t; reL = t;\nt = cR3 * (reL + lReY[3]) - lReX[3]; lReX[3] = reL; lReY[3] = t; reL = t;\nlet rawIL = lDelRe; lDelRe = reL;\n\nlet imL = cleanL;\nt = cI0 * (imL + lImY[0]) - lImX[0]; lImX[0] = imL; lImY[0] = t; imL = t;\nt = cI1 * (imL + lImY[1]) - lImX[1]; lImX[1] = imL; lImY[1] = t; imL = t;\nt = cI2 * (imL + lImY[2]) - lImX[2]; lImX[2] = imL; lImY[2] = t; imL = t;\nt = cI3 * (imL + lImY[3]) - lImX[3]; lImX[3] = imL; lImY[3] = t; imL = t;\nlet rawQL = 0.0 - imL; // negate: this order is the negative Hilbert\n\nlet reR = cleanR;\nt = cR0 * (reR + rReY[0]) - rReX[0]; rReX[0] = reR; rReY[0] = t; reR = t;\nt = cR1 * (reR + rReY[1]) - rReX[1]; rReX[1] = reR; rReY[1] = t; reR = t;\nt = cR2 * (reR + rReY[2]) - rReX[2]; rReX[2] = reR; rReY[2] = t; reR = t;\nt = cR3 * (reR + rReY[3]) - rReX[3]; rReX[3] = reR; rReY[3] = t; reR = t;\nlet rawIR = rDelRe; rDelRe = reR;\n\nlet imR = cleanR;\nt = cI0 * (imR + rImY[0]) - rImX[0]; rImX[0] = imR; rImY[0] = t; imR = t;\nt = cI1 * (imR + rImY[1]) - rImX[1]; rImX[1] = imR; rImY[1] = t; imR = t;\nt = cI2 * (imR + rImY[2]) - rImX[2]; rImX[2] = imR; rImY[2] = t; imR = t;\nt = cI3 * (imR + rImY[3]) - rImX[3]; rImX[3] = imR; rImY[3] = t; imR = t;\nlet rawQR = 0.0 - imR; // negate: this order is the negative Hilbert\n\n// Unit-circle quadrature (exact cos(theta), sin(theta)) + amplitude envelope\nlet magL = sqrt(rawIL * rawIL + rawQL * rawQL + 0.00000001);\nlet magR = sqrt(rawIR * rawIR + rawQR * rawQR + 0.00000001);\nlet xIL = rawIL / magL;\nlet xQL = rawQL / magL;\nlet xIR = rawIR / magR;\nlet xQR = rawQR / magR;\n\n// 2 ms / 80 ms peak follower on the analytic magnitude\nlet envAtk = 1.0 - exp(-1.0 / (0.002 * sr));\nlet envRel = 1.0 - exp(-1.0 / (0.080 * sr));\nampEnvL += (magL - ampEnvL) * ((magL > ampEnvL) ? envAtk : envRel);\nampEnvR += (magR - ampEnvR) * ((magR > ampEnvR) ? envAtk : envRel);\n\n// Shaping radius: drive applied to the envelope-normalised magnitude (about 1 on a\n// steady note). Harmonic k is weighted by rS^(k-1), so drive sets the brightness.\nlet drive = dbtoa(clamp(drive_db, 0.0, 18.0));\nlet rSL = tanh(drive * magL / maximum(ampEnvL, 0.0001));\nlet rSR = tanh(drive * magR / maximum(ampEnvR, 0.0001));\n\n// --- 2. Chebyshev Polynomials of 1st Kind (T_1..T_6) & 2nd Kind (U_0..U_5) ---\n// On the unit circle T_k(cos) = cos(k*theta) and sin * U_{k-1}(cos) = sin(k*theta)\n// Recurrences: T_k(x) = 2*x*T_{k-1}(x) - T_{k-2}(x), U_k(x) = 2*x*U_{k-1}(x) - U_{k-2}(x)\n// Left Channel:\nlet T1L = xIL;\nlet T2L = 2.0 * xIL * T1L - 1.0;\nlet T3L = 2.0 * xIL * T2L - T1L;\nlet T4L = 2.0 * xIL * T3L - T2L;\nlet T5L = 2.0 * xIL * T4L - T3L;\nlet T6L = 2.0 * xIL * T5L - T4L;\n\nlet U0L = 1.0;\nlet U1L = 2.0 * xIL;\nlet U2L = 2.0 * xIL * U1L - U0L;\nlet U3L = 2.0 * xIL * U2L - U1L;\nlet U4L = 2.0 * xIL * U3L - U2L;\nlet U5L = 2.0 * xIL * U4L - U3L;\n\n// Right Channel:\nlet T1R = xIR;\nlet T2R = 2.0 * xIR * T1R - 1.0;\nlet T3R = 2.0 * xIR * T2R - T1R;\nlet T4R = 2.0 * xIR * T3R - T2R;\nlet T5R = 2.0 * xIR * T4R - T3R;\nlet T6R = 2.0 * xIR * T5R - T4R;\n\nlet U0R = 1.0;\nlet U1R = 2.0 * xIR;\nlet U2R = 2.0 * xIR * U1R - U0R;\nlet U3R = 2.0 * xIR * U2R - U1R;\nlet U4R = 2.0 * xIR * U3R - U2R;\nlet U5R = 2.0 * xIR * U4R - U3R;\n\n// --- 3. Harmonic Phase Angle Rotation phi_k (Paper Eq. 10-15) ---\n// Glitch-free bar phasor detection (100 ms hold prevents wrap-around dropout clicks every 2 seconds!)\nif (abs(barIn - prevBarIn) > 0.0000001) {\n\tbarHold = 0.1 * sr;\n} else if (barHold > 0.0) {\n\tbarHold -= 1.0;\n}\nprevBarIn = barIn;\nlet fbPh = barFallback.next(0.5);\nlet spinPh = (barHold > 0.0) ? wrap(barIn * 2.0, 0.0, 1.0) : fbPh;\n// Integrated spin: advance by phase_spin x the (wrapped) step of the bar phase, so the\n// rotation stays continuous when the bar wraps. (Scaling the wrapping phase itself\n// made every harmonic's phase jump by a fraction of a turn - a click each half bar.)\nlet dSpin = spinPh - prevSpinPh;\ndSpin = dSpin - floor(dSpin + 0.5);\nprevSpinPh = spinPh;\nspinAcc = wrap(spinAcc + clamp(phase_spin, 0.0, 1.0) * dSpin, 0.0, 1.0);\nlet spinAngle = 2.0 * pi * spinAcc;\n\nlet baseAngle = clamp(quad_phase_angle, -3.14159, 3.14159) + smoothEnvMod * pi;\nlet stOffset = clamp(stereo_quad_spread, 0.0, 1.0) * 0.5 * pi;\n\n// Progressive harmonic phase dispersion: phi_k = k * baseAngle + spinAngle\nlet evAmt = pow(clamp(even_harmonics, 0.0, 1.0), 1.2);\nlet odAmt = pow(clamp(odd_harmonics, 0.0, 1.0), 1.2);\nlet hiTilt = clamp(high_order_tilt, 0.0, 1.0);\n\nlet a2 = evAmt * (0.75 - 0.25 * hiTilt);\nlet a3 = odAmt * (0.75 - 0.25 * hiTilt);\nlet a4 = evAmt * (0.25 + 0.55 * hiTilt);\nlet a5 = odAmt * (0.25 + 0.55 * hiTilt);\nlet a6 = evAmt * (0.15 + 0.50 * hiTilt);\n\nlet p2L = 2.0 * baseAngle + spinAngle;       let p2R = 2.0 * (baseAngle + stOffset) - spinAngle;\nlet p3L = 3.0 * baseAngle + spinAngle * 2.0; let p3R = 3.0 * (baseAngle + stOffset) - spinAngle * 2.0;\nlet p4L = 4.0 * baseAngle + spinAngle * 3.0; let p4R = 4.0 * (baseAngle + stOffset) - spinAngle * 3.0;\nlet p5L = 5.0 * baseAngle + spinAngle * 4.0; let p5R = 5.0 * (baseAngle + stOffset) - spinAngle * 4.0;\nlet p6L = 6.0 * baseAngle + spinAngle * 5.0; let p6R = 6.0 * (baseAngle + stOffset) - spinAngle * 5.0;\n\n// Paper Eq. 15: y(t) = sum_k a_k * [ cos(phi_k)*T_k(x_I) + sin(phi_k)*x_Q*U_{k-1}(x_I) ]\nlet rL2 = rSL * rSL; let rL3 = rL2 * rSL; let rL4 = rL3 * rSL; let rL5 = rL4 * rSL;\nlet rR2 = rSR * rSR; let rR3 = rR2 * rSR; let rR4 = rR3 * rSR; let rR5 = rR4 * rSR;\n\nlet sumL = T1L\n\t+ a2 * rSL * (cos(p2L) * T2L + sin(p2L) * xQL * U1L)\n\t+ a3 * rL2 * (cos(p3L) * T3L + sin(p3L) * xQL * U2L)\n\t+ a4 * rL3 * (cos(p4L) * T4L + sin(p4L) * xQL * U3L)\n\t+ a5 * rL4 * (cos(p5L) * T5L + sin(p5L) * xQL * U4L)\n\t+ a6 * rL5 * (cos(p6L) * T6L + sin(p6L) * xQL * U5L);\n\nlet sumR = T1R\n\t+ a2 * rSR * (cos(p2R) * T2R + sin(p2R) * xQR * U1R)\n\t+ a3 * rR2 * (cos(p3R) * T3R + sin(p3R) * xQR * U2R)\n\t+ a4 * rR3 * (cos(p4R) * T4R + sin(p4R) * xQR * U3R)\n\t+ a5 * rR4 * (cos(p5R) * T5R + sin(p5R) * xQR * U4R)\n\t+ a6 * rR5 * (cos(p6R) * T6R + sin(p6R) * xQR * U5R);\n\n// Restore the input's level (the unit-circle sum is scaled by the magnitude itself)\nlet norm = 1.0 / (1.0 + 0.50 * (a2 + a3 + a4 + a5 + a6));\nlet yL = sumL * norm * magL;\nlet yR = sumR * norm * magR;\n\n// DC blocker\nlet dcPole = 1.0 - (2.0 * pi * 10.0 / sr); // 10 Hz (a fixed 0.995 was 38 Hz at 48 kHz: -1.6 dB at 58 Hz, -4 dB at 29 Hz)\nlet outL = yL - dcXL + dcPole * dcYL;\ndcXL = yL; dcYL = outL;\nlet outR = yR - dcXR + dcPole * dcYR;\ndcXR = yR; dcYR = outR;\n\nout1 = tanh(outL * 1.15);\nout2 = tanh(outR * 1.15);\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "nocache": 0,
                                        "expr": "",
                                        "safemath": 1,
                                        "code": "// ============================================================================\n// quadrature_chebyshev_shaper.txt\n// Unix-Style Stereo Effect: Phase-Quadrature Chebyshev T_k & U_k Waveshaper\n// Implements Timoney, Lazzarini, Gibney & Pekonen (DAFx-10, Paper P65):\n// \"Digital Emulation of Distortion Effects by Wave and Phase Shaping Methods\"\n// (Section 2.1, Eq. 5-15).\n// Classical Chebyshev waveshaping T_k(cos(w*t)) = cos(k*w*t) only controls\n// harmonic magnitudes with fixed 0-degree phase. By extracting the quadrature\n// signal pair (x_I = cos(w*t), x_Q = sin(w*t)) via a 4-stage Hilbert network and\n// combining Chebyshev polynomials of the FIRST kind T_k(x_I) with Chebyshev\n// polynomials of the SECOND kind x_Q * U_{k-1}(x_I) = sin(k*w*t) (Eq. 11-15):\n//   y(t) = sum_k a_k * [ cos(phi_k) * T_k(x_I) + sin(phi_k) * x_Q * U_{k-1}(x_I) ]\n// you gain independent control over BOTH harmonic amplitudes AND harmonic phase\n// angles phi_k (even continuously rotating harmonic phases at audio/LFO rates)!\n// T_k(x_I) = cos(k*w*t) only holds on the unit circle, so the analytic pair is\n// normalised to unit magnitude first and the level is restored afterwards from an\n// envelope follower; drive_db acts on the envelope-normalised magnitude, so the\n// harmonic content no longer depends on how loud the tuba is (before, at real tuba\n// levels the polynomials saw r ~ 0.1 and mostly returned the fundamental).\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (prefer 01_harmonic_isolator or raw tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: Optional Mod Envelope [-2..2] (dynamically rotates harmonic phase angles phi_k;\n//        anything outside that range, such as the rig's pitch in Hz, is ignored)\n//   in4: Optional 1-Bar Phasor [0..1] (drives continuous per-harmonic Shepard/Barberpole\n//        phase rotation when phase_spin > 0)\n// Outlets:\n//   out1: Left Quadrature Chebyshev Output\n//   out2: Right Quadrature Chebyshev Output\n\n@param({ min: 0.0, max: 18.0 }) drive_db = 6.0;\n@param({ min: 0.0, max: 1.0 }) even_harmonics = 0.55;\n@param({ min: 0.0, max: 1.0 }) odd_harmonics = 0.75;\n@param({ min: 0.0, max: 1.0 }) high_order_tilt = 0.5;\n@param({ min: -3.14159, max: 3.14159 }) quad_phase_angle = 0.785;\n@param({ min: 0.0, max: 1.0 }) phase_spin = 0.35;\n@param({ min: 0.0, max: 1.0 }) stereo_quad_spread = 0.5;\n\n// Stereo 4-stage IIR Hilbert transform states for Quadrature (x_I, x_Q) extraction\n@state lReX = new FixedSampleArray(4); @state lReY = new FixedSampleArray(4);\n@state lImX = new FixedSampleArray(4); @state lImY = new FixedSampleArray(4);\n@state lDelRe = 0.0;\n\n@state rReX = new FixedSampleArray(4); @state rReY = new FixedSampleArray(4);\n@state rImX = new FixedSampleArray(4); @state rImY = new FixedSampleArray(4);\n@state rDelRe = 0.0;\n\n// Warm lowpass pre-conditioning so Chebyshev polynomials shape the fundamental + low brass body cleanly\n@state preLpL = new onepole();\n@state preLpR = new onepole();\n\n// Glitch-free bar phasor hold & smoothers\n@state barFallback = new phasor();\n@state prevBarIn = 0.0;\n@state barHold = 0.0;\n@state smoothEnvMod = 0.0;\n@state ampEnvL = 0.0;\n@state spinAcc = 0.0;\n@state prevSpinPh = 0.0;\n@state ampEnvR = 0.0;\n@state in2Hold = 0.0;\n@state dcXL = 0.0; @state dcYL = 0.0;\n@state dcXR = 0.0; @state dcYR = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\n// Mono fallback: in2 counts as patched for 250 ms after its last non-zero sample\nif (abs(in2) > 0.0000001) {\n\tin2Hold = 0.25 * sr;\n} else if (in2Hold > 0.0) {\n\tin2Hold -= 1.0;\n}\nlet xR = (in2Hold > 0.0) ? in2 : xL;\nlet envMod = (in3 > -2.0 && in3 < 2.0) ? in3 : 0.0;\nlet barIn = in4;\n\n// Smooth in3 modulation to prevent clicks\nlet modSlew = 1.0 - exp(-1.0 / (0.005 * sr));\nsmoothEnvMod += (envMod - smoothEnvMod) * modSlew;\n\n// --- 1. Stereo 4-Stage Hilbert Quadrature Extraction (x_I = cos, x_Q = sin) ---\n// Pre-condition high brass fizz slightly so 6th-order Chebyshev recurrences don't intermodulate harshly\nlet cleanL = 0.75 * preLpL.next(xL, 450.0) + 0.25 * xL;\nlet cleanR = 0.75 * preLpR.next(xR, 450.0) + 0.25 * xR;\n\nlet cR0 = 0.4794008656; let cR1 = 0.8762184935; let cR2 = 0.9765975895; let cR3 = 0.9974992559;\nlet cI0 = 0.1617584983; let cI1 = 0.7330289323; let cI2 = 0.9453497003; let cI3 = 0.9905991567;\n\n// Quadrature allpass: y[n] = c * (x[n] + y[n-1]) - x[n-1] (H = (c - z^-1)/(1 - c z^-1))\n// This cR/cI order is the negative Hilbert; the imaginary branch is negated below.\nlet reL = cleanL;\nlet t = cR0 * (reL + lReY[0]) - lReX[0]; lReX[0] = reL; lReY[0] = t; reL = t;\nt = cR1 * (reL + lReY[1]) - lReX[1]; lReX[1] = reL; lReY[1] = t; reL = t;\nt = cR2 * (reL + lReY[2]) - lReX[2]; lReX[2] = reL; lReY[2] = t; reL = t;\nt = cR3 * (reL + lReY[3]) - lReX[3]; lReX[3] = reL; lReY[3] = t; reL = t;\nlet rawIL = lDelRe; lDelRe = reL;\n\nlet imL = cleanL;\nt = cI0 * (imL + lImY[0]) - lImX[0]; lImX[0] = imL; lImY[0] = t; imL = t;\nt = cI1 * (imL + lImY[1]) - lImX[1]; lImX[1] = imL; lImY[1] = t; imL = t;\nt = cI2 * (imL + lImY[2]) - lImX[2]; lImX[2] = imL; lImY[2] = t; imL = t;\nt = cI3 * (imL + lImY[3]) - lImX[3]; lImX[3] = imL; lImY[3] = t; imL = t;\nlet rawQL = 0.0 - imL; // negate: this order is the negative Hilbert\n\nlet reR = cleanR;\nt = cR0 * (reR + rReY[0]) - rReX[0]; rReX[0] = reR; rReY[0] = t; reR = t;\nt = cR1 * (reR + rReY[1]) - rReX[1]; rReX[1] = reR; rReY[1] = t; reR = t;\nt = cR2 * (reR + rReY[2]) - rReX[2]; rReX[2] = reR; rReY[2] = t; reR = t;\nt = cR3 * (reR + rReY[3]) - rReX[3]; rReX[3] = reR; rReY[3] = t; reR = t;\nlet rawIR = rDelRe; rDelRe = reR;\n\nlet imR = cleanR;\nt = cI0 * (imR + rImY[0]) - rImX[0]; rImX[0] = imR; rImY[0] = t; imR = t;\nt = cI1 * (imR + rImY[1]) - rImX[1]; rImX[1] = imR; rImY[1] = t; imR = t;\nt = cI2 * (imR + rImY[2]) - rImX[2]; rImX[2] = imR; rImY[2] = t; imR = t;\nt = cI3 * (imR + rImY[3]) - rImX[3]; rImX[3] = imR; rImY[3] = t; imR = t;\nlet rawQR = 0.0 - imR; // negate: this order is the negative Hilbert\n\n// Unit-circle quadrature (exact cos(theta), sin(theta)) + amplitude envelope\nlet magL = sqrt(rawIL * rawIL + rawQL * rawQL + 0.00000001);\nlet magR = sqrt(rawIR * rawIR + rawQR * rawQR + 0.00000001);\nlet xIL = rawIL / magL;\nlet xQL = rawQL / magL;\nlet xIR = rawIR / magR;\nlet xQR = rawQR / magR;\n\n// 2 ms / 80 ms peak follower on the analytic magnitude\nlet envAtk = 1.0 - exp(-1.0 / (0.002 * sr));\nlet envRel = 1.0 - exp(-1.0 / (0.080 * sr));\nampEnvL += (magL - ampEnvL) * ((magL > ampEnvL) ? envAtk : envRel);\nampEnvR += (magR - ampEnvR) * ((magR > ampEnvR) ? envAtk : envRel);\n\n// Shaping radius: drive applied to the envelope-normalised magnitude (about 1 on a\n// steady note). Harmonic k is weighted by rS^(k-1), so drive sets the brightness.\nlet drive = dbtoa(clamp(drive_db, 0.0, 18.0));\nlet rSL = tanh(drive * magL / maximum(ampEnvL, 0.0001));\nlet rSR = tanh(drive * magR / maximum(ampEnvR, 0.0001));\n\n// --- 2. Chebyshev Polynomials of 1st Kind (T_1..T_6) & 2nd Kind (U_0..U_5) ---\n// On the unit circle T_k(cos) = cos(k*theta) and sin * U_{k-1}(cos) = sin(k*theta)\n// Recurrences: T_k(x) = 2*x*T_{k-1}(x) - T_{k-2}(x), U_k(x) = 2*x*U_{k-1}(x) - U_{k-2}(x)\n// Left Channel:\nlet T1L = xIL;\nlet T2L = 2.0 * xIL * T1L - 1.0;\nlet T3L = 2.0 * xIL * T2L - T1L;\nlet T4L = 2.0 * xIL * T3L - T2L;\nlet T5L = 2.0 * xIL * T4L - T3L;\nlet T6L = 2.0 * xIL * T5L - T4L;\n\nlet U0L = 1.0;\nlet U1L = 2.0 * xIL;\nlet U2L = 2.0 * xIL * U1L - U0L;\nlet U3L = 2.0 * xIL * U2L - U1L;\nlet U4L = 2.0 * xIL * U3L - U2L;\nlet U5L = 2.0 * xIL * U4L - U3L;\n\n// Right Channel:\nlet T1R = xIR;\nlet T2R = 2.0 * xIR * T1R - 1.0;\nlet T3R = 2.0 * xIR * T2R - T1R;\nlet T4R = 2.0 * xIR * T3R - T2R;\nlet T5R = 2.0 * xIR * T4R - T3R;\nlet T6R = 2.0 * xIR * T5R - T4R;\n\nlet U0R = 1.0;\nlet U1R = 2.0 * xIR;\nlet U2R = 2.0 * xIR * U1R - U0R;\nlet U3R = 2.0 * xIR * U2R - U1R;\nlet U4R = 2.0 * xIR * U3R - U2R;\nlet U5R = 2.0 * xIR * U4R - U3R;\n\n// --- 3. Harmonic Phase Angle Rotation phi_k (Paper Eq. 10-15) ---\n// Glitch-free bar phasor detection (100 ms hold prevents wrap-around dropout clicks every 2 seconds!)\nif (abs(barIn - prevBarIn) > 0.0000001) {\n\tbarHold = 0.1 * sr;\n} else if (barHold > 0.0) {\n\tbarHold -= 1.0;\n}\nprevBarIn = barIn;\nlet fbPh = barFallback.next(0.5);\nlet spinPh = (barHold > 0.0) ? wrap(barIn * 2.0, 0.0, 1.0) : fbPh;\n// Integrated spin: advance by phase_spin x the (wrapped) step of the bar phase, so the\n// rotation stays continuous when the bar wraps. (Scaling the wrapping phase itself\n// made every harmonic's phase jump by a fraction of a turn - a click each half bar.)\nlet dSpin = spinPh - prevSpinPh;\ndSpin = dSpin - floor(dSpin + 0.5);\nprevSpinPh = spinPh;\nspinAcc = wrap(spinAcc + clamp(phase_spin, 0.0, 1.0) * dSpin, 0.0, 1.0);\nlet spinAngle = 2.0 * pi * spinAcc;\n\nlet baseAngle = clamp(quad_phase_angle, -3.14159, 3.14159) + smoothEnvMod * pi;\nlet stOffset = clamp(stereo_quad_spread, 0.0, 1.0) * 0.5 * pi;\n\n// Progressive harmonic phase dispersion: phi_k = k * baseAngle + spinAngle\nlet evAmt = pow(clamp(even_harmonics, 0.0, 1.0), 1.2);\nlet odAmt = pow(clamp(odd_harmonics, 0.0, 1.0), 1.2);\nlet hiTilt = clamp(high_order_tilt, 0.0, 1.0);\n\nlet a2 = evAmt * (0.75 - 0.25 * hiTilt);\nlet a3 = odAmt * (0.75 - 0.25 * hiTilt);\nlet a4 = evAmt * (0.25 + 0.55 * hiTilt);\nlet a5 = odAmt * (0.25 + 0.55 * hiTilt);\nlet a6 = evAmt * (0.15 + 0.50 * hiTilt);\n\nlet p2L = 2.0 * baseAngle + spinAngle;       let p2R = 2.0 * (baseAngle + stOffset) - spinAngle;\nlet p3L = 3.0 * baseAngle + spinAngle * 2.0; let p3R = 3.0 * (baseAngle + stOffset) - spinAngle * 2.0;\nlet p4L = 4.0 * baseAngle + spinAngle * 3.0; let p4R = 4.0 * (baseAngle + stOffset) - spinAngle * 3.0;\nlet p5L = 5.0 * baseAngle + spinAngle * 4.0; let p5R = 5.0 * (baseAngle + stOffset) - spinAngle * 4.0;\nlet p6L = 6.0 * baseAngle + spinAngle * 5.0; let p6R = 6.0 * (baseAngle + stOffset) - spinAngle * 5.0;\n\n// Paper Eq. 15: y(t) = sum_k a_k * [ cos(phi_k)*T_k(x_I) + sin(phi_k)*x_Q*U_{k-1}(x_I) ]\nlet rL2 = rSL * rSL; let rL3 = rL2 * rSL; let rL4 = rL3 * rSL; let rL5 = rL4 * rSL;\nlet rR2 = rSR * rSR; let rR3 = rR2 * rSR; let rR4 = rR3 * rSR; let rR5 = rR4 * rSR;\n\nlet sumL = T1L\n\t+ a2 * rSL * (cos(p2L) * T2L + sin(p2L) * xQL * U1L)\n\t+ a3 * rL2 * (cos(p3L) * T3L + sin(p3L) * xQL * U2L)\n\t+ a4 * rL3 * (cos(p4L) * T4L + sin(p4L) * xQL * U3L)\n\t+ a5 * rL4 * (cos(p5L) * T5L + sin(p5L) * xQL * U4L)\n\t+ a6 * rL5 * (cos(p6L) * T6L + sin(p6L) * xQL * U5L);\n\nlet sumR = T1R\n\t+ a2 * rSR * (cos(p2R) * T2R + sin(p2R) * xQR * U1R)\n\t+ a3 * rR2 * (cos(p3R) * T3R + sin(p3R) * xQR * U2R)\n\t+ a4 * rR3 * (cos(p4R) * T4R + sin(p4R) * xQR * U3R)\n\t+ a5 * rR4 * (cos(p5R) * T5R + sin(p5R) * xQR * U4R)\n\t+ a6 * rR5 * (cos(p6R) * T6R + sin(p6R) * xQR * U5R);\n\n// Restore the input's level (the unit-circle sum is scaled by the magnitude itself)\nlet norm = 1.0 / (1.0 + 0.50 * (a2 + a3 + a4 + a5 + a6));\nlet yL = sumL * norm * magL;\nlet yR = sumR * norm * magR;\n\n// DC blocker\nlet dcPole = 1.0 - (2.0 * pi * 10.0 / sr); // 10 Hz (a fixed 0.995 was 38 Hz at 48 kHz: -1.6 dB at 58 Hz, -4 dB at 29 Hz)\nlet outL = yL - dcXL + dcPole * dcYL;\ndcXL = yL; dcYL = outL;\nlet outR = yR - dcXR + dcPole * dcYR;\ndcXR = yR; dcYR = outR;\n\nout1 = tanh(outL * 1.15);\nout2 = tanh(outR * 1.15);\n"
                                    },
                                    "rnbo_serial": 4,
                                    "rnbo_uniqueid": "effect_code",
                                    "rnboinfo": {
                                        "needsInstanceInfo": 1,
                                        "argnames": {
                                            "reset": {
                                                "attrOrProp": 1,
                                                "digest": "Reset all state and params to initial values",
                                                "isalias": 0,
                                                "aliases": [],
                                                "attachable": 1,
                                                "isparam": 0,
                                                "deprecated": 0,
                                                "touched": 0,
                                                "type": "bang"
                                            },
                                            "in1": {
                                                "attrOrProp": 1,
                                                "digest": "in1",
