            },
            {
                "box": {
                    "id": "obj-9",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "signal" ],
                    "patching_rect": [ 431.5, 364.0, 105.0, 23.0 ],
                    "rnbo_classname": "r~",
                    "rnbo_serial": 4,
                    "rnbo_uniqueid": "r~_obj-9",
                    "text": "r~ primary_phasor"
                }
            },
            {
                "box": {
                    "id": "obj-2",
                    "maxclass": "newobj",
                    "numinlets": 5,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 2,
                            "revision": 1,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 1807.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "ai.barberpole_comb_phaser",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// barberpole_comb_phaser.txt — space-bass endless phaser: a comb tuned to\n//                              the f0 period with a single-sideband shift\n//                              inside its feedback loop, so the peaks and\n//                              notches climb (or fall) forever, in key,\n//                              at a tempo-locked rate\n//\n// From: F. Esqueda, V. Välimäki, J. Parker, \"Barberpole Phasing and\n//       Flanging Illusions\", DAFx-15 paper 67: §3 eq. 9-10 (flanger comb and\n//       the endless-motion illusion), §4 eq. 11-14 (single-sideband\n//       modulation of the delayed path: the comb pattern moves by the shift\n//       frequency without ever resetting), §4.1 (allpass spectral delay in\n//       the path warps the notch spacing);\n//       S. Wardle, DAFx-98 §6 (stereo phaser from opposite SSB shifts);\n//       J. Kleimola, \"Dispersion Modulation using Allpass Filters\", DAFx-08\n//       paper 36 §2.3 (first-order allpass as frequency-dependent delay).\n// Parent: ai_freq_mod_phase_dist/barberpole_comb_ssb_flanger (4 stars),\n//         11_bode_ssb_freq_shifter (5 stars).\n//\n// Loop: v = x + fb * BP(SSB_shift(AP_warp(delay(v, T)))), wet = the\n// shifted path. BP = 20 Hz..7 kHz one-poles; the feedback is a soft tanh so\n// the loop cannot run away where the shifter is not exactly unity gain. T = comb_ratio f0 periods minus the loop's own phase delay at f0\n// (Hilbert real branch + warp allpasses, computed analytically) so the loop\n// resonates exactly on f0. Shift = cycles_per_bar * bar frequency (measured from in4).\n// Dry/wet: out = (1 - blend) dry + blend wet; 50 % is the classic phaser\n// sum. The barberpole motion IS the phase relation between the two.\n//\n// Inlets:\n//   in1 / in2: stereo tuba\n//   in3: f0 in Hz. > 0 = tracked pitch (clamped 20..1000 Hz);\n//        0 = disconnected -> fixed 55 Hz. No zero-crossing fallback.\n//   in4: 0..1 one-bar phasor (sets the shift rate). Held (no movement for\n//        100 ms) -> internal 2 s bar (120 BPM 4/4).\n//   in5: pitch confidence 0..1 (0 while the horn is silent, ~1 while\n//        playing). While it is low the comb tuning is held, so the tail keeps\n//        ringing on the last note. Never moved since load -> treated as 1.\n// Outlets:\n//   out1 / out2: stereo\n// No safety limiter, no metering.\n// ============================================================================\n\n// Barberpole cycles per bar (- = falling)\n@param({ min: -8, max: 8 }) cycles_per_bar = 2;\n// Comb delay in f0 periods\n@param({ min: 0.5, max: 4 }) comb_ratio = 3.414;\n// Loop feedback\n@param({ min: 0, max: 95 }) feedback = 88.72;\n// Notch warp (allpass dispersion)\n@param({ min: 0, max: 90 }) warp = 40;\n// Stereo width (100 = L up / R down)\n@param({ min: 0, max: 100 }) width = 2;\n// Dry/wet (50 = phaser sum)\n@param({ min: 0, max: 100 }) blend = 100;\n// Output gain\n@param({ min: -24, max: 12 }) out_gain_db = -4.5;\n\n@state f0Smooth = 55.0;\n@state f0Held = 55.0;\n\n@state prevBarIn = 0.0;\n@state barLast = 0.0;\n@state barHold = 0.0;\n@state barHzSm = 0.5;\n\n@state prevConfIn = 0.0;\n@state confSeen = 0.0;\n\n@state tSm = 872.0;\n@state thL = 0.0;\n@state thR = 0.0;\n\n@state bufL = new FixedSampleArray(32768);\n@state bufR = new FixedSampleArray(32768);\n@state wIdx: Int = 0;\n\n@state hpLoopL = new onepole();\n@state hpLoopR = new onepole();\n@state lpLoopL = new onepole();\n@state lpLoopR = new onepole();\n\n@state apX = new FixedSampleArray(2, 2);\n@state apY = new FixedSampleArray(2, 2);\n\n@state reX = new FixedSampleArray(2, 4);\n@state reY = new FixedSampleArray(2, 4);\n@state imX = new FixedSampleArray(2, 4);\n@state imY = new FixedSampleArray(2, 4);\n@state reDel = new FixedSampleArray(2);\n\n// Real branch of the 4-stage quadrature pair, plus one sample of delay to\n// line it up with the imaginary branch. y = c*(x + y1) - x1 per stage.\nfunction hilbRe(ch: Int, x: number): number {\n\tlet s = x;\n\tlet c = 0.0;\n\tfor (let i: Int = 0; i < 4; i++) {\n\t\tc = (i == 0) ? 0.4794008656 : ((i == 1) ? 0.8762184935 : ((i == 2) ? 0.9765975895 : 0.9974992559));\n\t\tlet y = c * (s + reY[ch][i]) - reX[ch][i];\n\t\treX[ch][i] = s;\n\t\treY[ch][i] = y;\n\t\ts = y;\n\t}\n\tlet out = reDel[ch];\n\treDel[ch] = s;\n\treturn out;\n}\n\n// Imaginary branch; this coefficient order gives the negative Hilbert, so negate.\nfunction hilbIm(ch: Int, x: number): number {\n\tlet s = x;\n\tlet c = 0.0;\n\tfor (let i: Int = 0; i < 4; i++) {\n\t\tc = (i == 0) ? 0.1617584983 : ((i == 1) ? 0.7330289323 : ((i == 2) ? 0.9453497003 : 0.9905991567));\n\t\tlet y = c * (s + imY[ch][i]) - imX[ch][i];\n\t\timX[ch][i] = s;\n\t\timY[ch][i] = y;\n\t\ts = y;\n\t}\n\treturn 0.0 - s;\n}\n\n// Two first-order allpasses H = (a + z^-1)/(1 + a z^-1) (spectral delay).\nfunction warpAp(ch: Int, x: number, a: number): number {\n\tlet s = x;\n\tfor (let i: Int = 0; i < 2; i++) {\n\t\tlet y = a * s + apX[ch][i] - a * apY[ch][i];\n\t\tapX[ch][i] = s;\n\t\tapY[ch][i] = y;\n\t\ts = y;\n\t}\n\treturn s;\n}\n\n// Cubic read d samples behind the write head; ch 0 = L, 1 = R.\nfunction readBack(ch: Int, d: number): number {\n\tlet pos = wIdx - d;\n\twhile (pos < 0.0) {\n\t\tpos += 32768.0;\n\t}\n\tlet i0: Int = trunc(pos);\n\tlet fr = pos - i0;\n\tlet im1: Int = (i0 + 32767) % 32768;\n\tlet ia: Int = i0 % 32768;\n\tlet ib: Int = (i0 + 1) % 32768;\n\tlet ic: Int = (i0 + 2) % 32768;\n\tlet y = 0.0;\n\tif (ch == 0) {\n\t\ty = cubicinterp(fr, bufL[im1], bufL[ia], bufL[ib], bufL[ic]);\n\t} else {\n\t\ty = cubicinterp(fr, bufR[im1], bufR[ia], bufR[ib], bufR[ic]);\n\t}\n\treturn y;\n}\n\n// Phase (rad) at w of (z^-1 - c)/(1 - c z^-1): continuous from 0 to -pi.\n// A Hilbert stage (c - z^-1)/(1 - c z^-1) is this times -1; the four sign\n// flips of the chain cancel, so the chain phase is the sum of these.\nfunction apPhase(c: number, w: number): number {\n\treturn atan2(0.0 - sin(w), cos(w) - c) - atan2(c * sin(w), 1.0 - c * cos(w));\n}\n\n// Phase (rad) at w of (a + z^-1)/(1 + a z^-1): continuous from 0 to -pi.\nfunction warpPhase(a: number, w: number): number {\n\treturn atan2(0.0 - sin(w), a + cos(w)) - atan2(0.0 - a * sin(w), 1.0 + a * cos(w));\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\nlet confIn = in5;\n\n// --- Confidence: 0 = silent horn; never moved = unpatched -> 1 ---------------\nif (abs(confIn - prevConfIn) > 0.0000001) {\n\tconfSeen = 1.0;\n}\nprevConfIn = confIn;\nlet confRaw = (confSeen > 0.5) ? clamp(confIn, 0.0, 1.0) : 1.0;\n\n// --- f0: in3 > 0 is the pitch; 0 = disconnected -> fixed 55 Hz; held while silent\nlet f0Target = (pitchIn > 0.0) ? clamp(pitchIn, 20.0, 1000.0) : 55.0;\nif (confRaw > 0.5) {\n\tf0Held = f0Target;\n}\nf0Smooth += (f0Held - f0Smooth) * (1.0 - exp(-1.0 / (0.004 * sr)));\nlet f0 = clamp(f0Smooth, 20.0, 1000.0);\n\n// --- Bar frequency: from in4's increment while it moves, else 0.5 Hz --------\nlet barInc = wrap(barIn - prevBarIn + 0.5, 0.0, 1.0) - 0.5;\nif (abs(barIn - prevBarIn) > 0.0000001) {\n\tbarLast = barIn;\n\tbarHold = 0.1 * sr;\n} else if (barHold > 0.0) {\n\tbarHold -= 1.0;\n}\nprevBarIn = barIn;\nlet barHzT = (barHold > 0.0) ? clamp(abs(barInc) * sr, 0.05, 8.0) : 0.5;\nbarHzSm += (barHzT - barHzSm) * (1.0 - exp(-1.0 / (0.25 * sr)));\n\n// --- Shift phases -------------------------------------------------------------\nlet shiftHz = clamp(cycles_per_bar, -8.0, 8.0) * barHzSm;\nlet wd = clamp(width, 0.0, 100.0) * 0.01;\nthL = wrap(thL + shiftHz / sr, 0.0, 1.0);\nthR = wrap(thR + shiftHz * (1.0 - 2.0 * wd) / sr, 0.0, 1.0);\n\n// --- Comb delay: comb_ratio periods minus the loop's phase delay at f0 ------\n// (the loop resonates where its total phase is a whole number of cycles)\nlet a = 0.0 - 0.9 * clamp(warp, 0.0, 90.0) * 0.01;\nlet w0 = 2.0 * pi * f0 / sr;\nlet phLoop = 0.0 - w0 + apPhase(0.4794008656, w0) + apPhase(0.8762184935, w0) + apPhase(0.9765975895, w0) + apPhase(0.9974992559, w0) + 2.0 * warpPhase(a, w0);\nlet period = sr / f0;\nlet tT = clamp(comb_ratio, 0.5, 4.0) * period + phLoop / w0;\n// a loop longer than the wanted delay: add whole periods (keeps f0 in tune)\nif (tT < 2.0) {\n\ttT += period * ceil((2.0 - tT) / period);\n}\ntT = clamp(tT, 2.0, 30000.0);\ntSm += (tT - tSm) * (1.0 - exp(-1.0 / (0.02 * sr)));\n\n// --- Loop -------------------------------------------------------------------\nlet fb = clamp(feedback, 0.0, 95.0) * 0.01;\nlet dL = warpAp(0, readBack(0, tSm), a);\nlet dR = warpAp(1, readBack(1, tSm), a);\nlet reL = hilbRe(0, dL);\nlet imL = hilbIm(0, dL);\nlet reR = hilbRe(1, dR);\nlet imR = hilbIm(1, dR);\nlet ssbL = reL * cos(2.0 * pi * thL) - imL * sin(2.0 * pi * thL);\nlet ssbR = reR * cos(2.0 * pi * thR) - imR * sin(2.0 * pi * thR);\n// Band-limit inside the loop: the Hilbert pair loses quadrature below\n// ~40 Hz and above a few kHz, where the rotation can exceed unity gain, and\n// each pass walks energy further out; the band edges also fade the\n// barberpole in and out (the Shepard part of the illusion).\nlet bpL = lpLoopL.next(ssbL - hpLoopL.next(ssbL, 20.0), 7000.0);\nlet bpR = lpLoopR.next(ssbR - hpLoopR.next(ssbR, 20.0), 7000.0);\nlet wetL = bpL;\nlet wetR = bpR;\n// soft feedback: linear for small signals, cannot run away\nbufL[wIdx] = xL + 1.5 * tanh(fb * wetL / 1.5);\nbufR[wIdx] = xR + 1.5 * tanh(fb * wetR / 1.5);\nwIdx = (wIdx + 1) % 32768;\n\n// --- Dry/wet ------------------------------------------------------------------\nlet b = clamp(blend, 0.0, 100.0) * 0.01;\nlet oL = linearinterp(b, xL, wetL);\nlet oR = linearinterp(b, xR, wetR);\n\n// --- Output gain (last stage) -----------------------------------------------\nlet outGain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = oL * outGain;\nout2 = oR * outGain;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 5,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "nocache": 0,
                                        "expr": "",
                                        "safemath": 1,
                                        "code": "// ============================================================================\n// barberpole_comb_phaser.txt — space-bass endless phaser: a comb tuned to\n//                              the f0 period with a single-sideband shift\n//                              inside its feedback loop, so the peaks and\n//                              notches climb (or fall) forever, in key,\n//                              at a tempo-locked rate\n//\n// From: F. Esqueda, V. Välimäki, J. Parker, \"Barberpole Phasing and\n//       Flanging Illusions\", DAFx-15 paper 67: §3 eq. 9-10 (flanger comb and\n//       the endless-motion illusion), §4 eq. 11-14 (single-sideband\n//       modulation of the delayed path: the comb pattern moves by the shift\n//       frequency without ever resetting), §4.1 (allpass spectral delay in\n//       the path warps the notch spacing);\n//       S. Wardle, DAFx-98 §6 (stereo phaser from opposite SSB shifts);\n//       J. Kleimola, \"Dispersion Modulation using Allpass Filters\", DAFx-08\n//       paper 36 §2.3 (first-order allpass as frequency-dependent delay).\n// Parent: ai_freq_mod_phase_dist/barberpole_comb_ssb_flanger (4 stars),\n//         11_bode_ssb_freq_shifter (5 stars).\n//\n// Loop: v = x + fb * BP(SSB_shift(AP_warp(delay(v, T)))), wet = the\n// shifted path. BP = 20 Hz..7 kHz one-poles; the feedback is a soft tanh so\n// the loop cannot run away where the shifter is not exactly unity gain. T = comb_ratio f0 periods minus the loop's own phase delay at f0\n// (Hilbert real branch + warp allpasses, computed analytically) so the loop\n// resonates exactly on f0. Shift = cycles_per_bar * bar frequency (measured from in4).\n// Dry/wet: out = (1 - blend) dry + blend wet; 50 % is the classic phaser\n// sum. The barberpole motion IS the phase relation between the two.\n//\n// Inlets:\n//   in1 / in2: stereo tuba\n//   in3: f0 in Hz. > 0 = tracked pitch (clamped 20..1000 Hz);\n//        0 = disconnected -> fixed 55 Hz. No zero-crossing fallback.\n//   in4: 0..1 one-bar phasor (sets the shift rate). Held (no movement for\n//        100 ms) -> internal 2 s bar (120 BPM 4/4).\n//   in5: pitch confidence 0..1 (0 while the horn is silent, ~1 while\n//        playing). While it is low the comb tuning is held, so the tail keeps\n//        ringing on the last note. Never moved since load -> treated as 1.\n// Outlets:\n//   out1 / out2: stereo\n// No safety limiter, no metering.\n// ============================================================================\n\n// Barberpole cycles per bar (- = falling)\n@param({ min: -8, max: 8 }) cycles_per_bar = 2;\n// Comb delay in f0 periods\n@param({ min: 0.5, max: 4 }) comb_ratio = 3.414;\n// Loop feedback\n@param({ min: 0, max: 95 }) feedback = 88.72;\n// Notch warp (allpass dispersion)\n@param({ min: 0, max: 90 }) warp = 40;\n// Stereo width (100 = L up / R down)\n@param({ min: 0, max: 100 }) width = 2;\n// Dry/wet (50 = phaser sum)\n@param({ min: 0, max: 100 }) blend = 100;\n// Output gain\n@param({ min: -24, max: 12 }) out_gain_db = -4.5;\n\n@state f0Smooth = 55.0;\n@state f0Held = 55.0;\n\n@state prevBarIn = 0.0;\n@state barLast = 0.0;\n@state barHold = 0.0;\n@state barHzSm = 0.5;\n\n@state prevConfIn = 0.0;\n@state confSeen = 0.0;\n\n@state tSm = 872.0;\n@state thL = 0.0;\n@state thR = 0.0;\n\n@state bufL = new FixedSampleArray(32768);\n@state bufR = new FixedSampleArray(32768);\n@state wIdx: Int = 0;\n\n@state hpLoopL = new onepole();\n@state hpLoopR = new onepole();\n@state lpLoopL = new onepole();\n@state lpLoopR = new onepole();\n\n@state apX = new FixedSampleArray(2, 2);\n@state apY = new FixedSampleArray(2, 2);\n\n@state reX = new FixedSampleArray(2, 4);\n@state reY = new FixedSampleArray(2, 4);\n@state imX = new FixedSampleArray(2, 4);\n@state imY = new FixedSampleArray(2, 4);\n@state reDel = new FixedSampleArray(2);\n\n// Real branch of the 4-stage quadrature pair, plus one sample of delay to\n// line it up with the imaginary branch. y = c*(x + y1) - x1 per stage.\nfunction hilbRe(ch: Int, x: number): number {\n\tlet s = x;\n\tlet c = 0.0;\n\tfor (let i: Int = 0; i < 4; i++) {\n\t\tc = (i == 0) ? 0.4794008656 : ((i == 1) ? 0.8762184935 : ((i == 2) ? 0.9765975895 : 0.9974992559));\n\t\tlet y = c * (s + reY[ch][i]) - reX[ch][i];\n\t\treX[ch][i] = s;\n\t\treY[ch][i] = y;\n\t\ts = y;\n\t}\n\tlet out = reDel[ch];\n\treDel[ch] = s;\n\treturn out;\n}\n\n// Imaginary branch; this coefficient order gives the negative Hilbert, so negate.\nfunction hilbIm(ch: Int, x: number): number {\n\tlet s = x;\n\tlet c = 0.0;\n\tfor (let i: Int = 0; i < 4; i++) {\n\t\tc = (i == 0) ? 0.1617584983 : ((i == 1) ? 0.7330289323 : ((i == 2) ? 0.9453497003 : 0.9905991567));\n\t\tlet y = c * (s + imY[ch][i]) - imX[ch][i];\n\t\timX[ch][i] = s;\n\t\timY[ch][i] = y;\n\t\ts = y;\n\t}\n\treturn 0.0 - s;\n}\n\n// Two first-order allpasses H = (a + z^-1)/(1 + a z^-1) (spectral delay).\nfunction warpAp(ch: Int, x: number, a: number): number {\n\tlet s = x;\n\tfor (let i: Int = 0; i < 2; i++) {\n\t\tlet y = a * s + apX[ch][i] - a * apY[ch][i];\n\t\tapX[ch][i] = s;\n\t\tapY[ch][i] = y;\n\t\ts = y;\n\t}\n\treturn s;\n}\n\n// Cubic read d samples behind the write head; ch 0 = L, 1 = R.\nfunction readBack(ch: Int, d: number): number {\n\tlet pos = wIdx - d;\n\twhile (pos < 0.0) {\n\t\tpos += 32768.0;\n\t}\n\tlet i0: Int = trunc(pos);\n\tlet fr = pos - i0;\n\tlet im1: Int = (i0 + 32767) % 32768;\n\tlet ia: Int = i0 % 32768;\n\tlet ib: Int = (i0 + 1) % 32768;\n\tlet ic: Int = (i0 + 2) % 32768;\n\tlet y = 0.0;\n\tif (ch == 0) {\n\t\ty = cubicinterp(fr, bufL[im1], bufL[ia], bufL[ib], bufL[ic]);\n\t} else {\n\t\ty = cubicinterp(fr, bufR[im1], bufR[ia], bufR[ib], bufR[ic]);\n\t}\n\treturn y;\n}\n\n// Phase (rad) at w of (z^-1 - c)/(1 - c z^-1): continuous from 0 to -pi.\n// A Hilbert stage (c - z^-1)/(1 - c z^-1) is this times -1; the four sign\n// flips of the chain cancel, so the chain phase is the sum of these.\nfunction apPhase(c: number, w: number): number {\n\treturn atan2(0.0 - sin(w), cos(w) - c) - atan2(c * sin(w), 1.0 - c * cos(w));\n}\n\n// Phase (rad) at w of (a + z^-1)/(1 + a z^-1): continuous from 0 to -pi.\nfunction warpPhase(a: number, w: number): number {\n\treturn atan2(0.0 - sin(w), a + cos(w)) - atan2(0.0 - a * sin(w), 1.0 + a * cos(w));\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\nlet confIn = in5;\n\n// --- Confidence: 0 = silent horn; never moved = unpatched -> 1 ---------------\nif (abs(confIn - prevConfIn) > 0.0000001) {\n\tconfSeen = 1.0;\n}\nprevConfIn = confIn;\nlet confRaw = (confSeen > 0.5) ? clamp(confIn, 0.0, 1.0) : 1.0;\n\n// --- f0: in3 > 0 is the pitch; 0 = disconnected -> fixed 55 Hz; held while silent\nlet f0Target = (pitchIn > 0.0) ? clamp(pitchIn, 20.0, 1000.0) : 55.0;\nif (confRaw > 0.5) {\n\tf0Held = f0Target;\n}\nf0Smooth += (f0Held - f0Smooth) * (1.0 - exp(-1.0 / (0.004 * sr)));\nlet f0 = clamp(f0Smooth, 20.0, 1000.0);\n\n// --- Bar frequency: from in4's increment while it moves, else 0.5 Hz --------\nlet barInc = wrap(barIn - prevBarIn + 0.5, 0.0, 1.0) - 0.5;\nif (abs(barIn - prevBarIn) > 0.0000001) {\n\tbarLast = barIn;\n\tbarHold = 0.1 * sr;\n} else if (barHold > 0.0) {\n\tbarHold -= 1.0;\n}\nprevBarIn = barIn;\nlet barHzT = (barHold > 0.0) ? clamp(abs(barInc) * sr, 0.05, 8.0) : 0.5;\nbarHzSm += (barHzT - barHzSm) * (1.0 - exp(-1.0 / (0.25 * sr)));\n\n// --- Shift phases -------------------------------------------------------------\nlet shiftHz = clamp(cycles_per_bar, -8.0, 8.0) * barHzSm;\nlet wd = clamp(width, 0.0, 100.0) * 0.01;\nthL = wrap(thL + shiftHz / sr, 0.0, 1.0);\nthR = wrap(thR + shiftHz * (1.0 - 2.0 * wd) / sr, 0.0, 1.0);\n\n// --- Comb delay: comb_ratio periods minus the loop's phase delay at f0 ------\n// (the loop resonates where its total phase is a whole number of cycles)\nlet a = 0.0 - 0.9 * clamp(warp, 0.0, 90.0) * 0.01;\nlet w0 = 2.0 * pi * f0 / sr;\nlet phLoop = 0.0 - w0 + apPhase(0.4794008656, w0) + apPhase(0.8762184935, w0) + apPhase(0.9765975895, w0) + apPhase(0.9974992559, w0) + 2.0 * warpPhase(a, w0);\nlet period = sr / f0;\nlet tT = clamp(comb_ratio, 0.5, 4.0) * period + phLoop / w0;\n// a loop longer than the wanted delay: add whole periods (keeps f0 in tune)\nif (tT < 2.0) {\n\ttT += period * ceil((2.0 - tT) / period);\n}\ntT = clamp(tT, 2.0, 30000.0);\ntSm += (tT - tSm) * (1.0 - exp(-1.0 / (0.02 * sr)));\n\n// --- Loop -------------------------------------------------------------------\nlet fb = clamp(feedback, 0.0, 95.0) * 0.01;\nlet dL = warpAp(0, readBack(0, tSm), a);\nlet dR = warpAp(1, readBack(1, tSm), a);\nlet reL = hilbRe(0, dL);\nlet imL = hilbIm(0, dL);\nlet reR = hilbRe(1, dR);\nlet imR = hilbIm(1, dR);\nlet ssbL = reL * cos(2.0 * pi * thL) - imL * sin(2.0 * pi * thL);\nlet ssbR = reR * cos(2.0 * pi * thR) - imR * sin(2.0 * pi * thR);\n// Band-limit inside the loop: the Hilbert pair loses quadrature below\n// ~40 Hz and above a few kHz, where the rotation can exceed unity gain, and\n// each pass walks energy further out; the band edges also fade the\n// barberpole in and out (the Shepard part of the illusion).\nlet bpL = lpLoopL.next(ssbL - hpLoopL.next(ssbL, 20.0), 7000.0);\nlet bpR = lpLoopR.next(ssbR - hpLoopR.next(ssbR, 20.0), 7000.0);\nlet wetL = bpL;\nlet wetR = bpR;\n// soft feedback: linear for small signals, cannot run away\nbufL[wIdx] = xL + 1.5 * tanh(fb * wetL / 1.5);\nbufR[wIdx] = xR + 1.5 * tanh(fb * wetR / 1.5);\nwIdx = (wIdx + 1) % 32768;\n\n// --- Dry/wet ------------------------------------------------------------------\nlet b = clamp(blend, 0.0, 100.0) * 0.01;\nlet oL = linearinterp(b, xL, wetL);\nlet oR = linearinterp(b, xR, wetR);\n\n// --- Output gain (last stage) -----------------------------------------------\nlet outGain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = oL * outGain;\nout2 = oR * outGain;\n"
                                    },
