        "rect": [ 935.0, 131.0, 1065.0, 1132.0 ],
        "default_fontname": "Lato",
        "title": "switch_synth_fx",
        "boxes": [
            {
                "box": {
                    "id": "obj-22",
                    "maxclass": "newobj",
                    "numinlets": 6,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 2,
                            "revision": 1,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 1820.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "ai.vps_liquid_orbit",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// vps_liquid_orbit.txt — vector phaseshaping on the tuba's own phase, with the\n//                        inflection point orbiting a bar-synced Lissajous path\n//\n// From: J. Kleimola, V. Lazzarini, J. Timoney, V. Välimäki, \"Vector\n//       Phaseshaping Synthesis\", DAFx-11 §3 eq. 6 (phaseshaper p = (d, v)),\n//       §3.1 eqs. 8-10 (two-oscillator crossfade for non-integral formants),\n//       §4.3 (Lissajous modulation of the inflection vector);\n//       V. Lazzarini, J. Timoney, J. Pekonen, V. Välimäki, \"Adaptive Phase\n//       Distortion Synthesis\",\n//       DAFx-09 paper 12 (phase distortion driven by an external signal).\n//\n// The phaseshaper is applied to the tuba's phase ramp, so the voice is\n// pitch- and phase-locked to the horn by construction. p = (0.5, 0.5) is the\n// identity and gives exactly sin(2*pi*phase), the horn's fundamental; moving\n// p away from the centre adds harmonics/formants. The orbit of p is locked to\n// the bar (rate 1/4 .. 4 cycles per bar), giving a slow, liquid timbre motion.\n//\n// Inlets:\n//   in1 / in2: stereo tuba\n//   in3: f0 in Hz. > 0 = tracked pitch (clamped 20..1000 Hz);\n//        0 = disconnected -> fixed 55 Hz. No zero-crossing fallback.\n//   in4: 0..1 one-bar phasor. Held (no movement for 100 ms) -> internal\n//        2 s bar (120 BPM 4/4).\n//   in5: phase-locked tuba phasor 0..1 (the phase that gets shaped). Static ->\n//        internal ramp at f0, continued from the last tracked phase.\n//   in6: pitch confidence 0..1. Low confidence fades the voice back to the\n//        plain fundamental. Static -> treated as 1.\n// Outlets:\n//   out1 / out2: stereo (dry keeps its image, voice is centred)\n// No safety limiter, no metering.\n// ============================================================================\n\n// Inflection x (d)\n@param({ min: 0.05, max: 0.95 }) d = 0.653;\n// Inflection y (v): formant height\n@param({ min: 0.5, max: 4 }) v = 3.121;\n// Orbit depth\n@param({ min: 0, max: 100 }) orbit = 100;\n// Orbit rate: 1/4, 1/2, 1, 2, 3, 4 cycles per bar (snaps)\n@param({ min: 0.25, max: 4 }) orbit_per_bar = 1;\n// Lissajous ratio (v axis turns this many times per d-axis turn)\n@param({ min: 1, max: 4 }) lissajous_ratio = 2;\n// Tone (2-pole lowpass)\n@param({ min: 200, max: 12000 }) tone_hz = 7000;\n// Wet\n@param({ min: 0, max: 100 }) wet = 100;\n// Output gain\n@param({ min: -24, max: 12 }) out_gain_db = 0;\n\n@state f0Smooth = 55.0;\n\n@state prevBarIn = 0.0;\n@state barLast = 0.0;\n@state barHold = 0.0;\n@state freeBar = 0.0;\n@state prevBarPh = 0.0;\n@state barCount = 0.0;\n\n@state prevPhIn = 0.0;\n@state phHold = 0.0;\n@state ownPh = 0.0;\n\n@state prevConfIn = 0.0;\n@state confHold = 0.0;\n\n@state envInt = 0.0;\n@state lp1 = new onepole();\n@state lp2 = new onepole();\n\n// VPS phaseshaper (DAFx-11 eq. 6), output cos(2*pi*P) with the -1 sign of\n// eq. 1 folded into a quarter-cycle input offset (see main code).\nfunction vps(x: number, dd: number, vv: number): number {\n\tlet pp = 0.0;\n\tif (x < dd) {\n\t\tpp = vv * x / dd;\n\t} else {\n\t\tpp = (1.0 - vv) * (x - dd) / (1.0 - dd) + vv;\n\t}\n\treturn 0.0 - cos(2.0 * pi * pp);\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\nlet phIn = in5;\nlet confIn = in6;\n\n// --- f0: in3 > 0 is the pitch; 0 = disconnected -> fixed 55 Hz --------------\nlet f0Target = (pitchIn > 0.0) ? clamp(pitchIn, 20.0, 1000.0) : 55.0;\nf0Smooth += (f0Target - f0Smooth) * (1.0 - exp(-1.0 / (0.004 * sr)));\nlet inc = clamp(f0Smooth, 20.0, 1000.0) / sr;\n\n// --- Bar phase: hold-latched in4, else internal 2 s bar; 4-bar position -----\nif (abs(barIn - prevBarIn) > 0.0000001) {\n\tbarLast = barIn;\n\tbarHold = 0.1 * sr;\n} else if (barHold > 0.0) {\n\tbarHold -= 1.0;\n}\nprevBarIn = barIn;\nfreeBar = wrap(freeBar + 0.5 / sr, 0.0, 1.0);\nlet barPh = (barHold > 0.0) ? wrap(barLast, 0.0, 1.0) : freeBar;\nif (barPh < prevBarPh - 0.5) {\n\tbarCount += 1.0;\n\tif (barCount >= 4.0) {\n\t\tbarCount = 0.0;\n\t}\n}\nprevBarPh = barPh;\nlet pos4 = barCount + barPh;\n\n// --- Tuba phase: in5 while it moves, else continue it at f0 -----------------\nif (abs(phIn - prevPhIn) > 0.0000001) {\n\tphHold = 0.1 * sr;\n} else if (phHold > 0.0) {\n\tphHold -= 1.0;\n}\nprevPhIn = phIn;\nif (phHold > 0.0) {\n\townPh = wrap(phIn, 0.0, 1.0);\n} else {\n\townPh = wrap(ownPh + inc, 0.0, 1.0);\n}\n\n// --- Confidence: in6 while it moves, else 1 ---------------------------------\nif (abs(confIn - prevConfIn) > 0.0000001) {\n\tconfHold = 0.1 * sr;\n} else if (confHold > 0.0) {\n\tconfHold -= 1.0;\n}\nprevConfIn = confIn;\nlet conf = (confHold > 0.0) ? clamp(confIn, 0.0, 1.0) : 1.0;\n\n// --- Internal envelope gate (quiet when the horn is quiet) -----------------\nlet absMono = 0.5 * (abs(xL) + abs(xR));\nlet atk = 1.0 - exp(-1.0 / (0.003 * sr));\nlet rel = 1.0 - exp(-1.0 / (0.080 * sr));\nenvInt += (absMono - envInt) * ((absMono > envInt) ? atk : rel);\nlet gate = clamp(sqrt(maximum(envInt, 0.0)) * 1.6, 0.0, 1.0);\n\n// --- Bar-locked Lissajous orbit of p = (d, v) (DAFx-11 §4.3) ---------------\nlet opb = clamp(orbit_per_bar, 0.25, 4.0);\nlet rate = 4.0;\nif (opb < 0.375) {\n\trate = 0.25;\n} else if (opb < 0.75) {\n\trate = 0.5;\n} else if (opb < 1.5) {\n\trate = 1.0;\n} else if (opb < 2.5) {\n\trate = 2.0;\n} else if (opb < 3.5) {\n\trate = 3.0;\n}\nlet theta = wrap(pos4 * rate, 0.0, 1.0);\nlet lr = round(clamp(lissajous_ratio, 1.0, 4.0));\nlet od = clamp(orbit, 0.0, 100.0) * 0.01;\nlet dNow = clamp(d + od * 0.35 * cos(2.0 * pi * theta), 0.02, 0.98);\nlet vNow = clamp(v + od * 1.5 * sin(2.0 * pi * wrap(lr * theta, 0.0, 1.0)), 0.5, 4.5);\n\n// --- Two-oscillator crossfade on the half-integer v grid (eqs. 9-10) -------\nlet twoV = 2.0 * vNow;\nlet vLo = floor(twoV) * 0.5;\nlet aMix = twoV - floor(twoV);\n// quarter-cycle offset: vps(.., 0.5, 0.5) = -cos(2pi(ph + 0.25)) = sin(2pi ph)\nlet shPh = wrap(ownPh + 0.25, 0.0, 1.0);\nlet s1 = vps(shPh, dNow, vLo);\nlet s2 = vps(shPh, dNow, vLo + 0.5);\nlet vpsOut = (1.0 - aMix) * s1 + aMix * s2;\n\n// --- Confidence fades back to the bare fundamental --------------------------\nlet fund = sin(2.0 * pi * ownPh);\nlet voice = linearinterp(conf, fund, vpsOut);\nlet tone = clamp(tone_hz, 200.0, minimum(12000.0, sr * 0.45));\nlet voiceF = lp2.next(lp1.next(voice, tone), tone) * gate * 0.7;\n\n// --- Wet: phase-locked crossfade (voice fundamental is in phase with in5) ---\nlet w = clamp(wet, 0.0, 100.0) * 0.01;\nlet outGain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = linearinterp(w, xL, voiceF) * outGain;\nout2 = linearinterp(w, xR, voiceF) * outGain;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 6,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "nocache": 0,
                                        "expr": "",
                                        "safemath": 1,
                                        "code": "// ============================================================================\n// vps_liquid_orbit.txt — vector phaseshaping on the tuba's own phase, with the\n//                        inflection point orbiting a bar-synced Lissajous path\n//\n// From: J. Kleimola, V. Lazzarini, J. Timoney, V. Välimäki, \"Vector\n//       Phaseshaping Synthesis\", DAFx-11 §3 eq. 6 (phaseshaper p = (d, v)),\n//       §3.1 eqs. 8-10 (two-oscillator crossfade for non-integral formants),\n//       §4.3 (Lissajous modulation of the inflection vector);\n//       V. Lazzarini, J. Timoney, J. Pekonen, V. Välimäki, \"Adaptive Phase\n//       Distortion Synthesis\",\n//       DAFx-09 paper 12 (phase distortion driven by an external signal).\n//\n// The phaseshaper is applied to the tuba's phase ramp, so the voice is\n// pitch- and phase-locked to the horn by construction. p = (0.5, 0.5) is the\n// identity and gives exactly sin(2*pi*phase), the horn's fundamental; moving\n// p away from the centre adds harmonics/formants. The orbit of p is locked to\n// the bar (rate 1/4 .. 4 cycles per bar), giving a slow, liquid timbre motion.\n//\n// Inlets:\n//   in1 / in2: stereo tuba\n//   in3: f0 in Hz. > 0 = tracked pitch (clamped 20..1000 Hz);\n//        0 = disconnected -> fixed 55 Hz. No zero-crossing fallback.\n//   in4: 0..1 one-bar phasor. Held (no movement for 100 ms) -> internal\n//        2 s bar (120 BPM 4/4).\n//   in5: phase-locked tuba phasor 0..1 (the phase that gets shaped). Static ->\n//        internal ramp at f0, continued from the last tracked phase.\n//   in6: pitch confidence 0..1. Low confidence fades the voice back to the\n//        plain fundamental. Static -> treated as 1.\n// Outlets:\n//   out1 / out2: stereo (dry keeps its image, voice is centred)\n// No safety limiter, no metering.\n// ============================================================================\n\n// Inflection x (d)\n@param({ min: 0.05, max: 0.95 }) d = 0.653;\n// Inflection y (v): formant height\n@param({ min: 0.5, max: 4 }) v = 3.121;\n// Orbit depth\n@param({ min: 0, max: 100 }) orbit = 100;\n// Orbit rate: 1/4, 1/2, 1, 2, 3, 4 cycles per bar (snaps)\n@param({ min: 0.25, max: 4 }) orbit_per_bar = 1;\n// Lissajous ratio (v axis turns this many times per d-axis turn)\n@param({ min: 1, max: 4 }) lissajous_ratio = 2;\n// Tone (2-pole lowpass)\n@param({ min: 200, max: 12000 }) tone_hz = 7000;\n// Wet\n@param({ min: 0, max: 100 }) wet = 100;\n// Output gain\n@param({ min: -24, max: 12 }) out_gain_db = 0;\n\n@state f0Smooth = 55.0;\n\n@state prevBarIn = 0.0;\n@state barLast = 0.0;\n@state barHold = 0.0;\n@state freeBar = 0.0;\n@state prevBarPh = 0.0;\n@state barCount = 0.0;\n\n@state prevPhIn = 0.0;\n@state phHold = 0.0;\n@state ownPh = 0.0;\n\n@state prevConfIn = 0.0;\n@state confHold = 0.0;\n\n@state envInt = 0.0;\n@state lp1 = new onepole();\n@state lp2 = new onepole();\n\n// VPS phaseshaper (DAFx-11 eq. 6), output cos(2*pi*P) with the -1 sign of\n// eq. 1 folded into a quarter-cycle input offset (see main code).\nfunction vps(x: number, dd: number, vv: number): number {\n\tlet pp = 0.0;\n\tif (x < dd) {\n\t\tpp = vv * x / dd;\n\t} else {\n\t\tpp = (1.0 - vv) * (x - dd) / (1.0 - dd) + vv;\n\t}\n\treturn 0.0 - cos(2.0 * pi * pp);\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\nlet phIn = in5;\nlet confIn = in6;\n\n// --- f0: in3 > 0 is the pitch; 0 = disconnected -> fixed 55 Hz --------------\nlet f0Target = (pitchIn > 0.0) ? clamp(pitchIn, 20.0, 1000.0) : 55.0;\nf0Smooth += (f0Target - f0Smooth) * (1.0 - exp(-1.0 / (0.004 * sr)));\nlet inc = clamp(f0Smooth, 20.0, 1000.0) / sr;\n\n// --- Bar phase: hold-latched in4, else internal 2 s bar; 4-bar position -----\nif (abs(barIn - prevBarIn) > 0.0000001) {\n\tbarLast = barIn;\n\tbarHold = 0.1 * sr;\n} else if (barHold > 0.0) {\n\tbarHold -= 1.0;\n}\nprevBarIn = barIn;\nfreeBar = wrap(freeBar + 0.5 / sr, 0.0, 1.0);\nlet barPh = (barHold > 0.0) ? wrap(barLast, 0.0, 1.0) : freeBar;\nif (barPh < prevBarPh - 0.5) {\n\tbarCount += 1.0;\n\tif (barCount >= 4.0) {\n\t\tbarCount = 0.0;\n\t}\n}\nprevBarPh = barPh;\nlet pos4 = barCount + barPh;\n\n// --- Tuba phase: in5 while it moves, else continue it at f0 -----------------\nif (abs(phIn - prevPhIn) > 0.0000001) {\n\tphHold = 0.1 * sr;\n} else if (phHold > 0.0) {\n\tphHold -= 1.0;\n}\nprevPhIn = phIn;\nif (phHold > 0.0) {\n\townPh = wrap(phIn, 0.0, 1.0);\n} else {\n\townPh = wrap(ownPh + inc, 0.0, 1.0);\n}\n\n// --- Confidence: in6 while it moves, else 1 ---------------------------------\nif (abs(confIn - prevConfIn) > 0.0000001) {\n\tconfHold = 0.1 * sr;\n} else if (confHold > 0.0) {\n\tconfHold -= 1.0;\n}\nprevConfIn = confIn;\nlet conf = (confHold > 0.0) ? clamp(confIn, 0.0, 1.0) : 1.0;\n\n// --- Internal envelope gate (quiet when the horn is quiet) -----------------\nlet absMono = 0.5 * (abs(xL) + abs(xR));\nlet atk = 1.0 - exp(-1.0 / (0.003 * sr));\nlet rel = 1.0 - exp(-1.0 / (0.080 * sr));\nenvInt += (absMono - envInt) * ((absMono > envInt) ? atk : rel);\nlet gate = clamp(sqrt(maximum(envInt, 0.0)) * 1.6, 0.0, 1.0);\n\n// --- Bar-locked Lissajous orbit of p = (d, v) (DAFx-11 §4.3) ---------------\nlet opb = clamp(orbit_per_bar, 0.25, 4.0);\nlet rate = 4.0;\nif (opb < 0.375) {\n\trate = 0.25;\n} else if (opb < 0.75) {\n\trate = 0.5;\n} else if (opb < 1.5) {\n\trate = 1.0;\n} else if (opb < 2.5) {\n\trate = 2.0;\n} else if (opb < 3.5) {\n\trate = 3.0;\n}\nlet theta = wrap(pos4 * rate, 0.0, 1.0);\nlet lr = round(clamp(lissajous_ratio, 1.0, 4.0));\nlet od = clamp(orbit, 0.0, 100.0) * 0.01;\nlet dNow = clamp(d + od * 0.35 * cos(2.0 * pi * theta), 0.02, 0.98);\nlet vNow = clamp(v + od * 1.5 * sin(2.0 * pi * wrap(lr * theta, 0.0, 1.0)), 0.5, 4.5);\n\n// --- Two-oscillator crossfade on the half-integer v grid (eqs. 9-10) -------\nlet twoV = 2.0 * vNow;\nlet vLo = floor(twoV) * 0.5;\nlet aMix = twoV - floor(twoV);\n// quarter-cycle offset: vps(.., 0.5, 0.5) = -cos(2pi(ph + 0.25)) = sin(2pi ph)\nlet shPh = wrap(ownPh + 0.25, 0.0, 1.0);\nlet s1 = vps(shPh, dNow, vLo);\nlet s2 = vps(shPh, dNow, vLo + 0.5);\nlet vpsOut = (1.0 - aMix) * s1 + aMix * s2;\n\n// --- Confidence fades back to the bare fundamental --------------------------\nlet fund = sin(2.0 * pi * ownPh);\nlet voice = linearinterp(conf, fund, vpsOut);\nlet tone = clamp(tone_hz, 200.0, minimum(12000.0, sr * 0.45));\nlet voiceF = lp2.next(lp1.next(voice, tone), tone) * gate * 0.7;\n\n// --- Wet: phase-locked crossfade (voice fundamental is in phase with in5) ---\nlet w = clamp(wet, 0.0, 100.0) * 0.01;\nlet outGain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = linearinterp(w, xL, voiceF) * outGain;\nout2 = linearinterp(w, xR, voiceF) * outGain;\n"
                                    },
