            {
                "box": {
                    "id": "obj-14",
                    "maxclass": "newobj",
                    "numinlets": 4,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 2,
                            "revision": 1,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 1879.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "ai.flanger_through_zero_jet",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// flanger_through_zero_jet.txt\n// Through-zero flanger: two taps swept symmetrically through the zero point.\n// From: Antti Huovilainen, \"Enhanced Digital Models for Analog Modulation\n//       Effects\", DAFx-05, 2005_P_155, §1.1 (fractional-delay flanger as a\n//       time-varying comb, feedback turns the FIR comb into an IIR comb) and\n//       §4 (delay-time warping / loop behaviour); structure after the flanger\n//       block of Esqueda, Välimäki & Parker, \"Barberpole Phasing and Flanging\n//       Illusions\", DAFx-15, 2015_DAFx-15_submission_67, Fig. 6;\n//       fractional-delay choice after Nam & Välimäki, DAFx-09 paper 72, §2.1\n//       (cubicinterp is 3rd-order Lagrange: FIR, no Thiran allpass\n//       dispersion; slight HF droop at half-sample positions).\n//\n// Two taps sit at c -/+ s around a centre delay c = 0.15 ms + base, so their\n// relative delay is 2s. In a true through-zero flanger the moving tap passes\n// the reference, so the relative delay crosses zero with full slope and |2s|\n// makes a sharp V-shaped bounce there - the notches slam up to Nyquist and\n// straight back, the \"jet\". Because the two taps are summed equally, swapping\n// them is inaudible, so s = base * sin(pi * p) (>= 0, continuous across the\n// phase wrap, a V-kink at p = 0) is exactly that crossing, once per cycle.\n// (A raised sine 0.5 + 0.5 sin only *touches* zero with zero slope - an\n// ordinary flanger reaching 0 ms, not through-zero.) Neither tap is ever\n// instantaneous (the 0.15 ms floor keeps the output off the dry path), so this\n// file is 100 % wet with no dry term at all.\n// ============================================================================\n// Inlets:\n//   in1 / in2: stereo audio\n//   in3: bound only - this sweep is time-based, not pitch-locked\n//        (use flanger_enharmonic_diesis / phaser_harmonic_track for f0 lock)\n//   in4: 0..1 one-bar phasor (exception to the Hz contract) - while it moves\n//        the sweep runs one full cycle per bar (zero crossing on the downbeat)\n//        and sweep_rate_hz is ignored; held constant (or unconnected) the\n//        sweep free-runs at sweep_rate_hz\n// Outlets:\n//   out1 / out2: stereo, wet only\n// No dry/wet control, no limiter, no metering.\n// ============================================================================\n\n@param({ min: 0.05, max: 12 }) sweep_ms = 10.10;      // sweep span\n@param({ min: 0.02, max: 2 }) sweep_rate_hz = 0.1; // sweep rate\n@param({ min: -0.95, max: 0.95 }) feedback = -0.9; // feedback\n@param({ min: 0, max: 1 }) stereo_offset = 1.0;    // stereo offset\n@param({ min: 800, max: 14000 }) tone_hz = 8000;    // loop damping\n@param({ min: -24, max: 12 }) out_gain_db = 0;      // output gain\n\n@state bufL = new FixedSampleArray(4096);\n@state bufR = new FixedSampleArray(4096);\n@state wi: Int = 0;\n\n@state dampL = 0.0;\n@state dampR = 0.0;\n\n@state phF = 0.0;\n@state phOff = 0.0;\n@state prevBarIn = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet unused_in3 = in3;  // keeps the in3 port present; this sweep is not pitch-locked\nlet barIn = in4;\n\n// --- Sweep phase -----------------------------------------------------------\n// The bar phase is carried as an offset against a free-running phase, so a\n// moving phasor takes over exactly and a stopped one hands back with no jump.\nlet rate = clamp(sweep_rate_hz, 0.02, 2.0);\nphF = wrap(phF + rate / sr, 0.0, 1.0);\nif (abs(barIn - prevBarIn) > 0.0000001) {\n\tphOff = wrap(barIn - phF, 0.0, 1.0);\n}\nprevBarIn = barIn;\n\nlet offR = clamp(stereo_offset, 0.0, 1.0) * 0.5;\nlet pL = wrap(phF + phOff, 0.0, 1.0);\nlet pR = wrap(pL + offR, 0.0, 1.0);\n\n// --- Delay geometry --------------------------------------------------------\n// centre c = dmin + base, half-spread s = base * sin(pi * p) in 0 .. base\nlet base = clamp(mstosamps(clamp(sweep_ms, 0.05, 12.0)), 2.0, 1600.0);\nlet dminS = maximum(mstosamps(0.15), 1.0);\nlet centre = dminS + base;\n\nlet spreadL = base * sin(pi * pL);\nlet dAL = centre - spreadL;\nlet dBL = centre + spreadL;\n\nlet spreadR = base * sin(pi * pR);\nlet dAR = centre - spreadR;\nlet dBR = centre + spreadR;\n\nlet fbAmt = clamp(feedback, -0.95, 0.95);\nlet dampF = clamp(tone_hz, 200.0, sr * 0.45);\nlet dampC = 1.0 - exp(0.0 - 2.0 * pi * dampF / sr);\n\n// --- Left channel: write input + damped feedback, read the two swept taps ----\nbufL[wi] = xL + fbAmt * dampL;\n\nlet rAL = wi - dAL;\nwhile (rAL < 0.0) { rAL += 4096.0; }\nlet qAL: Int = floor(rAL);\nlet tapAL = cubicinterp(rAL - qAL,\n\tbufL[(qAL - 1 + 4096) & 4095],\n\tbufL[qAL & 4095],\n\tbufL[(qAL + 1) & 4095],\n\tbufL[(qAL + 2) & 4095]);\n\nlet rBL = wi - dBL;\nwhile (rBL < 0.0) { rBL += 4096.0; }\nlet qBL: Int = floor(rBL);\nlet tapBL = cubicinterp(rBL - qBL,\n\tbufL[(qBL - 1 + 4096) & 4095],\n\tbufL[qBL & 4095],\n\tbufL[(qBL + 1) & 4095],\n\tbufL[(qBL + 2) & 4095]);\n\nlet yL = 0.5 * (tapAL + tapBL);\ndampL = dampL + dampC * (yL - dampL);\n\n// --- Right channel ---------------------------------------------------------\nbufR[wi] = xR + fbAmt * dampR;\n\nlet rAR = wi - dAR;\nwhile (rAR < 0.0) { rAR += 4096.0; }\nlet qAR: Int = floor(rAR);\nlet tapAR = cubicinterp(rAR - qAR,\n\tbufR[(qAR - 1 + 4096) & 4095],\n\tbufR[qAR & 4095],\n\tbufR[(qAR + 1) & 4095],\n\tbufR[(qAR + 2) & 4095]);\n\nlet rBR = wi - dBR;\nwhile (rBR < 0.0) { rBR += 4096.0; }\nlet qBR: Int = floor(rBR);\nlet tapBR = cubicinterp(rBR - qBR,\n\tbufR[(qBR - 1 + 4096) & 4095],\n\tbufR[qBR & 4095],\n\tbufR[(qBR + 1) & 4095],\n\tbufR[(qBR + 2) & 4095]);\n\nlet yR = 0.5 * (tapAR + tapBR);\ndampR = dampR + dampC * (yR - dampR);\n\nwi = (wi + 1) & 4095;\n\nlet gain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = yL * gain;\nout2 = yR * gain;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "nocache": 0,
                                        "expr": "",
                                        "safemath": 1,
                                        "code": "// ============================================================================\n// flanger_through_zero_jet.txt\n// Through-zero flanger: two taps swept symmetrically through the zero point.\n// From: Antti Huovilainen, \"Enhanced Digital Models for Analog Modulation\n//       Effects\", DAFx-05, 2005_P_155, §1.1 (fractional-delay flanger as a\n//       time-varying comb, feedback turns the FIR comb into an IIR comb) and\n//       §4 (delay-time warping / loop behaviour); structure after the flanger\n//       block of Esqueda, Välimäki & Parker, \"Barberpole Phasing and Flanging\n//       Illusions\", DAFx-15, 2015_DAFx-15_submission_67, Fig. 6;\n//       fractional-delay choice after Nam & Välimäki, DAFx-09 paper 72, §2.1\n//       (cubicinterp is 3rd-order Lagrange: FIR, no Thiran allpass\n//       dispersion; slight HF droop at half-sample positions).\n//\n// Two taps sit at c -/+ s around a centre delay c = 0.15 ms + base, so their\n// relative delay is 2s. In a true through-zero flanger the moving tap passes\n// the reference, so the relative delay crosses zero with full slope and |2s|\n// makes a sharp V-shaped bounce there - the notches slam up to Nyquist and\n// straight back, the \"jet\". Because the two taps are summed equally, swapping\n// them is inaudible, so s = base * sin(pi * p) (>= 0, continuous across the\n// phase wrap, a V-kink at p = 0) is exactly that crossing, once per cycle.\n// (A raised sine 0.5 + 0.5 sin only *touches* zero with zero slope - an\n// ordinary flanger reaching 0 ms, not through-zero.) Neither tap is ever\n// instantaneous (the 0.15 ms floor keeps the output off the dry path), so this\n// file is 100 % wet with no dry term at all.\n// ============================================================================\n// Inlets:\n//   in1 / in2: stereo audio\n//   in3: bound only - this sweep is time-based, not pitch-locked\n//        (use flanger_enharmonic_diesis / phaser_harmonic_track for f0 lock)\n//   in4: 0..1 one-bar phasor (exception to the Hz contract) - while it moves\n//        the sweep runs one full cycle per bar (zero crossing on the downbeat)\n//        and sweep_rate_hz is ignored; held constant (or unconnected) the\n//        sweep free-runs at sweep_rate_hz\n// Outlets:\n//   out1 / out2: stereo, wet only\n// No dry/wet control, no limiter, no metering.\n// ============================================================================\n\n@param({ min: 0.05, max: 12 }) sweep_ms = 10.10;      // sweep span\n@param({ min: 0.02, max: 2 }) sweep_rate_hz = 0.1; // sweep rate\n@param({ min: -0.95, max: 0.95 }) feedback = -0.9; // feedback\n@param({ min: 0, max: 1 }) stereo_offset = 1.0;    // stereo offset\n@param({ min: 800, max: 14000 }) tone_hz = 8000;    // loop damping\n@param({ min: -24, max: 12 }) out_gain_db = 0;      // output gain\n\n@state bufL = new FixedSampleArray(4096);\n@state bufR = new FixedSampleArray(4096);\n@state wi: Int = 0;\n\n@state dampL = 0.0;\n@state dampR = 0.0;\n\n@state phF = 0.0;\n@state phOff = 0.0;\n@state prevBarIn = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet unused_in3 = in3;  // keeps the in3 port present; this sweep is not pitch-locked\nlet barIn = in4;\n\n// --- Sweep phase -----------------------------------------------------------\n// The bar phase is carried as an offset against a free-running phase, so a\n// moving phasor takes over exactly and a stopped one hands back with no jump.\nlet rate = clamp(sweep_rate_hz, 0.02, 2.0);\nphF = wrap(phF + rate / sr, 0.0, 1.0);\nif (abs(barIn - prevBarIn) > 0.0000001) {\n\tphOff = wrap(barIn - phF, 0.0, 1.0);\n}\nprevBarIn = barIn;\n\nlet offR = clamp(stereo_offset, 0.0, 1.0) * 0.5;\nlet pL = wrap(phF + phOff, 0.0, 1.0);\nlet pR = wrap(pL + offR, 0.0, 1.0);\n\n// --- Delay geometry --------------------------------------------------------\n// centre c = dmin + base, half-spread s = base * sin(pi * p) in 0 .. base\nlet base = clamp(mstosamps(clamp(sweep_ms, 0.05, 12.0)), 2.0, 1600.0);\nlet dminS = maximum(mstosamps(0.15), 1.0);\nlet centre = dminS + base;\n\nlet spreadL = base * sin(pi * pL);\nlet dAL = centre - spreadL;\nlet dBL = centre + spreadL;\n\nlet spreadR = base * sin(pi * pR);\nlet dAR = centre - spreadR;\nlet dBR = centre + spreadR;\n\nlet fbAmt = clamp(feedback, -0.95, 0.95);\nlet dampF = clamp(tone_hz, 200.0, sr * 0.45);\nlet dampC = 1.0 - exp(0.0 - 2.0 * pi * dampF / sr);\n\n// --- Left channel: write input + damped feedback, read the two swept taps ----\nbufL[wi] = xL + fbAmt * dampL;\n\nlet rAL = wi - dAL;\nwhile (rAL < 0.0) { rAL += 4096.0; }\nlet qAL: Int = floor(rAL);\nlet tapAL = cubicinterp(rAL - qAL,\n\tbufL[(qAL - 1 + 4096) & 4095],\n\tbufL[qAL & 4095],\n\tbufL[(qAL + 1) & 4095],\n\tbufL[(qAL + 2) & 4095]);\n\nlet rBL = wi - dBL;\nwhile (rBL < 0.0) { rBL += 4096.0; }\nlet qBL: Int = floor(rBL);\nlet tapBL = cubicinterp(rBL - qBL,\n\tbufL[(qBL - 1 + 4096) & 4095],\n\tbufL[qBL & 4095],\n\tbufL[(qBL + 1) & 4095],\n\tbufL[(qBL + 2) & 4095]);\n\nlet yL = 0.5 * (tapAL + tapBL);\ndampL = dampL + dampC * (yL - dampL);\n\n// --- Right channel ---------------------------------------------------------\nbufR[wi] = xR + fbAmt * dampR;\n\nlet rAR = wi - dAR;\nwhile (rAR < 0.0) { rAR += 4096.0; }\nlet qAR: Int = floor(rAR);\nlet tapAR = cubicinterp(rAR - qAR,\n\tbufR[(qAR - 1 + 4096) & 4095],\n\tbufR[qAR & 4095],\n\tbufR[(qAR + 1) & 4095],\n\tbufR[(qAR + 2) & 4095]);\n\nlet rBR = wi - dBR;\nwhile (rBR < 0.0) { rBR += 4096.0; }\nlet qBR: Int = floor(rBR);\nlet tapBR = cubicinterp(rBR - qBR,\n\tbufR[(qBR - 1 + 4096) & 4095],\n\tbufR[qBR & 4095],\n\tbufR[(qBR + 1) & 4095],\n\tbufR[(qBR + 2) & 4095]);\n\nlet yR = 0.5 * (tapAR + tapBR);\ndampR = dampR + dampC * (yR - dampR);\n\nwi = (wi + 1) & 4095;\n\nlet gain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = yL * gain;\nout2 = yR * gain;\n"
                                    },
                                    "rnbo_serial": 4,
                                    "rnbo_uniqueid": "effect_code",
                                    "rnboinfo": {
                                        "needsInstanceInfo": 1,
                                        "argnames": {
                                            "reset": {
                                                "attrOrProp": 1,
