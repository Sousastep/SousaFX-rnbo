            {
                "box": {
                    "id": "obj-20",
                    "maxclass": "newobj",
                    "numinlets": 5,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 2,
                            "revision": 1,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 1743.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "ai.reese_liquid_5limit",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// reese_liquid_5limit.txt — phase-locked 5-limit Reese stack at the tuba's f0\n//\n// From: J. Timoney, \"Examining the Oscillator Waveform Animation Effect\",\n//       DAFx-14 (a bank of slightly detuned oscillators is the classic\n//       oscillator-animation / supersaw voice); W. E. Weingartner, \"Stable\n//       Limit Cycles as Tunable Signal Sources\", DAFx-25 paper 68, §supersaw\n//       (multi-saw chorus, detuned saw oscillator bank).\n//\n// Three band-limited saws share one phase ramp locked to the tuba's pitch.\n// Voice 1 is the unison core (phase-locked to in5 when it moves), voices 2 and\n// 3 sit at a 5-limit comma ratio and its square — 81/80, 128/125, 25/24 or\n// 16/15 — so the beating is a just-intonation comma beat, never an equal-\n// tempered detune. Motion opens the two-pole tone filter from the bar phasor\n// (or a slow free LFO when in4 is held at 0).\n//\n// Inlets:\n//   in1 / in2: stereo tuba\n//   in3: f0 in Hz. 0 = unknown -> hold last valid f0 (init 55 Hz).\n//        No zero-crossing fallback.\n//   in4: 0..1 one-bar phasor. Held 0 -> free 0.12 Hz LFO, still usable.\n//   in5: optional phase-locked tuba phasor 0..1. Used only as a gentle phase\n//        reference when it moves; unpatched / static -> f0 integration alone.\n// Outlets:\n//   out1 / out2: stereo, wet only at mix = 1\n// No safety limiter, no metering.\n// ============================================================================\n\n@param({ min: 0, max: 100 }) detune = 20;             // detune (5-limit comma)\n@param({ min: 0, max: 1 }) motion = 0.35;             // liquid motion\n@param({ min: 200, max: 12000 }) tone_hz = 7000;      // tone\n@param({ min: 0, max: 200 }) glide_ms = 9;           // glide\n@param({ min: 0, max: 1 }) stereo = 0.4;              // stereo spread\n@param({ min: 0, max: 1 }) mix = 1;                   // dry/wet\n@param({ min: -24, max: 12 }) out_gain_db = 0;        // output gain\n\n@state phBase = 0.0;\n@state phV2 = 0.0;\n@state phV3 = 0.0;\n@state f0Hold = 55.0;\n@state f0Smooth = 55.0;\n@state env = 0.0;\n\n@state lp1L = new onepole();\n@state lp2L = new onepole();\n@state lp1R = new onepole();\n@state lp2R = new onepole();\n\n@state freeLfo = new phasor();\n@state prevBarIn = 0.0;\n@state barLast = 0.0;\n@state barHold = 0.0;\n\n@state prevPhasorIn = 0.0;\n@state phasorLast = 0.0;\n@state phasorHold = 0.0;\n\n// Band-limited saw: naive ramp minus the polyBLEP correction at each jump.\nfunction polyBlep(t: number, dt: number): number {\n\tif (t < dt) {\n\t\tlet x = t / dt;\n\t\treturn x + x - x * x - 1.0;\n\t}\n\tif (t > 1.0 - dt) {\n\t\tlet x = (t - 1.0) / dt;\n\t\treturn x * x + x + x + 1.0;\n\t}\n\treturn 0.0;\n}\n\nfunction sawAt(phase01: number, inc: number): number {\n\treturn 2.0 * phase01 - 1.0 - polyBlep(phase01, inc);\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\nlet phasorIn = in5;\n\n// --- Pitch: hold the last valid f0, never read 0 as 1 Hz --------------------\nif (pitchIn > 15.0 && pitchIn < 1200.0) {\n\tf0Hold = pitchIn;\n}\nlet glideS = maximum(clamp(glide_ms, 0.0, 200.0) * 0.001, 0.001);\nlet slew = 1.0 - exp(0.0 - 1.0 / (glideS * sr));\nf0Smooth += (clamp(f0Hold, 15.0, 1200.0) - f0Smooth) * slew;\nlet f0 = clamp(f0Smooth, 15.0, 900.0);\n\n// --- 5-limit detune: nearest comma ratio, never an ET interval --------------\nlet det = clamp(detune, 0.0, 100.0);\nlet detRatio = 1.0;\nif (det >= 10.75 && det < 31.3) {\n\tdetRatio = 81.0 / 80.0;      // syntonic comma, 21.5 cents\n} else if (det >= 31.3 && det < 55.9) {\n\tdetRatio = 128.0 / 125.0;    // lesser diesis, 41.1 cents\n} else if (det >= 55.9 && det < 91.2) {\n\tdetRatio = 25.0 / 24.0;      // just chromatic semitone, 70.7 cents\n} else if (det >= 91.2) {\n\tdetRatio = 16.0 / 15.0;      // just diatonic semitone, 111.7 cents\n}\nlet detRatio2 = detRatio * detRatio;\n\n// --- Phase ramps: voice 1 is the coherent core, 2/3 drift by the comma -------\nlet incBase = f0 / sr;\nphBase = wrap(phBase + incBase, 0.0, 1.0);\nphV2 = wrap(phV2 + incBase * detRatio, 0.0, 1.0);\nphV3 = wrap(phV3 + incBase * detRatio2, 0.0, 1.0);\n\n// Gentle phase lock of the core to the tracker's phasor, only while it moves.\nif (abs(phasorIn - prevPhasorIn) > 0.0000001) {\n\tphasorLast = phasorIn;\n\tphasorHold = 0.1 * sr;\n} else if (phasorHold > 0.0) {\n\tphasorHold -= 1.0;\n}\nprevPhasorIn = phasorIn;\nif (phasorHold > 0.0) {\n\tlet phaseErr = wrap(phasorLast - phBase, 0.0 - 0.5, 0.5);\n\tphBase = wrap(phBase + 0.002 * phaseErr, 0.0, 1.0);\n}\n\n// --- Voice bank ------------------------------------------------------------\nlet v1 = sawAt(phBase, incBase);\nlet v2 = sawAt(phV2, incBase * detRatio);\nlet v3 = sawAt(phV3, incBase * detRatio2);\n\nlet sp = clamp(stereo, 0.0, 1.0);\nlet g2L = 0.5 + 0.4 * sp;\nlet g2R = 0.5 - 0.4 * sp;\nlet g3L = 0.5 - 0.4 * sp;\nlet g3R = 0.5 + 0.4 * sp;\n\nlet stackL = 0.34 * (v1 + g2L * v2 + g3L * v3);\nlet stackR = 0.34 * (v1 + g2R * v2 + g3R * v3);\n\n// --- Liquid motion: bar phasor (held with 100 ms hold) or free LFO ----------\nif (abs(barIn - prevBarIn) > 0.0000001) {\n\tbarLast = barIn;\n\tbarHold = 0.1 * sr;\n} else if (barHold > 0.0) {\n\tbarHold -= 1.0;\n}\nprevBarIn = barIn;\nlet lfoPh = (barHold > 0.0) ? wrap(barLast, 0.0, 1.0) : freeLfo.next(0.12);\n\nlet mot = clamp(motion, 0.0, 1.0);\nlet lfo = 0.5 + 0.5 * sin(2.0 * pi * lfoPh);\nlet cut = clamp(tone_hz, 200.0, 12000.0) * (1.0 - 0.55 * mot * (1.0 - lfo));\nlet cutSafe = clamp(cut, 80.0, sr * 0.42);\n\nlet yL = lp2L.next(lp1L.next(stackL, cutSafe), cutSafe);\nlet yR = lp2R.next(lp1R.next(stackR, cutSafe), cutSafe);\n\n// --- Tuba envelope gate: the synth voice breathes with the horn -------------\nlet absMono = abs(0.5 * (xL + xR));\nlet atk = 1.0 - exp(0.0 - 1.0 / (0.003 * sr));\nlet rel = 1.0 - exp(0.0 - 1.0 / (0.080 * sr));\nif (absMono > env) {\n\tenv += (absMono - env) * atk;\n} else {\n\tenv += (absMono - env) * rel;\n}\nlet gate = clamp(sqrt(maximum(env, 0.0)) * 1.7, 0.0, 1.0);\n\nlet wetL = yL * gate;\nlet wetR = yR * gate;\n\nlet w = clamp(mix, 0.0, 1.0);\nlet gain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = (linearinterp(w, xL, wetL)) * gain;\nout2 = (linearinterp(w, xR, wetR)) * gain;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 5,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "nocache": 0,
                                        "expr": "",
                                        "safemath": 1,
                                        "code": "// ============================================================================\n// reese_liquid_5limit.txt — phase-locked 5-limit Reese stack at the tuba's f0\n//\n// From: J. Timoney, \"Examining the Oscillator Waveform Animation Effect\",\n//       DAFx-14 (a bank of slightly detuned oscillators is the classic\n//       oscillator-animation / supersaw voice); W. E. Weingartner, \"Stable\n//       Limit Cycles as Tunable Signal Sources\", DAFx-25 paper 68, §supersaw\n//       (multi-saw chorus, detuned saw oscillator bank).\n//\n// Three band-limited saws share one phase ramp locked to the tuba's pitch.\n// Voice 1 is the unison core (phase-locked to in5 when it moves), voices 2 and\n// 3 sit at a 5-limit comma ratio and its square — 81/80, 128/125, 25/24 or\n// 16/15 — so the beating is a just-intonation comma beat, never an equal-\n// tempered detune. Motion opens the two-pole tone filter from the bar phasor\n// (or a slow free LFO when in4 is held at 0).\n//\n// Inlets:\n//   in1 / in2: stereo tuba\n//   in3: f0 in Hz. 0 = unknown -> hold last valid f0 (init 55 Hz).\n//        No zero-crossing fallback.\n//   in4: 0..1 one-bar phasor. Held 0 -> free 0.12 Hz LFO, still usable.\n//   in5: optional phase-locked tuba phasor 0..1. Used only as a gentle phase\n//        reference when it moves; unpatched / static -> f0 integration alone.\n// Outlets:\n//   out1 / out2: stereo, wet only at mix = 1\n// No safety limiter, no metering.\n// ============================================================================\n\n@param({ min: 0, max: 100 }) detune = 20;             // detune (5-limit comma)\n@param({ min: 0, max: 1 }) motion = 0.35;             // liquid motion\n@param({ min: 200, max: 12000 }) tone_hz = 7000;      // tone\n@param({ min: 0, max: 200 }) glide_ms = 9;           // glide\n@param({ min: 0, max: 1 }) stereo = 0.4;              // stereo spread\n@param({ min: 0, max: 1 }) mix = 1;                   // dry/wet\n@param({ min: -24, max: 12 }) out_gain_db = 0;        // output gain\n\n@state phBase = 0.0;\n@state phV2 = 0.0;\n@state phV3 = 0.0;\n@state f0Hold = 55.0;\n@state f0Smooth = 55.0;\n@state env = 0.0;\n\n@state lp1L = new onepole();\n@state lp2L = new onepole();\n@state lp1R = new onepole();\n@state lp2R = new onepole();\n\n@state freeLfo = new phasor();\n@state prevBarIn = 0.0;\n@state barLast = 0.0;\n@state barHold = 0.0;\n\n@state prevPhasorIn = 0.0;\n@state phasorLast = 0.0;\n@state phasorHold = 0.0;\n\n// Band-limited saw: naive ramp minus the polyBLEP correction at each jump.\nfunction polyBlep(t: number, dt: number): number {\n\tif (t < dt) {\n\t\tlet x = t / dt;\n\t\treturn x + x - x * x - 1.0;\n\t}\n\tif (t > 1.0 - dt) {\n\t\tlet x = (t - 1.0) / dt;\n\t\treturn x * x + x + x + 1.0;\n\t}\n\treturn 0.0;\n}\n\nfunction sawAt(phase01: number, inc: number): number {\n\treturn 2.0 * phase01 - 1.0 - polyBlep(phase01, inc);\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet barIn = in4;\nlet phasorIn = in5;\n\n// --- Pitch: hold the last valid f0, never read 0 as 1 Hz --------------------\nif (pitchIn > 15.0 && pitchIn < 1200.0) {\n\tf0Hold = pitchIn;\n}\nlet glideS = maximum(clamp(glide_ms, 0.0, 200.0) * 0.001, 0.001);\nlet slew = 1.0 - exp(0.0 - 1.0 / (glideS * sr));\nf0Smooth += (clamp(f0Hold, 15.0, 1200.0) - f0Smooth) * slew;\nlet f0 = clamp(f0Smooth, 15.0, 900.0);\n\n// --- 5-limit detune: nearest comma ratio, never an ET interval --------------\nlet det = clamp(detune, 0.0, 100.0);\nlet detRatio = 1.0;\nif (det >= 10.75 && det < 31.3) {\n\tdetRatio = 81.0 / 80.0;      // syntonic comma, 21.5 cents\n} else if (det >= 31.3 && det < 55.9) {\n\tdetRatio = 128.0 / 125.0;    // lesser diesis, 41.1 cents\n} else if (det >= 55.9 && det < 91.2) {\n\tdetRatio = 25.0 / 24.0;      // just chromatic semitone, 70.7 cents\n} else if (det >= 91.2) {\n\tdetRatio = 16.0 / 15.0;      // just diatonic semitone, 111.7 cents\n}\nlet detRatio2 = detRatio * detRatio;\n\n// --- Phase ramps: voice 1 is the coherent core, 2/3 drift by the comma -------\nlet incBase = f0 / sr;\nphBase = wrap(phBase + incBase, 0.0, 1.0);\nphV2 = wrap(phV2 + incBase * detRatio, 0.0, 1.0);\nphV3 = wrap(phV3 + incBase * detRatio2, 0.0, 1.0);\n\n// Gentle phase lock of the core to the tracker's phasor, only while it moves.\nif (abs(phasorIn - prevPhasorIn) > 0.0000001) {\n\tphasorLast = phasorIn;\n\tphasorHold = 0.1 * sr;\n} else if (phasorHold > 0.0) {\n\tphasorHold -= 1.0;\n}\nprevPhasorIn = phasorIn;\nif (phasorHold > 0.0) {\n\tlet phaseErr = wrap(phasorLast - phBase, 0.0 - 0.5, 0.5);\n\tphBase = wrap(phBase + 0.002 * phaseErr, 0.0, 1.0);\n}\n\n// --- Voice bank ------------------------------------------------------------\nlet v1 = sawAt(phBase, incBase);\nlet v2 = sawAt(phV2, incBase * detRatio);\nlet v3 = sawAt(phV3, incBase * detRatio2);\n\nlet sp = clamp(stereo, 0.0, 1.0);\nlet g2L = 0.5 + 0.4 * sp;\nlet g2R = 0.5 - 0.4 * sp;\nlet g3L = 0.5 - 0.4 * sp;\nlet g3R = 0.5 + 0.4 * sp;\n\nlet stackL = 0.34 * (v1 + g2L * v2 + g3L * v3);\nlet stackR = 0.34 * (v1 + g2R * v2 + g3R * v3);\n\n// --- Liquid motion: bar phasor (held with 100 ms hold) or free LFO ----------\nif (abs(barIn - prevBarIn) > 0.0000001) {\n\tbarLast = barIn;\n\tbarHold = 0.1 * sr;\n} else if (barHold > 0.0) {\n\tbarHold -= 1.0;\n}\nprevBarIn = barIn;\nlet lfoPh = (barHold > 0.0) ? wrap(barLast, 0.0, 1.0) : freeLfo.next(0.12);\n\nlet mot = clamp(motion, 0.0, 1.0);\nlet lfo = 0.5 + 0.5 * sin(2.0 * pi * lfoPh);\nlet cut = clamp(tone_hz, 200.0, 12000.0) * (1.0 - 0.55 * mot * (1.0 - lfo));\nlet cutSafe = clamp(cut, 80.0, sr * 0.42);\n\nlet yL = lp2L.next(lp1L.next(stackL, cutSafe), cutSafe);\nlet yR = lp2R.next(lp1R.next(stackR, cutSafe), cutSafe);\n\n// --- Tuba envelope gate: the synth voice breathes with the horn -------------\nlet absMono = abs(0.5 * (xL + xR));\nlet atk = 1.0 - exp(0.0 - 1.0 / (0.003 * sr));\nlet rel = 1.0 - exp(0.0 - 1.0 / (0.080 * sr));\nif (absMono > env) {\n\tenv += (absMono - env) * atk;\n} else {\n\tenv += (absMono - env) * rel;\n}\nlet gate = clamp(sqrt(maximum(env, 0.0)) * 1.7, 0.0, 1.0);\n\nlet wetL = yL * gate;\nlet wetR = yR * gate;\n\nlet w = clamp(mix, 0.0, 1.0);\nlet gain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = (linearinterp(w, xL, wetL)) * gain;\nout2 = (linearinterp(w, xR, wetR)) * gain;\n"
                                    },
