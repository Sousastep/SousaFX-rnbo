                        },
                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 1723.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "ai.ssb_space_shift",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// ssb_space_shift.txt — 5-limit single-sideband shifter for inharmonic space bass\n//\n// From: S. Wardle, \"A Hilbert-Transformer Frequency Shifter for Audio\", DAFx-98\n//       (analytic signal + quadrature carrier: y = re*cos - im*sin shifts the\n//       spectrum up, the + sign shifts it down); F. Esqueda, V. Välimäki &\n//       J. Parker, \"Barberpole Phasing and Flanging Illusions\", DAFx-15\n//       paper 67 (SSB frequency shifting as the barber-pole/endless engine).\n//\n// Every partial of the tuba is moved by the same number of Hz, chosen as a\n// 5-limit fraction of f0 (f0/4, f0/3, f0/2, 2f0/3, 3f0/4). Because the shift\n// is tied to the horn, the result stays \"in key\" at the fundamental while the\n// upper partials go deliberately inharmonic — the metallic, bell-like space\n// bass timbre. Feedback re-shifts the shifted signal for rising/falling\n// barber-pole sidebands.\n//\n// Inlets:\n//   in1 / in2: stereo tuba\n//   in3: f0 in Hz. 0 = unknown -> hold last valid f0 (init 55 Hz).\n//        No zero-crossing fallback.\n//   in4: bound only. A fixed 5-limit shift has no bar-synced motion.\n// Outlets:\n//   out1 / out2: stereo\n// No safety limiter, no metering.\n// ============================================================================\n\n@param({ min: 0, max: 4, steps: 5 }) interval = 0;    // shift (1/4…3/4 of f0)\n@param({ min: 0, max: 1, steps: 2 }) direction = 1;   // 0 = down, 1 = up\n@param({ min: 0, max: 1 }) glide = 0.0;               // shift glide\n@param({ min: 0, max: 0.7 }) feedback = 0.555;        // regeneration\n@param({ min: 0, max: 1 }) mix = 1.0;                 // dry/wet\n@param({ min: -24, max: 12 }) out_gain_db = 0;        // output gain\n\n@state lReX = new FixedSampleArray(4);\n@state lReY = new FixedSampleArray(4);\n@state lImX = new FixedSampleArray(4);\n@state lImY = new FixedSampleArray(4);\n@state lDelRe = 0.0;\n\n@state rReX = new FixedSampleArray(4);\n@state rReY = new FixedSampleArray(4);\n@state rImX = new FixedSampleArray(4);\n@state rImY = new FixedSampleArray(4);\n@state rDelRe = 0.0;\n\n@state phShift = 0.0;\n@state f0Hold = 55.0;\n@state shiftSmooth = 27.5;\n\n@state fbL = 0.0;\n@state fbR = 0.0;\n@state dcXL = 0.0;\n@state dcYL = 0.0;\n@state dcXR = 0.0;\n@state dcYR = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet unused_in4 = in4;\n\n// --- Pitch hold and 5-limit shift ------------------------------------------\nif (pitchIn > 15.0 && pitchIn < 1200.0) {\n\tf0Hold = pitchIn;\n}\nlet f0 = clamp(f0Hold, 15.0, 900.0);\n\nlet idx = clamp(interval, 0.0, 4.0);\nlet shiftRatio = 0.5;\nif (idx < 0.5) {\n\tshiftRatio = 1.0 / 4.0;\n} else if (idx < 1.5) {\n\tshiftRatio = 1.0 / 3.0;\n} else if (idx < 2.5) {\n\tshiftRatio = 1.0 / 2.0;\n} else if (idx < 3.5) {\n\tshiftRatio = 2.0 / 3.0;\n} else {\n\tshiftRatio = 3.0 / 4.0;\n}\nlet dir = (direction >= 0.5) ? 1.0 : 0.0;\nlet shiftTarget = f0 * shiftRatio * (1.0 + dir);\n\n// Glide: 3 ms .. 500 ms one-pole on the shift frequency.\nlet glideS = 0.003 + clamp(glide, 0.0, 1.0) * 0.497;\nshiftSmooth += (shiftTarget - shiftSmooth) * (1.0 - exp(0.0 - 1.0 / (glideS * sr)));\nlet shiftHz = clamp(shiftSmooth, -2000.0, 2000.0);\n\nphShift = wrap(phShift + shiftHz / sr, 0.0, 1.0);\nlet shiftCos = cos(2.0 * pi * phShift);\nlet shiftSin = sin(2.0 * pi * phShift);\n\n// --- Hilbert quadrature pair, per channel ----------------------------------\nlet cRe0 = 0.4794008656; let cRe1 = 0.8762184935;\nlet cRe2 = 0.9765975895; let cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983; let cIm1 = 0.7330289323;\nlet cIm2 = 0.9453497003; let cIm3 = 0.9905991567;\n\nlet fbAmt = clamp(feedback, 0.0, 0.7);\n\n// Left channel\nlet inL = xL + fbAmt * tanh(fbL) * 0.8;\nlet tL = inL;\nlet l0 = cRe0 * (tL + lReY[0]) - lReX[0]; lReX[0] = tL; lReY[0] = l0; tL = l0;\nlet l1 = cRe1 * (tL + lReY[1]) - lReX[1]; lReX[1] = tL; lReY[1] = l1; tL = l1;\nlet l2 = cRe2 * (tL + lReY[2]) - lReX[2]; lReX[2] = tL; lReY[2] = l2; tL = l2;\nlet l3 = cRe3 * (tL + lReY[3]) - lReX[3]; lReX[3] = tL; lReY[3] = l3;\nlet reL = lDelRe;\nlDelRe = l3;\n\nlet tLi = inL;\nlet li0 = cIm0 * (tLi + lImY[0]) - lImX[0]; lImX[0] = tLi; lImY[0] = li0; tLi = li0;\nlet li1 = cIm1 * (tLi + lImY[1]) - lImX[1]; lImX[1] = tLi; lImY[1] = li1; tLi = li1;\nlet li2 = cIm2 * (tLi + lImY[2]) - lImX[2]; lImX[2] = tLi; lImY[2] = li2; tLi = li2;\nlet li3 = cIm3 * (tLi + lImY[3]) - lImX[3]; lImX[3] = tLi; lImY[3] = li3;\nlet imL = 0.0 - li3; // negate: this cR/cI order is the negative Hilbert (up-shift for +phase)\n\nlet shiftL = (dir > 0.5) ? (reL * shiftCos - imL * shiftSin) : (reL * shiftCos + imL * shiftSin);\n\n// Right channel\nlet inR = xR + fbAmt * tanh(fbR) * 0.8;\nlet tR = inR;\nlet r0 = cRe0 * (tR + rReY[0]) - rReX[0]; rReX[0] = tR; rReY[0] = r0; tR = r0;\nlet r1 = cRe1 * (tR + rReY[1]) - rReX[1]; rReX[1] = tR; rReY[1] = r1; tR = r1;\nlet r2 = cRe2 * (tR + rReY[2]) - rReX[2]; rReX[2] = tR; rReY[2] = r2; tR = r2;\nlet r3 = cRe3 * (tR + rReY[3]) - rReX[3]; rReX[3] = tR; rReY[3] = r3;\nlet reR = rDelRe;\nrDelRe = r3;\n\nlet tRi = inR;\nlet ri0 = cIm0 * (tRi + rImY[0]) - rImX[0]; rImX[0] = tRi; rImY[0] = ri0; tRi = ri0;\nlet ri1 = cIm1 * (tRi + rImY[1]) - rImX[1]; rImX[1] = tRi; rImY[1] = ri1; tRi = ri1;\nlet ri2 = cIm2 * (tRi + rImY[2]) - rImX[2]; rImX[2] = tRi; rImY[2] = ri2; tRi = ri2;\nlet ri3 = cIm3 * (tRi + rImY[3]) - rImX[3]; rImX[3] = tRi; rImY[3] = ri3;\nlet imR = 0.0 - ri3; // negate: this cR/cI order is the negative Hilbert (up-shift for +phase)\n\nlet shiftR = (dir > 0.5) ? (reR * shiftCos - imR * shiftSin) : (reR * shiftCos + imR * shiftSin);\n\n// --- DC block and feedback state -------------------------------------------\nlet dcCoef = 1.0 - (2.0 * pi * 12.0 / sr);\nlet cleanL = shiftL - dcXL + dcCoef * dcYL;\ndcXL = shiftL;\ndcYL = cleanL;\nlet cleanR = shiftR - dcXR + dcCoef * dcYR;\ndcXR = shiftR;\ndcYR = cleanR;\n\nfbL = cleanL;\nfbR = cleanR;\n\nlet w = clamp(mix, 0.0, 1.0);\nlet gain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = linearinterp(w, xL, cleanL) * gain;\nout2 = linearinterp(w, xR, cleanR) * gain;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "nocache": 0,
                                        "expr": "",
                                        "safemath": 1,
                                        "code": "// ============================================================================\n// ssb_space_shift.txt — 5-limit single-sideband shifter for inharmonic space bass\n//\n// From: S. Wardle, \"A Hilbert-Transformer Frequency Shifter for Audio\", DAFx-98\n//       (analytic signal + quadrature carrier: y = re*cos - im*sin shifts the\n//       spectrum up, the + sign shifts it down); F. Esqueda, V. Välimäki &\n//       J. Parker, \"Barberpole Phasing and Flanging Illusions\", DAFx-15\n//       paper 67 (SSB frequency shifting as the barber-pole/endless engine).\n//\n// Every partial of the tuba is moved by the same number of Hz, chosen as a\n// 5-limit fraction of f0 (f0/4, f0/3, f0/2, 2f0/3, 3f0/4). Because the shift\n// is tied to the horn, the result stays \"in key\" at the fundamental while the\n// upper partials go deliberately inharmonic — the metallic, bell-like space\n// bass timbre. Feedback re-shifts the shifted signal for rising/falling\n// barber-pole sidebands.\n//\n// Inlets:\n//   in1 / in2: stereo tuba\n//   in3: f0 in Hz. 0 = unknown -> hold last valid f0 (init 55 Hz).\n//        No zero-crossing fallback.\n//   in4: bound only. A fixed 5-limit shift has no bar-synced motion.\n// Outlets:\n//   out1 / out2: stereo\n// No safety limiter, no metering.\n// ============================================================================\n\n@param({ min: 0, max: 4, steps: 5 }) interval = 0;    // shift (1/4…3/4 of f0)\n@param({ min: 0, max: 1, steps: 2 }) direction = 1;   // 0 = down, 1 = up\n@param({ min: 0, max: 1 }) glide = 0.0;               // shift glide\n@param({ min: 0, max: 0.7 }) feedback = 0.555;        // regeneration\n@param({ min: 0, max: 1 }) mix = 1.0;                 // dry/wet\n@param({ min: -24, max: 12 }) out_gain_db = 0;        // output gain\n\n@state lReX = new FixedSampleArray(4);\n@state lReY = new FixedSampleArray(4);\n@state lImX = new FixedSampleArray(4);\n@state lImY = new FixedSampleArray(4);\n@state lDelRe = 0.0;\n\n@state rReX = new FixedSampleArray(4);\n@state rReY = new FixedSampleArray(4);\n@state rImX = new FixedSampleArray(4);\n@state rImY = new FixedSampleArray(4);\n@state rDelRe = 0.0;\n\n@state phShift = 0.0;\n@state f0Hold = 55.0;\n@state shiftSmooth = 27.5;\n\n@state fbL = 0.0;\n@state fbR = 0.0;\n@state dcXL = 0.0;\n@state dcYL = 0.0;\n@state dcXR = 0.0;\n@state dcYR = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\nlet unused_in4 = in4;\n\n// --- Pitch hold and 5-limit shift ------------------------------------------\nif (pitchIn > 15.0 && pitchIn < 1200.0) {\n\tf0Hold = pitchIn;\n}\nlet f0 = clamp(f0Hold, 15.0, 900.0);\n\nlet idx = clamp(interval, 0.0, 4.0);\nlet shiftRatio = 0.5;\nif (idx < 0.5) {\n\tshiftRatio = 1.0 / 4.0;\n} else if (idx < 1.5) {\n\tshiftRatio = 1.0 / 3.0;\n} else if (idx < 2.5) {\n\tshiftRatio = 1.0 / 2.0;\n} else if (idx < 3.5) {\n\tshiftRatio = 2.0 / 3.0;\n} else {\n\tshiftRatio = 3.0 / 4.0;\n}\nlet dir = (direction >= 0.5) ? 1.0 : 0.0;\nlet shiftTarget = f0 * shiftRatio * (1.0 + dir);\n\n// Glide: 3 ms .. 500 ms one-pole on the shift frequency.\nlet glideS = 0.003 + clamp(glide, 0.0, 1.0) * 0.497;\nshiftSmooth += (shiftTarget - shiftSmooth) * (1.0 - exp(0.0 - 1.0 / (glideS * sr)));\nlet shiftHz = clamp(shiftSmooth, -2000.0, 2000.0);\n\nphShift = wrap(phShift + shiftHz / sr, 0.0, 1.0);\nlet shiftCos = cos(2.0 * pi * phShift);\nlet shiftSin = sin(2.0 * pi * phShift);\n\n// --- Hilbert quadrature pair, per channel ----------------------------------\nlet cRe0 = 0.4794008656; let cRe1 = 0.8762184935;\nlet cRe2 = 0.9765975895; let cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983; let cIm1 = 0.7330289323;\nlet cIm2 = 0.9453497003; let cIm3 = 0.9905991567;\n\nlet fbAmt = clamp(feedback, 0.0, 0.7);\n\n// Left channel\nlet inL = xL + fbAmt * tanh(fbL) * 0.8;\nlet tL = inL;\nlet l0 = cRe0 * (tL + lReY[0]) - lReX[0]; lReX[0] = tL; lReY[0] = l0; tL = l0;\nlet l1 = cRe1 * (tL + lReY[1]) - lReX[1]; lReX[1] = tL; lReY[1] = l1; tL = l1;\nlet l2 = cRe2 * (tL + lReY[2]) - lReX[2]; lReX[2] = tL; lReY[2] = l2; tL = l2;\nlet l3 = cRe3 * (tL + lReY[3]) - lReX[3]; lReX[3] = tL; lReY[3] = l3;\nlet reL = lDelRe;\nlDelRe = l3;\n\nlet tLi = inL;\nlet li0 = cIm0 * (tLi + lImY[0]) - lImX[0]; lImX[0] = tLi; lImY[0] = li0; tLi = li0;\nlet li1 = cIm1 * (tLi + lImY[1]) - lImX[1]; lImX[1] = tLi; lImY[1] = li1; tLi = li1;\nlet li2 = cIm2 * (tLi + lImY[2]) - lImX[2]; lImX[2] = tLi; lImY[2] = li2; tLi = li2;\nlet li3 = cIm3 * (tLi + lImY[3]) - lImX[3]; lImX[3] = tLi; lImY[3] = li3;\nlet imL = 0.0 - li3; // negate: this cR/cI order is the negative Hilbert (up-shift for +phase)\n\nlet shiftL = (dir > 0.5) ? (reL * shiftCos - imL * shiftSin) : (reL * shiftCos + imL * shiftSin);\n\n// Right channel\nlet inR = xR + fbAmt * tanh(fbR) * 0.8;\nlet tR = inR;\nlet r0 = cRe0 * (tR + rReY[0]) - rReX[0]; rReX[0] = tR; rReY[0] = r0; tR = r0;\nlet r1 = cRe1 * (tR + rReY[1]) - rReX[1]; rReX[1] = tR; rReY[1] = r1; tR = r1;\nlet r2 = cRe2 * (tR + rReY[2]) - rReX[2]; rReX[2] = tR; rReY[2] = r2; tR = r2;\nlet r3 = cRe3 * (tR + rReY[3]) - rReX[3]; rReX[3] = tR; rReY[3] = r3;\nlet reR = rDelRe;\nrDelRe = r3;\n\nlet tRi = inR;\nlet ri0 = cIm0 * (tRi + rImY[0]) - rImX[0]; rImX[0] = tRi; rImY[0] = ri0; tRi = ri0;\nlet ri1 = cIm1 * (tRi + rImY[1]) - rImX[1]; rImX[1] = tRi; rImY[1] = ri1; tRi = ri1;\nlet ri2 = cIm2 * (tRi + rImY[2]) - rImX[2]; rImX[2] = tRi; rImY[2] = ri2; tRi = ri2;\nlet ri3 = cIm3 * (tRi + rImY[3]) - rImX[3]; rImX[3] = tRi; rImY[3] = ri3;\nlet imR = 0.0 - ri3; // negate: this cR/cI order is the negative Hilbert (up-shift for +phase)\n\nlet shiftR = (dir > 0.5) ? (reR * shiftCos - imR * shiftSin) : (reR * shiftCos + imR * shiftSin);\n\n// --- DC block and feedback state -------------------------------------------\nlet dcCoef = 1.0 - (2.0 * pi * 12.0 / sr);\nlet cleanL = shiftL - dcXL + dcCoef * dcYL;\ndcXL = shiftL;\ndcYL = cleanL;\nlet cleanR = shiftR - dcXR + dcCoef * dcYR;\ndcXR = shiftR;\ndcYR = cleanR;\n\nfbL = cleanL;\nfbR = cleanR;\n\nlet w = clamp(mix, 0.0, 1.0);\nlet gain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = linearinterp(w, xL, cleanL) * gain;\nout2 = linearinterp(w, xR, cleanR) * gain;\n"
                                    },
