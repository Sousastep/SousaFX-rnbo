                        "gencode": "eq_bell(xin, cf, q, gain) {\n\tHistory y0(0);\n\tHistory y1(0);\n\tHistory a1(0);\n\tHistory a2(0);\n\tHistory a3(0);\n\tA = pow(10, gain / 40);\n\tg = tan(((cf * pi)) / samplerate);\n\tr = 1 / ((q * A));\n\ta1 = 1 / ((1 + (g * ((g + r)))));\n\ta2 = g * a1;\n\ta3 = g * a2;\n\tm1 = r * (((A * A) - 1));\n\tv3 = xin - y1;\n\tv1 = (a1 * y0) + (a2 * v3);\n\tv2 = ((y1 + (a2 * y0))) + (a3 * v3);\n\ty0 = (2 * v1) - y0;\n\ty1 = (2 * v2) - y1;\n\treturn xin + (m1 * v1);\n}\n\ntmp_eq_bell_1(xin, cf, q, gain) {\n\tHistory y0(0);\n\tHistory y1(0);\n\tHistory a1(0);\n\tHistory a2(0);\n\tHistory a3(0);\n\tA = pow(10, gain / 40);\n\tg = tan(((cf * pi)) / samplerate);\n\tr = 1 / ((q * A));\n\ta1 = 1 / ((1 + (g * ((g + r)))));\n\ta2 = g * a1;\n\ta3 = g * a2;\n\tm1 = r * (((A * A) - 1));\n\tv3 = xin - y1;\n\tv1 = (a1 * y0) + (a2 * v3);\n\tv2 = ((y1 + (a2 * y0))) + (a3 * v3);\n\ty0 = (2 * v1) - y0;\n\ty1 = (2 * v2) - y1;\n\treturn xin + (m1 * v1);\n}\n\nHistory tmp_history_2(0);\nHistory tmp_history_3(0);\nHistory tmp_history_4(0);\nHistory tmp_history_5(0);\ntmp_float_6 = float(0.79);\ntmp_int_7 = int(12);\ntmp_float_8 = float(0.79);\ntmp_int_9 = int(12);\ntmp_slide_10 = slide(in3, 480, 480);\nlimit = samplerate / 2;\ncf = clip(tmp_slide_10, 0, limit);\nq = (pow(10, (clip(tmp_float_6, 0, 1)) * 2)) * 0.10000000000000001;\ngain = clip(tmp_int_7, -60, 60);\ntmp_expr_11 = eq_bell(in2, cf, q, gain);\ntmp_gen_12 = tmp_expr_11;\ntmp_limit_13 = samplerate / 2;\ntmp_cf_14 = clip(tmp_slide_10, 0, tmp_limit_13);\ntmp_q_15 = (pow(10, (clip(tmp_float_8, 0, 1)) * 2)) * 0.10000000000000001;\ntmp_gain_16 = clip(tmp_int_9, -60, 60);\ntmp_expr_17 = tmp_eq_bell_1(in1, tmp_cf_14, tmp_q_15, tmp_gain_16);\ntmp_gen_18 = tmp_expr_17;\ntmp_int_19 = int(-3);\ntmp_dbtoa_20 = dbtoa(tmp_int_19);\ntmp_mul_21 = tmp_int_7 * -1;\ntmp_dbtoa_22 = dbtoa(tmp_mul_21);\ntmp_mul_23 = tmp_gen_12 * tmp_dbtoa_22;\ntmp_mul_24 = tmp_int_9 * -1;\ntmp_dbtoa_25 = dbtoa(tmp_mul_24);\ntmp_mul_26 = 