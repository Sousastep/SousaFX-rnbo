                    "numoutlets": 4,
                    "outlettype": [ "signal", "signal", "signal", "signal" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 2,
                            "revision": 1,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 2048.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "ai.tuba_freq_tracker_v3",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// tuba_freq_tracker_v3.txt\n// Low-latency tuba pitch tracker: lag-adaptive sliding NSDF (YIN / McLeod\n// family) with key-maximum picking, jump confirmation and an octave guard,\n// plus the v2 phase-locked phasor / sine outputs.\n// ============================================================================\n// From:\n//   - von dem Knesebeck & Zoelzer, \"Comparison of pitch trackers for real-time\n//     guitar effects\", DAFx-10: Sec. 2.2 Eq. 9 (normalised autocorrelation /\n//     LTP), Sec. 2.4 Eqs. 13-14 (YIN difference function), Sec. 3.3 (latency is\n//     bounded by the observation frame, and post-processing adds to it).\n//   - Derrien, \"A very low latency pitch tracker for audio to MIDI conversion\",\n//     DAFx-14, Sec. 2: the algorithmic delay is bounded below by the longest\n//     period you want to see, and in practice needs about two periods.\n//   - McLeod & Wyvill, \"A smarter way to find pitch\", ICMC 2005 (not in the\n//     local corpus): NSDF n(tau) = 2 r(tau) / m(tau) and key-maximum picking.\n//\n// What is new against v2 (measured on tuba_recs/, 149 labelled notes):\n//   v2 used a fixed 28 ms YIN window for every lag, then several smoothers\n//   (median, IFT gate, 1.5..10 ms slews, confidence-scaled adaptation).\n//   v3 gives EACH lag tau its own window W(tau) = window_periods * tau\n//   (at least 5 ms), so a high note is resolved from a few of its own periods\n//   instead of waiting for a window sized for pedal tones. Each lag keeps two\n//   running sums over its own window, updated recursively at ~11 kHz:\n//       d(tau) = sum (x[n] - x[n-tau])^2\n//       m(tau) = sum (x[n]^2 + x[n-tau]^2)\n//       nsdf(tau) = 1 - d/m        (= 2r/m, scale-free, in [-1, 1])\n//   Because nsdf is normalised per lag, lags with different window lengths\n//   can be compared directly. Pitch = first key maximum >= 0.6 * best key\n//   maximum (after the first negative-going crossing), parabolic refinement.\n//   Post-processing is deliberately thin:\n//     - changes < 1.5 semitones are accepted immediately;\n//     - larger jumps must hold (within 0.35 st) for confirm_ms;\n//     - exact octave jumps must hold for octave_ms (kills the sub-octave\n//       flips at tongue stops, where long lags still remember the old note);\n//     - the pitch is held while the level is below gate_db or the nsdf peak\n//       is below voicing.\n//   Prototype: tools/pitch_lab/proto.cpp (line-for-line; keep them in step).\n//   Offline result (tools/pitch_lab, prototype == this file through RNBO):\n//   median time to reach +/-50 cents of the steady note 40 ms (v2: 73 ms),\n//   p90 88 ms (v2: 136 ms), in-note accuracy 96.4% (v2: 82.6%), octave\n//   errors 0.0%. Much of the remaining attack time is the player's own\n//   scoop into the note, not tracker delay.\n//\n// Cost: ~maxLag (about 410 at 44.1/48 kHz, fmin 27 Hz) running-sum updates per\n// decimated sample plus one nsdf scan every 4 decimated samples (~0.36 ms).\n//\n// Known limitations:\n//   - Release noises between notes (breath, valve clicks) can still be read as\n//     a pitch if they are periodic and above the gate; the held value then\n//     shows until the next note starts.\n//   - Changing window_periods or min_freq_hz restarts the running sums; lags\n//     come back as their windows refill (up to ~0.15 s for the longest lag).\n// ============================================================================\n// Inlets:\n//   in1: Left audio input (tuba)\n//   in2: Right audio input (if silent/unpatched, in1 is used alone)\n// Outlets:\n//   out1: Tracked fundamental frequency f0 in Hz (audio rate; 58.27 Hz until\n//         the first note is found, then the last valid pitch is held)\n//   out2: Pitch confidence / periodicity [0 .. 1] (nsdf peak, 5 ms smoothing)\n//   out3: Phase-locked phasor [0 .. 1) at f0 (drop-in for phasor~)\n//   out4: Phase-locked fundamental sine [-1 .. 1], scaled by confidence\n\n// Lowest pitch searched (Hz)\n@param({ min: 24.0, max: 120.0, exponent: 2 }) min_freq_hz = 27.0;\n// Highest pitch searched (Hz)\n@param({ min: 150.0, max: 700.0, exponent: 2 }) max_freq_hz = 420.0;\n// Level gate (dB): below this the pitch is held\n@param({ min: -70.0, max: -20.0 }) gate_db = -48.0;\n// Periodicity needed to accept a pitch (nsdf peak)\n@param({ min: 0.2, max: 0.9 }) voicing = 0.4;\n// Analysis window in periods of each candidate lag\n@param({ min: 1.0, max: 5.0 }) window_periods = 3.0;\n// Hold time a jump of >= 1.5 semitones needs before it is accepted (ms)\n@param({ min: 0.0, max: 40.0 }) confirm_ms = 10.0;\n// Hold time an exact octave jump needs before it is accepted (ms)\n@param({ min: 0.0, max: 80.0 }) octave_ms = 25.0;\n// Output glide in the log-frequency domain (ms, 0 = steps)\n@param({ min: 0.0, max: 50.0, exponent: 2 }) smooth_ms = 1.0;\n\n// --- Pre-conditioning: 2nd-order HP 22 Hz + 4th-order Butterworth LP 900 Hz\n// (RBJ biquads, transposed direct form II) ---\n@state hpB0 = 0.0;\n@state hpB1 = 0.0;\n@state hpB2 = 0.0;\n@state hpA1 = 0.0;\n@state hpA2 = 0.0;\n@state hpZ1 = 0.0;\n@state hpZ2 = 0.0;\n@state l1B0 = 0.0;\n@state l1B1 = 0.0;\n@state l1B2 = 0.0;\n@state l1A1 = 0.0;\n@state l1A2 = 0.0;\n@state l1Z1 = 0.0;\n@state l1Z2 = 0.0;\n@state l2B0 = 0.0;\n@state l2B1 = 0.0;\n@state l2B2 = 0.0;\n@state l2A1 = 0.0;\n@state l2A2 = 0.0;\n@state l2Z1 = 0.0;\n@state l2Z2 = 0.0;\n@state lastSr = 0.0;\n@state decFactor: Int = 4;\n@state dsr = 11025.0;\n@state env = 0.0;\n\n// --- Lag-adaptive sliding NSDF state (decimated domain, ~11 kHz) ---\n// buf: 4096-sample ring, enough for W(tau) + tau at window_periods 5.\n// dd/mm: running sums per lag; wTab: window length per lag; ns: nsdf scratch.\n@state buf = new FixedSampleArray(4096);\n@state dd = new FixedSampleArray(512);\n@state mm = new FixedSampleArray(512);\n@state ns = new FixedSampleArray(512);\n@state wTab = new FixedSampleArray(512);\n@state keyT = new FixedSampleArray(64);\n@state keyV = new FixedSampleArray(64);\n@state wIdx: Int = 0;\n@state fillN: Int = 0;\n@state decCount: Int = 0;\n@state hopCount: Int = 0;\n@state minLag: Int = 10;\n@state maxLag: Int = 400;\n@state lastWinP = -1.0;\n@state lastFmin = -1.0;\n@state lastFmax = -1.0;\n\n// --- Decision state ---\n@state f0 = 0.0;\n@state candF = 0.0;\n@state candCount: Int = 0;\n@state rawConf = 0.0;\n@state smoothConf = 0.0;\n@state hasPitch: Int = 0;\n@state logOut = 5.864186;   // log2(58.27 Hz), Bb1, until the first note\n\n// --- Phase-lock section (from v2, with a linear TPT bandpass, example26) ---\n@state ic1 = new FixedSampleArray(2);\n@state ic2 = new FixedSampleArray(2);\n@state hReX = new FixedSampleArray(8);\n@state hReY = new FixedSampleArray(8);\n@state hImX = new FixedSampleArray(8);\n@state hImY = new FixedSampleArray(8);\n@state hDelRe = 0.0;\n@state pllPhase = 0.0;\n\n// Unity-peak TPT state-variable bandpass, one stage (idx selects the state slot)\nfunction svfBp(idx: Int, x, g, kd) {\n\tlet a1 = 1.0 / (1.0 + g * (g + kd));\n\tlet a2 = g * a1;\n\tlet a3 = g * a2;\n\tlet v3 = x - ic2[idx];\n\tlet v1 = a1 * ic1[idx] + a2 * v3;\n\tlet v2 = ic2[idx] + a2 * ic1[idx] + a3 * v3;\n\tic1[idx] = 2.0 * v1 - ic1[idx];\n\tic2[idx] = 2.0 * v2 - ic2[idx];\n\treturn kd * v1;\n}\n\nlet sr = maximum(samplerate(), 1.0);\n\n// ============================================================================\n// 0. SAMPLE-RATE DEPENDENT SETUP (filter coefficients, decimation factor)\n// ============================================================================\nif (sr != lastSr) {\n\t// HP 22 Hz, Q 0.707\n\tlet w0 = 2.0 * pi * 22.0 / sr;\n\tlet cw = cos(w0);\n\tlet al = sin(w0) / (2.0 * 0.707);\n\tlet a0 = 1.0 + al;\n\thpB0 = (1.0 + cw) / 2.0 / a0;\n\thpB1 = (0.0 - (1.0 + cw)) / a0;\n\thpB2 = hpB0;\n\thpA1 = -2.0 * cw / a0;\n\thpA2 = (1.0 - al) / a0;\n\t// LP 900 Hz, 4th-order Butterworth as two sections (Q 0.54, 1.31)\n\tlet w1 = 2.0 * pi * 900.0 / sr;\n\tlet cw1 = cos(w1);\n\tlet al1 = sin(w1) / (2.0 * 0.54);\n\tlet b1 = 1.0 + al1;\n\tl1B0 = (1.0 - cw1) / 2.0 / b1;\n\tl1B1 = (1.0 - cw1) / b1;\n\tl1B2 = l1B0;\n\tl1A1 = -2.0 * cw1 / b1;\n\tl1A2 = (1.0 - al1) / b1;\n\tlet al2 = sin(w1) / (2.0 * 1.31);\n\tlet b2 = 1.0 + al2;\n\tl2B0 = (1.0 - cw1) / 2.0 / b2;\n\tl2B1 = (1.0 - cw1) / b2;\n\tl2B2 = l2B0;\n\tl2A1 = -2.0 * cw1 / b2;\n\tl2A2 = (1.0 - al2) / b2;\n\t// decimate to ~11 kHz (4 at 44.1/48 kHz, 8 at 88.2 kHz, 9 at 96 kHz)\n\tdecFactor = maximum(1, floor(sr / 11025.0 + 0.5));\n\tdsr = sr / decFactor;\n\tlastSr = sr;\n\tlastWinP = -1.0;   // force the lag tables to rebuild\n}\n\n// ============================================================================\n// 1. INPUT, PRE-FILTER, LEVEL\n// ============================================================================\nlet x = (abs(in2) > 0.0000001) ? (0.5 * (in1 + in2)) : in1;\n\nlet hy = hpB0 * x + hpZ1;\nhpZ1 = hpB1 * x - hpA1 * hy + hpZ2;\nhpZ2 = hpB2 * x - hpA2 * hy;\n\nlet ly1 = l1B0 * hy + l1Z1;\nl1Z1 = l1B1 * hy - l1A1 * ly1 + l1Z2;\nl1Z2 = l1B2 * hy - l1A2 * ly1;\n\nlet ly2 = l2B0 * ly1 + l2Z1;\nl2Z1 = l2B1 * ly1 - l2A1 * ly2 + l2Z2;\nl2Z2 = l2B2 * ly1 - l2A2 * ly2;\n\nenv += (hy * hy - env) * (1.0 - exp(-1.0 / (0.005 * sr)));\n\n// ============================================================================\n// 2. LAG TABLES (rebuilt when window_periods / min / max freq / sr change)\n// ============================================================================\nlet winP = clamp(window_periods, 1.0, 5.0);\nlet fLo = clamp(min_freq_hz, 24.0, 120.0);\nlet fHi = clamp(max_freq_hz, 150.0, 700.0);\nif (winP != lastWinP || fLo != lastFmin || fHi != lastFmax) {\n\tminLag = maximum(2, floor(dsr / fHi));\n\tmaxLag = minimum(510, ceil(dsr / fLo) + 1);\n\tlet wMin: Int = floor(0.005 * dsr);\n\tfor (let t: Int = 1; t <= maxLag + 1; t++) {\n\t\tlet ww: Int = floor(winP * t + 0.5);\n\t\tif (ww < wMin) {\n\t\t\tww = wMin;\n\t\t}\n\t\tif (ww + t + 2 > 4096) {\n\t\t\tww = 4096 - t - 2;\n\t\t}\n\t\twTab[t] = ww;\n\t}\n\t// The running sums are only valid for the window they were built with:\n\t// restart them; each lag becomes usable again once its window refills.\n\tif (winP != lastWinP || fLo != lastFmin) {\n\t\tfor (let i: Int = 0; i < 512; i++) {\n\t\t\tdd[i] = 0.0;\n\t\t\tmm[i] = 0.0;\n\t\t}\n\t\tfillN = 0;\n\t}\n\tlastWinP = winP;\n\tlastFmin = fLo;\n\tlastFmax = fHi;\n}\n\n// ============================================================================\n// 3. DECIMATED SLIDING NSDF + KEY-MAXIMUM PITCH PICKING\n// ============================================================================\ndecCount = decCount + 1;\nif (decCount >= decFactor) {\n\tdecCount = 0;\n\twIdx = wIdx + 1;\n\tif (wIdx >= 4096) {\n\t\twIdx = 0;\n\t}\n\tbuf[wIdx] = ly2;\n\tif (fillN < 1000000) {\n\t\tfillN = fillN + 1;\n\t}\n\tlet xn = ly2;\n\tlet top: Int = maxLag + 1;\n\tfor (let t: Int = 1; t <= top; t++) {\n\t\tlet iT: Int = wIdx - t;\n\t\tif (iT < 0) {\n\t\t\tiT += 4096;\n\t\t}\n\t\tlet xt = buf[iT];\n\t\tlet a = xn - xt;\n\t\tlet ww: Int = wTab[t];\n\t\tif (fillN > ww) {\n\t\t\tlet iO: Int = wIdx - ww;\n\t\t\tif (iO < 0) {\n\t\t\t\tiO += 4096;\n\t\t\t}\n\t\t\tlet iOT: Int = iO - t;\n\t\t\tif (iOT < 0) {\n\t\t\t\tiOT += 4096;\n\t\t\t}\n\t\t\tlet xo = buf[iO];\n\t\t\tlet xot = buf[iOT];\n\t\t\tlet b = xo - xot;\n\t\t\tdd[t] += a * a - b * b;\n\t\t\tmm[t] += xn * xn + xt * xt - xo * xo - xot * xot;\n\t\t} else {\n\t\t\tdd[t] += a * a;\n\t\t\tmm[t] += xn * xn + xt * xt;\n\t\t}\n\t}\n\n\thopCount = hopCount + 1;\n\tif (hopCount >= 4) {\n\t\thopCount = 0;\n\t\tlet rms = sqrt(maximum(env, 0.0));\n\t\tlet loud = (20.0 * log10(rms + 0.000000000001) > gate_db) ? 1 : 0;\n\n\t\tfor (let t: Int = 1; t <= top; t++) {\n\t\t\tlet mv = mm[t];\n\t\t\tlet wv: Int = wTab[t];\n\t\t\tns[t] = (mv > 0.000000000001 && fillN >= wv) ? (1.0 - dd[t] / mv) : 0.0;\n\t\t}\n\n\t\t// key maxima: the maximum of each positive region after the first\n\t\t// negative-going crossing (lags below minLag are not candidates)\n\t\tlet nk: Int = 0;\n\t\tlet seenNeg: Int = 0;\n\t\tlet curMax = -2.0;\n\t\tlet curT: Int = -1;\n\t\tfor (let t: Int = 1; t <= maxLag; t++) {\n\t\t\tlet v = ns[t];\n\t\t\tif (seenNeg == 0) {\n\t\t\t\tif (v < 0.0) {\n\t\t\t\t\tseenNeg = 1;\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tif (v > 0.0) {\n\t\t\t\t\tif (v > curMax && t >= minLag) {\n\t\t\t\t\t\tcurMax = v;\n\t\t\t\t\t\tcurT = t;\n\t\t\t\t\t}\n\t\t\t\t} else if (curT > 0) {\n\t\t\t\t\tif (nk < 64) {\n\t\t\t\t\t\tkeyT[nk] = curT;\n\t\t\t\t\t\tkeyV[nk] = curMax;\n\t\t\t\t\t\tnk = nk + 1;\n\t\t\t\t\t}\n\t\t\t\t\tcurMax = -2.0;\n\t\t\t\t\tcurT = -1;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif (curT > 0 && nk < 64 && curT < maxLag) {\n\t\t\tkeyT[nk] = curT;\n\t\t\tkeyV[nk] = curMax;\n\t\t\tnk = nk + 1;\n\t\t}\n\t\tlet gmax = -1.0;\n\t\tfor (let i: Int = 0; i < nk; i++) {\n\t\t\tif (keyV[i] > gmax) {\n\t\t\t\tgmax = keyV[i];\n\t\t\t}\n\t\t}\n\t\tlet bt: Int = -1;\n\t\tlet bv = 0.0;\n\t\tlet found: Int = 0;\n\t\tfor (let i: Int = 0; i < nk; i++) {\n\t\t\tif (found == 0 && keyV[i] >= 0.6 * gmax) {\n\t\t\t\tbt = keyT[i];\n\t\t\t\tbv = keyV[i];\n\t\t\t\tfound = 1;\n\t\t\t}\n\t\t}\n\n\t\tif (bt > 1 && loud == 1 && bv >= voicing) {\n\t\t\tlet y1 = ns[bt - 1];\n\t\t\tlet y2 = ns[bt];\n\t\t\tlet y3 = ns[bt + 1];\n\t\t\tlet den = y1 - 2.0 * y2 + y3;\n\t\t\tlet dl = (abs(den) > 0.000000000001) ? (0.5 * (y1 - y3) / den) : 0.0;\n\t\t\tdl = clamp(dl, -0.5, 0.5);\n\t\t\tlet fNew = dsr / (bt + dl);\n\n\t\t\tlet hopsPerMs = 0.001 * dsr / 4.0;\n\t\t\tlet confirmN: Int = ceil(clamp(confirm_ms, 0.0, 40.0) * hopsPerMs);\n\t\t\tlet octN: Int = ceil(clamp(octave_ms, 0.0, 80.0) * hopsPerMs);\n\n\t\t\tif (f0 <= 0.0) {\n\t\t\t\tf0 = fNew;\n\t\t\t\tcandCount = 0;\n\t\t\t} else {\n\t\t\t\tlet st = 12.0 * log2(fNew / f0);\n\t\t\t\tif (abs(st) < 1.5) {\n\t\t\t\t\tf0 = fNew;\n\t\t\t\t\tcandCount = 0;\n\t\t\t\t} else {\n\t\t\t\t\tif (candF > 0.0 && abs(12.0 * log2(fNew / candF)) < 0.35) {\n\t\t\t\t\t\tcandCount = candCount + 1;\n\t\t\t\t\t} else {\n\t\t\t\t\t\tcandCount = 1;\n\t\t\t\t\t\tcandF = fNew;\n\t\t\t\t\t}\n\t\t\t\t\tlet isOct = (abs(abs(st) - 12.0) < 0.6) ? 1 : 0;\n\t\t\t\t\tlet need: Int = (isOct == 1) ? maximum(confirmN, octN) : confirmN;\n\t\t\t\t\tif (candCount >= need) {\n\t\t\t\t\t\tf0 = fNew;\n\t\t\t\t\t\tcandCount = 0;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\trawConf = bv;\n\t\t} else {\n\t\t\trawConf = (loud == 1) ? bv * 0.5 : 0.0;\n\t\t\tcandCount = 0;\n\t\t}\n\t}\n}\n\n// ============================================================================\n// 4. OUTPUT GLIDE (log-frequency one-pole), CONFIDENCE\n// ============================================================================\nif (f0 > 0.0) {\n\tlet target = log2(f0);\n\tif (hasPitch == 0) {\n\t\tlogOut = target;\n\t\thasPitch = 1;\n\t}\n\tlet sm = clamp(smooth_ms, 0.0, 50.0);\n\tlet ga = (sm > 0.0) ? (1.0 - exp(-1.0 / (sm * 0.001 * sr))) : 1.0;\n\tlogOut += (target - logOut) * ga;\n}\nlet fOut = exp2(logOut);\nsmoothConf += (rawConf - smoothConf) * (1.0 - exp(-1.0 / (0.005 * sr)));\n\n// ============================================================================\n// 5. PHASE-LOCKED PHASOR (v2 design): isolate the fundamental with two linear\n// TPT bandpass stages at fOut (Q ~ 3.3), build the analytic signal with the\n// verified 4+4 z^-2 polyphase Hilbert pair, and pull a monotonic phase ramp\n// gently toward its phase. With a Q this low the bandpass settles in a few\n// periods; the ramp itself always runs at fOut.\n// ============================================================================\nlet gBp = tan(pi * clamp(fOut, 20.0, sr * 0.45) / sr);\nlet isoFund = svfBp(1, svfBp(0, hy, gBp, 0.3), gBp, 0.3);\n\nlet cRe0 = 0.4794008656;\nlet cRe1 = 0.8762184935;\nlet cRe2 = 0.9765975895;\nlet cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983;\nlet cIm1 = 0.7330289323;\nlet cIm2 = 0.9453497003;\nlet cIm3 = 0.9905991567;\n\nlet sRe = isoFund;\nlet yRe0 = cRe0 * (sRe + hReY[1]) - hReX[1];\nhReX[1] = hReX[0]; hReX[0] = sRe; hReY[1] = hReY[0]; hReY[0] = yRe0; sRe = yRe0;\nlet yRe1 = cRe1 * (sRe + hReY[3]) - hReX[3];\nhReX[3] = hReX[2]; hReX[2] = sRe; hReY[3] = hReY[2]; hReY[2] = yRe1; sRe = yRe1;\nlet yRe2 = cRe2 * (sRe + hReY[5]) - hReX[5];\nhReX[5] = hReX[4]; hReX[4] = sRe; hReY[5] = hReY[4]; hReY[4] = yRe2; sRe = yRe2;\nlet yRe3 = cRe3 * (sRe + hReY[7]) - hReX[7];\nhReX[7] = hReX[6]; hReX[6] = sRe; hReY[7] = hReY[6]; hReY[6] = yRe3;\nlet outRe = hDelRe;\nhDelRe = yRe3;\n\nlet sIm = isoFund;\nlet yIm0 = cIm0 * (sIm + hImY[1]) - hImX[1];\nhImX[1] = hImX[0]; hImX[0] = sIm; hImY[1] = hImY[0]; hImY[0] = yIm0; sIm = yIm0;\nlet yIm1 = cIm1 * (sIm + hImY[3]) - hImX[3];\nhImX[3] = hImX[2]; hImX[2] = sIm; hImY[3] = hImY[2]; hImY[2] = yIm1; sIm = yIm1;\nlet yIm2 = cIm2 * (sIm + hImY[5]) - hImX[5];\nhImX[5] = hImX[4]; hImX[4] = sIm; hImY[5] = hImY[4]; hImY[4] = yIm2; sIm = yIm2;\nlet yIm3 = cIm3 * (sIm + hImY[7]) - hImX[7];\nhImX[7] = hImX[6]; hImX[6] = sIm; hImY[7] = hImY[6]; hImY[6] = yIm3;\nlet outIm = yIm3;\n\n// the one-sample delay on the real path makes the pair rotate clockwise, so\n// the imaginary part is negated to get a phase that increases with time\nlet theta = atan2(0.0 - outIm, outRe);\nlet targetPh = wrap((theta + pi) / (2.0 * pi), 0.0, 1.0);\nlet phErr = targetPh - pllPhase;\nif (phErr > 0.5) {\n\tphErr -= 1.0;\n} else if (phErr < -0.5) {\n\tphErr += 1.0;\n}\npllPhase = wrap(pllPhase + fOut / sr + 0.015 * smoothConf * phErr, 0.0, 1.0);\n\nout1 = fOut;\nout2 = smoothConf;\nout3 = pllPhase;\nout4 = sin(2.0 * pi * pllPhase) * smoothConf;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 2,
                                    "numoutlets": 4,
                                    "outlettype": [ "signal", "signal", "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "nocache": 0,
                                        "expr": "",
                                        "code": "// ============================================================================\n// tuba_freq_tracker_v3.txt\n// Low-latency tuba pitch tracker: lag-adaptive sliding NSDF (YIN / McLeod\n// family) with key-maximum picking, jump confirmation and an octave guard,\n// plus the v2 phase-locked phasor / sine outputs.\n// ============================================================================\n// From:\n//   - von dem Knesebeck & Zoelzer, \"Comparison of pitch trackers for real-time\n//     guitar effects\", DAFx-10: Sec. 2.2 Eq. 9 (normalised autocorrelation /\n//     LTP), Sec. 2.4 Eqs. 13-14 (YIN difference function), Sec. 3.3 (latency is\n//     bounded by the observation frame, and post-processing adds to it).\n//   - Derrien, \"A very low latency pitch tracker for audio to MIDI conversion\",\n//     DAFx-14, Sec. 2: the algorithmic delay is bounded below by the longest\n//     period you want to see, and in practice needs about two periods.\n//   - McLeod & Wyvill, \"A smarter way to find pitch\", ICMC 2005 (not in the\n//     local corpus): NSDF n(tau) = 2 r(tau) / m(tau) and key-maximum picking.\n//\n// What is new against v2 (measured on tuba_recs/, 149 labelled notes):\n//   v2 used a fixed 28 ms YIN window for every lag, then several smoothers\n//   (median, IFT gate, 1.5..10 ms slews, confidence-scaled adaptation).\n//   v3 gives EACH lag tau its own window W(tau) = window_periods * tau\n//   (at least 5 ms), so a high note is resolved from a few of its own periods\n//   instead of waiting for a window sized for pedal tones. Each lag keeps two\n//   running sums over its own window, updated recursively at ~11 kHz:\n//       d(tau) = sum (x[n] - x[n-tau])^2\n//       m(tau) = sum (x[n]^2 + x[n-tau]^2)\n//       nsdf(tau) = 1 - d/m        (= 2r/m, scale-free, in [-1, 1])\n//   Because nsdf is normalised per lag, lags with different window lengths\n//   can be compared directly. Pitch = first key maximum >= 0.6 * best key\n//   maximum (after the first negative-going crossing), parabolic refinement.\n//   Post-processing is deliberately thin:\n//     - changes < 1.5 semitones are accepted immediately;\n//     - larger jumps must hold (within 0.35 st) for confirm_ms;\n//     - exact octave jumps must hold for octave_ms (kills the sub-octave\n//       flips at tongue stops, where long lags still remember the old note);\n//     - the pitch is held while the level is below gate_db or the nsdf peak\n//       is below voicing.\n//   Prototype: tools/pitch_lab/proto.cpp (line-for-line; keep them in step).\n//   Offline result (tools/pitch_lab, prototype == this file through RNBO):\n//   median time to reach +/-50 cents of the steady note 40 ms (v2: 73 ms),\n//   p90 88 ms (v2: 136 ms), in-note accuracy 96.4% (v2: 82.6%), octave\n//   errors 0.0%. Much of the remaining attack time is the player's own\n//   scoop into the note, not tracker delay.\n//\n// Cost: ~maxLag (about 410 at 44.1/48 kHz, fmin 27 Hz) running-sum updates per\n// decimated sample plus one nsdf scan every 4 decimated samples (~0.36 ms).\n//\n// Known limitations:\n//   - Release noises between notes (breath, valve clicks) can still be read as\n//     a pitch if they are periodic and above the gate; the held value then\n//     shows until the next note starts.\n//   - Changing window_periods or min_freq_hz restarts the running sums; lags\n//     come back as their windows refill (up to ~0.15 s for the longest lag).\n// ============================================================================\n// Inlets:\n//   in1: Left audio input (tuba)\n//   in2: Right audio input (if silent/unpatched, in1 is used alone)\n// Outlets:\n//   out1: Tracked fundamental frequency f0 in Hz (audio rate; 58.27 Hz until\n//         the first note is found, then the last valid pitch is held)\n//   out2: Pitch confidence / periodicity [0 .. 1] (nsdf peak, 5 ms smoothing)\n//   out3: Phase-locked phasor [0 .. 1) at f0 (drop-in for phasor~)\n//   out4: Phase-locked fundamental sine [-1 .. 1], scaled by confidence\n\n// Lowest pitch searched (Hz)\n@param({ min: 24.0, max: 120.0, exponent: 2 }) min_freq_hz = 27.0;\n// Highest pitch searched (Hz)\n@param({ min: 150.0, max: 700.0, exponent: 2 }) max_freq_hz = 420.0;\n// Level gate (dB): below this the pitch is held\n@param({ min: -70.0, max: -20.0 }) gate_db = -48.0;\n// Periodicity needed to accept a pitch (nsdf peak)\n@param({ min: 0.2, max: 0.9 }) voicing = 0.4;\n// Analysis window in periods of each candidate lag\n@param({ min: 1.0, max: 5.0 }) window_periods = 3.0;\n// Hold time a jump of >= 1.5 semitones needs before it is accepted (ms)\n@param({ min: 0.0, max: 40.0 }) confirm_ms = 10.0;\n// Hold time an exact octave jump needs before it is accepted (ms)\n@param({ min: 0.0, max: 80.0 }) octave_ms = 25.0;\n// Output glide in the log-frequency domain (ms, 0 = steps)\n@param({ min: 0.0, max: 50.0, exponent: 2 }) smooth_ms = 1.0;\n\n// --- Pre-conditioning: 2nd-order HP 22 Hz + 4th-order Butterworth LP 900 Hz\n// (RBJ biquads, transposed direct form II) ---\n@state hpB0 = 0.0;\n@state hpB1 = 0.0;\n@state hpB2 = 0.0;\n@state hpA1 = 0.0;\n@state hpA2 = 0.0;\n@state hpZ1 = 0.0;\n@state hpZ2 = 0.0;\n@state l1B0 = 0.0;\n@state l1B1 = 0.0;\n@state l1B2 = 0.0;\n@state l1A1 = 0.0;\n@state l1A2 = 0.0;\n@state l1Z1 = 0.0;\n@state l1Z2 = 0.0;\n@state l2B0 = 0.0;\n@state l2B1 = 0.0;\n@state l2B2 = 0.0;\n@state l2A1 = 0.0;\n@state l2A2 = 0.0;\n@state l2Z1 = 0.0;\n@state l2Z2 = 0.0;\n@state lastSr = 0.0;\n@state decFactor: Int = 4;\n@state dsr = 11025.0;\n@state env = 0.0;\n\n// --- Lag-adaptive sliding NSDF state (decimated domain, ~11 kHz) ---\n// buf: 4096-sample ring, enough for W(tau) + tau at window_periods 5.\n// dd/mm: running sums per lag; wTab: window length per lag; ns: nsdf scratch.\n@state buf = new FixedSampleArray(4096);\n@state dd = new FixedSampleArray(512);\n@state mm = new FixedSampleArray(512);\n@state ns = new FixedSampleArray(512);\n@state wTab = new FixedSampleArray(512);\n@state keyT = new FixedSampleArray(64);\n@state keyV = new FixedSampleArray(64);\n@state wIdx: Int = 0;\n@state fillN: Int = 0;\n@state decCount: Int = 0;\n@state hopCount: Int = 0;\n@state minLag: Int = 10;\n@state maxLag: Int = 400;\n@state lastWinP = -1.0;\n@state lastFmin = -1.0;\n@state lastFmax = -1.0;\n\n// --- Decision state ---\n@state f0 = 0.0;\n@state candF = 0.0;\n@state candCount: Int = 0;\n@state rawConf = 0.0;\n@state smoothConf = 0.0;\n@state hasPitch: Int = 0;\n@state logOut = 5.864186;   // log2(58.27 Hz), Bb1, until the first note\n\n// --- Phase-lock section (from v2, with a linear TPT bandpass, example26) ---\n@state ic1 = new FixedSampleArray(2);\n@state ic2 = new FixedSampleArray(2);\n@state hReX = new FixedSampleArray(8);\n@state hReY = new FixedSampleArray(8);\n@state hImX = new FixedSampleArray(8);\n@state hImY = new FixedSampleArray(8);\n@state hDelRe = 0.0;\n@state pllPhase = 0.0;\n\n// Unity-peak TPT state-variable bandpass, one stage (idx selects the state slot)\nfunction svfBp(idx: Int, x, g, kd) {\n\tlet a1 = 1.0 / (1.0 + g * (g + kd));\n\tlet a2 = g * a1;\n\tlet a3 = g * a2;\n\tlet v3 = x - ic2[idx];\n\tlet v1 = a1 * ic1[idx] + a2 * v3;\n\tlet v2 = ic2[idx] + a2 * ic1[idx] + a3 * v3;\n\tic1[idx] = 2.0 * v1 - ic1[idx];\n\tic2[idx] = 2.0 * v2 - ic2[idx];\n\treturn kd * v1;\n}\n\nlet sr = maximum(samplerate(), 1.0);\n\n// ============================================================================\n// 0. SAMPLE-RATE DEPENDENT SETUP (filter coefficients, decimation factor)\n// ============================================================================\nif (sr != lastSr) {\n\t// HP 22 Hz, Q 0.707\n\tlet w0 = 2.0 * pi * 22.0 / sr;\n\tlet cw = cos(w0);\n\tlet al = sin(w0) / (2.0 * 0.707);\n\tlet a0 = 1.0 + al;\n\thpB0 = (1.0 + cw) / 2.0 / a0;\n\thpB1 = (0.0 - (1.0 + cw)) / a0;\n\thpB2 = hpB0;\n\thpA1 = -2.0 * cw / a0;\n\thpA2 = (1.0 - al) / a0;\n\t// LP 900 Hz, 4th-order Butterworth as two sections (Q 0.54, 1.31)\n\tlet w1 = 2.0 * pi * 900.0 / sr;\n\tlet cw1 = cos(w1);\n\tlet al1 = sin(w1) / (2.0 * 0.54);\n\tlet b1 = 1.0 + al1;\n\tl1B0 = (1.0 - cw1) / 2.0 / b1;\n\tl1B1 = (1.0 - cw1) / b1;\n\tl1B2 = l1B0;\n\tl1A1 = -2.0 * cw1 / b1;\n\tl1A2 = (1.0 - al1) / b1;\n\tlet al2 = sin(w1) / (2.0 * 1.31);\n\tlet b2 = 1.0 + al2;\n\tl2B0 = (1.0 - cw1) / 2.0 / b2;\n\tl2B1 = (1.0 - cw1) / b2;\n\tl2B2 = l2B0;\n\tl2A1 = -2.0 * cw1 / b2;\n\tl2A2 = (1.0 - al2) / b2;\n\t// decimate to ~11 kHz (4 at 44.1/48 kHz, 8 at 88.2 kHz, 9 at 96 kHz)\n\tdecFactor = maximum(1, floor(sr / 11025.0 + 0.5));\n\tdsr = sr / decFactor;\n\tlastSr = sr;\n\tlastWinP = -1.0;   // force the lag tables to rebuild\n}\n\n// ============================================================================\n// 1. INPUT, PRE-FILTER, LEVEL\n// ============================================================================\nlet x = (abs(in2) > 0.0000001) ? (0.5 * (in1 + in2)) : in1;\n\nlet hy = hpB0 * x + hpZ1;\nhpZ1 = hpB1 * x - hpA1 * hy + hpZ2;\nhpZ2 = hpB2 * x - hpA2 * hy;\n\nlet ly1 = l1B0 * hy + l1Z1;\nl1Z1 = l1B1 * hy - l1A1 * ly1 + l1Z2;\nl1Z2 = l1B2 * hy - l1A2 * ly1;\n\nlet ly2 = l2B0 * ly1 + l2Z1;\nl2Z1 = l2B1 * ly1 - l2A1 * ly2 + l2Z2;\nl2Z2 = l2B2 * ly1 - l2A2 * ly2;\n\nenv += (hy * hy - env) * (1.0 - exp(-1.0 / (0.005 * sr)));\n\n// ============================================================================\n// 2. LAG TABLES (rebuilt when window_periods / min / max freq / sr change)\n// ============================================================================\nlet winP = clamp(window_periods, 1.0, 5.0);\nlet fLo = clamp(min_freq_hz, 24.0, 120.0);\nlet fHi = clamp(max_freq_hz, 150.0, 700.0);\nif (winP != lastWinP || fLo != lastFmin || fHi != lastFmax) {\n\tminLag = maximum(2, floor(dsr / fHi));\n\tmaxLag = minimum(510, ceil(dsr / fLo) + 1);\n\tlet wMin: Int = floor(0.005 * dsr);\n\tfor (let t: Int = 1; t <= maxLag + 1; t++) {\n\t\tlet ww: Int = floor(winP * t + 0.5);\n\t\tif (ww < wMin) {\n\t\t\tww = wMin;\n\t\t}\n\t\tif (ww + t + 2 > 4096) {\n\t\t\tww = 4096 - t - 2;\n\t\t}\n\t\twTab[t] = ww;\n\t}\n\t// The running sums are only valid for the window they were built with:\n\t// restart them; each lag becomes usable again once its window refills.\n\tif (winP != lastWinP || fLo != lastFmin) {\n\t\tfor (let i: Int = 0; i < 512; i++) {\n\t\t\tdd[i] = 0.0;\n\t\t\tmm[i] = 0.0;\n\t\t}\n\t\tfillN = 0;\n\t}\n\tlastWinP = winP;\n\tlastFmin = fLo;\n\tlastFmax = fHi;\n}\n\n// ============================================================================\n// 3. DECIMATED SLIDING NSDF + KEY-MAXIMUM PITCH PICKING\n// ============================================================================\ndecCount = decCount + 1;\nif (decCount >= decFactor) {\n\tdecCount = 0;\n\twIdx = wIdx + 1;\n\tif (wIdx >= 4096) {\n\t\twIdx = 0;\n\t}\n\tbuf[wIdx] = ly2;\n\tif (fillN < 1000000) {\n\t\tfillN = fillN + 1;\n\t}\n\tlet xn = ly2;\n\tlet top: Int = maxLag + 1;\n\tfor (let t: Int = 1; t <= top; t++) {\n\t\tlet iT: Int = wIdx - t;\n\t\tif (iT < 0) {\n\t\t\tiT += 4096;\n\t\t}\n\t\tlet xt = buf[iT];\n\t\tlet a = xn - xt;\n\t\tlet ww: Int = wTab[t];\n\t\tif (fillN > ww) {\n\t\t\tlet iO: Int = wIdx - ww;\n\t\t\tif (iO < 0) {\n\t\t\t\tiO += 4096;\n\t\t\t}\n\t\t\tlet iOT: Int = iO - t;\n\t\t\tif (iOT < 0) {\n\t\t\t\tiOT += 4096;\n\t\t\t}\n\t\t\tlet xo = buf[iO];\n\t\t\tlet xot = buf[iOT];\n\t\t\tlet b = xo - xot;\n\t\t\tdd[t] += a * a - b * b;\n\t\t\tmm[t] += xn * xn + xt * xt - xo * xo - xot * xot;\n\t\t} else {\n\t\t\tdd[t] += a * a;\n\t\t\tmm[t] += xn * xn + xt * xt;\n\t\t}\n\t}\n\n\thopCount = hopCount + 1;\n\tif (hopCount >= 4) {\n\t\thopCount = 0;\n\t\tlet rms = sqrt(maximum(env, 0.0));\n\t\tlet loud = (20.0 * log10(rms + 0.000000000001) > gate_db) ? 1 : 0;\n\n\t\tfor (let t: Int = 1; t <= top; t++) {\n\t\t\tlet mv = mm[t];\n\t\t\tlet wv: Int = wTab[t];\n\t\t\tns[t] = (mv > 0.000000000001 && fillN >= wv) ? (1.0 - dd[t] / mv) : 0.0;\n\t\t}\n\n\t\t// key maxima: the maximum of each positive region after the first\n\t\t// negative-going crossing (lags below minLag are not candidates)\n\t\tlet nk: Int = 0;\n\t\tlet seenNeg: Int = 0;\n\t\tlet curMax = -2.0;\n\t\tlet curT: Int = -1;\n\t\tfor (let t: Int = 1; t <= maxLag; t++) {\n\t\t\tlet v = ns[t];\n\t\t\tif (seenNeg == 0) {\n\t\t\t\tif (v < 0.0) {\n\t\t\t\t\tseenNeg = 1;\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tif (v > 0.0) {\n\t\t\t\t\tif (v > curMax && t >= minLag) {\n\t\t\t\t\t\tcurMax = v;\n\t\t\t\t\t\tcurT = t;\n\t\t\t\t\t}\n\t\t\t\t} else if (curT > 0) {\n\t\t\t\t\tif (nk < 64) {\n\t\t\t\t\t\tkeyT[nk] = curT;\n\t\t\t\t\t\tkeyV[nk] = curMax;\n\t\t\t\t\t\tnk = nk + 1;\n\t\t\t\t\t}\n\t\t\t\t\tcurMax = -2.0;\n\t\t\t\t\tcurT = -1;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif (curT > 0 && nk < 64 && curT < maxLag) {\n\t\t\tkeyT[nk] = curT;\n\t\t\tkeyV[nk] = curMax;\n\t\t\tnk = nk + 1;\n\t\t}\n\t\tlet gmax = -1.0;\n\t\tfor (let i: Int = 0; i < nk; i++) {\n\t\t\tif (keyV[i] > gmax) {\n\t\t\t\tgmax = keyV[i];\n\t\t\t}\n\t\t}\n\t\tlet bt: Int = -1;\n\t\tlet bv = 0.0;\n\t\tlet found: Int = 0;\n\t\tfor (let i: Int = 0; i < nk; i++) {\n\t\t\tif (found == 0 && keyV[i] >= 0.6 * gmax) {\n\t\t\t\tbt = keyT[i];\n\t\t\t\tbv = keyV[i];\n\t\t\t\tfound = 1;\n\t\t\t}\n\t\t}\n\n\t\tif (bt > 1 && loud == 1 && bv >= voicing) {\n\t\t\tlet y1 = ns[bt - 1];\n\t\t\tlet y2 = ns[bt];\n\t\t\tlet y3 = ns[bt + 1];\n\t\t\tlet den = y1 - 2.0 * y2 + y3;\n\t\t\tlet dl = (abs(den) > 0.000000000001) ? (0.5 * (y1 - y3) / den) : 0.0;\n\t\t\tdl = clamp(dl, -0.5, 0.5);\n\t\t\tlet fNew = dsr / (bt + dl);\n\n\t\t\tlet hopsPerMs = 0.001 * dsr / 4.0;\n\t\t\tlet confirmN: Int = ceil(clamp(confirm_ms, 0.0, 40.0) * hopsPerMs);\n\t\t\tlet octN: Int = ceil(clamp(octave_ms, 0.0, 80.0) * hopsPerMs);\n\n\t\t\tif (f0 <= 0.0) {\n\t\t\t\tf0 = fNew;\n\t\t\t\tcandCount = 0;\n\t\t\t} else {\n\t\t\t\tlet st = 12.0 * log2(fNew / f0);\n\t\t\t\tif (abs(st) < 1.5) {\n\t\t\t\t\tf0 = fNew;\n\t\t\t\t\tcandCount = 0;\n\t\t\t\t} else {\n\t\t\t\t\tif (candF > 0.0 && abs(12.0 * log2(fNew / candF)) < 0.35) {\n\t\t\t\t\t\tcandCount = candCount + 1;\n\t\t\t\t\t} else {\n\t\t\t\t\t\tcandCount = 1;\n\t\t\t\t\t\tcandF = fNew;\n\t\t\t\t\t}\n\t\t\t\t\tlet isOct = (abs(abs(st) - 12.0) < 0.6) ? 1 : 0;\n\t\t\t\t\tlet need: Int = (isOct == 1) ? maximum(confirmN, octN) : confirmN;\n\t\t\t\t\tif (candCount >= need) {\n\t\t\t\t\t\tf0 = fNew;\n\t\t\t\t\t\tcandCount = 0;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\trawConf = bv;\n\t\t} else {\n\t\t\trawConf = (loud == 1) ? bv * 0.5 : 0.0;\n\t\t\tcandCount = 0;\n\t\t}\n\t}\n}\n\n// ============================================================================\n// 4. OUTPUT GLIDE (log-frequency one-pole), CONFIDENCE\n// ============================================================================\nif (f0 > 0.0) {\n\tlet target = log2(f0);\n\tif (hasPitch == 0) {\n\t\tlogOut = target;\n\t\thasPitch = 1;\n\t}\n\tlet sm = clamp(smooth_ms, 0.0, 50.0);\n\tlet ga = (sm > 0.0) ? (1.0 - exp(-1.0 / (sm * 0.001 * sr))) : 1.0;\n\tlogOut += (target - logOut) * ga;\n}\nlet fOut = exp2(logOut);\nsmoothConf += (rawConf - smoothConf) * (1.0 - exp(-1.0 / (0.005 * sr)));\n\n// ============================================================================\n// 5. PHASE-LOCKED PHASOR (v2 design): isolate the fundamental with two linear\n// TPT bandpass stages at fOut (Q ~ 3.3), build the analytic signal with the\n// verified 4+4 z^-2 polyphase Hilbert pair, and pull a monotonic phase ramp\n// gently toward its phase. With a Q this low the bandpass settles in a few\n// periods; the ramp itself always runs at fOut.\n// ============================================================================\nlet gBp = tan(pi * clamp(fOut, 20.0, sr * 0.45) / sr);\nlet isoFund = svfBp(1, svfBp(0, hy, gBp, 0.3), gBp, 0.3);\n\nlet cRe0 = 0.4794008656;\nlet cRe1 = 0.8762184935;\nlet cRe2 = 0.9765975895;\nlet cRe3 = 0.9974992559;\nlet cIm0 = 0.1617584983;\nlet cIm1 = 0.7330289323;\nlet cIm2 = 0.9453497003;\nlet cIm3 = 0.9905991567;\n\nlet sRe = isoFund;\nlet yRe0 = cRe0 * (sRe + hReY[1]) - hReX[1];\nhReX[1] = hReX[0]; hReX[0] = sRe; hReY[1] = hReY[0]; hReY[0] = yRe0; sRe = yRe0;\nlet yRe1 = cRe1 * (sRe + hReY[3]) - hReX[3];\nhReX[3] = hReX[2]; hReX[2] = sRe; hReY[3] = hReY[2]; hReY[2] = yRe1; sRe = yRe1;\nlet yRe2 = cRe2 * (sRe + hReY[5]) - hReX[5];\nhReX[5] = hReX[4]; hReX[4] = sRe; hReY[5] = hReY[4]; hReY[4] = yRe2; sRe = yRe2;\nlet yRe3 = cRe3 * (sRe + hReY[7]) - hReX[7];\nhReX[7] = hReX[6]; hReX[6] = sRe; hReY[7] = hReY[6]; hReY[6] = yRe3;\nlet outRe = hDelRe;\nhDelRe = yRe3;\n\nlet sIm = isoFund;\nlet yIm0 = cIm0 * (sIm + hImY[1]) - hImX[1];\nhImX[1] = hImX[0]; hImX[0] = sIm; hImY[1] = hImY[0]; hImY[0] = yIm0; sIm = yIm0;\nlet yIm1 = cIm1 * (sIm + hImY[3]) - hImX[3];\nhImX[3] = hImX[2]; hImX[2] = sIm; hImY[3] = hImY[2]; hImY[2] = yIm1; sIm = yIm1;\nlet yIm2 = cIm2 * (sIm + hImY[5]) - hImX[5];\nhImX[5] = hImX[4]; hImX[4] = sIm; hImY[5] = hImY[4]; hImY[4] = yIm2; sIm = yIm2;\nlet yIm3 = cIm3 * (sIm + hImY[7]) - hImX[7];\nhImX[7] = hImX[6]; hImX[6] = sIm; hImY[7] = hImY[6]; hImY[6] = yIm3;\nlet outIm = yIm3;\n\n// the one-sample delay on the real path makes the pair rotate clockwise, so\n// the imaginary part is negated to get a phase that increases with time\nlet theta = atan2(0.0 - outIm, outRe);\nlet targetPh = wrap((theta + pi) / (2.0 * pi), 0.0, 1.0);\nlet phErr = targetPh - pllPhase;\nif (phErr > 0.5) {\n\tphErr -= 1.0;\n} else if (phErr < -0.5) {\n\tphErr += 1.0;\n}\npllPhase = wrap(pllPhase + fOut / sr + 0.015 * smoothConf * phErr, 0.0, 1.0);\n\nout1 = fOut;\nout2 = smoothConf;\nout3 = pllPhase;\nout4 = sin(2.0 * pi * pllPhase) * smoothConf;\n",
                                        "safemath": 1
                                    },
