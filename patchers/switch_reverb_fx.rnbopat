                        "rect": [ 100.0, 100.0, 2119.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "ai.rev_velvet_grain",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// rev_velvet_grain.txt\n// A velvet-noise tail of sparse signed clicks whose grain runs from smooth to crackly lo-fi.\n// From: Prawda, Schlecht & Välimäki, \"Multichannel Interleaved Velvet Noise\",\n//       DAFx-22 Paper 28, §2 Eq. 1 — four extended-velvet-noise (EVN) branches,\n//       pulse k at round(k*Td + r*(Td - 1)), each recirculated through its own\n//       loss filter G(z), and §3.3 — branch outputs mixed orthogonally (sign\n//       patterns) so the two outputs are decorrelated.\n//       Fagerström, Meyer-Kahlen, Schlecht & Välimäki, \"Dark Velvet Noise\",\n//       DAFx-22 Paper 31, §3 — each pulse gets a random width, realised as one\n//       running-sum filter per unique width; wide pulses = darker clicks.\n//       Roberts et al., DAFx-23 Paper 57, §2.2 — at low pulse density the\n//       sequence is heard as rough/crackly instead of smooth; grain_hz rides\n//       that boundary on purpose.\n// 100% wet. No dry path, no limiter, no metering.\n// Inlets:\n//   in1 / in2: stereo audio (summed to excite the four branches)\n// Outlets:\n//   out1 / out2: stereo tail, wet only\n// ============================================================================\n\n// predelay\n@param({ min: 0, max: 250 }) predelay_ms = 10;\n// decay time (RT60)\n@param({ min: 0.2, max: 10, exponent: 2 }) decay_s = 2.0;\n// pulse density: low = crackly grit, high = smooth\n@param({ min: 40, max: 1200, exponent: 2 }) grain_hz = 400;\n// darkness: pulse width and loop lowpass\n@param({ min: 500, max: 16000, exponent: 2 }) damp_hz = 5000;\n// low cut\n@param({ min: 20, max: 600, exponent: 2 }) lowcut_hz = 150;\n// width\n@param({ min: 0, max: 1 }) width = 1.0;\n// output gain\n@param({ min: -24, max: 12 }) out_gain_db = 0;\n\n// predelay line (mono excitation)\n@state preBuf = new FixedSampleArray(65536);\n@state preIdx: Int = 0;\n\n// raw history for the running-sum filters\n@state rawBuf = new FixedSampleArray(256);\n@state rawIdx: Int = 0;\n\n// one history per pulse width group (dark velvet noise)\n@state grpBuf = new FixedSampleArray(4, 32768);\n@state grpSum = new FixedSampleArray(4);\n@state gIdx: Int = 0;\n\n// one recirculating loop per EVN branch\n@state loopBuf = new FixedSampleArray(4, 32768);\n@state loopLp = new FixedSampleArray(4);\n@state lIdx: Int = 0;\n\n// EVN pulse tables: position, signed gain, width group\n@state tapPos = new FixedIntArray(4, 32);\n@state tapGain = new FixedSampleArray(4, 32);\n@state tapGrp = new FixedIntArray(4, 32);\n@state tapCount = new FixedIntArray(4);\n@state loopLen = new FixedIntArray(4);\n\n@state rng = 1.0;\n@state lastSr = 0.0;\n@state lastGrain = -1.0;\n\n// low-cut: two one-pole highpasses in series\n@state hx1 = 0.0;\n@state hy1 = 0.0;\n@state hx2 = 0.0;\n@state hy2 = 0.0;\n\nfunction nextRand() {\n\trng = (rng * 16807.0) % 2147483647.0;\n\treturn rng / 2147483647.0;\n}\n\n// Eq. 1: k-th pulse inside grid cell k, signed, assigned a random width group\nfunction makeBranch(b: Int, sr: number, density: number) {\n\tlet lenS = loopLen[b];\n\tlet k: Int = clamp(floor(density * 0.25 * lenS / sr + 0.5), 1, 32);\n\ttapCount[b] = k;\n\trng = 1234.0 + 7919.0 * b;\n\tlet td = lenS / k;\n\tlet amp = 1.0 / sqrt(k * 1.0);\n\tfor (let m: Int = 0; m < k; m++) {\n\t\tlet r = nextRand();\n\t\tlet p: Int = clamp(floor(m * td + r * (td - 1.0) + 0.5), 0, lenS - 1);\n\t\ttapPos[b][m] = p;\n\t\tlet sgn = 1.0;\n\t\tif (nextRand() < 0.5) {\n\t\t\tsgn = -1.0;\n\t\t}\n\t\ttapGain[b][m] = sgn * amp;\n\t\tlet gq: Int = clamp(floor(nextRand() * 4.0), 0, 3);\n\t\ttapGrp[b][m] = gq;\n\t}\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet x = 0.5 * (in1 + in2);\n\n// --- (Re)build the pulse tables when the rate or the density moves --------\nlet dens = clamp(grain_hz, 40.0, 1200.0);\nif (sr != lastSr || abs(dens - lastGrain) > 0.5) {\n\tloopLen[0] = clamp(floor(0.0971 * sr), 16, 32700);\n\tloopLen[1] = clamp(floor(0.1129 * sr), 16, 32700);\n\tloopLen[2] = clamp(floor(0.1277 * sr), 16, 32700);\n\tloopLen[3] = clamp(floor(0.1399 * sr), 16, 32700);\n\tfor (let b: Int = 0; b < 4; b++) {\n\t\tmakeBranch(b, sr, dens);\n\t}\n\tlastSr = sr;\n\tlastGrain = dens;\n}\n\n// --- Predelay (ms) ---------------------------------------------------------\npreBuf[preIdx] = x;\nlet preS: Int = clamp(floor(mstosamps(predelay_ms) + 0.5), 0, 65000);\nlet xp = preBuf[(preIdx - preS + 65536) & 65535];\npreIdx = (preIdx + 1) & 65535;\n\n// --- Low cut ---------------------------------------------------------------\nlet cutF = clamp(lowcut_hz, 10.0, sr * 0.45);\nlet cutR = exp(0.0 - 2.0 * pi * cutF / sr);\nlet ha = xp - hx1 + cutR * hy1;\nhx1 = xp;\nhy1 = ha;\nlet hb = ha - hx2 + cutR * hy2;\nhx2 = ha;\nhy2 = hb;\n\n// --- Dark velvet noise: four pulse widths as leaky running sums -----------\n// boxcar of width w has its -3 dB point near 0.443*sr/w\nlet dampF = clamp(damp_hz, 200.0, sr * 0.45);\nlet wMax = clamp(0.443 * sr / dampF, 1.0, 120.0);\nrawBuf[rawIdx] = hb;\nlet leak = 0.999;\nfor (let j: Int = 0; j < 4; j++) {\n\tlet w: Int = clamp(floor(wMax * (j + 1) * 0.25 + 0.5), 1, 120);\n\tlet aw = pow(leak, w * 1.0);\n\tlet old = rawBuf[(rawIdx - w + 256) & 255];\n\tlet s = leak * grpSum[j] + hb - aw * old;\n\tgrpSum[j] = s;\n\tgrpBuf[j][gIdx] = s * (1.0 - leak) / (1.0 - aw);\n}\nrawIdx = (rawIdx + 1) & 255;\n\n// --- Four EVN branches, each recirculating through G(z) -------------------\nlet rt60 = clamp(decay_s, 0.2, 10.0);\nlet lpC = 1.0 - exp(0.0 - 2.0 * pi * dampF / sr);\nlet br0 = 0.0;\nlet br1 = 0.0;\nlet br2 = 0.0;\nlet br3 = 0.0;\nlet gSum = 0.0;\nfor (let b: Int = 0; b < 4; b++) {\n\tlet fir = 0.0;\n\tlet k: Int = tapCount[b];\n\tfor (let m: Int = 0; m < k; m++) {\n\t\tlet gq: Int = tapGrp[b][m];\n\t\tlet p: Int = tapPos[b][m];\n\t\tfir += tapGain[b][m] * grpBuf[gq][(gIdx - p + 32768) & 32767];\n\t}\n\tlet lenS: Int = loopLen[b];\n\tlet back = loopBuf[b][(lIdx - lenS + 32768) & 32767];\n\tlet lp = loopLp[b] + lpC * (back - loopLp[b]);\n\tloopLp[b] = lp;\n\tlet g = exp(0.0 - 6.907755 * (lenS / sr) / rt60);\n\tgSum += g;\n\tlet y = fir + g * lp;\n\tloopBuf[b][lIdx] = y;\n\tif (b == 0) {\n\t\tbr0 = y;\n\t} else if (b == 1) {\n\t\tbr1 = y;\n\t} else if (b == 2) {\n\t\tbr2 = y;\n\t} else {\n\t\tbr3 = y;\n\t}\n}\ngIdx = (gIdx + 1) & 32767;\nlIdx = (lIdx + 1) & 32767;\n\n// --- Orthogonal sign mixing (§3.3): two decorrelated outputs -------------\nlet wetL = 0.5 * (br0 + br1 - br2 + br3);\nlet wetR = 0.5 * (br0 - br1 + br2 + br3);\n\n// level: the loop gain sets the tail energy, so normalise by it\nlet gMean = 0.25 * gSum;\nlet norm = 1.4 * sqrt(maximum(1.0 - gMean * gMean, 0.0001));\nlet sL = wetL * norm;\nlet sR = wetR * norm;\n\n// --- Width (mid/side) -----------------------------------------------------\nlet mid = 0.5 * (sL + sR);\nlet side = 0.5 * (sL - sR) * clamp(width, 0.0, 1.0);\n\nlet outG = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = (mid + side) * outG;\nout2 = (mid - side) * outG;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 2,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "nocache": 0,
                                        "expr": "",
                                        "safemath": 1,
                                        "code": "// ============================================================================\n// rev_velvet_grain.txt\n// A velvet-noise tail of sparse signed clicks whose grain runs from smooth to crackly lo-fi.\n// From: Prawda, Schlecht & Välimäki, \"Multichannel Interleaved Velvet Noise\",\n//       DAFx-22 Paper 28, §2 Eq. 1 — four extended-velvet-noise (EVN) branches,\n//       pulse k at round(k*Td + r*(Td - 1)), each recirculated through its own\n//       loss filter G(z), and §3.3 — branch outputs mixed orthogonally (sign\n//       patterns) so the two outputs are decorrelated.\n//       Fagerström, Meyer-Kahlen, Schlecht & Välimäki, \"Dark Velvet Noise\",\n//       DAFx-22 Paper 31, §3 — each pulse gets a random width, realised as one\n//       running-sum filter per unique width; wide pulses = darker clicks.\n//       Roberts et al., DAFx-23 Paper 57, §2.2 — at low pulse density the\n//       sequence is heard as rough/crackly instead of smooth; grain_hz rides\n//       that boundary on purpose.\n// 100% wet. No dry path, no limiter, no metering.\n// Inlets:\n//   in1 / in2: stereo audio (summed to excite the four branches)\n// Outlets:\n//   out1 / out2: stereo tail, wet only\n// ============================================================================\n\n// predelay\n@param({ min: 0, max: 250 }) predelay_ms = 10;\n// decay time (RT60)\n@param({ min: 0.2, max: 10, exponent: 2 }) decay_s = 2.0;\n// pulse density: low = crackly grit, high = smooth\n@param({ min: 40, max: 1200, exponent: 2 }) grain_hz = 400;\n// darkness: pulse width and loop lowpass\n@param({ min: 500, max: 16000, exponent: 2 }) damp_hz = 5000;\n// low cut\n@param({ min: 20, max: 600, exponent: 2 }) lowcut_hz = 150;\n// width\n@param({ min: 0, max: 1 }) width = 1.0;\n// output gain\n@param({ min: -24, max: 12 }) out_gain_db = 0;\n\n// predelay line (mono excitation)\n@state preBuf = new FixedSampleArray(65536);\n@state preIdx: Int = 0;\n\n// raw history for the running-sum filters\n@state rawBuf = new FixedSampleArray(256);\n@state rawIdx: Int = 0;\n\n// one history per pulse width group (dark velvet noise)\n@state grpBuf = new FixedSampleArray(4, 32768);\n@state grpSum = new FixedSampleArray(4);\n@state gIdx: Int = 0;\n\n// one recirculating loop per EVN branch\n@state loopBuf = new FixedSampleArray(4, 32768);\n@state loopLp = new FixedSampleArray(4);\n@state lIdx: Int = 0;\n\n// EVN pulse tables: position, signed gain, width group\n@state tapPos = new FixedIntArray(4, 32);\n@state tapGain = new FixedSampleArray(4, 32);\n@state tapGrp = new FixedIntArray(4, 32);\n@state tapCount = new FixedIntArray(4);\n@state loopLen = new FixedIntArray(4);\n\n@state rng = 1.0;\n@state lastSr = 0.0;\n@state lastGrain = -1.0;\n\n// low-cut: two one-pole highpasses in series\n@state hx1 = 0.0;\n@state hy1 = 0.0;\n@state hx2 = 0.0;\n@state hy2 = 0.0;\n\nfunction nextRand() {\n\trng = (rng * 16807.0) % 2147483647.0;\n\treturn rng / 2147483647.0;\n}\n\n// Eq. 1: k-th pulse inside grid cell k, signed, assigned a random width group\nfunction makeBranch(b: Int, sr: number, density: number) {\n\tlet lenS = loopLen[b];\n\tlet k: Int = clamp(floor(density * 0.25 * lenS / sr + 0.5), 1, 32);\n\ttapCount[b] = k;\n\trng = 1234.0 + 7919.0 * b;\n\tlet td = lenS / k;\n\tlet amp = 1.0 / sqrt(k * 1.0);\n\tfor (let m: Int = 0; m < k; m++) {\n\t\tlet r = nextRand();\n\t\tlet p: Int = clamp(floor(m * td + r * (td - 1.0) + 0.5), 0, lenS - 1);\n\t\ttapPos[b][m] = p;\n\t\tlet sgn = 1.0;\n\t\tif (nextRand() < 0.5) {\n\t\t\tsgn = -1.0;\n\t\t}\n\t\ttapGain[b][m] = sgn * amp;\n\t\tlet gq: Int = clamp(floor(nextRand() * 4.0), 0, 3);\n\t\ttapGrp[b][m] = gq;\n\t}\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet x = 0.5 * (in1 + in2);\n\n// --- (Re)build the pulse tables when the rate or the density moves --------\nlet dens = clamp(grain_hz, 40.0, 1200.0);\nif (sr != lastSr || abs(dens - lastGrain) > 0.5) {\n\tloopLen[0] = clamp(floor(0.0971 * sr), 16, 32700);\n\tloopLen[1] = clamp(floor(0.1129 * sr), 16, 32700);\n\tloopLen[2] = clamp(floor(0.1277 * sr), 16, 32700);\n\tloopLen[3] = clamp(floor(0.1399 * sr), 16, 32700);\n\tfor (let b: Int = 0; b < 4; b++) {\n\t\tmakeBranch(b, sr, dens);\n\t}\n\tlastSr = sr;\n\tlastGrain = dens;\n}\n\n// --- Predelay (ms) ---------------------------------------------------------\npreBuf[preIdx] = x;\nlet preS: Int = clamp(floor(mstosamps(predelay_ms) + 0.5), 0, 65000);\nlet xp = preBuf[(preIdx - preS + 65536) & 65535];\npreIdx = (preIdx + 1) & 65535;\n\n// --- Low cut ---------------------------------------------------------------\nlet cutF = clamp(lowcut_hz, 10.0, sr * 0.45);\nlet cutR = exp(0.0 - 2.0 * pi * cutF / sr);\nlet ha = xp - hx1 + cutR * hy1;\nhx1 = xp;\nhy1 = ha;\nlet hb = ha - hx2 + cutR * hy2;\nhx2 = ha;\nhy2 = hb;\n\n// --- Dark velvet noise: four pulse widths as leaky running sums -----------\n// boxcar of width w has its -3 dB point near 0.443*sr/w\nlet dampF = clamp(damp_hz, 200.0, sr * 0.45);\nlet wMax = clamp(0.443 * sr / dampF, 1.0, 120.0);\nrawBuf[rawIdx] = hb;\nlet leak = 0.999;\nfor (let j: Int = 0; j < 4; j++) {\n\tlet w: Int = clamp(floor(wMax * (j + 1) * 0.25 + 0.5), 1, 120);\n\tlet aw = pow(leak, w * 1.0);\n\tlet old = rawBuf[(rawIdx - w + 256) & 255];\n\tlet s = leak * grpSum[j] + hb - aw * old;\n\tgrpSum[j] = s;\n\tgrpBuf[j][gIdx] = s * (1.0 - leak) / (1.0 - aw);\n}\nrawIdx = (rawIdx + 1) & 255;\n\n// --- Four EVN branches, each recirculating through G(z) -------------------\nlet rt60 = clamp(decay_s, 0.2, 10.0);\nlet lpC = 1.0 - exp(0.0 - 2.0 * pi * dampF / sr);\nlet br0 = 0.0;\nlet br1 = 0.0;\nlet br2 = 0.0;\nlet br3 = 0.0;\nlet gSum = 0.0;\nfor (let b: Int = 0; b < 4; b++) {\n\tlet fir = 0.0;\n\tlet k: Int = tapCount[b];\n\tfor (let m: Int = 0; m < k; m++) {\n\t\tlet gq: Int = tapGrp[b][m];\n\t\tlet p: Int = tapPos[b][m];\n\t\tfir += tapGain[b][m] * grpBuf[gq][(gIdx - p + 32768) & 32767];\n\t}\n\tlet lenS: Int = loopLen[b];\n\tlet back = loopBuf[b][(lIdx - lenS + 32768) & 32767];\n\tlet lp = loopLp[b] + lpC * (back - loopLp[b]);\n\tloopLp[b] = lp;\n\tlet g = exp(0.0 - 6.907755 * (lenS / sr) / rt60);\n\tgSum += g;\n\tlet y = fir + g * lp;\n\tloopBuf[b][lIdx] = y;\n\tif (b == 0) {\n\t\tbr0 = y;\n\t} else if (b == 1) {\n\t\tbr1 = y;\n\t} else if (b == 2) {\n\t\tbr2 = y;\n\t} else {\n\t\tbr3 = y;\n\t}\n}\ngIdx = (gIdx + 1) & 32767;\nlIdx = (lIdx + 1) & 32767;\n\n// --- Orthogonal sign mixing (§3.3): two decorrelated outputs -------------\nlet wetL = 0.5 * (br0 + br1 - br2 + br3);\nlet wetR = 0.5 * (br0 - br1 + br2 + br3);\n\n// level: the loop gain sets the tail energy, so normalise by it\nlet gMean = 0.25 * gSum;\nlet norm = 1.4 * sqrt(maximum(1.0 - gMean * gMean, 0.0001));\nlet sL = wetL * norm;\nlet sR = wetR * norm;\n\n// --- Width (mid/side) -----------------------------------------------------\nlet mid = 0.5 * (sL + sR);\nlet side = 0.5 * (sL - sR) * clamp(width, 0.0, 1.0);\n\nlet outG = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = (mid + side) * outG;\nout2 = (mid - side) * outG;\n"
                                    },
