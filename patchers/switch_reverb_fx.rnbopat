                                    "code": "// ============================================================================\n// rev_spring_dispersion_tank_v2.txt\n// A single-spring tank: dispersive echoes that chirp downward like a drip,\n// with a spring that has MASS: moving spring_ms stretches, overshoots, bounces\n// and rattles instead of just jumping.\n// From: Julian Parker & Stefan Bilbao, \"Spring Reverberation: A Physical\n//       Perspective\", DAFx-09 Paper 84, §3 (echo spacing TD, dispersion\n//       transition frequency FC), and Hannes Gamper, Julian Parker & Vesa\n//       Välimäki, \"Automated Calibration of a Parametric Spring Reverb Model\",\n//       DAFx-11 Paper 39, §2 (first-order allpass dispersion inside a delay\n//       loop).\n// 100% wet. No dry path, no limiter, no metering.\n// Inlets:\n//   in1 / in2: stereo audio\n//   in3: bound only (this tank has no pitch-relative parameter)\n//   in4: 0..1 one-bar phasor, bound only (no tempo-locked time in a spring)\n// Outlets:\n//   out1 / out2: stereo spring tank, wet only\n//\n// v2 changes (see paraminfo for the short version):\n//   - spring_ms is now driven through a mass-spring-damper, not read raw.\n//     Delay-time velocity = Doppler pitch bend on every recirculating echo.\n//   - Moving the spring injects a clang/rattle burst into the loop (whack).\n//   - Chirp steepens as the spring stretches (tension coupling).\n//   - Input now enters BEFORE the dispersion chain, so echo 1 chirps too.\n//   - disperse = 0 is now a true plain comb.\n//   - Loop delay is compensated, so spring_ms is the true echo spacing.\n//   - DC blocker + gentle tanh in the loop; buffers sized for up to 192 kHz.\n//   - predelay / disperse / damp are slewed (no zipper clicks).\n// ============================================================================\n\n@param({ min: 0, max: 150, exponent: 2 }) predelay_ms = 10;      // predelay\n@param({ min: 15, max: 90 }) spring_ms = 45;        // spring length\n@param({ min: 0, max: 1 }) disperse = 0.6;          // dispersion\n@param({ min: 0.4, max: 8, exponent: 2 }) decay_s = 2.5;         // decay\n@param({ min: 800, max: 12000, exponent: 2 }) damp_hz = 3500;    // damping\n@param({ min: 0, max: 1 }) width = 0.7;             // width\n@param({ min: 0, max: 1 }) elastic = 0.6;           // spring mass: 0 = instant jump (v1), up = slower + bouncier\n@param({ min: 0, max: 1 }) whack = 0.35;            // clang / rattle when the spring is moved\n@param({ min: -24, max: 12 }) out_gain_db = 0;      // output gain\n\n@state preBufL = new FixedSampleArray(32768);\n@state preBufR = new FixedSampleArray(32768);\n@state preIdx: Int = 0;\n\n@state springBufL = new FixedSampleArray(32768);\n@state springBufR = new FixedSampleArray(32768);\n@state spIdx: Int = 0;\n\n// Dispersion: 12 first-order allpasses per channel, x[n-1] / y[n-1] state.\n// (Raise 12 -> 24 in BOTH loops and in loopComp below for longer \"pew\" zaps.)\n@state dspXL = new FixedSampleArray(12);\n@state dspYL = new FixedSampleArray(12);\n@state dspXR = new FixedSampleArray(12);\n@state dspYR = new FixedSampleArray(12);\n\n@state lpL = 0.0;\n@state lpR = 0.0;\n@state dcXL = 0.0;\n@state dcYL = 0.0;\n@state dcXR = 0.0;\n@state dcYR = 0.0;\n\n// Spring body (mass-spring-damper acting on the delay length, in samples)\n@state inited: Int = 0;\n@state springPos = 0.0;\n@state springVel = 0.0;\n@state prevTgtMs = 0.0;\n@state whackEnv = 0.0;\n@state nPrevL = 0.0;\n@state nPrevR = 0.0;\n@state noiseGenL = new noise();   // generators are stateful in codebox~: declare, then .next()\n@state noiseGenR = new noise();   // separate instance per channel so the clang is decorrelated\n@state cosWc = 1.0;\n\n// Slewed copies of the other time-ish controls\n@state preSm = 0.0;\n@state dispSm = 0.0;\n@state dampSm = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet unused_in3 = in3; // keeps the in3 port present\nlet barIn = in4;      // accepted for the batch contract; no tempo-locked time here\n\nlet tgtMs = clamp(spring_ms, 15.0, 90.0);\nlet tgtSamps = mstosamps(tgtMs);\n\nif (inited == 0) {\n\tinited = 1;\n\tspringPos = tgtSamps;\n\tspringVel = 0.0;\n\tprevTgtMs = tgtMs;\n\tpreSm = clamp(mstosamps(predelay_ms), 1.0, 32700.0);\n\tdispSm = clamp(disperse, 0.0, 1.0);\n\tdampSm = clamp(damp_hz, 200.0, sr * 0.45);\n\tcosWc = cos(2.0 * pi * 1000.0 / sr);\n}\n\n// --- Slew the controls that otherwise click when moved ---------------------\nlet cSlow = 1.0 - exp(0.0 - 1.0 / (0.02 * sr));   // ~20 ms\nlet cPre = 1.0 - exp(0.0 - 1.0 / (0.04 * sr));    // ~40 ms (predelay glides like tape)\npreSm = preSm + cPre * (clamp(mstosamps(predelay_ms), 1.0, 32700.0) - preSm);\ndispSm = dispSm + cSlow * (clamp(disperse, 0.0, 1.0) - dispSm);\ndampSm = dampSm + cSlow * (clamp(damp_hz, 200.0, sr * 0.45) - dampSm);\n\n// --- Predelay (read position is identical for L and R) ---------------------\npreBufL[preIdx] = xL;\npreBufR[preIdx] = xR;\n\nlet preRead = preIdx - preSm;\nwhile (preRead < 0.0) { preRead += 32768.0; }\nlet preInt: Int = floor(preRead);\nlet preFrac = preRead - preInt;\nlet feedL = cubicinterp(preFrac,\n\tpreBufL[(preInt - 1 + 32768) & 32767],\n\tpreBufL[preInt & 32767],\n\tpreBufL[(preInt + 1) & 32767],\n\tpreBufL[(preInt + 2) & 32767]);\nlet feedR = cubicinterp(preFrac,\n\tpreBufR[(preInt - 1 + 32768) & 32767],\n\tpreBufR[preInt & 32767],\n\tpreBufR[(preInt + 1) & 32767],\n\tpreBufR[(preInt + 2) & 32767]);\n\npreIdx = (preIdx + 1) & 32767;\n\n// --- The spring body: a mass on a spring, pulled toward spring_ms ----------\n// elastic = 0 reproduces v1 (instant jump). Above that the delay length is a\n// damped oscillator: low elastic = quick critically-damped glide, high elastic\n// = slow and underdamped, so it overshoots and wobbles before settling.\n// Delay velocity (samples/sample) is a Doppler pitch bend on every echo:\n// shortening = pitch up, lengthening = pitch down. It is capped at +/-0.8\n// so the read head never runs backwards.\nlet el = clamp(elastic, 0.0, 1.0);\nif (el < 0.001) {\n\tspringPos = tgtSamps;\n\tspringVel = 0.0;\n} else {\n\tlet f0 = 60.0 * exp(0.0 - 3.2189 * el);        // 60 Hz .. 2.4 Hz\n\tlet w0 = minimum(2.0 * pi * f0 / sr, 0.5);\n\tlet zeta = 1.0 - 0.8 * el;                     // 1.0 .. 0.2\n\tspringVel = springVel + w0 * w0 * (tgtSamps - springPos) - 2.0 * zeta * w0 * springVel;\n\tspringVel = clamp(springVel, -0.8, 0.8);\n\tspringPos = springPos + springVel;\n}\n// End stops: let it overshoot the knob range a little, never past the buffer.\nlet stopLo = mstosamps(9.0);\nlet stopHi = mstosamps(103.0);\nif (springPos < stopLo) { springPos = stopLo; springVel = maximum(springVel, 0.0); }\nif (springPos > stopHi) { springPos = stopHi; springVel = minimum(springVel, 0.0); }\n\n// --- Whack: moving the spring jostles it -----------------------------------\n// A jump of the knob adds a burst that decays in ~30 ms; the spring's speed\n// adds a continuous rattle while it is in motion. Works with silent input,\n// like bumping a real tank.\nlet dTgt = tgtMs - prevTgtMs;\nprevTgtMs = tgtMs;\nlet whAmt = clamp(whack, 0.0, 1.0);\nlet whDecay = exp(0.0 - 1.0 / (0.03 * sr));\nwhackEnv = minimum(whackEnv * whDecay + minimum(abs(dTgt) * 0.05, 1.0) * whAmt, 1.0);\nlet exc = whackEnv + abs(springVel) * 0.5 * whAmt;\n\nlet nL = noiseGenL.next();\nlet nR = noiseGenR.next();\nlet clangL = (nL - nPrevL) * exc * 0.25;   // first-difference = high-passed noise\nlet clangR = (nR - nPrevR) * exc * 0.25;\nnPrevL = nL;\nnPrevR = nR;\n\n// --- Loop gain and damping (DAFx-09 §3: TD sets the echo spacing) ----------\nlet springSec = springPos / sr;\nlet rt60 = clamp(decay_s, 0.4, 8.0);\n// Every other gain in the loop is <= 1 (the 20 Hz DC blocker peaks at\n// 1.0013), so 0.995 is only a guard; at 0.975 a 15 ms spring topped out\n// at a 4 s decay whatever decay_s said\nlet gLoop = clamp(exp(0.0 - 6.907755 * springSec / rt60), 0.0, 0.995);\n\nlet dampC = 1.0 - exp(0.0 - 2.0 * pi * dampSm / sr);\n\n// Negative allpass coefficient: group delay is longest at DC and collapses at\n// Nyquist, which is the downward chirp of a real spring. disperse = 0 gives\n// coefficient 0, i.e. each stage is a plain 1-sample delay -> plain comb.\nlet gd = 0.0 - 0.85 * pow(maximum(dispSm, 0.0), 0.85);\n\n// Tension coupling: a stretching spring (springVel > 0) chirps harder, a\n// compressing one chirps less. Zero when elastic = 0.\nlet gdEff = clamp(gd * (1.0 + 0.5 * clamp(springVel, -0.8, 0.8)), 0.0 - 0.9, 0.0);\n\n// Loop delay compensation: the 12-stage chain adds group delay inside the\n// loop. Subtract its value at 1 kHz so spring_ms is the real echo spacing.\nlet loopComp = 12.0 * (1.0 - gd * gd) / (1.0 + 2.0 * gd * cosWc + gd * gd);\nlet dBase = springPos - loopComp;\n\n// --- Spring delay line read (two slightly different lengths for stereo) ----\nlet dSampsL = clamp(dBase, 8.0, 32700.0);\nlet dSampsR = clamp(dBase * 1.037, 8.0, 32700.0);\n\nlet readL = spIdx - dSampsL;\nwhile (readL < 0.0) { readL += 32768.0; }\nlet riL: Int = floor(readL);\nlet tapL = cubicinterp(readL - riL,\n\tspringBufL[(riL - 1 + 32768) & 32767],\n\tspringBufL[riL & 32767],\n\tspringBufL[(riL + 1) & 32767],\n\tspringBufL[(riL + 2) & 32767]);\n\nlet readR = spIdx - dSampsR;\nwhile (readR < 0.0) { readR += 32768.0; }\nlet riR: Int = floor(readR);\nlet tapR = cubicinterp(readR - riR,\n\tspringBufR[(riR - 1 + 32768) & 32767],\n\tspringBufR[riR & 32767],\n\tspringBufR[(riR + 1) & 32767],\n\tspringBufR[(riR + 2) & 32767]);\n\n// --- Damping, DC block, gentle saturation on the recirculating signal ------\nlpL = lpL + dampC * (tapL - lpL);\nlpR = lpR + dampC * (tapR - lpR);\n\nlet dcR = 1.0 - 2.0 * pi * 20.0 / sr;\nlet hpL = lpL - dcXL + dcR * dcYL;\ndcXL = lpL;\ndcYL = hpL;\nlet hpR = lpR - dcXR + dcR * dcYR;\ndcXR = lpR;\ndcYR = hpR;\n\n// tanh(0.7x)/0.7: unity at small signal, soft ceiling ~1.43. Dubby when hot.\nlet recL = tanh(hpL * 0.7) / 0.7;\nlet recR = tanh(hpR * 0.7) / 0.7;\n\n// --- Dispersion chain: input + recirculation + clang all get chirped -------\nlet dL = feedL + recL * gLoop + clangL;\nfor (let i: Int = 0; i < 12; i++) {\n\tlet vL = gdEff * (dL - dspYL[i]) + dspXL[i];\n\tdspXL[i] = dL;\n\tdspYL[i] = vL;\n\tdL = vL;\n}\n\nlet dR = feedR + recR * gLoop + clangR;\nfor (let i: Int = 0; i < 12; i++) {\n\tlet vR = gdEff * (dR - dspYR[i]) + dspXR[i];\n\tdspXR[i] = dR;\n\tdspYR[i] = vR;\n\tdR = vR;\n}\n\nspringBufL[spIdx] = dL;\nspringBufR[spIdx] = dR;\nspIdx = (spIdx + 1) & 32767;\n\n// Energy normalisation: a comb of feedback g carries 1/(1-g^2) of the input\n// energy, so scale by its inverse root to keep the wet level steady. The\n// (rt60 / 2.5)^0.15 term is measured: damping and dispersion eat more of a\n// long tail, which left decay 8 s ~5 dB under decay 0.4 s on the tuba\nlet norm = sqrt(maximum(1.0 - gLoop * gLoop, 0.0001)) * pow(rt60 / 2.5, 0.15);\nlet wetL = tapL * norm;\nlet wetR = tapR * norm;\n\n// --- Width (mid/side) ------------------------------------------------------\nlet mid = 0.5 * (wetL + wetR);\nlet side = 0.5 * (wetL - wetR) * clamp(width, 0.0, 1.0);\nlet oL = mid + side;\nlet oR = mid - side;\n\nlet g = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = oL * g;\nout2 = oR * g;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "nocache": 0,
                                        "expr": "",
                                        "safemath": 1,
                                        "code": "// ============================================================================\n// rev_spring_dispersion_tank_v2.txt\n// A single-spring tank: dispersive echoes that chirp downward like a drip,\n// with a spring that has MASS: moving spring_ms stretches, overshoots, bounces\n// and rattles instead of just jumping.\n// From: Julian Parker & Stefan Bilbao, \"Spring Reverberation: A Physical\n//       Perspective\", DAFx-09 Paper 84, §3 (echo spacing TD, dispersion\n//       transition frequency FC), and Hannes Gamper, Julian Parker & Vesa\n//       Välimäki, \"Automated Calibration of a Parametric Spring Reverb Model\",\n//       DAFx-11 Paper 39, §2 (first-order allpass dispersion inside a delay\n//       loop).\n// 100% wet. No dry path, no limiter, no metering.\n// Inlets:\n//   in1 / in2: stereo audio\n//   in3: bound only (this tank has no pitch-relative parameter)\n//   in4: 0..1 one-bar phasor, bound only (no tempo-locked time in a spring)\n// Outlets:\n//   out1 / out2: stereo spring tank, wet only\n//\n// v2 changes (see paraminfo for the short version):\n//   - spring_ms is now driven through a mass-spring-damper, not read raw.\n//     Delay-time velocity = Doppler pitch bend on every recirculating echo.\n//   - Moving the spring injects a clang/rattle burst into the loop (whack).\n//   - Chirp steepens as the spring stretches (tension coupling).\n//   - Input now enters BEFORE the dispersion chain, so echo 1 chirps too.\n//   - disperse = 0 is now a true plain comb.\n//   - Loop delay is compensated, so spring_ms is the true echo spacing.\n//   - DC blocker + gentle tanh in the loop; buffers sized for up to 192 kHz.\n//   - predelay / disperse / damp are slewed (no zipper clicks).\n// ============================================================================\n\n@param({ min: 0, max: 150, exponent: 2 }) predelay_ms = 10;      // predelay\n@param({ min: 15, max: 90 }) spring_ms = 45;        // spring length\n@param({ min: 0, max: 1 }) disperse = 0.6;          // dispersion\n@param({ min: 0.4, max: 8, exponent: 2 }) decay_s = 2.5;         // decay\n@param({ min: 800, max: 12000, exponent: 2 }) damp_hz = 3500;    // damping\n@param({ min: 0, max: 1 }) width = 0.7;             // width\n@param({ min: 0, max: 1 }) elastic = 0.6;           // spring mass: 0 = instant jump (v1), up = slower + bouncier\n@param({ min: 0, max: 1 }) whack = 0.35;            // clang / rattle when the spring is moved\n@param({ min: -24, max: 12 }) out_gain_db = 0;      // output gain\n\n@state preBufL = new FixedSampleArray(32768);\n@state preBufR = new FixedSampleArray(32768);\n@state preIdx: Int = 0;\n\n@state springBufL = new FixedSampleArray(32768);\n@state springBufR = new FixedSampleArray(32768);\n@state spIdx: Int = 0;\n\n// Dispersion: 12 first-order allpasses per channel, x[n-1] / y[n-1] state.\n// (Raise 12 -> 24 in BOTH loops and in loopComp below for longer \"pew\" zaps.)\n@state dspXL = new FixedSampleArray(12);\n@state dspYL = new FixedSampleArray(12);\n@state dspXR = new FixedSampleArray(12);\n@state dspYR = new FixedSampleArray(12);\n\n@state lpL = 0.0;\n@state lpR = 0.0;\n@state dcXL = 0.0;\n@state dcYL = 0.0;\n@state dcXR = 0.0;\n@state dcYR = 0.0;\n\n// Spring body (mass-spring-damper acting on the delay length, in samples)\n@state inited: Int = 0;\n@state springPos = 0.0;\n@state springVel = 0.0;\n@state prevTgtMs = 0.0;\n@state whackEnv = 0.0;\n@state nPrevL = 0.0;\n@state nPrevR = 0.0;\n@state noiseGenL = new noise();   // generators are stateful in codebox~: declare, then .next()\n@state noiseGenR = new noise();   // separate instance per channel so the clang is decorrelated\n@state cosWc = 1.0;\n\n// Slewed copies of the other time-ish controls\n@state preSm = 0.0;\n@state dispSm = 0.0;\n@state dampSm = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet unused_in3 = in3; // keeps the in3 port present\nlet barIn = in4;      // accepted for the batch contract; no tempo-locked time here\n\nlet tgtMs = clamp(spring_ms, 15.0, 90.0);\nlet tgtSamps = mstosamps(tgtMs);\n\nif (inited == 0) {\n\tinited = 1;\n\tspringPos = tgtSamps;\n\tspringVel = 0.0;\n\tprevTgtMs = tgtMs;\n\tpreSm = clamp(mstosamps(predelay_ms), 1.0, 32700.0);\n\tdispSm = clamp(disperse, 0.0, 1.0);\n\tdampSm = clamp(damp_hz, 200.0, sr * 0.45);\n\tcosWc = cos(2.0 * pi * 1000.0 / sr);\n}\n\n// --- Slew the controls that otherwise click when moved ---------------------\nlet cSlow = 1.0 - exp(0.0 - 1.0 / (0.02 * sr));   // ~20 ms\nlet cPre = 1.0 - exp(0.0 - 1.0 / (0.04 * sr));    // ~40 ms (predelay glides like tape)\npreSm = preSm + cPre * (clamp(mstosamps(predelay_ms), 1.0, 32700.0) - preSm);\ndispSm = dispSm + cSlow * (clamp(disperse, 0.0, 1.0) - dispSm);\ndampSm = dampSm + cSlow * (clamp(damp_hz, 200.0, sr * 0.45) - dampSm);\n\n// --- Predelay (read position is identical for L and R) ---------------------\npreBufL[preIdx] = xL;\npreBufR[preIdx] = xR;\n\nlet preRead = preIdx - preSm;\nwhile (preRead < 0.0) { preRead += 32768.0; }\nlet preInt: Int = floor(preRead);\nlet preFrac = preRead - preInt;\nlet feedL = cubicinterp(preFrac,\n\tpreBufL[(preInt - 1 + 32768) & 32767],\n\tpreBufL[preInt & 32767],\n\tpreBufL[(preInt + 1) & 32767],\n\tpreBufL[(preInt + 2) & 32767]);\nlet feedR = cubicinterp(preFrac,\n\tpreBufR[(preInt - 1 + 32768) & 32767],\n\tpreBufR[preInt & 32767],\n\tpreBufR[(preInt + 1) & 32767],\n\tpreBufR[(preInt + 2) & 32767]);\n\npreIdx = (preIdx + 1) & 32767;\n\n// --- The spring body: a mass on a spring, pulled toward spring_ms ----------\n// elastic = 0 reproduces v1 (instant jump). Above that the delay length is a\n// damped oscillator: low elastic = quick critically-damped glide, high elastic\n// = slow and underdamped, so it overshoots and wobbles before settling.\n// Delay velocity (samples/sample) is a Doppler pitch bend on every echo:\n// shortening = pitch up, lengthening = pitch down. It is capped at +/-0.8\n// so the read head never runs backwards.\nlet el = clamp(elastic, 0.0, 1.0);\nif (el < 0.001) {\n\tspringPos = tgtSamps;\n\tspringVel = 0.0;\n} else {\n\tlet f0 = 60.0 * exp(0.0 - 3.2189 * el);        // 60 Hz .. 2.4 Hz\n\tlet w0 = minimum(2.0 * pi * f0 / sr, 0.5);\n\tlet zeta = 1.0 - 0.8 * el;                     // 1.0 .. 0.2\n\tspringVel = springVel + w0 * w0 * (tgtSamps - springPos) - 2.0 * zeta * w0 * springVel;\n\tspringVel = clamp(springVel, -0.8, 0.8);\n\tspringPos = springPos + springVel;\n}\n// End stops: let it overshoot the knob range a little, never past the buffer.\nlet stopLo = mstosamps(9.0);\nlet stopHi = mstosamps(103.0);\nif (springPos < stopLo) { springPos = stopLo; springVel = maximum(springVel, 0.0); }\nif (springPos > stopHi) { springPos = stopHi; springVel = minimum(springVel, 0.0); }\n\n// --- Whack: moving the spring jostles it -----------------------------------\n// A jump of the knob adds a burst that decays in ~30 ms; the spring's speed\n// adds a continuous rattle while it is in motion. Works with silent input,\n// like bumping a real tank.\nlet dTgt = tgtMs - prevTgtMs;\nprevTgtMs = tgtMs;\nlet whAmt = clamp(whack, 0.0, 1.0);\nlet whDecay = exp(0.0 - 1.0 / (0.03 * sr));\nwhackEnv = minimum(whackEnv * whDecay + minimum(abs(dTgt) * 0.05, 1.0) * whAmt, 1.0);\nlet exc = whackEnv + abs(springVel) * 0.5 * whAmt;\n\nlet nL = noiseGenL.next();\nlet nR = noiseGenR.next();\nlet clangL = (nL - nPrevL) * exc * 0.25;   // first-difference = high-passed noise\nlet clangR = (nR - nPrevR) * exc * 0.25;\nnPrevL = nL;\nnPrevR = nR;\n\n// --- Loop gain and damping (DAFx-09 §3: TD sets the echo spacing) ----------\nlet springSec = springPos / sr;\nlet rt60 = clamp(decay_s, 0.4, 8.0);\n// Every other gain in the loop is <= 1 (the 20 Hz DC blocker peaks at\n// 1.0013), so 0.995 is only a guard; at 0.975 a 15 ms spring topped out\n// at a 4 s decay whatever decay_s said\nlet gLoop = clamp(exp(0.0 - 6.907755 * springSec / rt60), 0.0, 0.995);\n\nlet dampC = 1.0 - exp(0.0 - 2.0 * pi * dampSm / sr);\n\n// Negative allpass coefficient: group delay is longest at DC and collapses at\n// Nyquist, which is the downward chirp of a real spring. disperse = 0 gives\n// coefficient 0, i.e. each stage is a plain 1-sample delay -> plain comb.\nlet gd = 0.0 - 0.85 * pow(maximum(dispSm, 0.0), 0.85);\n\n// Tension coupling: a stretching spring (springVel > 0) chirps harder, a\n// compressing one chirps less. Zero when elastic = 0.\nlet gdEff = clamp(gd * (1.0 + 0.5 * clamp(springVel, -0.8, 0.8)), 0.0 - 0.9, 0.0);\n\n// Loop delay compensation: the 12-stage chain adds group delay inside the\n// loop. Subtract its value at 1 kHz so spring_ms is the real echo spacing.\nlet loopComp = 12.0 * (1.0 - gd * gd) / (1.0 + 2.0 * gd * cosWc + gd * gd);\nlet dBase = springPos - loopComp;\n\n// --- Spring delay line read (two slightly different lengths for stereo) ----\nlet dSampsL = clamp(dBase, 8.0, 32700.0);\nlet dSampsR = clamp(dBase * 1.037, 8.0, 32700.0);\n\nlet readL = spIdx - dSampsL;\nwhile (readL < 0.0) { readL += 32768.0; }\nlet riL: Int = floor(readL);\nlet tapL = cubicinterp(readL - riL,\n\tspringBufL[(riL - 1 + 32768) & 32767],\n\tspringBufL[riL & 32767],\n\tspringBufL[(riL + 1) & 32767],\n\tspringBufL[(riL + 2) & 32767]);\n\nlet readR = spIdx - dSampsR;\nwhile (readR < 0.0) { readR += 32768.0; }\nlet riR: Int = floor(readR);\nlet tapR = cubicinterp(readR - riR,\n\tspringBufR[(riR - 1 + 32768) & 32767],\n\tspringBufR[riR & 32767],\n\tspringBufR[(riR + 1) & 32767],\n\tspringBufR[(riR + 2) & 32767]);\n\n// --- Damping, DC block, gentle saturation on the recirculating signal ------\nlpL = lpL + dampC * (tapL - lpL);\nlpR = lpR + dampC * (tapR - lpR);\n\nlet dcR = 1.0 - 2.0 * pi * 20.0 / sr;\nlet hpL = lpL - dcXL + dcR * dcYL;\ndcXL = lpL;\ndcYL = hpL;\nlet hpR = lpR - dcXR + dcR * dcYR;\ndcXR = lpR;\ndcYR = hpR;\n\n// tanh(0.7x)/0.7: unity at small signal, soft ceiling ~1.43. Dubby when hot.\nlet recL = tanh(hpL * 0.7) / 0.7;\nlet recR = tanh(hpR * 0.7) / 0.7;\n\n// --- Dispersion chain: input + recirculation + clang all get chirped -------\nlet dL = feedL + recL * gLoop + clangL;\nfor (let i: Int = 0; i < 12; i++) {\n\tlet vL = gdEff * (dL - dspYL[i]) + dspXL[i];\n\tdspXL[i] = dL;\n\tdspYL[i] = vL;\n\tdL = vL;\n}\n\nlet dR = feedR + recR * gLoop + clangR;\nfor (let i: Int = 0; i < 12; i++) {\n\tlet vR = gdEff * (dR - dspYR[i]) + dspXR[i];\n\tdspXR[i] = dR;\n\tdspYR[i] = vR;\n\tdR = vR;\n}\n\nspringBufL[spIdx] = dL;\nspringBufR[spIdx] = dR;\nspIdx = (spIdx + 1) & 32767;\n\n// Energy normalisation: a comb of feedback g carries 1/(1-g^2) of the input\n// energy, so scale by its inverse root to keep the wet level steady. The\n// (rt60 / 2.5)^0.15 term is measured: damping and dispersion eat more of a\n// long tail, which left decay 8 s ~5 dB under decay 0.4 s on the tuba\nlet norm = sqrt(maximum(1.0 - gLoop * gLoop, 0.0001)) * pow(rt60 / 2.5, 0.15);\nlet wetL = tapL * norm;\nlet wetR = tapR * norm;\n\n// --- Width (mid/side) ------------------------------------------------------\nlet mid = 0.5 * (wetL + wetR);\nlet side = 0.5 * (wetL - wetR) * clamp(width, 0.0, 1.0);\nlet oL = mid + side;\nlet oR = mid - side;\n\nlet g = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = oL * g;\nout2 = oR * g;\n"
                                    },
                                    "rnbo_serial": 7,
