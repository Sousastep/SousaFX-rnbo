            },
            {
                "box": {
                    "code": "// ============================================================================\n// selector_ramp_24.txt — selector~ 24 @ramptime with a working linear ramp\n//\n// From: utility, no paper. Models Max/RNBO [selector~ 24 @ramptime <ms>], whose\n// ramptime is broken in RNBO. Choosing a new input crossfades linearly from\n// whatever is sounding now to the new input over ramp_ms.\n//\n// A change snapshots the current per-input gains and then moves every gain in a\n// straight line from its snapshot to its new target (1 for the selected input,\n// 0 for the others) with one shared ramp position. The gains therefore always\n// sum to 1 (or fall linearly to 0 when selecting 0 = off), and a change made\n// mid-ramp restarts a full ramp_ms crossfade from the current mix without a\n// jump.\n//\n// IO contract exception: this is a mono router, not a stereo effect.\n// Inlets:\n//   in1..in24: signal inputs 1..24\n// Outlets:\n//   out1: the selected input (crossfaded while ramping)\n// ============================================================================\n\n// Selected input (0 = off)\n@param({ min: 0, max: 24, steps: 25 }) selection = 1;\n// Ramp time\n@param({ min: 0.0, max: 5000.0, exponent: 3 }) ramp_ms = 200.0;\n\n@state gain = new FixedSampleArray(24);\n@state startGain = new FixedSampleArray(24);\n@state lastSel = -1;\n@state rampPos = 1.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet sel: Int = clamp(floor(selection + 0.5), 0, 24);\n\nif (sel != lastSel) {\n    if (lastSel < 0) {\n        // first sample: start on the selected input, no fade-in\n        for (let i: Int = 0; i < 24; i++) {\n            gain[i] = (i + 1 == sel) ? 1.0 : 0.0;\n        }\n        rampPos = 1.0;\n    } else {\n        for (let i: Int = 0; i < 24; i++) {\n            startGain[i] = gain[i];\n        }\n        rampPos = 0.0;\n    }\n    lastSel = sel;\n}\n\nif (rampPos < 1.0) {\n    let rampSamps = ramp_ms * 0.001 * sr;\n    let inc = rampSamps > 1.0 ? 1.0 / rampSamps : 1.0;\n    rampPos = minimum(rampPos + inc, 1.0);\n    for (let i: Int = 0; i < 24; i++) {\n        let tgt = (i + 1 == sel) ? 1.0 : 0.0;\n        let st = startGain[i];\n        gain[i] = st + (tgt - st) * rampPos;\n    }\n}\n\nout1 = gain[0] * in1\n     + gain[1] * in2\n     + gain[2] * in3\n     + gain[3] * in4\n     + gain[4] * in5\n     + gain[5] * in6\n     + gain[6] * in7\n     + gain[7] * in8\n     + gain[8] * in9\n     + gain[9] * in10\n     + gain[10] * in11\n     + gain[11] * in12\n     + gain[12] * in13\n     + gain[13] * in14\n     + gain[14] * in15\n     + gain[15] * in16\n     + gain[16] * in17\n     + gain[17] * in18\n     + gain[18] * in19\n     + gain[19] * in20\n     + gain[20] * in21\n     + gain[21] * in22\n     + gain[22] * in23\n     + gain[23] * in24;\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-2",
                    "maxclass": "codebox~",
                    "numinlets": 24,
                    "numoutlets": 1,
                    "outlettype": [ "signal" ],
                    "patching_rect": [ 350.0, 522.0, 620.0, 360.0 ],
                    "rnbo_classname": "codebox~",
                    "rnbo_extra_attributes": {
                        "nocache": 0,
                        "expr": "",
                        "code": "// ============================================================================\n// selector_ramp_24.txt — selector~ 24 @ramptime with a working linear ramp\n//\n// From: utility, no paper. Models Max/RNBO [selector~ 24 @ramptime <ms>], whose\n// ramptime is broken in RNBO. Choosing a new input crossfades linearly from\n// whatever is sounding now to the new input over ramp_ms.\n//\n// A change snapshots the current per-input gains and then moves every gain in a\n// straight line from its snapshot to its new target (1 for the selected input,\n// 0 for the others) with one shared ramp position. The gains therefore always\n// sum to 1 (or fall linearly to 0 when selecting 0 = off), and a change made\n// mid-ramp restarts a full ramp_ms crossfade from the current mix without a\n// jump.\n//\n// IO contract exception: this is a mono router, not a stereo effect.\n// Inlets:\n//   in1..in24: signal inputs 1..24\n// Outlets:\n//   out1: the selected input (crossfaded while ramping)\n// ============================================================================\n\n// Selected input (0 = off)\n@param({ min: 0, max: 24, steps: 25 }) selection = 1;\n// Ramp time\n@param({ min: 0.0, max: 5000.0, exponent: 3 }) ramp_ms = 200.0;\n\n@state gain = new FixedSampleArray(24);\n@state startGain = new FixedSampleArray(24);\n@state lastSel = -1;\n@state rampPos = 1.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet sel: Int = clamp(floor(selection + 0.5), 0, 24);\n\nif (sel != lastSel) {\n    if (lastSel < 0) {\n        // first sample: start on the selected input, no fade-in\n        for (let i: Int = 0; i < 24; i++) {\n            gain[i] = (i + 1 == sel) ? 1.0 : 0.0;\n        }\n        rampPos = 1.0;\n    } else {\n        for (let i: Int = 0; i < 24; i++) {\n            startGain[i] = gain[i];\n        }\n        rampPos = 0.0;\n    }\n    lastSel = sel;\n}\n\nif (rampPos < 1.0) {\n    let rampSamps = ramp_ms * 0.001 * sr;\n    let inc = rampSamps > 1.0 ? 1.0 / rampSamps : 1.0;\n    rampPos = minimum(rampPos + inc, 1.0);\n    for (let i: Int = 0; i < 24; i++) {\n        let tgt = (i + 1 == sel) ? 1.0 : 0.0;\n        let st = startGain[i];\n        gain[i] = st + (tgt - st) * rampPos;\n    }\n}\n\nout1 = gain[0] * in1\n     + gain[1] * in2\n     + gain[2] * in3\n     + gain[3] * in4\n     + gain[4] * in5\n     + gain[5] * in6\n     + gain[6] * in7\n     + gain[7] * in8\n     + gain[8] * in9\n     + gain[9] * in10\n     + gain[10] * in11\n     + gain[11] * in12\n     + gain[12] * in13\n     + gain[13] * in14\n     + gain[14] * in15\n     + gain[15] * in16\n     + gain[16] * in17\n     + gain[17] * in18\n     + gain[18] * in19\n     + gain[19] * in20\n     + gain[20] * in21\n     + gain[21] * in22\n     + gain[22] * in23\n     + gain[23] * in24;\n",
                        "safemath": 1
                    },
                    "rnbo_serial": 1,
                    "rnbo_uniqueid": "effect_code",
