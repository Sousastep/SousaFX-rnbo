                        "nocache": 0,
                        "code": "// ============================================================================\n// chorus_psychoacoustic_hyperbolic_itd.txt\n// Standalone Stereo Chorus Effect: Psychoacoustically Mapped Constant-Excursion\n// Hyperbolic Chorus with Interaural Time Delay (ITD) Spatial Panning\n// Implements William L. Martens & Atsushi Marui (DAFx-06, Paper p_149):\n// \"Categories of Perception for Vibrato, Flange, and Stereo Chorus: Mapping out the\n// Musically Useful Ranges of Modulation Rate and Depth for Delay-Based Effects\"\n// (Sections 1, 2.1 & 3, Eq. 1-3, Fig. 1-2).\n// Implements the two core psychoacoustic discoveries of the paper:\n//   1. Section 3 & Fig. 2 (Constant Pitch-Excursion Hyperbola):\n//      Listening tests proved that the musically useful chorus depth in microseconds\n//      is a linear function of modulation PERIOD (1 / Rate_Hz):\n//        Depth_lower(us) = 814 / Rate_Hz - 66\n//        Depth_upper(us) = 4800 / Rate_Hz - 350\n//      By coupling modulation depth inversely to modulation rate along this exact\n//      logistic-regression hyperbola, you can sweep Rate from 0.5 Hz to 9.0 Hz and\n//      the chorus NEVER becomes \"supra-useful\" (seasick/out-of-tune) or \"sub-useful\"!\n//   2. Section 2.1 (ITD Lead/Lag Spatial Stereo Chorus):\n//      Delays the unmodulated reference path by 0.5 ms (500 us) so the modulated\n//      chorus voices fluctuate symmetrically between LEADING and LAGGING the dry\n//      signal in time of arrival across the +/- 0.65 ms human Interaural Time Delay\n//      (ITD) horizon—making the tuba orbit circularly around the listener's head!\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: Optional Envelope Modulator [0..1] (shifts position within the useful zone)\n//   in4: Optional 1-Bar Phasor [0..1]\n// Outlets:\n//   out1: Left ITD Lead/Lag Hyperbolic Stereo Chorus Output\n//   out2: Right ITD Lead/Lag Hyperbolic Stereo Chorus Output\n\n@param({ min: 0.4, max: 9.0 }) mod_rate_hz = 3.2;\n@param({ min: 0.0, max: 1.0 }) perceptual_zone = 0.55;\n@param({ min: 0.0, max: 1.0 }) rate_depth_coupling = 0.85;\n@param({ min: 0.2, max: 2.5 }) itd_center_ms = 0.55;\n@param({ min: 0.0, max: 1.0 }) voice_quadrature = 0.65;\n@param({ min: 0.0, max: 1.0 }) dry_wet_mix = 0.50;\n\n// Stereo circular delay buffers (2048 samples per channel)\n@state itdBufL = new FixedSampleArray(2048);\n@state itdBufR = new FixedSampleArray(2048);\n@state writeIdx: Int = 0;\n\n// Dual quadrature LFO phasors\n@state lfoPh1 = new phasor();\n@state lfoPh2 = new phasor();\n@state prevBarIn = 0.0;\n@state smoothRate = 3.2;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = (abs(in2) > 0.0000001) ? in2 : xL;\nlet envMod = clamp(in3, 0.0, 1.0);\nlet barIn = in4;\n\nitdBufL[writeIdx] = xL;\nitdBufR[writeIdx] = xR;\n\n// --- 1. Martens & Marui Logistic-Regression Useful Depth Hyperbola (DAFx-06 Fig. 2) ---\nlet slew = 1.0 - exp(-1.0 / (0.008 * sr));\nsmoothRate += (clamp(mod_rate_hz, 0.4, 9.0) - smoothRate) * slew;\n\n// Effective rate clamped to [1.2 .. 9.0] Hz for the Fig. 2 regression equations\nlet rReg = clamp(smoothRate, 1.2, 9.0);\n// Lower boundary of musically useful region (microseconds): Depth_low = 814 * (1/Rate) - 66\nlet depthLowUs = clamp(814.0 / rReg - 66.0, 25.0, 800.0);\n// Upper boundary of musically useful region (microseconds): Depth_high = 4800 * (1/Rate) - 350\nlet depthHighUs = clamp(4800.0 / rReg - 350.0, 180.0, 2200.0);\n\n// perceptual_zone [0..1] interpolates from sub-useful threshold (0.0) through optimal center (0.5)\n// to supra-useful boundary (1.0)\nlet zone = clamp(perceptual_zone + 0.25 * envMod, 0.0, 1.0);\nlet hyperDepthMs = (depthLowUs + zone * (depthHighUs - depthLowUs)) * 0.001;\n\n// Allow blending between uncoupled manual depth (at 3 Hz reference) and rate-coupled hyperbola\nlet uncoupledDepthMs = (0.20 + zone * 1.05);\nlet coup = clamp(rate_depth_coupling, 0.0, 1.0);\nlet depthMs = linearinterp(coup, uncoupledDepthMs, hyperDepthMs);\n\n// --- 2. ITD Reference Delay so Modulated Signal Leads AND Lags Dry Signal (Sec 2.1) ---\n// Ensure center delay >= depthMs + 0.05 ms so delay stays strictly causal while leading/lagging\nlet centerMs = maximum(clamp(itd_center_ms, 0.2, 2.5), depthMs + 0.06);\nlet centerSamps = mstosamps(centerMs);\nlet modDepthSamps = mstosamps(depthMs);\n\n// Delayed unmodulated reference signals (at exactly centerSamps)\nlet rpRefL = writeIdx - clamp(centerSamps, 1.0, 2042.0);\nwhile (rpRefL < 0.0) { rpRefL += 2048.0; }\nlet iRefL: Int = floor(rpRefL);\nlet refDryL = cubicinterp(rpRefL - iRefL, itdBufL[(iRefL - 1 + 2048) & 2047], itdBufL[iRefL & 2047], itdBufL[(iRefL + 1) & 2047], itdBufL[(iRefL + 2) & 2047]);\n\nlet rpRefR = writeIdx - clamp(centerSamps, 1.0, 2042.0);\nwhile (rpRefR < 0.0) { rpRefR += 2048.0; }\nlet iRefR: Int = floor(rpRefR);\nlet refDryR = cubicinterp(rpRefR - iRefR, itdBufR[(iRefR - 1 + 2048) & 2047], itdBufR[iRefR & 2047], itdBufR[(iRefR + 1) & 2047], itdBufR[(iRefR + 2) & 2047]);\n\n// --- 3. Quadrature Circular Head-Orbit Delay Modulation (Sec 2.1) ---\nlet barActive = (abs(barIn - prevBarIn) > 0.000001 || (barIn > 0.001 && barIn < 0.999)) ? 1.0 : 0.0;\nprevBarIn = barIn;\n\nlet ph1 = barActive ? wrap(barIn * 2.0, 0.0, 1.0) : lfoPh1.next(smoothRate);\nlet ph2 = lfoPh2.next(smoothRate * 1.19); // Secondary chorus voice\n\nlet quadSpread = clamp(voice_quadrature, 0.0, 1.0);\nlet lfo1L = sin(2.0 * pi * ph1);\nlet lfo1R = sin(2.0 * pi * (ph1 + 0.25 + 0.25 * quadSpread));\nlet lfo2L = cos(2.0 * pi * ph2);\nlet lfo2R = 0.0 - cos(2.0 * pi * ph2);\n\n// Modulated taps swing both AHEAD of (< centerSamps) and BEHIND (> centerSamps) refDry!\nlet rpM1L = writeIdx - clamp(centerSamps + modDepthSamps * lfo1L, 1.0, 2042.0);\nwhile (rpM1L < 0.0) { rpM1L += 2048.0; }\nlet iM1L: Int = floor(rpM1L);\nlet mod1L = cubicinterp(rpM1L - iM1L, itdBufL[(iM1L - 1 + 2048) & 2047], itdBufL[iM1L & 2047], itdBufL[(iM1L + 1) & 2047], itdBufL[(iM1L + 2) & 2047]);\n\nlet rpM1R = writeIdx - clamp(centerSamps + modDepthSamps * lfo1R, 1.0, 2042.0);\nwhile (rpM1R < 0.0) { rpM1R += 2048.0; }\nlet iM1R: Int = floor(rpM1R);\nlet mod1R = cubicinterp(rpM1R - iM1R, itdBufR[(iM1R - 1 + 2048) & 2047], itdBufR[iM1R & 2047], itdBufR[(iM1R + 1) & 2047], itdBufR[(iM1R + 2) & 2047]);\n\nlet rpM2L = writeIdx - clamp(centerSamps * 1.35 + modDepthSamps * 0.7 * lfo2L, 1.0, 2042.0);\nwhile (rpM2L < 0.0) { rpM2L += 2048.0; }\nlet iM2L: Int = floor(rpM2L);\nlet mod2L = cubicinterp(rpM2L - iM2L, itdBufL[(iM2L - 1 + 2048) & 2047], itdBufL[iM2L & 2047], itdBufL[(iM2L + 1) & 2047], itdBufL[(iM2L + 2) & 2047]);\n\nlet rpM2R = writeIdx - clamp(centerSamps * 1.35 + modDepthSamps * 0.7 * lfo2R, 1.0, 2042.0);\nwhile (rpM2R < 0.0) { rpM2R += 2048.0; }\nlet iM2R: Int = floor(rpM2R);\nlet mod2R = cubicinterp(rpM2R - iM2R, itdBufR[(iM2R - 1 + 2048) & 2047], itdBufR[iM2R & 2047], itdBufR[(iM2R + 1) & 2047], itdBufR[(iM2R + 2) & 2047]);\n\nwriteIdx = (writeIdx + 1) & 2047;\n\nlet wetL = linearinterp(quadSpread * 0.45, mod1L, 0.7 * mod1L + 0.5 * mod2L);\nlet wetR = linearinterp(quadSpread * 0.45, mod1R, 0.7 * mod1R + 0.5 * mod2R);\n\n// In ITD Stereo Chorus (Sec 1 & 2.1), reference dry and leading/lagging modulated voices combine\nlet mix = clamp(dry_wet_mix, 0.0, 1.0);\nout1 = cos(mix * 0.5 * pi) * refDryL + sin(mix * 0.5 * pi) * wetL;\nout2 = cos(mix * 0.5 * pi) * refDryR + sin(mix * 0.5 * pi) * wetR;\n"
                    },
