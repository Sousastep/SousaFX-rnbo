            {
                "box": {
                    "id": "obj-9",
                    "maxclass": "newobj",
                    "numinlets": 4,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 2,
                            "revision": 0,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 1763.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "ai.lp_cat_dual_svf_ladder",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// lp_cat_dual_svf_ladder.txt — Octave CAT style 24 dB/oct lowpass: two\n//                              2-pole state-variable sections in cascade\n//                              inside one global (saturated) feedback loop\n//\n// From: K. J. Werner, R. McClellan, \"Moog Ladder Filter Generalizations Based\n//       on State Variable Filters\", DAFx-20 paper 70: §2 Eq. 2-6 (Moog loop,\n//       passband gain gdc = 1/(1 + 4k)), §3.1 Eq. 9-10 (CAT = two SVF\n//       sections H = wc^2 / (s^2 + 2 r wc s + wc^2) with global feedback,\n//       \"~CAT\" equal damping r ~ 1.064);\n//       R. McClellan, \"Stability Analysis of Time-Varying Virtual Analog\n//       Filters\", DAFx-26 paper 28: §SVF and ladder sections (trapezoidal\n//       SVF stays stable under audio-rate cutoff / resonance changes).\n//\n// Signal (per channel):\n//   G, S       = TPT SVF lowpass as y = G x + S (per section, from its state)\n//   K          = 4 r^2 k             (self-oscillation exactly at k = 1)\n//   u          = x - K y_est          (zero-delay solve of the linear loop)\n//   u          = tanh(drive u) / drive\n//   y          = SVF(SVF(u))\n//   out        = y * sqrt(1 + K) * peakComp(r)\n//     sqrt(1 + K): makes up half of the passband loss (in dB) that the\n//     feedback causes, so turning resonance up never gets louder overall;\n//     peakComp undoes half of the section peaks when r < 0.707.\n//\n// Inlets:\n//   in1 / in2: stereo audio\n//   in3: cutoff in Hz (held when <= 1 Hz; 600 Hz until the first value)\n//   in4: resonance 0..1 (k; 1 = edge of self-oscillation)\n// Outlets:\n//   out1 / out2: stereo (mono sum = plain stereo filter, see width)\n// No safety limiter, no metering.\n// ============================================================================\n\n// Section damping r (low = peaky sections, 1.064 = original CAT)\n@param({ min: 0.2, max: 1.2 }) damping = 0.7;\n// Loop saturation drive (dB)\n@param({ min: 0, max: 24 }) drive_db = 6;\n// Cutoff offset from in3 (semitones)\n@param({ min: -36, max: 36 }) freq_offset_st = 0;\n// Width (%): detuned side copy, cancels exactly in mono\n@param({ min: 0, max: 100 }) width = 50;\n\n// SVF integrator states: slot = channel * 2 + section (0 L, 1 R, 2 side copy)\n@state ic1 = new FixedSampleArray(6);\n@state ic2 = new FixedSampleArray(6);\n@state fHold = 600.0;\n@state fSm = 600.0;\n@state resSm = 0.0;\n\n// One TPT SVF lowpass step on state slot idx\nfunction svfLp(idx: Int, x: number, a1: number, a2: number, a3: number): number {\n\tlet v3 = x - ic2[idx];\n\tlet v1 = a1 * ic1[idx] + a2 * v3;\n\tlet v2 = ic2[idx] + a2 * ic1[idx] + a3 * v3;\n\tic1[idx] = 2.0 * v1 - ic1[idx];\n\tic2[idx] = 2.0 * v2 - ic2[idx];\n\treturn v2;\n}\n\n// Two SVF sections in a saturated global loop, channel ch\nfunction catLp(ch: Int, x: number, g: number, kd: number, kfb: number, drv: number): number {\n\tlet a1 = 1.0 / (1.0 + g * (g + kd));\n\tlet a2 = g * a1;\n\tlet a3 = g * a2;\n\tlet i0: Int = ch * 2;\n\tlet i1: Int = i0 + 1;\n\t// each section is y = a3 x + s\n\tlet s1 = ic2[i0] * (1.0 - a3) + a2 * ic1[i0];\n\tlet s2 = ic2[i1] * (1.0 - a3) + a2 * ic1[i1];\n\tlet yEst = (a3 * a3 * x + a3 * s1 + s2) / (1.0 + kfb * a3 * a3);\n\tlet u = tanh(drv * (x - kfb * yEst)) / drv;\n\tlet y1 = svfLp(i0, u, a1, a2, a3);\n\treturn svfLp(i1, y1, a1, a2, a3);\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet aSm = 1.0 - exp(-200.0 / sr);\n\n// --- Controls: in3 cutoff (held), in4 resonance, 5 ms smoothing --------------\nif (in3 > 1.0) {\n\tfHold = in3;\n}\nlet fTarget = clamp(fHold * exp2(clamp(freq_offset_st, -36.0, 36.0) / 12.0), 20.0, sr * 0.45);\nfSm = fSm + (fTarget - fSm) * aSm;\nresSm = resSm + (clamp(in4, 0.0, 1.0) - resSm) * aSm;\n\nlet r = clamp(damping, 0.2, 1.2);\nlet kd = 2.0 * r;\nlet kfb = 4.0 * r * r * resSm;\nlet drv = dbtoa(clamp(drive_db, 0.0, 24.0));\nlet peakComp = (r < 0.7071) ? 2.0 * r * sqrt(1.0 - r * r) : 1.0;\nlet makeup = sqrt(1.0 + kfb) * peakComp;\n\nlet wd = clamp(width, 0.0, 100.0) * 0.01;\nlet g = tan(pi * fSm / sr);\nlet gD = tan(pi * minimum(fSm * exp2(wd), sr * 0.45) / sr);\n\n// --- Filter: L, R, and a side copy on the mono sum tuned up to +1 octave ----\nlet yL = catLp(0, xL, g, kd, kfb, drv);\nlet yR = catLp(1, xR, g, kd, kfb, drv);\nlet yD = catLp(2, 0.5 * (xL + xR), gD, kd, kfb, drv);\nlet side = wd * (yD - 0.5 * (yL + yR));\n\nout1 = (yL + side) * makeup;\nout2 = (yR - side) * makeup;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "nocache": 0,
                                        "expr": "",
                                        "safemath": 1,
                                        "code": "// ============================================================================\n// lp_cat_dual_svf_ladder.txt — Octave CAT style 24 dB/oct lowpass: two\n//                              2-pole state-variable sections in cascade\n//                              inside one global (saturated) feedback loop\n//\n// From: K. J. Werner, R. McClellan, \"Moog Ladder Filter Generalizations Based\n//       on State Variable Filters\", DAFx-20 paper 70: §2 Eq. 2-6 (Moog loop,\n//       passband gain gdc = 1/(1 + 4k)), §3.1 Eq. 9-10 (CAT = two SVF\n//       sections H = wc^2 / (s^2 + 2 r wc s + wc^2) with global feedback,\n//       \"~CAT\" equal damping r ~ 1.064);\n//       R. McClellan, \"Stability Analysis of Time-Varying Virtual Analog\n//       Filters\", DAFx-26 paper 28: §SVF and ladder sections (trapezoidal\n//       SVF stays stable under audio-rate cutoff / resonance changes).\n//\n// Signal (per channel):\n//   G, S       = TPT SVF lowpass as y = G x + S (per section, from its state)\n//   K          = 4 r^2 k             (self-oscillation exactly at k = 1)\n//   u          = x - K y_est          (zero-delay solve of the linear loop)\n//   u          = tanh(drive u) / drive\n//   y          = SVF(SVF(u))\n//   out        = y * sqrt(1 + K) * peakComp(r)\n//     sqrt(1 + K): makes up half of the passband loss (in dB) that the\n//     feedback causes, so turning resonance up never gets louder overall;\n//     peakComp undoes half of the section peaks when r < 0.707.\n//\n// Inlets:\n//   in1 / in2: stereo audio\n//   in3: cutoff in Hz (held when <= 1 Hz; 600 Hz until the first value)\n//   in4: resonance 0..1 (k; 1 = edge of self-oscillation)\n// Outlets:\n//   out1 / out2: stereo (mono sum = plain stereo filter, see width)\n// No safety limiter, no metering.\n// ============================================================================\n\n// Section damping r (low = peaky sections, 1.064 = original CAT)\n@param({ min: 0.2, max: 1.2 }) damping = 0.7;\n// Loop saturation drive (dB)\n@param({ min: 0, max: 24 }) drive_db = 6;\n// Cutoff offset from in3 (semitones)\n@param({ min: -36, max: 36 }) freq_offset_st = 0;\n// Width (%): detuned side copy, cancels exactly in mono\n@param({ min: 0, max: 100 }) width = 50;\n\n// SVF integrator states: slot = channel * 2 + section (0 L, 1 R, 2 side copy)\n@state ic1 = new FixedSampleArray(6);\n@state ic2 = new FixedSampleArray(6);\n@state fHold = 600.0;\n@state fSm = 600.0;\n@state resSm = 0.0;\n\n// One TPT SVF lowpass step on state slot idx\nfunction svfLp(idx: Int, x: number, a1: number, a2: number, a3: number): number {\n\tlet v3 = x - ic2[idx];\n\tlet v1 = a1 * ic1[idx] + a2 * v3;\n\tlet v2 = ic2[idx] + a2 * ic1[idx] + a3 * v3;\n\tic1[idx] = 2.0 * v1 - ic1[idx];\n\tic2[idx] = 2.0 * v2 - ic2[idx];\n\treturn v2;\n}\n\n// Two SVF sections in a saturated global loop, channel ch\nfunction catLp(ch: Int, x: number, g: number, kd: number, kfb: number, drv: number): number {\n\tlet a1 = 1.0 / (1.0 + g * (g + kd));\n\tlet a2 = g * a1;\n\tlet a3 = g * a2;\n\tlet i0: Int = ch * 2;\n\tlet i1: Int = i0 + 1;\n\t// each section is y = a3 x + s\n\tlet s1 = ic2[i0] * (1.0 - a3) + a2 * ic1[i0];\n\tlet s2 = ic2[i1] * (1.0 - a3) + a2 * ic1[i1];\n\tlet yEst = (a3 * a3 * x + a3 * s1 + s2) / (1.0 + kfb * a3 * a3);\n\tlet u = tanh(drv * (x - kfb * yEst)) / drv;\n\tlet y1 = svfLp(i0, u, a1, a2, a3);\n\treturn svfLp(i1, y1, a1, a2, a3);\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet aSm = 1.0 - exp(-200.0 / sr);\n\n// --- Controls: in3 cutoff (held), in4 resonance, 5 ms smoothing --------------\nif (in3 > 1.0) {\n\tfHold = in3;\n}\nlet fTarget = clamp(fHold * exp2(clamp(freq_offset_st, -36.0, 36.0) / 12.0), 20.0, sr * 0.45);\nfSm = fSm + (fTarget - fSm) * aSm;\nresSm = resSm + (clamp(in4, 0.0, 1.0) - resSm) * aSm;\n\nlet r = clamp(damping, 0.2, 1.2);\nlet kd = 2.0 * r;\nlet kfb = 4.0 * r * r * resSm;\nlet drv = dbtoa(clamp(drive_db, 0.0, 24.0));\nlet peakComp = (r < 0.7071) ? 2.0 * r * sqrt(1.0 - r * r) : 1.0;\nlet makeup = sqrt(1.0 + kfb) * peakComp;\n\nlet wd = clamp(width, 0.0, 100.0) * 0.01;\nlet g = tan(pi * fSm / sr);\nlet gD = tan(pi * minimum(fSm * exp2(wd), sr * 0.45) / sr);\n\n// --- Filter: L, R, and a side copy on the mono sum tuned up to +1 octave ----\nlet yL = catLp(0, xL, g, kd, kfb, drv);\nlet yR = catLp(1, xR, g, kd, kfb, drv);\nlet yD = catLp(2, 0.5 * (xL + xR), gD, kd, kfb, drv);\nlet side = wd * (yD - 0.5 * (yL + yR));\n\nout1 = (yL + side) * makeup;\nout2 = (yR - side) * makeup;\n"
                                    },
                                    "rnbo_serial": 1,
                                    "rnbo_uniqueid": "effect_code",
                                    "rnboinfo": {
                                        "needsInstanceInfo": 1,
                                        "argnames": {
                                            "reset": {
                                                "attrOrProp": 1,
                                                "digest": "Reset all state and params to initial values",
