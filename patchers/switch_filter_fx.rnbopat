            {
                "box": {
                    "id": "obj-14",
                    "maxclass": "newobj",
                    "numinlets": 4,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 2,
                            "revision": 0,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 100.0, 100.0, 1711.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "ai.lp_pole_mixing_ota",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// ============================================================================\n// lp_pole_mixing_ota.txt — 4-stage OTA one-pole cascade with resonance\n//                          feedback; mixing the five stage taps morphs the\n//                          response LP4 -> LP2 -> BP2 -> HP2\n//\n// From: R. Trausmuth, A. Huovilainen, \"POWERWAVE - A High Performance Single\n//       Chip Interpolating Wavetable Synthesizer\", DAFx-05 P_293 §filter\n//       (mixing the outputs of the individual ladder stages gives the other\n//       responses; only the last tap = the original Moog lowpass);\n//       A. Huovilainen, \"Non-Linear Digital Implementation of the Moog\n//       Ladder Filter\", DAFx-04 P_061 §3-5 (OTA / transistor stage\n//       saturation at the input differential pair, feedback k up to 4);\n//       R. McClellan, \"Stability Analysis of Time-Varying Virtual Analog\n//       Filters\", DAFx-26 paper 28 §ladder (stable time-varying k range).\n//\n// Signal (per channel):\n//   y1..y4 = four TPT one-pole lowpasses in series, y0 = stage-1 input\n//   u      = x - k y4_est     (zero-delay solve of the linear loop)\n//   y0     = tanh(drive u) / drive\n//   out    = c0 y0 + c1 y1 + c2 y2 + c3 y3 + c4 y4   (pole mixing)\n//            LP4 (0,0,0,0,1)  LP2 (0,0,1,0,0)  BP2 (0,2,-2,0,0)\n//            HP2 (1,-2,1,0,0), crossfaded by shape\n//   k      = 4 * in4 (self-oscillation at 1)\n//   makeup = (1 + k)^(share / 2), share 1 (LP4) -> 0.5 (LP2) -> 0 (BP2,\n//            HP2): the y2 tap already rings 6 dB more than y4\n//\n// Inlets:\n//   in1 / in2: stereo audio\n//   in3: cutoff in Hz (held when <= 1 Hz; 600 Hz until the first value)\n//   in4: resonance 0..1 (1 = edge of self-oscillation)\n// Outlets:\n//   out1 / out2: stereo (mono sum = plain stereo filter, see width)\n// No safety limiter, no metering.\n// ============================================================================\n\n// Response: 0 LP4, 0.33 LP2, 0.67 BP2, 1 HP2 (crossfades in between)\n@param({ min: 0, max: 1 }) shape = 0;\n// Input stage saturation drive (dB)\n@param({ min: 0, max: 24 }) drive_db = 3;\n// Cutoff offset from in3 (semitones)\n@param({ min: -36, max: 36 }) freq_offset_st = 0;\n// Width (%): detuned side copy, cancels exactly in mono\n@param({ min: 0, max: 100 }) width = 50;\n\n// one-pole states: slot = channel * 4 + stage (0 L, 1 R, 2 side copy)\n@state s = new FixedSampleArray(12);\n@state fHold = 600.0;\n@state fSm = 600.0;\n@state resSm = 0.0;\n\n// TPT one-pole lowpass on slot idx, gg = g / (1 + g)\nfunction lp1(idx: Int, x: number, gg: number): number {\n\tlet v = (x - s[idx]) * gg;\n\tlet y = v + s[idx];\n\ts[idx] = y + v;\n\treturn y;\n}\n\n// Pole-mixed 4-stage cascade, channel ch\nfunction poleMix(ch: Int, x: number, gg: number, k: number, drv: number, c0: number, c1: number, c2: number, c4: number): number {\n\tlet b: Int = ch * 4;\n\tlet h = 1.0 - gg;\n\t// y4 = gg^4 u + sum, from the four states\n\tlet sum = gg * gg * gg * h * s[b] + gg * gg * h * s[b + 1] + gg * h * s[b + 2] + h * s[b + 3];\n\tlet g4 = gg * gg * gg * gg;\n\tlet y4Est = (g4 * x + sum) / (1.0 + k * g4);\n\tlet y0 = tanh(drv * (x - k * y4Est)) / drv;\n\tlet y1 = lp1(b, y0, gg);\n\tlet y2 = lp1(b + 1, y1, gg);\n\tlet y3 = lp1(b + 2, y2, gg);\n\tlet y4 = lp1(b + 3, y3, gg);\n\treturn c0 * y0 + c1 * y1 + c2 * y2 + c4 * y4;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet aSm = 1.0 - exp(-200.0 / sr);\n\n// --- Controls: in3 cutoff (held), in4 resonance, 5 ms smoothing --------------\nif (in3 > 1.0) {\n\tfHold = in3;\n}\nlet fTarget = clamp(fHold * exp2(clamp(freq_offset_st, -36.0, 36.0) / 12.0), 20.0, sr * 0.45);\nfSm = fSm + (fTarget - fSm) * aSm;\nresSm = resSm + (clamp(in4, 0.0, 1.0) - resSm) * aSm;\n\nlet k = 4.0 * resSm;\nlet drv = dbtoa(clamp(drive_db, 0.0, 24.0));\n\n// --- Pole-mixing coefficients (the y3 tap is unused by these four modes) ----\nlet m = clamp(shape, 0.0, 1.0) * 3.0;\nlet c0 = 0.0;\nlet c1 = 0.0;\nlet c2 = 0.0;\nlet c4 = 0.0;\nif (m < 1.0) {\n\tc2 = m;\n\tc4 = 1.0 - m;\n} else if (m < 2.0) {\n\tlet t = m - 1.0;\n\tc1 = 2.0 * t;\n\tc2 = 1.0 - 3.0 * t;\n} else {\n\tlet t = m - 2.0;\n\tc0 = t;\n\tc1 = 2.0 - 4.0 * t;\n\tc2 = -2.0 + 3.0 * t;\n}\nlet lpShare = clamp(1.0 - 0.5 * m, 0.0, 1.0);\nlet makeup = pow(1.0 + k, 0.5 * lpShare);\n\nlet wd = clamp(width, 0.0, 100.0) * 0.01;\nlet g = tan(pi * fSm / sr);\nlet gg = g / (1.0 + g);\nlet gD = tan(pi * minimum(fSm * exp2(wd), sr * 0.45) / sr);\nlet ggD = gD / (1.0 + gD);\n\n// --- Filter: L, R, and a side copy on the mono sum tuned up to +1 octave ----\nlet yL = poleMix(0, xL, gg, k, drv, c0, c1, c2, c4);\nlet yR = poleMix(1, xR, gg, k, drv, c0, c1, c2, c4);\nlet yD = poleMix(2, 0.5 * (xL + xR), ggD, k, drv, c0, c1, c2, c4);\nlet side = wd * (yD - 0.5 * (yL + yR));\n\nout1 = (yL + side) * makeup;\nout2 = (yR - side) * makeup;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "nocache": 0,
                                        "expr": "",
                                        "safemath": 1,
                                        "code": "// ============================================================================\n// lp_pole_mixing_ota.txt — 4-stage OTA one-pole cascade with resonance\n//                          feedback; mixing the five stage taps morphs the\n//                          response LP4 -> LP2 -> BP2 -> HP2\n//\n// From: R. Trausmuth, A. Huovilainen, \"POWERWAVE - A High Performance Single\n//       Chip Interpolating Wavetable Synthesizer\", DAFx-05 P_293 §filter\n//       (mixing the outputs of the individual ladder stages gives the other\n//       responses; only the last tap = the original Moog lowpass);\n//       A. Huovilainen, \"Non-Linear Digital Implementation of the Moog\n//       Ladder Filter\", DAFx-04 P_061 §3-5 (OTA / transistor stage\n//       saturation at the input differential pair, feedback k up to 4);\n//       R. McClellan, \"Stability Analysis of Time-Varying Virtual Analog\n//       Filters\", DAFx-26 paper 28 §ladder (stable time-varying k range).\n//\n// Signal (per channel):\n//   y1..y4 = four TPT one-pole lowpasses in series, y0 = stage-1 input\n//   u      = x - k y4_est     (zero-delay solve of the linear loop)\n//   y0     = tanh(drive u) / drive\n//   out    = c0 y0 + c1 y1 + c2 y2 + c3 y3 + c4 y4   (pole mixing)\n//            LP4 (0,0,0,0,1)  LP2 (0,0,1,0,0)  BP2 (0,2,-2,0,0)\n//            HP2 (1,-2,1,0,0), crossfaded by shape\n//   k      = 4 * in4 (self-oscillation at 1)\n//   makeup = (1 + k)^(share / 2), share 1 (LP4) -> 0.5 (LP2) -> 0 (BP2,\n//            HP2): the y2 tap already rings 6 dB more than y4\n//\n// Inlets:\n//   in1 / in2: stereo audio\n//   in3: cutoff in Hz (held when <= 1 Hz; 600 Hz until the first value)\n//   in4: resonance 0..1 (1 = edge of self-oscillation)\n// Outlets:\n//   out1 / out2: stereo (mono sum = plain stereo filter, see width)\n// No safety limiter, no metering.\n// ============================================================================\n\n// Response: 0 LP4, 0.33 LP2, 0.67 BP2, 1 HP2 (crossfades in between)\n@param({ min: 0, max: 1 }) shape = 0;\n// Input stage saturation drive (dB)\n@param({ min: 0, max: 24 }) drive_db = 3;\n// Cutoff offset from in3 (semitones)\n@param({ min: -36, max: 36 }) freq_offset_st = 0;\n// Width (%): detuned side copy, cancels exactly in mono\n@param({ min: 0, max: 100 }) width = 50;\n\n// one-pole states: slot = channel * 4 + stage (0 L, 1 R, 2 side copy)\n@state s = new FixedSampleArray(12);\n@state fHold = 600.0;\n@state fSm = 600.0;\n@state resSm = 0.0;\n\n// TPT one-pole lowpass on slot idx, gg = g / (1 + g)\nfunction lp1(idx: Int, x: number, gg: number): number {\n\tlet v = (x - s[idx]) * gg;\n\tlet y = v + s[idx];\n\ts[idx] = y + v;\n\treturn y;\n}\n\n// Pole-mixed 4-stage cascade, channel ch\nfunction poleMix(ch: Int, x: number, gg: number, k: number, drv: number, c0: number, c1: number, c2: number, c4: number): number {\n\tlet b: Int = ch * 4;\n\tlet h = 1.0 - gg;\n\t// y4 = gg^4 u + sum, from the four states\n\tlet sum = gg * gg * gg * h * s[b] + gg * gg * h * s[b + 1] + gg * h * s[b + 2] + h * s[b + 3];\n\tlet g4 = gg * gg * gg * gg;\n\tlet y4Est = (g4 * x + sum) / (1.0 + k * g4);\n\tlet y0 = tanh(drv * (x - k * y4Est)) / drv;\n\tlet y1 = lp1(b, y0, gg);\n\tlet y2 = lp1(b + 1, y1, gg);\n\tlet y3 = lp1(b + 2, y2, gg);\n\tlet y4 = lp1(b + 3, y3, gg);\n\treturn c0 * y0 + c1 * y1 + c2 * y2 + c4 * y4;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet aSm = 1.0 - exp(-200.0 / sr);\n\n// --- Controls: in3 cutoff (held), in4 resonance, 5 ms smoothing --------------\nif (in3 > 1.0) {\n\tfHold = in3;\n}\nlet fTarget = clamp(fHold * exp2(clamp(freq_offset_st, -36.0, 36.0) / 12.0), 20.0, sr * 0.45);\nfSm = fSm + (fTarget - fSm) * aSm;\nresSm = resSm + (clamp(in4, 0.0, 1.0) - resSm) * aSm;\n\nlet k = 4.0 * resSm;\nlet drv = dbtoa(clamp(drive_db, 0.0, 24.0));\n\n// --- Pole-mixing coefficients (the y3 tap is unused by these four modes) ----\nlet m = clamp(shape, 0.0, 1.0) * 3.0;\nlet c0 = 0.0;\nlet c1 = 0.0;\nlet c2 = 0.0;\nlet c4 = 0.0;\nif (m < 1.0) {\n\tc2 = m;\n\tc4 = 1.0 - m;\n} else if (m < 2.0) {\n\tlet t = m - 1.0;\n\tc1 = 2.0 * t;\n\tc2 = 1.0 - 3.0 * t;\n} else {\n\tlet t = m - 2.0;\n\tc0 = t;\n\tc1 = 2.0 - 4.0 * t;\n\tc2 = -2.0 + 3.0 * t;\n}\nlet lpShare = clamp(1.0 - 0.5 * m, 0.0, 1.0);\nlet makeup = pow(1.0 + k, 0.5 * lpShare);\n\nlet wd = clamp(width, 0.0, 100.0) * 0.01;\nlet g = tan(pi * fSm / sr);\nlet gg = g / (1.0 + g);\nlet gD = tan(pi * minimum(fSm * exp2(wd), sr * 0.45) / sr);\nlet ggD = gD / (1.0 + gD);\n\n// --- Filter: L, R, and a side copy on the mono sum tuned up to +1 octave ----\nlet yL = poleMix(0, xL, gg, k, drv, c0, c1, c2, c4);\nlet yR = poleMix(1, xR, gg, k, drv, c0, c1, c2, c4);\nlet yD = poleMix(2, 0.5 * (xL + xR), ggD, k, drv, c0, c1, c2, c4);\nlet side = wd * (yD - 0.5 * (yL + yR));\n\nout1 = (yL + side) * makeup;\nout2 = (yR - side) * makeup;\n"
                                    },
                                    "rnbo_serial": 1,
                                    "rnbo_uniqueid": "effect_code",
