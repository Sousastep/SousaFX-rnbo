            {
                "box": {
                    "code": "// BandbAss 0.02 by mrelwood — RNBO codebox~ DSP port.\n// in1/in2: main L/R; in3: kick sidechain; in4: optional second sidechain.\n// out1/out2: processed L/R. No graphics or passthrough sidechain outlets.\n// Source defaults to MONO (averages main inputs). Stereo still uses the\n// LEFT main envelope to control both channels, exactly as in the JSFX.\n// No kick input means no ducking after initial gain recovery: the source\n// does not implement the standalone compressor described in its about text.\n// attack/hold/release are original slider positions, not literal times;\n// the same nonlinear mappings are preserved.\n@param({ min: 100, max: 500 }) crossover = 200;\n@param({ min: -40, max: 0 }) threshold_kick = -20;\n@param({ min: -40, max: 0 }) threshold_bass = -20;\n@param({ min: 0, max: 50 }) attack = 0;\n@param({ min: 0, max: 100 }) hold = 0;\n@param({ min: 10, max: 300 }) release = 30;\n@param({ min: 0, max: 200 }) depth = 100;\n@param({ enum: [\"Mono\", \"Stereo\"] }) stereo = 0;\n// Auto is the original slider10 default (0). -1 disabled, +1 enabled.\n@param({ min: -1, max: 1 }) channel4 = 0;\n// Source threshold linking is only a GUI gesture, not a DSP operation.\n// Here linking explicitly makes threshold_bass follow threshold_kick.\n@param({ enum: [\"Separate\", \"Link\"] }) link_thresholds = 1;\n\n// Six independent five-biquad cascades: kick LP, main LP/HP,\n// right main LP/HP and optional second sidechain LP.\n@state filters = new FixedFloat64Array(6, 5, 4);\n// Per detector: peak, peak counter, envelope, envelope counter.\n@state envelopes = new FixedFloat64Array(4, 4);\n// Original JSFX instance variables start at zero, including compressor gain.\n@state gains = new FixedFloat64Array(3, 2);\n@state lpco = new FixedFloat64Array(5);\n@state hpco = new FixedFloat64Array(5);\n@state atts = 1;\n@state holds = 1;\n@state rels = 1;\n@state thr = 0.1;\n@state thr2 = 0.1;\n@state depth1 = 1;\n@state depth2 = 1;\n@state thirds = 0;\n@state secmode = 0;\n@state oldChannel4 = 99;\n@state sleepc = 0;\n@state sleeping = 0;\n@state frame: Int = 0;\nfunction dspsetup() { frame = 0; }\n\nfunction filterCascade(x, bank: Int, highpass) {\n    for (let stage: Int = 0; stage < 5; stage++) {\n        let y = 0;\n        if (highpass != 0) {\n            y = hpco[0]*x+hpco[1]*filters[bank][stage][0]+hpco[2]*filters[bank][stage][1]\n                -hpco[3]*filters[bank][stage][2]-hpco[4]*filters[bank][stage][3];\n        } else {\n            y = lpco[0]*x+lpco[1]*filters[bank][stage][0]+lpco[2]*filters[bank][stage][1]\n                -lpco[3]*filters[bank][stage][2]-lpco[4]*filters[bank][stage][3];\n        }\n        filters[bank][stage][1] = filters[bank][stage][0];\n        filters[bank][stage][0] = x;\n        filters[bank][stage][3] = filters[bank][stage][2];\n        filters[bank][stage][2] = y;\n        x = y;\n    }\n    return x;\n}\nfunction envelope(x, speed, bank: Int) {\n    let ina = abs(x);\n    let pk = envelopes[bank][0];\n    let pkc = envelopes[bank][1];\n    let flt = envelopes[bank][2];\n    let fc = envelopes[bank][3];\n    if (ina > pk) {\n        pk = ina;\n        pkc = 0;\n    } else {\n        let pkrels = samplerate()*(0.04-0.02*speed);\n        if (pkc < pkrels) pkc++;\n        pk -= (pk+(pk-ina))*0.001*(0.1+0.9*speed)*minimum(1, pkc/pkrels);\n        // EEL evaluates division by zero to zero. Make silence well-defined.\n        let ratio = 0;\n        if (pk != 0) ratio = ina/pk;\n        pkc /= 1+0.2*minimum(1, maximum(0, ratio-0.8)/0.2);\n    }\n    if (pk > flt) {\n        flt = pk;\n        fc = -holds-atts;\n    } else {\n        fc++;\n        if (fc > 0) flt -= (flt-pk)*0.003*minimum(1, fc/rels)/(1+(holds+atts)*0.001);\n    }\n    envelopes[bank][0] = pk;\n    envelopes[bank][1] = pkc;\n    envelopes[bank][2] = flt;\n    envelopes[bank][3] = fc;\n    return flt;\n}\nfunction compress(level, threshold, bank: Int) {\n    let target = 1;\n    if (level != 0) target = minimum(1, threshold/level);\n    let gain = gains[bank][0];\n    let rc = gains[bank][1];\n    if (target < gain) {\n        gain -= (gain-target)/atts;\n        rc = 0;\n    } else {\n        if (rc < rels) rc++;\n        gain += (target-gain)/(rels*0.4)*maximum(0, rc/rels);\n    }\n    gains[bank][0] = gain;\n    gains[bank][1] = rc;\n    return gain;\n}\nif (frame == 0) {\n    thr = pow(2, threshold_kick/6);\n    thr2 = pow(2, threshold_bass/6);\n    if (link_thresholds != 0) thr2 = thr;\n    let av = attack/50;\n    atts = samplerate()*((av*0.5+0.5*av*av)*50*0.001)+1;\n    let hv = hold/100;\n    holds = samplerate()*((hv*0.5+0.5*hv*hv)*100*0.001)+1;\n    let rv = (release-5)/295;\n    rels = samplerate()*((5+(rv*0.25+0.75*rv*rv)*295)*0.001)+1;\n    depth1 = minimum(1, depth/100);\n    depth2 = maximum(1, depth/100);\n    if (channel4 != oldChannel4) {\n        secmode = channel4;\n        oldChannel4 = channel4;\n    }\n    if (thirds > 100 && secmode == 0) secmode = 1;\n    let resonance = pow(10, 0.05*(5.2/5+1.5));\n    for (let mode: Int = 0; mode < 2; mode++) {\n        let frequency = crossover*1.2;\n        if (mode == 1) frequency = crossover*0.8;\n        let omega = PI*2*frequency/samplerate();\n        let k = 0.5*resonance*sin(omega);\n        let c1 = 0.5*(1-k)/(1+k);\n        let c2 = (0.5+c1)*cos(omega);\n        let c3 = (0.5+c1-c2)*0.25;\n        if (mode == 1) c3 = (0.5+c1+c2)*0.25;\n        if (mode == 0) {\n            lpco[0] = 2*c3; lpco[1] = 4*c3; lpco[2] = 2*c3;\n            lpco[3] = -2*c2; lpco[4] = 2*c1;\n        } else {\n            hpco[0] = 2*c3; hpco[1] = -4*c3; hpco[2] = 2*c3;\n            hpco[3] = -2*c2; hpco[4] = 2*c1;\n        }\n    }\n}\nif (in1 == 0 && in2 == 0) {\n    sleepc++;\n    if (sleepc > samplerate()*5) sleeping = 1;\n} else {\n    sleepc = 0;\n    sleeping = 0;\n}\nlet kicklp = filterCascade(in3, 0, 0);\nlet kickflt = envelope(kicklp, 1, 0);\nlet kickg = compress(kickflt, thr, 0);\nlet left = in1;\nlet right = in2;\nif (!sleeping) {\n    let main = (in1+in2)*0.5;\n    if (stereo != 0) main = in1;\n    let mainlp = filterCascade(main, 1, 0);\n    let mainhp = filterCascade(main, 2, 1);\n    let mainlp2 = 0;\n    let mainhp2 = 0;\n    if (stereo != 0) {\n        mainlp2 = filterCascade(in2, 3, 0);\n        mainhp2 = filterCascade(in2, 4, 1);\n        let unusedRightEnvelope = envelope(mainlp2, 0.1, 3);\n    }\n    let mainflt = envelope(mainlp, 0.1, 1);\n    if (secmode == 0) {\n        if (in4 != 0) thirds++;\n        else if (thirds > 0) thirds--;\n    }\n    let maincomp = 0;\n    let maing = 1;\n    if (secmode == 1) {\n        let seclp = filterCascade(in4, 5, 0);\n        let secflt = envelope(seclp, 0.3, 2);\n        let secg = compress(secflt, thr2, 2);\n        maincomp = compress(mainflt, thr, 1);\n        maing = pow(1-(1-maincomp)*(1-kickg*secg)*depth1, depth2);\n    } else {\n        maincomp = compress(mainflt, thr, 1);\n        maing = pow(1-(1-maincomp)*(1-pow(kickg,4))*depth1, depth2);\n    }\n    left = mainlp*maing+mainhp;\n    right = left;\n    if (stereo != 0) right = mainlp2*maing+mainhp2;\n}\nout1 = left;\nout2 = right;\nframe++;\nif (frame >= vectorsize()) frame = 0;\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-2",
                    "maxclass": "codebox~",
                    "numinlets": 4,
                    "numoutlets": 2,
                    "outlettype": [ "signal", "signal" ],
                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                    "rnbo_classname": "codebox~",
                    "rnbo_extra_attributes": {
                        "safemath": 1,
                        "expr": "",
                        "nocache": 0,
                        "code": "// BandbAss 0.02 by mrelwood — RNBO codebox~ DSP port.\n// in1/in2: main L/R; in3: kick sidechain; in4: optional second sidechain.\n// out1/out2: processed L/R. No graphics or passthrough sidechain outlets.\n// Source defaults to MONO (averages main inputs). Stereo still uses the\n// LEFT main envelope to control both channels, exactly as in the JSFX.\n// No kick input means no ducking after initial gain recovery: the source\n// does not implement the standalone compressor described in its about text.\n// attack/hold/release are original slider positions, not literal times;\n// the same nonlinear mappings are preserved.\n@param({ min: 100, max: 500 }) crossover = 200;\n@param({ min: -40, max: 0 }) threshold_kick = -20;\n@param({ min: -40, max: 0 }) threshold_bass = -20;\n@param({ min: 0, max: 50 }) attack = 0;\n@param({ min: 0, max: 100 }) hold = 0;\n@param({ min: 10, max: 300 }) release = 30;\n@param({ min: 0, max: 200 }) depth = 100;\n@param({ enum: [\"Mono\", \"Stereo\"] }) stereo = 0;\n// Auto is the original slider10 default (0). -1 disabled, +1 enabled.\n@param({ min: -1, max: 1 }) channel4 = 0;\n// Source threshold linking is only a GUI gesture, not a DSP operation.\n// Here linking explicitly makes threshold_bass follow threshold_kick.\n@param({ enum: [\"Separate\", \"Link\"] }) link_thresholds = 1;\n\n// Six independent five-biquad cascades: kick LP, main LP/HP,\n// right main LP/HP and optional second sidechain LP.\n@state filters = new FixedFloat64Array(6, 5, 4);\n// Per detector: peak, peak counter, envelope, envelope counter.\n@state envelopes = new FixedFloat64Array(4, 4);\n// Original JSFX instance variables start at zero, including compressor gain.\n@state gains = new FixedFloat64Array(3, 2);\n@state lpco = new FixedFloat64Array(5);\n@state hpco = new FixedFloat64Array(5);\n@state atts = 1;\n@state holds = 1;\n@state rels = 1;\n@state thr = 0.1;\n@state thr2 = 0.1;\n@state depth1 = 1;\n@state depth2 = 1;\n@state thirds = 0;\n@state secmode = 0;\n@state oldChannel4 = 99;\n@state sleepc = 0;\n@state sleeping = 0;\n@state frame: Int = 0;\nfunction dspsetup() { frame = 0; }\n\nfunction filterCascade(x, bank: Int, highpass) {\n    for (let stage: Int = 0; stage < 5; stage++) {\n        let y = 0;\n        if (highpass != 0) {\n            y = hpco[0]*x+hpco[1]*filters[bank][stage][0]+hpco[2]*filters[bank][stage][1]\n                -hpco[3]*filters[bank][stage][2]-hpco[4]*filters[bank][stage][3];\n        } else {\n            y = lpco[0]*x+lpco[1]*filters[bank][stage][0]+lpco[2]*filters[bank][stage][1]\n                -lpco[3]*filters[bank][stage][2]-lpco[4]*filters[bank][stage][3];\n        }\n        filters[bank][stage][1] = filters[bank][stage][0];\n        filters[bank][stage][0] = x;\n        filters[bank][stage][3] = filters[bank][stage][2];\n        filters[bank][stage][2] = y;\n        x = y;\n    }\n    return x;\n}\nfunction envelope(x, speed, bank: Int) {\n    let ina = abs(x);\n    let pk = envelopes[bank][0];\n    let pkc = envelopes[bank][1];\n    let flt = envelopes[bank][2];\n    let fc = envelopes[bank][3];\n    if (ina > pk) {\n        pk = ina;\n        pkc = 0;\n    } else {\n        let pkrels = samplerate()*(0.04-0.02*speed);\n        if (pkc < pkrels) pkc++;\n        pk -= (pk+(pk-ina))*0.001*(0.1+0.9*speed)*minimum(1, pkc/pkrels);\n        // EEL evaluates division by zero to zero. Make silence well-defined.\n        let ratio = 0;\n        if (pk != 0) ratio = ina/pk;\n        pkc /= 1+0.2*minimum(1, maximum(0, ratio-0.8)/0.2);\n    }\n    if (pk > flt) {\n        flt = pk;\n        fc = -holds-atts;\n    } else {\n        fc++;\n        if (fc > 0) flt -= (flt-pk)*0.003*minimum(1, fc/rels)/(1+(holds+atts)*0.001);\n    }\n    envelopes[bank][0] = pk;\n    envelopes[bank][1] = pkc;\n    envelopes[bank][2] = flt;\n    envelopes[bank][3] = fc;\n    return flt;\n}\nfunction compress(level, threshold, bank: Int) {\n    let target = 1;\n    if (level != 0) target = minimum(1, threshold/level);\n    let gain = gains[bank][0];\n    let rc = gains[bank][1];\n    if (target < gain) {\n        gain -= (gain-target)/atts;\n        rc = 0;\n    } else {\n        if (rc < rels) rc++;\n        gain += (target-gain)/(rels*0.4)*maximum(0, rc/rels);\n    }\n    gains[bank][0] = gain;\n    gains[bank][1] = rc;\n    return gain;\n}\nif (frame == 0) {\n    thr = pow(2, threshold_kick/6);\n    thr2 = pow(2, threshold_bass/6);\n    if (link_thresholds != 0) thr2 = thr;\n    let av = attack/50;\n    atts = samplerate()*((av*0.5+0.5*av*av)*50*0.001)+1;\n    let hv = hold/100;\n    holds = samplerate()*((hv*0.5+0.5*hv*hv)*100*0.001)+1;\n    let rv = (release-5)/295;\n    rels = samplerate()*((5+(rv*0.25+0.75*rv*rv)*295)*0.001)+1;\n    depth1 = minimum(1, depth/100);\n    depth2 = maximum(1, depth/100);\n    if (channel4 != oldChannel4) {\n        secmode = channel4;\n        oldChannel4 = channel4;\n    }\n    if (thirds > 100 && secmode == 0) secmode = 1;\n    let resonance = pow(10, 0.05*(5.2/5+1.5));\n    for (let mode: Int = 0; mode < 2; mode++) {\n        let frequency = crossover*1.2;\n        if (mode == 1) frequency = crossover*0.8;\n        let omega = PI*2*frequency/samplerate();\n        let k = 0.5*resonance*sin(omega);\n        let c1 = 0.5*(1-k)/(1+k);\n        let c2 = (0.5+c1)*cos(omega);\n        let c3 = (0.5+c1-c2)*0.25;\n        if (mode == 1) c3 = (0.5+c1+c2)*0.25;\n        if (mode == 0) {\n            lpco[0] = 2*c3; lpco[1] = 4*c3; lpco[2] = 2*c3;\n            lpco[3] = -2*c2; lpco[4] = 2*c1;\n        } else {\n            hpco[0] = 2*c3; hpco[1] = -4*c3; hpco[2] = 2*c3;\n            hpco[3] = -2*c2; hpco[4] = 2*c1;\n        }\n    }\n}\nif (in1 == 0 && in2 == 0) {\n    sleepc++;\n    if (sleepc > samplerate()*5) sleeping = 1;\n} else {\n    sleepc = 0;\n    sleeping = 0;\n}\nlet kicklp = filterCascade(in3, 0, 0);\nlet kickflt = envelope(kicklp, 1, 0);\nlet kickg = compress(kickflt, thr, 0);\nlet left = in1;\nlet right = in2;\nif (!sleeping) {\n    let main = (in1+in2)*0.5;\n    if (stereo != 0) main = in1;\n    let mainlp = filterCascade(main, 1, 0);\n    let mainhp = filterCascade(main, 2, 1);\n    let mainlp2 = 0;\n    let mainhp2 = 0;\n    if (stereo != 0) {\n        mainlp2 = filterCascade(in2, 3, 0);\n        mainhp2 = filterCascade(in2, 4, 1);\n        let unusedRightEnvelope = envelope(mainlp2, 0.1, 3);\n    }\n    let mainflt = envelope(mainlp, 0.1, 1);\n    if (secmode == 0) {\n        if (in4 != 0) thirds++;\n        else if (thirds > 0) thirds--;\n    }\n    let maincomp = 0;\n    let maing = 1;\n    if (secmode == 1) {\n        let seclp = filterCascade(in4, 5, 0);\n        let secflt = envelope(seclp, 0.3, 2);\n        let secg = compress(secflt, thr2, 2);\n        maincomp = compress(mainflt, thr, 1);\n        maing = pow(1-(1-maincomp)*(1-kickg*secg)*depth1, depth2);\n    } else {\n        maincomp = compress(mainflt, thr, 1);\n        maing = pow(1-(1-maincomp)*(1-pow(kickg,4))*depth1, depth2);\n    }\n    left = mainlp*maing+mainhp;\n    right = left;\n    if (stereo != 0) right = mainlp2*maing+mainhp2;\n}\nout1 = left;\nout2 = right;\nframe++;\nif (frame >= vectorsize()) frame = 0;\n"
                    },
