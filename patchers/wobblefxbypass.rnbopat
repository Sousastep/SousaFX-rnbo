                            },
                            {
                                "box": {
                                    "id": "obj-9",
                                    "maxclass": "newobj",
                                    "numinlets": 2,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patcher": {
                                        "fileversion": 1,
                                        "appversion": {
                                            "major": 9,
                                            "minor": 2,
                                            "revision": 0,
                                            "architecture": "x64",
                                            "modernui": 1
                                        },
                                        "classnamespace": "rnbo",
                                        "rect": [ 100.0, 100.0, 1996.0, 780.0 ],
                                        "default_fontname": "Lato",
                                        "title": "ai.chorus_supersaw_waveform_animator",
                                        "boxes": [
                                            {
                                                "box": {
                                                    "code": "// ============================================================================\n// chorus_supersaw_waveform_animator.txt\n// Standalone Stereo Chorus Effect: 7-Voice Unison \"Supersaw\" Waveform Animator\n// Implements Joseph Timoney, Victor Lazzarini, Jari Kleimola & Vesa Valimaki\n// (DAFx-14): \"Examining the Oscillator Waveform Animation Effect\"\n// (Sections 2, 3, 4 & 5, Eq. 1, 17-27, Fig. 1-7).\n// Unites BOTH unison waveform animation engines derived in the paper:\n//   1. Section 5 (Fig. 6-7, Eq. 24-27): 7-Voice Delay-Line Pitch-Shifter Ensemble\n//      for arbitrary live audio inputs! Uses 4 dual-windowed raised-cosine\n//      crossfaded ramp delay lines at symmetric transposition ratios\n//      (s, s^3, 1/s, 1/s^3 where s = 1 + df0/f0) plus 2 quadrature LFO chorus taps\n//      and the center dry voice so harmonic cluster bandwidth grows proportionally\n//      with harmonic number k (Eq. 1 & Fig. 7)!\n//   2. Section 3 & 4 (Fig. 1-5, Eq. 17-23): Hutchins Multi-Channel Triangle-LFO\n//      Comparator PWM Waveform Animator, peaking at duty-cycle width 0.70 (Fig. 5).\n//      The paper's input is a sawtooth of known amplitude A; for live audio the input is\n//      normalised by its peak envelope so the LFO threshold stays at 0.70 of the signal\n//      level, and the comparator output is scaled back by that envelope (silent in rests).\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: unused\n//   in4: unused\n// Outlets:\n//   out1: Left 7-Voice Unison Supersaw Animated Chorus Output\n//   out2: Right 7-Voice Unison Supersaw Animated Chorus Output\n\n@param({ min: 1.0, max: 45.0 }) unison_detune_cents = 14.0;     // outer voice detune\n@param({ min: 12.0, max: 45.0 }) grain_window_ms = 24.0;        // shifter window\n@param({ min: 0.0, max: 1.0 }) hutchins_pwm_anim = 0.25;        // PWM animator depth\n@param({ min: 0.1, max: 2.0 }) pwm_lfo_rate_hz = 0.65;          // animator LFO rate\n@param({ min: 0.0, max: 1.0 }) stereo_voice_spread = 0.85;      // stereo spread\n@param({ min: 0.0, max: 1.0 }) center_to_side_mix = 0.65;       // side voice level\n\n// Circular delay buffers for the 4 dual-grain pitch-shifter voices + 2 LFO voices\n// (16384 samples: the 45 ms window plus margin fits at 192 kHz)\n@state animBufL = new FixedSampleArray(16384);\n@state animBufR = new FixedSampleArray(16384);\n@state writeIdx: Int = 0;\n\n// Ramp phases gamma_1..gamma_4 for transpositions s, s^3, 1/s, 1/s^3 (DAFx-14 Eq. 24-27, Fig. 6)\n@state rampPh = new FixedSampleArray(4);\n\n// 3 Independent slow triangle LFOs (< 2 Hz) for Hutchins Comparator Animator (Sec 3, Fig. 1)\n@state triPh1 = new phasor();\n@state triPh2 = new phasor();\n@state triPh3 = new phasor();\n@state dcXL = 0.0; @state dcYL = 0.0;\n@state dcXR = 0.0; @state dcYR = 0.0;\n// Peak envelopes that normalise the live input for the Hutchins comparators\n@state envPkL = 0.0; @state envPkR = 0.0;\n@state in2Hold = 0.0;\n\n// Evaluate dual-head raised-cosine windowed pitch shifter (DAFx-14 Sec 5, Eq. 24-27)\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\n// in2 counts as patched for 250 ms after any non-zero sample (a per-sample test\n// would swap in xL for single samples at in2's zero crossings)\nif (abs(in2) > 0.0000001) {\n\tin2Hold = 0.25 * sr;\n} else if (in2Hold > 0.0) {\n\tin2Hold -= 1.0;\n}\nlet xR = (in2Hold > 0.0) ? in2 : xL;\n\nanimBufL[writeIdx] = xL;\nanimBufR[writeIdx] = xR;\n\n// --- 1. 7-Voice Delay-Line Pitch-Shifter Unison Bank (DAFx-14 Sec 5, Fig. 6-7) ---\n// Transposition factor s = 2^(cents / 1200) -> four shifters at s, s^3, 1/s, 1/s^3\nlet cents = clamp(unison_detune_cents, 1.0, 45.0) * 0.3333; // per-step spacing so s^3 = full detune\nlet sRatio = pow(2.0, cents / 1200.0);\nlet s3Ratio = sRatio * sRatio * sRatio;\nlet invSRatio = 1.0 / sRatio;\nlet invS3Ratio = 1.0 / s3Ratio;\n\nlet tauSamps = clamp(mstosamps(clamp(grain_window_ms, 12.0, 45.0)), 256.0, 16370.0);\n\n// Eq. 25: delay growth rate dD/dt = 1 - s, normalized by window length tauSamps\nlet inc0 = (1.0 - sRatio) / tauSamps;\nlet inc1 = (1.0 - s3Ratio) / tauSamps;\nlet inc2 = (1.0 - invSRatio) / tauSamps;\nlet inc3 = (1.0 - invS3Ratio) / tauSamps;\n\nrampPh[0] = wrap(rampPh[0] + inc0, 0.0, 1.0);\nrampPh[1] = wrap(rampPh[1] + inc1, 0.0, 1.0);\nrampPh[2] = wrap(rampPh[2] + inc2, 0.0, 1.0);\nrampPh[3] = wrap(rampPh[3] + inc3, 0.0, 1.0);\n\n// Voices +1 (s) and -3 (1/s^3) biased Left; Voices -1 (1/s) and +3 (s^3) biased Right\n// Dual-head raised-cosine windowed pitch shifter (DAFx-14 Sec 5, Eq. 24-27), inlined per voice\nlet g1A = wrap(rampPh[0], 0.0, 1.0);\nlet g2A = wrap(g1A + 0.5, 0.0, 1.0);\nlet w1A = 0.5 * (1.0 - cos(2.0 * pi * g1A));\nlet w2A = 1.0 - w1A;\nlet d1A = 4.0 + g1A * tauSamps;\nlet rp1A = writeIdx - clamp(d1A, 2.0, 16378.0);\nwhile (rp1A < 0.0) { rp1A += 16384.0; }\nlet i1A: Int = floor(rp1A);\nlet r1A = cubicinterp(rp1A - i1A, animBufL[(i1A - 1 + 16384) & 16383], animBufL[i1A & 16383], animBufL[(i1A + 1) & 16383], animBufL[(i1A + 2) & 16383]);\nlet d2A = 4.0 + g2A * tauSamps;\nlet rp2A = writeIdx - clamp(d2A, 2.0, 16378.0);\nwhile (rp2A < 0.0) { rp2A += 16384.0; }\nlet i2A: Int = floor(rp2A);\nlet r2A = cubicinterp(rp2A - i2A, animBufL[(i2A - 1 + 16384) & 16383], animBufL[i2A & 16383], animBufL[(i2A + 1) & 16383], animBufL[(i2A + 2) & 16383]);\nlet vUp1L = w1A * r1A + w2A * r2A;\n\nlet g1B = wrap(rampPh[1], 0.0, 1.0);\nlet g2B = wrap(g1B + 0.5, 0.0, 1.0);\nlet w1B = 0.5 * (1.0 - cos(2.0 * pi * g1B));\nlet w2B = 1.0 - w1B;\nlet d1B = 4.0 + g1B * tauSamps;\nlet rp1B = writeIdx - clamp(d1B, 2.0, 16378.0);\nwhile (rp1B < 0.0) { rp1B += 16384.0; }\nlet i1B: Int = floor(rp1B);\nlet r1B = cubicinterp(rp1B - i1B, animBufR[(i1B - 1 + 16384) & 16383], animBufR[i1B & 16383], animBufR[(i1B + 1) & 16383], animBufR[(i1B + 2) & 16383]);\nlet d2B = 4.0 + g2B * tauSamps;\nlet rp2B = writeIdx - clamp(d2B, 2.0, 16378.0);\nwhile (rp2B < 0.0) { rp2B += 16384.0; }\nlet i2B: Int = floor(rp2B);\nlet r2B = cubicinterp(rp2B - i2B, animBufR[(i2B - 1 + 16384) & 16383], animBufR[i2B & 16383], animBufR[(i2B + 1) & 16383], animBufR[(i2B + 2) & 16383]);\nlet vUp3R = w1B * r1B + w2B * r2B;\n\nlet g1C = wrap(rampPh[2], 0.0, 1.0);\nlet g2C = wrap(g1C + 0.5, 0.0, 1.0);\nlet w1C = 0.5 * (1.0 - cos(2.0 * pi * g1C));\nlet w2C = 1.0 - w1C;\nlet d1C = 4.0 + g1C * tauSamps;\nlet rp1C = writeIdx - clamp(d1C, 2.0, 16378.0);\nwhile (rp1C < 0.0) { rp1C += 16384.0; }\nlet i1C: Int = floor(rp1C);\nlet r1C = cubicinterp(rp1C - i1C, animBufR[(i1C - 1 + 16384) & 16383], animBufR[i1C & 16383], animBufR[(i1C + 1) & 16383], animBufR[(i1C + 2) & 16383]);\nlet d2C = 4.0 + g2C * tauSamps;\nlet rp2C = writeIdx - clamp(d2C, 2.0, 16378.0);\nwhile (rp2C < 0.0) { rp2C += 16384.0; }\nlet i2C: Int = floor(rp2C);\nlet r2C = cubicinterp(rp2C - i2C, animBufR[(i2C - 1 + 16384) & 16383], animBufR[i2C & 16383], animBufR[(i2C + 1) & 16383], animBufR[(i2C + 2) & 16383]);\nlet vDn1R = w1C * r1C + w2C * r2C;\n\nlet g1D = wrap(rampPh[3], 0.0, 1.0);\nlet g2D = wrap(g1D + 0.5, 0.0, 1.0);\nlet w1D = 0.5 * (1.0 - cos(2.0 * pi * g1D));\nlet w2D = 1.0 - w1D;\nlet d1D = 4.0 + g1D * tauSamps;\nlet rp1D = writeIdx - clamp(d1D, 2.0, 16378.0);\nwhile (rp1D < 0.0) { rp1D += 16384.0; }\nlet i1D: Int = floor(rp1D);\nlet r1D = cubicinterp(rp1D - i1D, animBufL[(i1D - 1 + 16384) & 16383], animBufL[i1D & 16383], animBufL[(i1D + 1) & 16383], animBufL[(i1D + 2) & 16383]);\nlet d2D = 4.0 + g2D * tauSamps;\nlet rp2D = writeIdx - clamp(d2D, 2.0, 16378.0);\nwhile (rp2D < 0.0) { rp2D += 16384.0; }\nlet i2D: Int = floor(rp2D);\nlet r2D = cubicinterp(rp2D - i2D, animBufL[(i2D - 1 + 16384) & 16383], animBufL[i2D & 16383], animBufL[(i2D + 1) & 16383], animBufL[(i2D + 2) & 16383]);\nlet vDn3L = w1D * r1D + w2D * r2D;\n\n// --- 2. Hutchins Multi-Channel Comparator PWM Animator + LFO Voices 5 & 6 (Sec 3 & 4) ---\n// Fig. 5: Optimal first-sideband magnitude occurs at duty-cycle width 0.70 (LFO amp = 0.70 * A)\nlet lfoRate = clamp(pwm_lfo_rate_hz, 0.1, 2.0);\nlet t1 = 2.0 * triangle(triPh1.next(lfoRate * 0.73), 0.5) - 1.0;\nlet t2 = 2.0 * triangle(triPh2.next(lfoRate * 1.00), 0.5) - 1.0;\nlet t3 = 2.0 * triangle(triPh3.next(lfoRate * 1.37), 0.5) - 1.0;\n\n// Voices 5 & 6: Smoothly modulated delay-line unison voices (3.75 / 4.375 ms +/- 2.92 ms)\nlet rpV5L = writeIdx - clamp(mstosamps(3.75 + 2.92 * t1), 2.0, 16378.0);\nwhile (rpV5L < 0.0) { rpV5L += 16384.0; }\nlet iV5L: Int = floor(rpV5L);\nlet vLfo5L = cubicinterp(rpV5L - iV5L, animBufL[(iV5L - 1 + 16384) & 16383], animBufL[iV5L & 16383], animBufL[(iV5L + 1) & 16383], animBufL[(iV5L + 2) & 16383]);\n\nlet rpV6R = writeIdx - clamp(mstosamps(4.375 + 2.92 * t2), 2.0, 16378.0);\nwhile (rpV6R < 0.0) { rpV6R += 16384.0; }\nlet iV6R: Int = floor(rpV6R);\nlet vLfo6R = cubicinterp(rpV6R - iV6R, animBufR[(iV6R - 1 + 16384) & 16383], animBufR[iV6R & 16383], animBufR[(iV6R + 1) & 16383], animBufR[(iV6R + 2) & 16383]);\n\nwriteIdx = (writeIdx + 1) & 16383;\n\n// Hutchins Soft-Comparator PWM Animator (Fig. 1-3, Eq. 2-17):\n// Compare the envelope-normalised signal u = x / env against a slow triangle LFO scaled by\n// the 0.70 optimal duty-cycle width (Fig. 5), then subtract the smooth comparator step,\n// scaled back by env so the pulse tracks the playing level and vanishes in rests\nlet pwmAmt = clamp(hutchins_pwm_anim, 0.0, 1.0);\nlet pkRel = exp(-1.0 / (0.08 * sr));\nenvPkL = maximum(abs(xL), envPkL * pkRel);\nenvPkR = maximum(abs(xR), envPkR * pkRel);\nlet uL = xL / (envPkL + 0.0001);\nlet uR = xR / (envPkR + 0.0001);\n\nlet comp1L = 0.5 * tanh(12.0 * (uL - 0.70 * t1)) * envPkL;\nlet comp2L = 0.5 * tanh(12.0 * (uL - 0.70 * t3)) * envPkL;\nlet hutchL = xL - pwmAmt * 0.45 * (comp1L + comp2L);\n\nlet comp1R = 0.5 * tanh(12.0 * (uR - 0.70 * t2)) * envPkR;\nlet comp2R = 0.5 * tanh(12.0 * (uR + 0.70 * t3)) * envPkR;\nlet hutchR = xR - pwmAmt * 0.45 * (comp1R + comp2R);\n\nlet animCleanL = hutchL - dcXL + 0.995 * dcYL;\ndcXL = hutchL; dcYL = animCleanL;\nlet animCleanR = hutchR - dcXR + 0.995 * dcYR;\ndcXR = hutchR; dcYR = animCleanR;\n\n// --- 3. 7-Voice Stereo Panning & Center/Side Unison Mix (JP-8000 Supersaw Style) ---\nlet stSpread = clamp(stereo_voice_spread, 0.0, 1.0);\nlet cross = 1.0 - 0.75 * stSpread;\n\nlet sideClusterL = (vUp1L + vDn3L + 0.85 * vLfo5L + cross * (vDn1R + vUp3R + 0.85 * vLfo6R)) * 0.35;\nlet sideClusterR = (vDn1R + vUp3R + 0.85 * vLfo6R + cross * (vUp1L + vDn3L + 0.85 * vLfo5L)) * 0.35;\n\nlet sideMix = clamp(center_to_side_mix, 0.0, 1.0);\nout1 = linearinterp(sideMix * 0.75, animCleanL, animCleanL * 0.65 + sideClusterL);\nout2 = linearinterp(sideMix * 0.75, animCleanR, animCleanR * 0.65 + sideClusterR);\n",
                                                    "fontface": 0,
                                                    "fontname": "<Monospaced>",
                                                    "fontsize": 12.0,
                                                    "id": "obj-2",
                                                    "maxclass": "codebox~",
                                                    "numinlets": 2,
                                                    "numoutlets": 2,
                                                    "outlettype": [ "signal", "signal" ],
                                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                                    "rnbo_classname": "codebox~",
                                                    "rnbo_extra_attributes": {
                                                        "nocache": 0,
                                                        "expr": "",
                                                        "safemath": 1,
                                                        "code": "// ============================================================================\n// chorus_supersaw_waveform_animator.txt\n// Standalone Stereo Chorus Effect: 7-Voice Unison \"Supersaw\" Waveform Animator\n// Implements Joseph Timoney, Victor Lazzarini, Jari Kleimola & Vesa Valimaki\n// (DAFx-14): \"Examining the Oscillator Waveform Animation Effect\"\n// (Sections 2, 3, 4 & 5, Eq. 1, 17-27, Fig. 1-7).\n// Unites BOTH unison waveform animation engines derived in the paper:\n//   1. Section 5 (Fig. 6-7, Eq. 24-27): 7-Voice Delay-Line Pitch-Shifter Ensemble\n//      for arbitrary live audio inputs! Uses 4 dual-windowed raised-cosine\n//      crossfaded ramp delay lines at symmetric transposition ratios\n//      (s, s^3, 1/s, 1/s^3 where s = 1 + df0/f0) plus 2 quadrature LFO chorus taps\n//      and the center dry voice so harmonic cluster bandwidth grows proportionally\n//      with harmonic number k (Eq. 1 & Fig. 7)!\n//   2. Section 3 & 4 (Fig. 1-5, Eq. 17-23): Hutchins Multi-Channel Triangle-LFO\n//      Comparator PWM Waveform Animator, peaking at duty-cycle width 0.70 (Fig. 5).\n//      The paper's input is a sawtooth of known amplitude A; for live audio the input is\n//      normalised by its peak envelope so the LFO threshold stays at 0.70 of the signal\n//      level, and the comparator output is scaled back by that envelope (silent in rests).\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: unused\n//   in4: unused\n// Outlets:\n//   out1: Left 7-Voice Unison Supersaw Animated Chorus Output\n//   out2: Right 7-Voice Unison Supersaw Animated Chorus Output\n\n@param({ min: 1.0, max: 45.0 }) unison_detune_cents = 14.0;     // outer voice detune\n@param({ min: 12.0, max: 45.0 }) grain_window_ms = 24.0;        // shifter window\n@param({ min: 0.0, max: 1.0 }) hutchins_pwm_anim = 0.25;        // PWM animator depth\n@param({ min: 0.1, max: 2.0 }) pwm_lfo_rate_hz = 0.65;          // animator LFO rate\n@param({ min: 0.0, max: 1.0 }) stereo_voice_spread = 0.85;      // stereo spread\n@param({ min: 0.0, max: 1.0 }) center_to_side_mix = 0.65;       // side voice level\n\n// Circular delay buffers for the 4 dual-grain pitch-shifter voices + 2 LFO voices\n// (16384 samples: the 45 ms window plus margin fits at 192 kHz)\n@state animBufL = new FixedSampleArray(16384);\n@state animBufR = new FixedSampleArray(16384);\n@state writeIdx: Int = 0;\n\n// Ramp phases gamma_1..gamma_4 for transpositions s, s^3, 1/s, 1/s^3 (DAFx-14 Eq. 24-27, Fig. 6)\n@state rampPh = new FixedSampleArray(4);\n\n// 3 Independent slow triangle LFOs (< 2 Hz) for Hutchins Comparator Animator (Sec 3, Fig. 1)\n@state triPh1 = new phasor();\n@state triPh2 = new phasor();\n@state triPh3 = new phasor();\n@state dcXL = 0.0; @state dcYL = 0.0;\n@state dcXR = 0.0; @state dcYR = 0.0;\n// Peak envelopes that normalise the live input for the Hutchins comparators\n@state envPkL = 0.0; @state envPkR = 0.0;\n@state in2Hold = 0.0;\n\n// Evaluate dual-head raised-cosine windowed pitch shifter (DAFx-14 Sec 5, Eq. 24-27)\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\n// in2 counts as patched for 250 ms after any non-zero sample (a per-sample test\n// would swap in xL for single samples at in2's zero crossings)\nif (abs(in2) > 0.0000001) {\n\tin2Hold = 0.25 * sr;\n} else if (in2Hold > 0.0) {\n\tin2Hold -= 1.0;\n}\nlet xR = (in2Hold > 0.0) ? in2 : xL;\n\nanimBufL[writeIdx] = xL;\nanimBufR[writeIdx] = xR;\n\n// --- 1. 7-Voice Delay-Line Pitch-Shifter Unison Bank (DAFx-14 Sec 5, Fig. 6-7) ---\n// Transposition factor s = 2^(cents / 1200) -> four shifters at s, s^3, 1/s, 1/s^3\nlet cents = clamp(unison_detune_cents, 1.0, 45.0) * 0.3333; // per-step spacing so s^3 = full detune\nlet sRatio = pow(2.0, cents / 1200.0);\nlet s3Ratio = sRatio * sRatio * sRatio;\nlet invSRatio = 1.0 / sRatio;\nlet invS3Ratio = 1.0 / s3Ratio;\n\nlet tauSamps = clamp(mstosamps(clamp(grain_window_ms, 12.0, 45.0)), 256.0, 16370.0);\n\n// Eq. 25: delay growth rate dD/dt = 1 - s, normalized by window length tauSamps\nlet inc0 = (1.0 - sRatio) / tauSamps;\nlet inc1 = (1.0 - s3Ratio) / tauSamps;\nlet inc2 = (1.0 - invSRatio) / tauSamps;\nlet inc3 = (1.0 - invS3Ratio) / tauSamps;\n\nrampPh[0] = wrap(rampPh[0] + inc0, 0.0, 1.0);\nrampPh[1] = wrap(rampPh[1] + inc1, 0.0, 1.0);\nrampPh[2] = wrap(rampPh[2] + inc2, 0.0, 1.0);\nrampPh[3] = wrap(rampPh[3] + inc3, 0.0, 1.0);\n\n// Voices +1 (s) and -3 (1/s^3) biased Left; Voices -1 (1/s) and +3 (s^3) biased Right\n// Dual-head raised-cosine windowed pitch shifter (DAFx-14 Sec 5, Eq. 24-27), inlined per voice\nlet g1A = wrap(rampPh[0], 0.0, 1.0);\nlet g2A = wrap(g1A + 0.5, 0.0, 1.0);\nlet w1A = 0.5 * (1.0 - cos(2.0 * pi * g1A));\nlet w2A = 1.0 - w1A;\nlet d1A = 4.0 + g1A * tauSamps;\nlet rp1A = writeIdx - clamp(d1A, 2.0, 16378.0);\nwhile (rp1A < 0.0) { rp1A += 16384.0; }\nlet i1A: Int = floor(rp1A);\nlet r1A = cubicinterp(rp1A - i1A, animBufL[(i1A - 1 + 16384) & 16383], animBufL[i1A & 16383], animBufL[(i1A + 1) & 16383], animBufL[(i1A + 2) & 16383]);\nlet d2A = 4.0 + g2A * tauSamps;\nlet rp2A = writeIdx - clamp(d2A, 2.0, 16378.0);\nwhile (rp2A < 0.0) { rp2A += 16384.0; }\nlet i2A: Int = floor(rp2A);\nlet r2A = cubicinterp(rp2A - i2A, animBufL[(i2A - 1 + 16384) & 16383], animBufL[i2A & 16383], animBufL[(i2A + 1) & 16383], animBufL[(i2A + 2) & 16383]);\nlet vUp1L = w1A * r1A + w2A * r2A;\n\nlet g1B = wrap(rampPh[1], 0.0, 1.0);\nlet g2B = wrap(g1B + 0.5, 0.0, 1.0);\nlet w1B = 0.5 * (1.0 - cos(2.0 * pi * g1B));\nlet w2B = 1.0 - w1B;\nlet d1B = 4.0 + g1B * tauSamps;\nlet rp1B = writeIdx - clamp(d1B, 2.0, 16378.0);\nwhile (rp1B < 0.0) { rp1B += 16384.0; }\nlet i1B: Int = floor(rp1B);\nlet r1B = cubicinterp(rp1B - i1B, animBufR[(i1B - 1 + 16384) & 16383], animBufR[i1B & 16383], animBufR[(i1B + 1) & 16383], animBufR[(i1B + 2) & 16383]);\nlet d2B = 4.0 + g2B * tauSamps;\nlet rp2B = writeIdx - clamp(d2B, 2.0, 16378.0);\nwhile (rp2B < 0.0) { rp2B += 16384.0; }\nlet i2B: Int = floor(rp2B);\nlet r2B = cubicinterp(rp2B - i2B, animBufR[(i2B - 1 + 16384) & 16383], animBufR[i2B & 16383], animBufR[(i2B + 1) & 16383], animBufR[(i2B + 2) & 16383]);\nlet vUp3R = w1B * r1B + w2B * r2B;\n\nlet g1C = wrap(rampPh[2], 0.0, 1.0);\nlet g2C = wrap(g1C + 0.5, 0.0, 1.0);\nlet w1C = 0.5 * (1.0 - cos(2.0 * pi * g1C));\nlet w2C = 1.0 - w1C;\nlet d1C = 4.0 + g1C * tauSamps;\nlet rp1C = writeIdx - clamp(d1C, 2.0, 16378.0);\nwhile (rp1C < 0.0) { rp1C += 16384.0; }\nlet i1C: Int = floor(rp1C);\nlet r1C = cubicinterp(rp1C - i1C, animBufR[(i1C - 1 + 16384) & 16383], animBufR[i1C & 16383], animBufR[(i1C + 1) & 16383], animBufR[(i1C + 2) & 16383]);\nlet d2C = 4.0 + g2C * tauSamps;\nlet rp2C = writeIdx - clamp(d2C, 2.0, 16378.0);\nwhile (rp2C < 0.0) { rp2C += 16384.0; }\nlet i2C: Int = floor(rp2C);\nlet r2C = cubicinterp(rp2C - i2C, animBufR[(i2C - 1 + 16384) & 16383], animBufR[i2C & 16383], animBufR[(i2C + 1) & 16383], animBufR[(i2C + 2) & 16383]);\nlet vDn1R = w1C * r1C + w2C * r2C;\n\nlet g1D = wrap(rampPh[3], 0.0, 1.0);\nlet g2D = wrap(g1D + 0.5, 0.0, 1.0);\nlet w1D = 0.5 * (1.0 - cos(2.0 * pi * g1D));\nlet w2D = 1.0 - w1D;\nlet d1D = 4.0 + g1D * tauSamps;\nlet rp1D = writeIdx - clamp(d1D, 2.0, 16378.0);\nwhile (rp1D < 0.0) { rp1D += 16384.0; }\nlet i1D: Int = floor(rp1D);\nlet r1D = cubicinterp(rp1D - i1D, animBufL[(i1D - 1 + 16384) & 16383], animBufL[i1D & 16383], animBufL[(i1D + 1) & 16383], animBufL[(i1D + 2) & 16383]);\nlet d2D = 4.0 + g2D * tauSamps;\nlet rp2D = writeIdx - clamp(d2D, 2.0, 16378.0);\nwhile (rp2D < 0.0) { rp2D += 16384.0; }\nlet i2D: Int = floor(rp2D);\nlet r2D = cubicinterp(rp2D - i2D, animBufL[(i2D - 1 + 16384) & 16383], animBufL[i2D & 16383], animBufL[(i2D + 1) & 16383], animBufL[(i2D + 2) & 16383]);\nlet vDn3L = w1D * r1D + w2D * r2D;\n\n// --- 2. Hutchins Multi-Channel Comparator PWM Animator + LFO Voices 5 & 6 (Sec 3 & 4) ---\n// Fig. 5: Optimal first-sideband magnitude occurs at duty-cycle width 0.70 (LFO amp = 0.70 * A)\nlet lfoRate = clamp(pwm_lfo_rate_hz, 0.1, 2.0);\nlet t1 = 2.0 * triangle(triPh1.next(lfoRate * 0.73), 0.5) - 1.0;\nlet t2 = 2.0 * triangle(triPh2.next(lfoRate * 1.00), 0.5) - 1.0;\nlet t3 = 2.0 * triangle(triPh3.next(lfoRate * 1.37), 0.5) - 1.0;\n\n// Voices 5 & 6: Smoothly modulated delay-line unison voices (3.75 / 4.375 ms +/- 2.92 ms)\nlet rpV5L = writeIdx - clamp(mstosamps(3.75 + 2.92 * t1), 2.0, 16378.0);\nwhile (rpV5L < 0.0) { rpV5L += 16384.0; }\nlet iV5L: Int = floor(rpV5L);\nlet vLfo5L = cubicinterp(rpV5L - iV5L, animBufL[(iV5L - 1 + 16384) & 16383], animBufL[iV5L & 16383], animBufL[(iV5L + 1) & 16383], animBufL[(iV5L + 2) & 16383]);\n\nlet rpV6R = writeIdx - clamp(mstosamps(4.375 + 2.92 * t2), 2.0, 16378.0);\nwhile (rpV6R < 0.0) { rpV6R += 16384.0; }\nlet iV6R: Int = floor(rpV6R);\nlet vLfo6R = cubicinterp(rpV6R - iV6R, animBufR[(iV6R - 1 + 16384) & 16383], animBufR[iV6R & 16383], animBufR[(iV6R + 1) & 16383], animBufR[(iV6R + 2) & 16383]);\n\nwriteIdx = (writeIdx + 1) & 16383;\n\n// Hutchins Soft-Comparator PWM Animator (Fig. 1-3, Eq. 2-17):\n// Compare the envelope-normalised signal u = x / env against a slow triangle LFO scaled by\n// the 0.70 optimal duty-cycle width (Fig. 5), then subtract the smooth comparator step,\n// scaled back by env so the pulse tracks the playing level and vanishes in rests\nlet pwmAmt = clamp(hutchins_pwm_anim, 0.0, 1.0);\nlet pkRel = exp(-1.0 / (0.08 * sr));\nenvPkL = maximum(abs(xL), envPkL * pkRel);\nenvPkR = maximum(abs(xR), envPkR * pkRel);\nlet uL = xL / (envPkL + 0.0001);\nlet uR = xR / (envPkR + 0.0001);\n\nlet comp1L = 0.5 * tanh(12.0 * (uL - 0.70 * t1)) * envPkL;\nlet comp2L = 0.5 * tanh(12.0 * (uL - 0.70 * t3)) * envPkL;\nlet hutchL = xL - pwmAmt * 0.45 * (comp1L + comp2L);\n\nlet comp1R = 0.5 * tanh(12.0 * (uR - 0.70 * t2)) * envPkR;\nlet comp2R = 0.5 * tanh(12.0 * (uR + 0.70 * t3)) * envPkR;\nlet hutchR = xR - pwmAmt * 0.45 * (comp1R + comp2R);\n\nlet animCleanL = hutchL - dcXL + 0.995 * dcYL;\ndcXL = hutchL; dcYL = animCleanL;\nlet animCleanR = hutchR - dcXR + 0.995 * dcYR;\ndcXR = hutchR; dcYR = animCleanR;\n\n// --- 3. 7-Voice Stereo Panning & Center/Side Unison Mix (JP-8000 Supersaw Style) ---\nlet stSpread = clamp(stereo_voice_spread, 0.0, 1.0);\nlet cross = 1.0 - 0.75 * stSpread;\n\nlet sideClusterL = (vUp1L + vDn3L + 0.85 * vLfo5L + cross * (vDn1R + vUp3R + 0.85 * vLfo6R)) * 0.35;\nlet sideClusterR = (vDn1R + vUp3R + 0.85 * vLfo6R + cross * (vUp1L + vDn3L + 0.85 * vLfo5L)) * 0.35;\n\nlet sideMix = clamp(center_to_side_mix, 0.0, 1.0);\nout1 = linearinterp(sideMix * 0.75, animCleanL, animCleanL * 0.65 + sideClusterL);\nout2 = linearinterp(sideMix * 0.75, animCleanR, animCleanR * 0.65 + sideClusterR);\n"
                                                    },
                                                    "rnbo_serial": 1,
