                                            {
                                                "box": {
                                                    "code": "// ============================================================================\n// rev_plate_dattorro.txt   (revision 3: full Dattorro tank and output taps)\n// A Dattorro plate: dense bright metal with a slow wobble.\n// From: Fernando A. Beltrán, José R. Beltrán, Nicolas Holzem & Adrian Gogu,\n//       \"Matlab Implementation of Reverberation Algorithms\", DAFx-99, §3 and\n//       Table 1 — the Dattorro (JAES 1997) network: predelay -> bandwidth\n//       lowpass -> four input allpasses -> two cross-coupled tank halves, each\n//       modulated allpass -> delay -> damping -> decay -> allpass -> delay ->\n//       decay, read by the seven output taps per side of Table 1.\n// 100% wet. No dry path, no limiter, no metering.\n// Inlets:\n//   in1 / in2: stereo audio\n//   in3: bound only (no pitch-relative parameter in a plate)\n//   in4: 0..1 one-bar phasor, bound only (a plate has no tempo-locked time)\n// Outlets:\n//   out1 / out2: stereo plate, wet only\n//\n// Changes in revision 3:\n//   - the tank is Dattorro's full half: the 1800 / 2656 stages are allpasses\n//     (decay diffusion 2 = 0.5) followed by the 3720 / 3163 delays, and decay\n//     diffusion 1 is -0.70 as in the paper; the decay gain is applied twice\n//     per half. Revision 2 used 1800 / 2656 as plain delays and had no\n//     3720 / 3163 lines.\n//   - output is the seven taps per side of DAFx-99 Table 1 (taken inside the\n//     delay lines and allpasses). The four end-of-line taps of revision 2\n//     left a ~12 dB energy hole at ~130 ms followed by a second swell.\n//   - wobble modulates the decay diffusion 1 allpasses (as in the paper)\n//\n// Changes in revision 2:\n//   - decay_s is now a true RT60: the decay gain is solved from the whole\n//     half-loop (both tank delays of both halves, both decay allpasses, and\n//     the one-sample cross-feedback). Range is now 0.8..20 s, default 5.0 s,\n//     which sounds like the old 2.0 s default did.\n//   - tank delay and input allpass lengths are rounded to integers\n//   - bandwidth lowpass added (Dattorro's 0.9995, effectively transparent)\n//   - right tank half has its own allpass order and a quadrature wobble phase\n//   - predelay: minimum 2 samples, buffer sized for 200 ms up to 192 kHz,\n//     and the delay time is slew-limited so moving it live does not click\n//   - diffuse / damp / decay / wobble depth / width / out gain are smoothed\n//   - tiny alternating offset on the input keeps the loops out of denormals\n//   - t1/t2 share one write index; buffers sized for sample rates to ~218 kHz\n// ============================================================================\n\n@param({ min: 0, max: 200, exponent: 2 }) predelay_ms = 20;      // predelay\n@param({ min: 0.8, max: 20, exponent: 2 }) decay_s = 5.0;        // decay (RT60)\n@param({ min: 500, max: 16000, exponent: 2 }) damp_hz = 6000;    // damping\n@param({ min: 0, max: 1 }) diffuse = 0.65;          // diffusion\n@param({ min: 0, max: 3 }) wobble_ms = 0.8;         // wobble depth\n@param({ min: 0.05, max: 2, exponent: 2 }) wobble_hz = 0.35;     // wobble rate\n@param({ min: 0, max: 1 }) width = 1.0;             // width\n@param({ min: -24, max: 12 }) out_gain_db = 0;      // output gain\n\n// Predelay: 65536 samples covers 200 ms at any rate up to ~327 kHz\n@state preL = new FixedSampleArray(65536);\n@state preR = new FixedSampleArray(65536);\n@state preIdx: Int = 0;\n@state preSm = 0.0;\n\n// Bandwidth lowpass state\n@state bwL = 0.0;\n@state bwR = 0.0;\n\n// Four input diffusion allpasses per channel: row 0..3 = left, 4..7 = right\n@state inAp = new FixedSampleArray(8, 4096);\n@state iaIdx: Int = 0;\n\n// Decay diffusion 1 (modulated) allpass per tank half: row 0 = L (672), 1 = R (908)\n@state tankAp = new FixedSampleArray(2, 8192);\n@state taIdx: Int = 0;\n\n// Tank, per half at 29.76 kHz: delay t1 (4453 L / 4217 R), decay diffusion 2\n// allpass whose internal line is t2 (1800 L / 2656 R), delay t3 (3720 L /\n// 3163 R). 32768 samples holds the longest (4453) up to ~218 kHz.\n@state t1L = new FixedSampleArray(32768);\n@state t1R = new FixedSampleArray(32768);\n@state t2L = new FixedSampleArray(32768);\n@state t2R = new FixedSampleArray(32768);\n@state t3L = new FixedSampleArray(32768);\n@state t3R = new FixedSampleArray(32768);\n@state tIdx: Int = 0;\n\n@state dmpL = 0.0;\n@state dmpR = 0.0;\n@state wobPh = 0.0;\n@state xfbL = 0.0;\n@state xfbR = 0.0;\n\n// Smoothed parameters\n@state gInAp = 0.6;\n@state smDecay = 0.0;\n@state smDampC = 0.0;\n@state smWob = 0.0;\n@state smWidth = 1.0;\n@state smGain = 1.0;\n@state initDone: Int = 0;\n\n// Alternating sub-audible offset: keeps feedback loops from decaying into\n// denormals during long silences\n@state dn = 1e-18;\n\n// Decay diffusion 1: Schroeder allpass on a tank row (fractional, for the\n// wobble) with Dattorro's coefficient -0.70\nfunction tankStep(row: Int, xin: number, len: number): number {\n\tlet rp = taIdx - len;\n\twhile (rp < 0.0) { rp += 8192.0; }\n\tlet i0: Int = floor(rp);\n\tlet xd = cubicinterp(rp - i0,\n\t\ttankAp[row][(i0 - 1 + 8192) & 8191],\n\t\ttankAp[row][i0 & 8191],\n\t\ttankAp[row][(i0 + 1) & 8191],\n\t\ttankAp[row][(i0 + 2) & 8191]);\n\tlet v = xin - 0.7 * xd;\n\ttankAp[row][taIdx] = v;\n\treturn xd + 0.7 * v;\n}\n\n// One input diffusion allpass stage (integer length, no interpolation)\nfunction inputStep(row: Int, xin: number, len: Int): number {\n\tlet xd = inAp[row][(iaIdx - len) & 4095];\n\tlet v = xin + gInAp * xd;\n\tinAp[row][iaIdx] = v;\n\treturn xd - gInAp * v;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet unused_in3 = in3; // keeps the in3 port present\nlet barIn = in4;      // accepted for the batch contract; a plate has no bar time\nlet srScale = sr / 29761.0;\n\n// --- Fixed geometry (integer sample lengths) -------------------------------\nlet l0: Int = floor(clamp(142.0 * srScale, 4.0, 4000.0) + 0.5);\nlet l1: Int = floor(clamp(107.0 * srScale, 4.0, 4000.0) + 0.5);\nlet l2: Int = floor(clamp(379.0 * srScale, 4.0, 4000.0) + 0.5);\nlet l3: Int = floor(clamp(277.0 * srScale, 4.0, 4000.0) + 0.5);\n\nlet t1LenL: Int = floor(clamp(4453.0 * srScale, 16.0, 32700.0) + 0.5);\nlet t1LenR: Int = floor(clamp(4217.0 * srScale, 16.0, 32700.0) + 0.5);\nlet t2LenL: Int = floor(clamp(1800.0 * srScale, 16.0, 32700.0) + 0.5);\nlet t2LenR: Int = floor(clamp(2656.0 * srScale, 16.0, 32700.0) + 0.5);\nlet t3LenL: Int = floor(clamp(3720.0 * srScale, 16.0, 32700.0) + 0.5);\nlet t3LenR: Int = floor(clamp(3163.0 * srScale, 16.0, 32700.0) + 0.5);\n\nlet baseA = clamp(672.0 * srScale, 8.0, 7900.0);\nlet baseB = clamp(908.0 * srScale, 8.0, 7900.0);\n\n// --- Parameter targets ------------------------------------------------------\n// Predelay, never below 2 samples so the cubic read never touches a stale slot\nlet preTarget = clamp(mstosamps(clamp(predelay_ms, 0.0, 200.0)), 2.0, 65000.0);\n\nlet gTarget = 0.40 + 0.35 * clamp(diffuse, 0.0, 1.0);\n\n// Decay: the gain is applied twice per tank half (after the damping and at\n// the end), so each application is the square root of the half-pass gain.\n// One half pass is allpass1 + delay1 + allpass2 + delay3 + 1 sample of\n// cross-feedback; the halves differ in length, so use the average of the two.\nlet halfSamps = 0.5 * (t1LenL + t2LenL + t3LenL + t1LenR + t2LenR + t3LenR) + baseA + baseB + 1.0;\nlet halfSec = halfSamps / sr;\nlet tgtDecay = clamp(exp(0.0 - 3.4538776 * halfSec / clamp(decay_s, 0.8, 20.0)), 0.0, 0.97);\n\nlet dampF = clamp(damp_hz, 200.0, sr * 0.45);\nlet tgtDampC = 1.0 - exp(0.0 - 2.0 * pi * dampF / sr);\n\nlet tgtWob = clamp(wobble_ms, 0.0, 3.0) * 0.001 * sr;\nlet tgtWidth = clamp(width, 0.0, 1.0);\nlet tgtGain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\n\n// --- First-sample init, then smoothing -------------------------------------\nif (initDone == 0) {\n\tpreSm = preTarget;\n\tgInAp = gTarget;\n\tsmDecay = tgtDecay;\n\tsmDampC = tgtDampC;\n\tsmWob = tgtWob;\n\tsmWidth = tgtWidth;\n\tsmGain = tgtGain;\n\tinitDone = 1;\n}\n\nlet smC = 1.0 - exp(0.0 - 1.0 / (0.02 * sr)); // ~20 ms\ngInAp = gInAp + smC * (gTarget - gInAp);\nsmDecay = smDecay + smC * (tgtDecay - smDecay);\nsmDampC = smDampC + smC * (tgtDampC - smDampC);\nsmWob = smWob + smC * (tgtWob - smWob);\nsmWidth = smWidth + smC * (tgtWidth - smWidth);\nsmGain = smGain + smC * (tgtGain - smGain);\n\n// Predelay time glides at most 0.15 samples per sample (about +/-2.5 semitones\n// of pitch glide while it moves), so live changes do not click\npreSm = preSm + clamp(preTarget - preSm, -0.15, 0.15);\n\n// --- Predelay ---------------------------------------------------------------\npreL[preIdx] = xL;\npreR[preIdx] = xR;\n\nlet rpP = preIdx - preSm;\nwhile (rpP < 0.0) { rpP += 65536.0; }\nlet piP: Int = floor(rpP);\nlet fP = rpP - piP;\n\nlet pL = cubicinterp(fP,\n\tpreL[(piP - 1 + 65536) & 65535],\n\tpreL[piP & 65535],\n\tpreL[(piP + 1) & 65535],\n\tpreL[(piP + 2) & 65535]);\n\nlet pR = cubicinterp(fP,\n\tpreR[(piP - 1 + 65536) & 65535],\n\tpreR[piP & 65535],\n\tpreR[(piP + 1) & 65535],\n\tpreR[(piP + 2) & 65535]);\n\npreIdx = (preIdx + 1) & 65535;\n\n// --- Bandwidth lowpass (Dattorro's 0.9995: effectively transparent) --------\ndn = 0.0 - dn;\nbwL = bwL + 0.9995 * ((pL + dn) - bwL);\nbwR = bwR + 0.9995 * ((pR + dn) - bwR);\n\n// --- Input diffusion: four allpasses per channel (DAFx-99 §3.1) ------------\nlet diffL = inputStep(0, bwL, l0);\ndiffL = inputStep(1, diffL, l1);\ndiffL = inputStep(2, diffL, l2);\ndiffL = inputStep(3, diffL, l3);\n\nlet diffR = inputStep(4, bwR, l0);\ndiffR = inputStep(5, diffR, l1);\ndiffR = inputStep(6, diffR, l2);\ndiffR = inputStep(7, diffR, l3);\n\niaIdx = (iaIdx + 1) & 4095;\n\n// --- Wobble: right half runs a quarter cycle behind the left ---------------\n// Modulates the decay diffusion 1 allpasses (672 left, 908 right)\nwobPh = wrap(wobPh + clamp(wobble_hz, 0.01, 5.0) / sr, 0.0, 1.0);\nlet wobL = sin(2.0 * pi * wobPh) * smWob;\nlet wobR = sin(2.0 * pi * (wobPh + 0.25)) * smWob;\n\nlet apL1 = clamp(baseA + wobL, 8.0, 8000.0);\nlet apR1 = clamp(baseB + wobR, 8.0, 8000.0);\n\n// --- Left tank half -------------------------------------------------------\nlet aL = diffL + xfbL;\nlet yA_L = tankStep(0, aL, apL1);\n\nt1L[tIdx] = yA_L;\nlet dL = t1L[(tIdx - t1LenL) & 32767];\ndmpL = dmpL + smDampC * (dL - dmpL);\n\n// decay diffusion 2: allpass (0.5) whose internal line is t2L\nlet zL = t2L[(tIdx - t2LenL) & 32767];\nlet vL = dmpL * smDecay + 0.5 * zL;\nt2L[tIdx] = vL;\nlet yB_L = zL - 0.5 * vL;\n\nt3L[tIdx] = yB_L;\nlet fL = t3L[(tIdx - t3LenL) & 32767];\n\n// --- Right tank half ------------------------------------------------------\nlet aR = diffR + xfbR;\nlet yA_R = tankStep(1, aR, apR1);\n\nt1R[tIdx] = yA_R;\nlet dR = t1R[(tIdx - t1LenR) & 32767];\ndmpR = dmpR + smDampC * (dR - dmpR);\n\nlet zR = t2R[(tIdx - t2LenR) & 32767];\nlet vR = dmpR * smDecay + 0.5 * zR;\nt2R[tIdx] = vR;\nlet yB_R = zR - 0.5 * vR;\n\nt3R[tIdx] = yB_R;\nlet fR = t3R[(tIdx - t3LenR) & 32767];\n\n// --- Output taps: DAFx-99 Table 1 (Dattorro), positions scaled to the rate -\n// Read before the index advances, so a tap of k is the value written k\n// samples ago (t1 / t3: the delay input, t2: the allpass's internal node)\nlet k266: Int = floor(266.0 * srScale + 0.5);\nlet k2974: Int = floor(2974.0 * srScale + 0.5);\nlet k1913: Int = floor(1913.0 * srScale + 0.5);\nlet k1996: Int = floor(1996.0 * srScale + 0.5);\nlet k1990: Int = floor(1990.0 * srScale + 0.5);\nlet k187: Int = floor(187.0 * srScale + 0.5);\nlet k1066: Int = floor(1066.0 * srScale + 0.5);\nlet k353: Int = floor(353.0 * srScale + 0.5);\nlet k3627: Int = floor(3627.0 * srScale + 0.5);\nlet k1228: Int = floor(1228.0 * srScale + 0.5);\nlet k2673: Int = floor(2673.0 * srScale + 0.5);\nlet k2111: Int = floor(2111.0 * srScale + 0.5);\nlet k335: Int = floor(335.0 * srScale + 0.5);\nlet k121: Int = floor(121.0 * srScale + 0.5);\n\nlet rawL = t1R[(tIdx - k266) & 32767]\n\t+ t1R[(tIdx - k2974) & 32767]\n\t- t2R[(tIdx - k1913) & 32767]\n\t+ t3R[(tIdx - k1996) & 32767]\n\t- t1L[(tIdx - k1990) & 32767]\n\t- t2L[(tIdx - k187) & 32767]\n\t- t3L[(tIdx - k1066) & 32767];\nlet rawR = t1L[(tIdx - k353) & 32767]\n\t+ t1L[(tIdx - k3627) & 32767]\n\t- t2L[(tIdx - k1228) & 32767]\n\t+ t3L[(tIdx - k2673) & 32767]\n\t- t1R[(tIdx - k2111) & 32767]\n\t- t2R[(tIdx - k335) & 32767]\n\t- t3R[(tIdx - k121) & 32767];\n\ntIdx = (tIdx + 1) & 32767;\ntaIdx = (taIdx + 1) & 8191;\n\n// Cross-coupling: each half's end (after its second decay) drives the other\n// on the next sample\nxfbL = fR * smDecay;\nxfbR = fL * smDecay;\n\n// Level: energy normalisation against the half-pass gain (decay squared);\n// 0.28 is the measured trim (default sits ~4 dB under the dry tuba)\nlet gHalf = smDecay * smDecay;\nlet norm = 0.28 * sqrt(maximum(1.0 - gHalf * gHalf, 0.0001));\nlet wetL = rawL * norm;\nlet wetR = rawR * norm;\n\n// --- Width (mid/side) -----------------------------------------------------\nlet mid = 0.5 * (wetL + wetR);\nlet side = 0.5 * (wetL - wetR) * smWidth;\nlet oL = mid + side;\nlet oR = mid - side;\n\nout1 = oL * smGain;\nout2 = oR * smGain;\n",
                                                    "fontface": 0,
                                                    "fontname": "<Monospaced>",
                                                    "fontsize": 12.0,
                                                    "id": "obj-2",
                                                    "maxclass": "codebox~",
                                                    "numinlets": 4,
                                                    "numoutlets": 2,
                                                    "outlettype": [ "signal", "signal" ],
                                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                                    "rnbo_classname": "codebox~",
                                                    "rnbo_extra_attributes": {
                                                        "nocache": 0,
                                                        "expr": "",
                                                        "safemath": 1,
                                                        "code": "// ============================================================================\n// rev_plate_dattorro.txt   (revision 3: full Dattorro tank and output taps)\n// A Dattorro plate: dense bright metal with a slow wobble.\n// From: Fernando A. Beltrán, José R. Beltrán, Nicolas Holzem & Adrian Gogu,\n//       \"Matlab Implementation of Reverberation Algorithms\", DAFx-99, §3 and\n//       Table 1 — the Dattorro (JAES 1997) network: predelay -> bandwidth\n//       lowpass -> four input allpasses -> two cross-coupled tank halves, each\n//       modulated allpass -> delay -> damping -> decay -> allpass -> delay ->\n//       decay, read by the seven output taps per side of Table 1.\n// 100% wet. No dry path, no limiter, no metering.\n// Inlets:\n//   in1 / in2: stereo audio\n//   in3: bound only (no pitch-relative parameter in a plate)\n//   in4: 0..1 one-bar phasor, bound only (a plate has no tempo-locked time)\n// Outlets:\n//   out1 / out2: stereo plate, wet only\n//\n// Changes in revision 3:\n//   - the tank is Dattorro's full half: the 1800 / 2656 stages are allpasses\n//     (decay diffusion 2 = 0.5) followed by the 3720 / 3163 delays, and decay\n//     diffusion 1 is -0.70 as in the paper; the decay gain is applied twice\n//     per half. Revision 2 used 1800 / 2656 as plain delays and had no\n//     3720 / 3163 lines.\n//   - output is the seven taps per side of DAFx-99 Table 1 (taken inside the\n//     delay lines and allpasses). The four end-of-line taps of revision 2\n//     left a ~12 dB energy hole at ~130 ms followed by a second swell.\n//   - wobble modulates the decay diffusion 1 allpasses (as in the paper)\n//\n// Changes in revision 2:\n//   - decay_s is now a true RT60: the decay gain is solved from the whole\n//     half-loop (both tank delays of both halves, both decay allpasses, and\n//     the one-sample cross-feedback). Range is now 0.8..20 s, default 5.0 s,\n//     which sounds like the old 2.0 s default did.\n//   - tank delay and input allpass lengths are rounded to integers\n//   - bandwidth lowpass added (Dattorro's 0.9995, effectively transparent)\n//   - right tank half has its own allpass order and a quadrature wobble phase\n//   - predelay: minimum 2 samples, buffer sized for 200 ms up to 192 kHz,\n//     and the delay time is slew-limited so moving it live does not click\n//   - diffuse / damp / decay / wobble depth / width / out gain are smoothed\n//   - tiny alternating offset on the input keeps the loops out of denormals\n//   - t1/t2 share one write index; buffers sized for sample rates to ~218 kHz\n// ============================================================================\n\n@param({ min: 0, max: 200, exponent: 2 }) predelay_ms = 20;      // predelay\n@param({ min: 0.8, max: 20, exponent: 2 }) decay_s = 5.0;        // decay (RT60)\n@param({ min: 500, max: 16000, exponent: 2 }) damp_hz = 6000;    // damping\n@param({ min: 0, max: 1 }) diffuse = 0.65;          // diffusion\n@param({ min: 0, max: 3 }) wobble_ms = 0.8;         // wobble depth\n@param({ min: 0.05, max: 2, exponent: 2 }) wobble_hz = 0.35;     // wobble rate\n@param({ min: 0, max: 1 }) width = 1.0;             // width\n@param({ min: -24, max: 12 }) out_gain_db = 0;      // output gain\n\n// Predelay: 65536 samples covers 200 ms at any rate up to ~327 kHz\n@state preL = new FixedSampleArray(65536);\n@state preR = new FixedSampleArray(65536);\n@state preIdx: Int = 0;\n@state preSm = 0.0;\n\n// Bandwidth lowpass state\n@state bwL = 0.0;\n@state bwR = 0.0;\n\n// Four input diffusion allpasses per channel: row 0..3 = left, 4..7 = right\n@state inAp = new FixedSampleArray(8, 4096);\n@state iaIdx: Int = 0;\n\n// Decay diffusion 1 (modulated) allpass per tank half: row 0 = L (672), 1 = R (908)\n@state tankAp = new FixedSampleArray(2, 8192);\n@state taIdx: Int = 0;\n\n// Tank, per half at 29.76 kHz: delay t1 (4453 L / 4217 R), decay diffusion 2\n// allpass whose internal line is t2 (1800 L / 2656 R), delay t3 (3720 L /\n// 3163 R). 32768 samples holds the longest (4453) up to ~218 kHz.\n@state t1L = new FixedSampleArray(32768);\n@state t1R = new FixedSampleArray(32768);\n@state t2L = new FixedSampleArray(32768);\n@state t2R = new FixedSampleArray(32768);\n@state t3L = new FixedSampleArray(32768);\n@state t3R = new FixedSampleArray(32768);\n@state tIdx: Int = 0;\n\n@state dmpL = 0.0;\n@state dmpR = 0.0;\n@state wobPh = 0.0;\n@state xfbL = 0.0;\n@state xfbR = 0.0;\n\n// Smoothed parameters\n@state gInAp = 0.6;\n@state smDecay = 0.0;\n@state smDampC = 0.0;\n@state smWob = 0.0;\n@state smWidth = 1.0;\n@state smGain = 1.0;\n@state initDone: Int = 0;\n\n// Alternating sub-audible offset: keeps feedback loops from decaying into\n// denormals during long silences\n@state dn = 1e-18;\n\n// Decay diffusion 1: Schroeder allpass on a tank row (fractional, for the\n// wobble) with Dattorro's coefficient -0.70\nfunction tankStep(row: Int, xin: number, len: number): number {\n\tlet rp = taIdx - len;\n\twhile (rp < 0.0) { rp += 8192.0; }\n\tlet i0: Int = floor(rp);\n\tlet xd = cubicinterp(rp - i0,\n\t\ttankAp[row][(i0 - 1 + 8192) & 8191],\n\t\ttankAp[row][i0 & 8191],\n\t\ttankAp[row][(i0 + 1) & 8191],\n\t\ttankAp[row][(i0 + 2) & 8191]);\n\tlet v = xin - 0.7 * xd;\n\ttankAp[row][taIdx] = v;\n\treturn xd + 0.7 * v;\n}\n\n// One input diffusion allpass stage (integer length, no interpolation)\nfunction inputStep(row: Int, xin: number, len: Int): number {\n\tlet xd = inAp[row][(iaIdx - len) & 4095];\n\tlet v = xin + gInAp * xd;\n\tinAp[row][iaIdx] = v;\n\treturn xd - gInAp * v;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet unused_in3 = in3; // keeps the in3 port present\nlet barIn = in4;      // accepted for the batch contract; a plate has no bar time\nlet srScale = sr / 29761.0;\n\n// --- Fixed geometry (integer sample lengths) -------------------------------\nlet l0: Int = floor(clamp(142.0 * srScale, 4.0, 4000.0) + 0.5);\nlet l1: Int = floor(clamp(107.0 * srScale, 4.0, 4000.0) + 0.5);\nlet l2: Int = floor(clamp(379.0 * srScale, 4.0, 4000.0) + 0.5);\nlet l3: Int = floor(clamp(277.0 * srScale, 4.0, 4000.0) + 0.5);\n\nlet t1LenL: Int = floor(clamp(4453.0 * srScale, 16.0, 32700.0) + 0.5);\nlet t1LenR: Int = floor(clamp(4217.0 * srScale, 16.0, 32700.0) + 0.5);\nlet t2LenL: Int = floor(clamp(1800.0 * srScale, 16.0, 32700.0) + 0.5);\nlet t2LenR: Int = floor(clamp(2656.0 * srScale, 16.0, 32700.0) + 0.5);\nlet t3LenL: Int = floor(clamp(3720.0 * srScale, 16.0, 32700.0) + 0.5);\nlet t3LenR: Int = floor(clamp(3163.0 * srScale, 16.0, 32700.0) + 0.5);\n\nlet baseA = clamp(672.0 * srScale, 8.0, 7900.0);\nlet baseB = clamp(908.0 * srScale, 8.0, 7900.0);\n\n// --- Parameter targets ------------------------------------------------------\n// Predelay, never below 2 samples so the cubic read never touches a stale slot\nlet preTarget = clamp(mstosamps(clamp(predelay_ms, 0.0, 200.0)), 2.0, 65000.0);\n\nlet gTarget = 0.40 + 0.35 * clamp(diffuse, 0.0, 1.0);\n\n// Decay: the gain is applied twice per tank half (after the damping and at\n// the end), so each application is the square root of the half-pass gain.\n// One half pass is allpass1 + delay1 + allpass2 + delay3 + 1 sample of\n// cross-feedback; the halves differ in length, so use the average of the two.\nlet halfSamps = 0.5 * (t1LenL + t2LenL + t3LenL + t1LenR + t2LenR + t3LenR) + baseA + baseB + 1.0;\nlet halfSec = halfSamps / sr;\nlet tgtDecay = clamp(exp(0.0 - 3.4538776 * halfSec / clamp(decay_s, 0.8, 20.0)), 0.0, 0.97);\n\nlet dampF = clamp(damp_hz, 200.0, sr * 0.45);\nlet tgtDampC = 1.0 - exp(0.0 - 2.0 * pi * dampF / sr);\n\nlet tgtWob = clamp(wobble_ms, 0.0, 3.0) * 0.001 * sr;\nlet tgtWidth = clamp(width, 0.0, 1.0);\nlet tgtGain = dbtoa(clamp(out_gain_db, -24.0, 12.0));\n\n// --- First-sample init, then smoothing -------------------------------------\nif (initDone == 0) {\n\tpreSm = preTarget;\n\tgInAp = gTarget;\n\tsmDecay = tgtDecay;\n\tsmDampC = tgtDampC;\n\tsmWob = tgtWob;\n\tsmWidth = tgtWidth;\n\tsmGain = tgtGain;\n\tinitDone = 1;\n}\n\nlet smC = 1.0 - exp(0.0 - 1.0 / (0.02 * sr)); // ~20 ms\ngInAp = gInAp + smC * (gTarget - gInAp);\nsmDecay = smDecay + smC * (tgtDecay - smDecay);\nsmDampC = smDampC + smC * (tgtDampC - smDampC);\nsmWob = smWob + smC * (tgtWob - smWob);\nsmWidth = smWidth + smC * (tgtWidth - smWidth);\nsmGain = smGain + smC * (tgtGain - smGain);\n\n// Predelay time glides at most 0.15 samples per sample (about +/-2.5 semitones\n// of pitch glide while it moves), so live changes do not click\npreSm = preSm + clamp(preTarget - preSm, -0.15, 0.15);\n\n// --- Predelay ---------------------------------------------------------------\npreL[preIdx] = xL;\npreR[preIdx] = xR;\n\nlet rpP = preIdx - preSm;\nwhile (rpP < 0.0) { rpP += 65536.0; }\nlet piP: Int = floor(rpP);\nlet fP = rpP - piP;\n\nlet pL = cubicinterp(fP,\n\tpreL[(piP - 1 + 65536) & 65535],\n\tpreL[piP & 65535],\n\tpreL[(piP + 1) & 65535],\n\tpreL[(piP + 2) & 65535]);\n\nlet pR = cubicinterp(fP,\n\tpreR[(piP - 1 + 65536) & 65535],\n\tpreR[piP & 65535],\n\tpreR[(piP + 1) & 65535],\n\tpreR[(piP + 2) & 65535]);\n\npreIdx = (preIdx + 1) & 65535;\n\n// --- Bandwidth lowpass (Dattorro's 0.9995: effectively transparent) --------\ndn = 0.0 - dn;\nbwL = bwL + 0.9995 * ((pL + dn) - bwL);\nbwR = bwR + 0.9995 * ((pR + dn) - bwR);\n\n// --- Input diffusion: four allpasses per channel (DAFx-99 §3.1) ------------\nlet diffL = inputStep(0, bwL, l0);\ndiffL = inputStep(1, diffL, l1);\ndiffL = inputStep(2, diffL, l2);\ndiffL = inputStep(3, diffL, l3);\n\nlet diffR = inputStep(4, bwR, l0);\ndiffR = inputStep(5, diffR, l1);\ndiffR = inputStep(6, diffR, l2);\ndiffR = inputStep(7, diffR, l3);\n\niaIdx = (iaIdx + 1) & 4095;\n\n// --- Wobble: right half runs a quarter cycle behind the left ---------------\n// Modulates the decay diffusion 1 allpasses (672 left, 908 right)\nwobPh = wrap(wobPh + clamp(wobble_hz, 0.01, 5.0) / sr, 0.0, 1.0);\nlet wobL = sin(2.0 * pi * wobPh) * smWob;\nlet wobR = sin(2.0 * pi * (wobPh + 0.25)) * smWob;\n\nlet apL1 = clamp(baseA + wobL, 8.0, 8000.0);\nlet apR1 = clamp(baseB + wobR, 8.0, 8000.0);\n\n// --- Left tank half -------------------------------------------------------\nlet aL = diffL + xfbL;\nlet yA_L = tankStep(0, aL, apL1);\n\nt1L[tIdx] = yA_L;\nlet dL = t1L[(tIdx - t1LenL) & 32767];\ndmpL = dmpL + smDampC * (dL - dmpL);\n\n// decay diffusion 2: allpass (0.5) whose internal line is t2L\nlet zL = t2L[(tIdx - t2LenL) & 32767];\nlet vL = dmpL * smDecay + 0.5 * zL;\nt2L[tIdx] = vL;\nlet yB_L = zL - 0.5 * vL;\n\nt3L[tIdx] = yB_L;\nlet fL = t3L[(tIdx - t3LenL) & 32767];\n\n// --- Right tank half ------------------------------------------------------\nlet aR = diffR + xfbR;\nlet yA_R = tankStep(1, aR, apR1);\n\nt1R[tIdx] = yA_R;\nlet dR = t1R[(tIdx - t1LenR) & 32767];\ndmpR = dmpR + smDampC * (dR - dmpR);\n\nlet zR = t2R[(tIdx - t2LenR) & 32767];\nlet vR = dmpR * smDecay + 0.5 * zR;\nt2R[tIdx] = vR;\nlet yB_R = zR - 0.5 * vR;\n\nt3R[tIdx] = yB_R;\nlet fR = t3R[(tIdx - t3LenR) & 32767];\n\n// --- Output taps: DAFx-99 Table 1 (Dattorro), positions scaled to the rate -\n// Read before the index advances, so a tap of k is the value written k\n// samples ago (t1 / t3: the delay input, t2: the allpass's internal node)\nlet k266: Int = floor(266.0 * srScale + 0.5);\nlet k2974: Int = floor(2974.0 * srScale + 0.5);\nlet k1913: Int = floor(1913.0 * srScale + 0.5);\nlet k1996: Int = floor(1996.0 * srScale + 0.5);\nlet k1990: Int = floor(1990.0 * srScale + 0.5);\nlet k187: Int = floor(187.0 * srScale + 0.5);\nlet k1066: Int = floor(1066.0 * srScale + 0.5);\nlet k353: Int = floor(353.0 * srScale + 0.5);\nlet k3627: Int = floor(3627.0 * srScale + 0.5);\nlet k1228: Int = floor(1228.0 * srScale + 0.5);\nlet k2673: Int = floor(2673.0 * srScale + 0.5);\nlet k2111: Int = floor(2111.0 * srScale + 0.5);\nlet k335: Int = floor(335.0 * srScale + 0.5);\nlet k121: Int = floor(121.0 * srScale + 0.5);\n\nlet rawL = t1R[(tIdx - k266) & 32767]\n\t+ t1R[(tIdx - k2974) & 32767]\n\t- t2R[(tIdx - k1913) & 32767]\n\t+ t3R[(tIdx - k1996) & 32767]\n\t- t1L[(tIdx - k1990) & 32767]\n\t- t2L[(tIdx - k187) & 32767]\n\t- t3L[(tIdx - k1066) & 32767];\nlet rawR = t1L[(tIdx - k353) & 32767]\n\t+ t1L[(tIdx - k3627) & 32767]\n\t- t2L[(tIdx - k1228) & 32767]\n\t+ t3L[(tIdx - k2673) & 32767]\n\t- t1R[(tIdx - k2111) & 32767]\n\t- t2R[(tIdx - k335) & 32767]\n\t- t3R[(tIdx - k121) & 32767];\n\ntIdx = (tIdx + 1) & 32767;\ntaIdx = (taIdx + 1) & 8191;\n\n// Cross-coupling: each half's end (after its second decay) drives the other\n// on the next sample\nxfbL = fR * smDecay;\nxfbR = fL * smDecay;\n\n// Level: energy normalisation against the half-pass gain (decay squared);\n// 0.28 is the measured trim (default sits ~4 dB under the dry tuba)\nlet gHalf = smDecay * smDecay;\nlet norm = 0.28 * sqrt(maximum(1.0 - gHalf * gHalf, 0.0001));\nlet wetL = rawL * norm;\nlet wetR = rawR * norm;\n\n// --- Width (mid/side) -----------------------------------------------------\nlet mid = 0.5 * (wetL + wetR);\nlet side = 0.5 * (wetL - wetR) * smWidth;\nlet oL = mid + side;\nlet oR = mid - side;\n\nout1 = oL * smGain;\nout2 = oR * smGain;\n"
                                                    },
                                                    "rnbo_serial": 1,
                                                    "rnbo_uniqueid": "effect_code",
