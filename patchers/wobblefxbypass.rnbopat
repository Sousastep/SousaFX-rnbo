                                    "id": "obj-11",
                                    "maxclass": "newobj",
                                    "numinlets": 1,
                                    "numoutlets": 1,
                                    "outlettype": [ "signal" ],
                                    "patching_rect": [ 50.0, 530.0, 35.0, 23.0 ],
                                    "rnbo_classname": "gen~",
                                    "rnbo_extra_attributes": {
                                        "exposeparams": 0,
                                        "gencode": "upsample2x_ppiir(x) {\n\tHistory p0_d1(0);\n\tHistory p0_d2(0);\n\tHistory p0_d3(0);\n\tHistory p1_d1(0);\n\tHistory p1_d2(0);\n\tHistory p1_d3(0);\n\tp0_a0 = 0.052037289518901;\n\tp0_a1 = 0.4378390730273;\n\tp1_a0 = 0.20139892364006;\n\tp1_a1 = 0.77390943595264;\n\tp1_d3_last = p1_d3;\n\ts = p0_d1 + (p0_a0 * ((x - p0_d2)));\n\ty = p0_d2 + (p0_a1 * ((s - p0_d3)));\n\tp0_d3 = y;\n\tp0_d2 = s;\n\tp0_d1 = x;\n\ts_1 = p1_d1 + (p1_a0 * ((x - p1_d2)));\n\ty_2 = p1_d2 + (p1_a1 * ((s_1 - p1_d3)));\n\tp1_d3 = y_2;\n\tp1_d2 = s_1;\n\tp1_d1 = x;\n\treturn ((p0_d3 + p1_d3_last)) * 0.5, ((p0_d3 + p1_d3)) * 0.5;\n}\n\ndownsample2x_ppiir(x1, x2) {\n\tHistory p0_d1(0);\n\tHistory p0_d2(0);\n\tHistory p0_d3(0);\n\tHistory p1_d1(0);\n\tHistory p1_d2(0);\n\tHistory p1_d3(0);\n\tp0_a0 = 0.052037289518901;\n\tp0_a1 = 0.4378390730273;\n\tp1_a0 = 0.20139892364006;\n\tp1_a1 = 0.77390943595264;\n\tp1_d3_last = p1_d3;\n\ts = p0_d1 + (p0_a0 * ((x1 - p0_d2)));\n\ty = p0_d2 + (p0_a1 * ((s - p0_d3)));\n\tp0_d3 = y;\n\tp0_d2 = s;\n\tp0_d1 = x1;\n\ts_3 = p1_d1 + (p1_a0 * ((x2 - p1_d2)));\n\ty_4 = p1_d2 + (p1_a1 * ((s_3 - p1_d3)));\n\tp1_d3 = y_4;\n\tp1_d2 = s_3;\n\tp1_d1 = x2;\n\treturn ((p0_d3 + p1_d3_last)) * 0.5;\n}\n\nupsample4x_ppiir(x) {\n\tData pass1_buf(16, 1);\n\tData pass2_buf(16, 1);\n\ta, b = upsample2x_ppiir(x);\n\tpoke(pass1_buf, a, 0, 0, 0);\n\tpoke(pass1_buf, b, 1, 0, 0);\n\tfor(i = 0; i < 2; i = i + 1) {\n\t\tv = peek(pass1_buf, i, 0);\n\t\ta, b = upsample2x_ppiir(v);\n\t\tpoke(pass2_buf, a, i * 2, 0, 0);\n\t\tpoke(pass2_buf, b, (i * 2) + 1, 0, 0);\n\t}\n\ty1 = peek(pass2_buf, 0, 0);\n\ty2 = peek(pass2_buf, 1, 0);\n\ty3 = peek(pass2_buf, 2, 0);\n\ty4 = peek(pass2_buf, 3, 0);\n\treturn y1, y2, y3, y4;\n}\n\ndownsample4x_ppiir(x1, x2, x3, x4) {\n\tData pass1_buf(16, 1);\n\tData pass2_buf(16, 1);\n\tpoke(pass1_buf, x1, 0, 0, 0);\n\tpoke(pass1_buf, x2, 1, 0, 0);\n\tpoke(pass1_buf, x3, 2, 0, 0);\n\tpoke(pass1_buf, x4, 3, 0, 0);\n\tfor(i = 0; i < 2; i = i + 1) {\n\t\ta = peek(pass1_buf, i * 2, 0);\n\t\tb = peek(pass1_buf, (i * 2) + 1, 0);\n\t\tv = downsample2x_ppiir(a, b);\n\t\tpoke(pass2_buf, v, i, 0, 0);\n\t}\n\ty1 = peek(pass2_buf, 0, 0);\n\ty2 = peek(pass2_buf, 1, 0);\n\treturn downsample2x_ppiir(y1, y2);\n}\n\nupsample8x_ppiir(x) {\n\tData pass3_buf(16);\n\tData pass2_buf(16);\n\tData pass1_buf(16);\n\ta, b = upsample2x_ppiir(x);\n\tpoke(pass1_buf, a, 0);\n\tpoke(pass1_buf, b, 1);\n\tfor(i = 0; i < 2; i = i + 1) {\n\t\tv = peek(pass1_buf, i);\n\t\ta, b = upsample2x_ppiir(v);\n\t\tpoke(pass2_buf, a, i * 2);\n\t\tpoke(pass2_buf, b, (i * 2) + 1);\n\t}\n\tfor(i = 0; i < 4; i = i + 1) {\n\t\tv = peek(pass2_buf, i);\n\t\ta, b = upsample2x_ppiir(v);\n\t\tpoke(pass3_buf, a, i * 2);\n\t\tpoke(pass3_buf, b, (i * 2) + 1);\n\t}\n\ty1 = peek(pass3_buf, 0);\n\ty2 = peek(pass3_buf, 1);\n\ty3 = peek(pass3_buf, 2);\n\ty4 = peek(pass3_buf, 3);\n\ty5 = peek(pass3_buf, 4);\n\ty6 = peek(pass3_buf, 5);\n\ty7 = peek(pass3_buf, 6);\n\ty8 = peek(pass3_buf, 7);\n\treturn y1, y2, y3, y4, y5, y6, y7, y8;\n}\n\ndownsample8x_ppiir(x1, x2, x3, x4, x5, x6, x7, x8) {\n\tData pass3_buf(16);\n\tData pass2_buf(16);\n\tData pass1_buf(16);\n\tpoke(pass1_buf, x1, 0);\n\tpoke(pass1_buf, x2, 1);\n\tpoke(pass1_buf, x3, 2);\n\tpoke(pass1_buf, x4, 3);\n\tpoke(pass1_buf, x5, 4);\n\tpoke(pass1_buf, x6, 5);\n\tpoke(pass1_buf, x7, 6);\n\tpoke(pass1_buf, x8, 7);\n\tfor(i = 0; i < 4; i = i + 1) {\n\t\ta = peek(pass1_buf, i * 2);\n\t\tb = peek(pass1_buf, (i * 2) + 1);\n\t\tv = downsample2x_ppiir(a, b);\n\t\tpoke(pass2_buf, v, i);\n\t}\n\tfor(i = 0; i < 2; i = i + 1) {\n\t\ta = peek(pass2_buf, i * 2);\n\t\tb = peek(pass2_buf, (i * 2) + 1);\n\t\tv = downsample2x_ppiir(a, b);\n\t\tpoke(pass3_buf, v, i);\n\t}\n\ty1 = peek(pass3_buf, 0);\n\ty2 = peek(pass3_buf, 1);\n\treturn downsample2x_ppiir(y1, y2);\n}\n\nupsample16x_ppiir(x) {\n\tData pass4_buf(16);\n\tData pass3_buf(16);\n\tData pass2_buf(16);\n\tData pass1_buf(16);\n\ta, b = upsample2x_ppiir(x);\n\tpoke(pass1_buf, a, 0);\n\tpoke(pass1_buf, b, 1);\n\tfor(i = 0; i < 2; i = i + 1) {\n\t\tv = peek(pass1_buf, i);\n\t\ta, b = upsample2x_ppiir(v);\n\t\tpoke(pass2_buf, a, i * 2);\n\t\tpoke(pass2_buf, b, (i * 2) + 1);\n\t}\n\tfor(i = 0; i < 4; i = i + 1) {\n\t\tv = peek(pass2_buf, i);\n\t\ta, b = upsample2x_ppiir(v);\n\t\tpoke(pass3_buf, a, i * 2);\n\t\tpoke(pass3_buf, b, (i * 2) + 1);\n\t}\n\tfor(i = 0; i < 8; i = i + 1) {\n\t\tv = peek(pass3_buf, i);\n\t\ta, b = upsample2x_ppiir(v);\n\t\tpoke(pass4_buf, a, i * 2);\n\t\tpoke(pass4_buf, b, (i * 2) + 1);\n\t}\n\ty1 = peek(pass4_buf, 0);\n\ty2 = peek(pass4_buf, 1);\n\ty3 = peek(pass4_buf, 2);\n\ty4 = peek(pass4_buf, 3);\n\ty5 = peek(pass4_buf, 4);\n\ty6 = peek(pass4_buf, 5);\n\ty7 = peek(pass4_buf, 6);\n\ty8 = peek(pass4_buf, 7);\n\ty9 = peek(pass4_buf, 8);\n\ty10 = peek(pass4_buf, 9);\n\ty11 = peek(pass4_buf, 10);\n\ty12 = peek(pass4_buf, 11);\n\ty13 = peek(pass4_buf, 12);\n\ty14 = peek(pass4_buf, 13);\n\ty15 = peek(pass4_buf, 14);\n\ty16 = peek(pass4_buf, 15);\n\treturn y1, y2, y3, y4, y5, y6, y7, y8, y9, y10, y11, y12, y13, y14, y15, y16;\n}\n\ndownsample16x_ppiir(x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16) {\n\tData pass4_buf(16);\n\tData pass3_buf(16);\n\tData pass2_buf(16);\n\tData pass1_buf(16);\n\tpoke(pass1_buf, x1, 0);\n\tpoke(pass1_buf, x2, 1);\n\tpoke(pass1_buf, x3, 2);\n\tpoke(pass1_buf, x4, 3);\n\tpoke(pass1_buf, x5, 4);\n\tpoke(pass1_buf, x6, 5);\n\tpoke(pass1_buf, x7, 6);\n\tpoke(pass1_buf, x8, 7);\n\tpoke(pass1_buf, x9, 8);\n\tpoke(pass1_buf, x10, 9);\n\tpoke(pass1_buf, x11, 10);\n\tpoke(pass1_buf, x12, 11);\n\tpoke(pass1_buf, x13, 12);\n\tpoke(pass1_buf, x14, 13);\n\tpoke(pass1_buf, x15, 14);\n\tpoke(pass1_buf, x16, 15);\n\tfor(i = 0; i < 8; i = i + 1) {\n\t\ta = peek(pass1_buf, i * 2);\n\t\tb = peek(pass1_buf, (i * 2) + 1);\n\t\tv = downsample2x_ppiir(a, b);\n\t\tpoke(pass2_buf, v, i);\n\t}\n\tfor(i = 0; i < 4; i = i + 1) {\n\t\ta = peek(pass2_buf, i * 2);\n\t\tb = peek(pass2_buf, (i * 2) + 1);\n\t\tv = downsample2x_ppiir(a, b);\n\t\tpoke(pass3_buf, v, i);\n\t}\n\tfor(i = 0; i < 2; i = i + 1) {\n\t\ta = peek(pass3_buf, i * 2);\n\t\tb = peek(pass3_buf, (i * 2) + 1);\n\t\tv = downsample2x_ppiir(a, b);\n\t\tpoke(pass4_buf, v, i);\n\t}\n\ty1 = peek(pass4_buf, 0);\n\ty2 = peek(pass4_buf, 1);\n\treturn downsample2x_ppiir(y1, y2);\n}\n\n\n\ndiodeSolve(v_in, seed_offset, gr1, gr2, is, vt) {\n\tMAX_ITER = 20;\n\tVD_CLAMP = 1.2;\n\tEXP_CLAMP = 85;\n\tinvVt = 1 / vt;\n\tvd = clip(seed_offset, -VD_CLAMP, VD_CLAMP);\n\tlo = -VD_CLAMP;\n\thi = VD_CLAMP;\n\ted1 = exp(clip((-vd) * invVt, -EXP_CLAMP, EXP_CLAMP));\n\tid1 = (is * ed1) - is;\n\tgd1 = ((is * ed1)) * invVt;\n\ted2 = exp(clip(vd * invVt, -EXP_CLAMP, EXP_CLAMP));\n\tid2 = (is * ed2) - is;\n\tgd2 = ((is * ed2)) * invVt;\n\tf = (((vd * gr1) - (v_in * gr2))) - ((id1 - id2));\n\tfor(i = 0; i < MAX_ITER; i = i + 1) {\n\t\tif(f > 0) {\n\t\t\thi = vd;\n\t\t}\n\t\telse {\n\t\t\tlo = vd;\n\t\t}\n\t\tvd_new = vd;\n\t\tvd_newton = vd - (f / ((((gr1 + gd1)) + gd2)));\n\t\ttake_newton = 0;\n\t\tif((vd_newton > lo) && (vd_newton < hi)) {\n\t\t\tif((abs(f)) < 0.001) {\n\t\t\t\ttake_newton = 1;\n\t\t\t}\n\t\t\telse if((abs(vd_newton - vd)) >= (((hi - lo)) * 0.5)) {\n\t\t\t\ttake_newton = 1;\n\t\t\t}\n\t\t}\n\t\tif(take_newton == 1) {\n\t\t\tvd_new = vd_newton;\n\t\t}\n\t\telse {\n\t\t\tvd_new = ((lo + hi)) * 0.5;\n\t\t}\n\t\ted1 = exp(clip((-vd_new) * invVt, -EXP_CLAMP, EXP_CLAMP));\n\t\tid1 = (is * ed1) - is;\n\t\tgd1 = ((is * ed1)) * invVt;\n\t\ted2 = exp(clip(vd_new * invVt, -EXP_CLAMP, EXP_CLAMP));\n\t\tid2 = (is * ed2) - is;\n\t\tgd2 = ((is * ed2)) * invVt;\n\t\tvd = vd_new;\n\t\tf = (((vd * gr1) - (v_in * gr2))) - ((id1 - id2));\n\t}\n\treturn v_in + vd, 1;\n}\n\nDiodeDistortion(v_in, gain) {\n\tHistory v_out(0);\n\tHistory vd_prev(0);\n\tis = 1e-15;\n\tvt = 0.026;\n\tgr1 = 1 / ((gain * 10000));\n\tgr2 = 1 / 10000;\n\tv_out, converged = diodeSolve(v_in, vd_prev, gr1, gr2, is, vt);\n\tif(!conver