                            },
                            {
                                "box": {
                                    "id": "obj-18",
                                    "linecount": 5,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 607.0, 376.5, 180.0, 78.0 ],
                                    "text": "1. thru\n2. bbd blep clock matrix\n3. supersaw waveform animator\n4. univibe optical throb\n5. bbd compander juno"
                                }
                            },
                            {
                                "box": {
                                    "id": "obj-15",
                                    "maxclass": "newobj",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patcher": {
                                        "fileversion": 1,
                                        "appversion": {
                                            "major": 9,
                                            "minor": 2,
                                            "revision": 0,
                                            "architecture": "x64",
                                            "modernui": 1
                                        },
                                        "classnamespace": "rnbo",
                                        "rect": [ 100.0, 100.0, 1918.0, 780.0 ],
                                        "default_fontname": "Lato",
                                        "title": "ai.chorus_bbd_compander_juno",
                                        "boxes": [
                                            {
                                                "box": {
                                                    "code": "// ============================================================================\n// chorus_bbd_compander_juno.txt\n// Standalone Stereo Chorus Effect: Dual Push-Pull Analog BBD Chorus with NE570 Compander\n// Synthesizes 3 DAFx Bucket-Brigade Device (BBD) Chorus Papers into one complete unit:\n//   1. Antti Huovilainen (DAFx-05, Paper P_155, Sec 5.1 & 5.2, Eq. 25-31, Fig. 8-11):\n//      - Fixed N-stage capacitor delay line driven by a variable clock f_clock, producing\n//        the characteristic hyperbolic 1/f_clock BBD delay-time warp (Fig. 9) and moving-\n//        average clock-history smoothing t_d = avg(N * fs / (2 * f_clock), M) (Eq. 25).\n//      - Matched NE570-style compander after Eq. 26-27, implemented with a square-root\n//        detector law: feedback compressor y = x / sqrt(avg|y|) (1.5:1) before the BBD and\n//        feedforward expander y = x * sqrt(avg|x|) (1:1.5) after it (gentler than the 2:1 IC).\n//   2. Colin Raffel & Julius O. Smith (DAFx-10, Paper P42, Sec 2.2, 3.3 & 4.4):\n//      - Clock-tracking anti-aliasing & reconstruction lowpass filtering (2 one-poles each,\n//        standing in for the Sallen-Key stages) and an asymmetric tanh bucket saturation\n//        standing in for the stage-accumulated charge-transfer THD.\n//   3. Martin Holters & Julian D. Parker (DAFx-18, Paper 12, Sec 2 & 4, Eq. 1, 34):\n//      - Roland Juno-60 / Dimension-D push-pull dual BBD stereo architecture (Mode I and a\n//        dual-LFO I+II ensemble). The sinc(f / f_BBD) sample-and-hold rolloff is below\n//        -1.5 dB in the audio band at these clock rates and is left to the reconstruction lowpass.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: unused (bound to a dummy local so the port stays present)\n//   in4: Optional 1-Bar Phasor [0..1] (exception to the in4-in-Hz contract): while it\n//        moves, the primary triangle LFO runs at 1 cycle per bar\n// Outlets:\n//   out1: Left Stereo BBD Chorus Output\n//   out2: Right Stereo BBD Chorus Output\n\n@param({ min: 0.1, max: 5.0 }) lfo_rate_hz = 0.55;              // LFO rate\n@param({ min: 0.0, max: 1.0 }) clock_mod_depth = 0.60;          // clock sweep depth\n@param({ min: 1.5, max: 15.0 }) center_delay_ms = 3.6;          // centre delay\n@param({ min: 0.0, max: 1.0 }) juno_mode_morph = 0.35;          // Mode I -> I+II morph\n@param({ min: 0.0, max: 1.0 }) ne570_compand = 0.55;            // compander depth\n@param({ min: 0.0, max: 1.0 }) bbd_warmth_thd = 0.45;           // darkness + saturation\n@param({ min: 0.0, max: 1.0 }) dry_wet_mix = 0.50;              // dry/wet\n\n// Dual stereo BBD circular delay buffers (4096 samples per channel)\n@state bbdBufL = new FixedSampleArray(4096);\n@state bbdBufR = new FixedSampleArray(4096);\n@state writeIdx: Int = 0;\n\n// NE570 Compander rectifier averaging capacitor states (DAFx-05 Eq. 26-30, DAFx-10 Sec 3.4)\n@state compEnvL = 0.1; @state compOutPrevL = 0.0;\n@state compEnvR = 0.1; @state compOutPrevR = 0.0;\n@state expEnvL = 0.1;  @state expEnvR = 0.1;\n\n//Huovilainen Eq. 25 moving-average BBD clock-history delay smoothers\n@state smoothTdL = 160.0;\n@state smoothTdR = 160.0;\n\n// Pre-BBD anti-aliasing & Post-BBD reconstruction Sallen-Key cascades (DAFx-10 Fig. 5, DAFx-18 Fig. 6)\n@state aaLp1L = new onepole(); @state aaLp2L = new onepole();\n@state aaLp1R = new onepole(); @state aaLp2R = new onepole();\n@state recLp1L = new onepole(); @state recLp2L = new onepole();\n@state recLp1R = new onepole(); @state recLp2R = new onepole();\n@state dcXL = 0.0; @state dcYL = 0.0;\n@state dcXR = 0.0; @state dcYR = 0.0;\n\n// Dual LFOs (Slow Chorus I + Fast Chorus II for Juno Mode I / II / I+II morph)\n@state lfoPh1 = new phasor();\n@state lfoPh2 = new phasor();\n@state prevBarIn = 0.0;\n@state barHold = 0.0;\n@state in2Hold = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\n// in2 counts as patched for 250 ms after any non-zero sample (a per-sample test\n// would swap in xL for single samples at in2's zero crossings)\nif (abs(in2) > 0.0000001) {\n\tin2Hold = 0.25 * sr;\n} else if (in2Hold > 0.0) {\n\tin2Hold -= 1.0;\n}\nlet xR = (in2Hold > 0.0) ? in2 : xL;\nlet unused_in3 = in3;\nlet barIn = in4;\n\n// --- 1. NE570-style 1.5:1 Feedback Compressor Before BBD (DAFx-05 Sec 5.2 Eq. 27, DAFx-10 Sec 3.4) ---\n// Rectifier RC time constant tau ~ 25 ms (R2 = 10 kOhm, C = 2.2 uF)\nlet rectAlpha = 1.0 - exp(-1.0 / (0.025 * sr));\ncompEnvL += (abs(compOutPrevL) - compEnvL) * rectAlpha;\ncompEnvR += (abs(compOutPrevR) - compEnvR) * rectAlpha;\n\nlet compGainL = 1.0 / clamp(sqrt(compEnvL + 0.0004), 0.12, 3.5);\nlet compGainR = 1.0 / clamp(sqrt(compEnvR + 0.0004), 0.12, 3.5);\nlet compAmt = clamp(ne570_compand, 0.0, 1.0);\n\nlet compInL = linearinterp(compAmt, xL, xL * compGainL * 0.72);\nlet compInR = linearinterp(compAmt, xR, xR * compGainR * 0.72);\ncompOutPrevL = compInL;\ncompOutPrevR = compInR;\n\n// --- 2. Juno-60 / Dimension-D Triangle LFOs & Variable BBD Clock Rate f_clock ---\nlet baseRate = clamp(lfo_rate_hz, 0.1, 5.0);\n// Bar phasor counts as active for 100 ms after it last moved (a constant in4 must not freeze the LFO)\nif (abs(barIn - prevBarIn) > 0.000001) {\n\tbarHold = 0.1 * sr;\n} else if (barHold > 0.0) {\n\tbarHold -= 1.0;\n}\nprevBarIn = barIn;\n\nlet freeP1 = lfoPh1.next(baseRate);\nlet p1 = (barHold > 0.0) ? wrap(barIn, 0.0, 1.0) : freeP1;\nlet p2 = lfoPh2.next(baseRate * 1.618 + 0.45); // Secondary rich ensemble LFO (Juno I+II mode)\n\n// Bipolar triangle LFOs in [-1, 1]\nlet tri1 = 2.0 * triangle(p1, 0.5) - 1.0;\nlet tri2 = 2.0 * triangle(p2, 0.5) - 1.0;\n\n// Juno Mode Morph: 0.0 = single-LFO push-pull (Mode I style), 1.0 = 65/35 sum of both LFOs (I+II ensemble)\nlet jMode = clamp(juno_mode_morph, 0.0, 1.0);\nlet lfoL = linearinterp(jMode, tri1, 0.65 * tri1 + 0.35 * tri2);\n// Push-pull anti-phase LFO on Right in Mode I/II, quadrature offset in Mode I+II\nlet lfoR = linearinterp(jMode, -tri1, -0.65 * tri1 + 0.35 * tri2);\n\n// Nominal MN3007 BBD stages N = 512 (256 buckets per channel): f_clock0 = N / (2 * delay_sec)\nlet nomDelSec = clamp(center_delay_ms, 1.5, 15.0) * 0.001;\nlet stagesN = 512.0;\nlet fClock0 = stagesN / (2.0 * nomDelSec);\n\n// Modulate BBD clock frequency linearly -> Delay time warps hyperbolically as 1 / f_clock! (DAFx-05 Fig. 9)\nlet modDepth = clamp(clock_mod_depth, 0.0, 1.0) * 0.48;\nlet fClockL = maximum(fClock0 * (1.0 + modDepth * lfoL), 6000.0);\nlet fClockR = maximum(fClock0 * (1.0 + modDepth * lfoR), 6000.0);\n\n// Huovilainen Eq. 25: td = avg(N * fs / (2 * f_clock), M) where M is average delay in samples\nlet rawTdL = (stagesN * sr) / (2.0 * fClockL);\nlet rawTdR = (stagesN * sr) / (2.0 * fClockR);\nlet avgAlpha = 1.0 / clamp(nomDelSec * sr, 16.0, 2000.0);\nsmoothTdL += (rawTdL - smoothTdL) * avgAlpha;\nsmoothTdR += (rawTdR - smoothTdR) * avgAlpha;\n\n// --- 3. Pre-BBD Sallen-Key Anti-Aliasing Filter (DAFx-10 Sec 2.2, DAFx-18 Sec 3.1) ---\nlet warmth = clamp(bbd_warmth_thd, 0.0, 1.0);\nlet aaCutoffL = clamp(fClockL * (0.42 - 0.18 * warmth), 1800.0, 18000.0);\nlet aaCutoffR = clamp(fClockR * (0.42 - 0.18 * warmth), 1800.0, 18000.0);\n\nlet bbdInL = aaLp2L.next(aaLp1L.next(compInL, aaCutoffL), aaCutoffL);\nlet bbdInR = aaLp2R.next(aaLp1R.next(compInR, aaCutoffR), aaCutoffR);\n\n// Stage-accumulated MOSFET bucket charge-transfer asymmetry & saturation (DAFx-10 Sec 4.4)\nlet drive = 1.0 + warmth * 0.85;\nlet asymBias = warmth * 0.08;\nbbdBufL[writeIdx] = (tanh(bbdInL * drive + asymBias) - tanh(asymBias)) / drive;\nbbdBufR[writeIdx] = (tanh(bbdInR * drive - asymBias) + tanh(asymBias)) / drive;\n\nlet rpOutL = writeIdx - clamp(smoothTdL, 2.0, 4090.0);\nwhile (rpOutL < 0.0) { rpOutL += 4096.0; }\nlet iOutL: Int = floor(rpOutL);\nlet delOutL = cubicinterp(rpOutL - iOutL, bbdBufL[(iOutL - 1 + 4096) & 4095], bbdBufL[iOutL & 4095], bbdBufL[(iOutL + 1) & 4095], bbdBufL[(iOutL + 2) & 4095]);\n\nlet rpOutR = writeIdx - clamp(smoothTdR, 2.0, 4090.0);\nwhile (rpOutR < 0.0) { rpOutR += 4096.0; }\nlet iOutR: Int = floor(rpOutR);\nlet delOutR = cubicinterp(rpOutR - iOutR, bbdBufR[(iOutR - 1 + 4096) & 4095], bbdBufR[iOutR & 4095], bbdBufR[(iOutR + 1) & 4095], bbdBufR[(iOutR + 2) & 4095]);\nwriteIdx = (writeIdx + 1) & 4095;\n\n// --- 4. Post-BBD Reconstruction Filter (also covers the small sinc(f/f_BBD) S&H roll-off, DAFx-18 Eq. 34) ---\nlet recL = recLp2L.next(recLp1L.next(delOutL, aaCutoffL * 0.9), aaCutoffL * 0.9);\nlet recR = recLp2R.next(recLp1R.next(delOutR, aaCutoffR * 0.9), aaCutoffR * 0.9);\n\n// --- 5. NE570-style 1:1.5 Feedforward Expander After BBD (DAFx-05 Sec 5.2 Eq. 26, DAFx-10 Sec 3.4) ---\nexpEnvL += (abs(recL) - expEnvL) * rectAlpha;\nexpEnvR += (abs(recR) - expEnvR) * rectAlpha;\n\nlet expOutL = linearinterp(compAmt, recL, recL * clamp(sqrt(expEnvL + 0.0004) * 1.42, 0.1, 3.0));\nlet expOutR = linearinterp(compAmt, recR, recR * clamp(sqrt(expEnvR + 0.0004) * 1.42, 0.1, 3.0));\n\n// DC Blockers\nlet wetL = expOutL - dcXL + 0.995 * dcYL;\ndcXL = expOutL; dcYL = wetL;\nlet wetR = expOutR - dcXR + 0.995 * dcYR;\ndcXR = expOutR; dcYR = wetR;\n\n// Constant-power dry/wet chorus blend\nlet mix = clamp(dry_wet_mix, 0.0, 1.0);\nlet dryGain = cos(mix * 0.5 * pi);\nlet wetGain = sin(mix * 0.5 * pi);\n\nout1 = dryGain * xL + wetGain * wetL;\nout2 = dryGain * xR + wetGain * wetR;\n",
                                                    "fontface": 0,
                                                    "fontname": "<Monospaced>",
                                                    "fontsize": 12.0,
                                                    "id": "obj-2",
                                                    "maxclass": "codebox~",
                                                    "numinlets": 4,
                                                    "numoutlets": 2,
                                                    "outlettype": [ "signal", "signal" ],
                                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                                    "rnbo_classname": "codebox~",
                                                    "rnbo_extra_attributes": {
                                                        "nocache": 0,
                                                        "expr": "",
                                                        "safemath": 1,
                                                        "code": "// ============================================================================\n// chorus_bbd_compander_juno.txt\n// Standalone Stereo Chorus Effect: Dual Push-Pull Analog BBD Chorus with NE570 Compander\n// Synthesizes 3 DAFx Bucket-Brigade Device (BBD) Chorus Papers into one complete unit:\n//   1. Antti Huovilainen (DAFx-05, Paper P_155, Sec 5.1 & 5.2, Eq. 25-31, Fig. 8-11):\n//      - Fixed N-stage capacitor delay line driven by a variable clock f_clock, producing\n//        the characteristic hyperbolic 1/f_clock BBD delay-time warp (Fig. 9) and moving-\n//        average clock-history smoothing t_d = avg(N * fs / (2 * f_clock), M) (Eq. 25).\n//      - Matched NE570-style compander after Eq. 26-27, implemented with a square-root\n//        detector law: feedback compressor y = x / sqrt(avg|y|) (1.5:1) before the BBD and\n//        feedforward expander y = x * sqrt(avg|x|) (1:1.5) after it (gentler than the 2:1 IC).\n//   2. Colin Raffel & Julius O. Smith (DAFx-10, Paper P42, Sec 2.2, 3.3 & 4.4):\n//      - Clock-tracking anti-aliasing & reconstruction lowpass filtering (2 one-poles each,\n//        standing in for the Sallen-Key stages) and an asymmetric tanh bucket saturation\n//        standing in for the stage-accumulated charge-transfer THD.\n//   3. Martin Holters & Julian D. Parker (DAFx-18, Paper 12, Sec 2 & 4, Eq. 1, 34):\n//      - Roland Juno-60 / Dimension-D push-pull dual BBD stereo architecture (Mode I and a\n//        dual-LFO I+II ensemble). The sinc(f / f_BBD) sample-and-hold rolloff is below\n//        -1.5 dB in the audio band at these clock rates and is left to the reconstruction lowpass.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: unused (bound to a dummy local so the port stays present)\n//   in4: Optional 1-Bar Phasor [0..1] (exception to the in4-in-Hz contract): while it\n//        moves, the primary triangle LFO runs at 1 cycle per bar\n// Outlets:\n//   out1: Left Stereo BBD Chorus Output\n//   out2: Right Stereo BBD Chorus Output\n\n@param({ min: 0.1, max: 5.0 }) lfo_rate_hz = 0.55;              // LFO rate\n@param({ min: 0.0, max: 1.0 }) clock_mod_depth = 0.60;          // clock sweep depth\n@param({ min: 1.5, max: 15.0 }) center_delay_ms = 3.6;          // centre delay\n@param({ min: 0.0, max: 1.0 }) juno_mode_morph = 0.35;          // Mode I -> I+II morph\n@param({ min: 0.0, max: 1.0 }) ne570_compand = 0.55;            // compander depth\n@param({ min: 0.0, max: 1.0 }) bbd_warmth_thd = 0.45;           // darkness + saturation\n@param({ min: 0.0, max: 1.0 }) dry_wet_mix = 0.50;              // dry/wet\n\n// Dual stereo BBD circular delay buffers (4096 samples per channel)\n@state bbdBufL = new FixedSampleArray(4096);\n@state bbdBufR = new FixedSampleArray(4096);\n@state writeIdx: Int = 0;\n\n// NE570 Compander rectifier averaging capacitor states (DAFx-05 Eq. 26-30, DAFx-10 Sec 3.4)\n@state compEnvL = 0.1; @state compOutPrevL = 0.0;\n@state compEnvR = 0.1; @state compOutPrevR = 0.0;\n@state expEnvL = 0.1;  @state expEnvR = 0.1;\n\n//Huovilainen Eq. 25 moving-average BBD clock-history delay smoothers\n@state smoothTdL = 160.0;\n@state smoothTdR = 160.0;\n\n// Pre-BBD anti-aliasing & Post-BBD reconstruction Sallen-Key cascades (DAFx-10 Fig. 5, DAFx-18 Fig. 6)\n@state aaLp1L = new onepole(); @state aaLp2L = new onepole();\n@state aaLp1R = new onepole(); @state aaLp2R = new onepole();\n@state recLp1L = new onepole(); @state recLp2L = new onepole();\n@state recLp1R = new onepole(); @state recLp2R = new onepole();\n@state dcXL = 0.0; @state dcYL = 0.0;\n@state dcXR = 0.0; @state dcYR = 0.0;\n\n// Dual LFOs (Slow Chorus I + Fast Chorus II for Juno Mode I / II / I+II morph)\n@state lfoPh1 = new phasor();\n@state lfoPh2 = new phasor();\n@state prevBarIn = 0.0;\n@state barHold = 0.0;\n@state in2Hold = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\n// in2 counts as patched for 250 ms after any non-zero sample (a per-sample test\n// would swap in xL for single samples at in2's zero crossings)\nif (abs(in2) > 0.0000001) {\n\tin2Hold = 0.25 * sr;\n} else if (in2Hold > 0.0) {\n\tin2Hold -= 1.0;\n}\nlet xR = (in2Hold > 0.0) ? in2 : xL;\nlet unused_in3 = in3;\nlet barIn = in4;\n\n// --- 1. NE570-style 1.5:1 Feedback Compressor Before BBD (DAFx-05 Sec 5.2 Eq. 27, DAFx-10 Sec 3.4) ---\n// Rectifier RC time constant tau ~ 25 ms (R2 = 10 kOhm, C = 2.2 uF)\nlet rectAlpha = 1.0 - exp(-1.0 / (0.025 * sr));\ncompEnvL += (abs(compOutPrevL) - compEnvL) * rectAlpha;\ncompEnvR += (abs(compOutPrevR) - compEnvR) * rectAlpha;\n\nlet compGainL = 1.0 / clamp(sqrt(compEnvL + 0.0004), 0.12, 3.5);\nlet compGainR = 1.0 / clamp(sqrt(compEnvR + 0.0004), 0.12, 3.5);\nlet compAmt = clamp(ne570_compand, 0.0, 1.0);\n\nlet compInL = linearinterp(compAmt, xL, xL * compGainL * 0.72);\nlet compInR = linearinterp(compAmt, xR, xR * compGainR * 0.72);\ncompOutPrevL = compInL;\ncompOutPrevR = compInR;\n\n// --- 2. Juno-60 / Dimension-D Triangle LFOs & Variable BBD Clock Rate f_clock ---\nlet baseRate = clamp(lfo_rate_hz, 0.1, 5.0);\n// Bar phasor counts as active for 100 ms after it last moved (a constant in4 must not freeze the LFO)\nif (abs(barIn - prevBarIn) > 0.000001) {\n\tbarHold = 0.1 * sr;\n} else if (barHold > 0.0) {\n\tbarHold -= 1.0;\n}\nprevBarIn = barIn;\n\nlet freeP1 = lfoPh1.next(baseRate);\nlet p1 = (barHold > 0.0) ? wrap(barIn, 0.0, 1.0) : freeP1;\nlet p2 = lfoPh2.next(baseRate * 1.618 + 0.45); // Secondary rich ensemble LFO (Juno I+II mode)\n\n// Bipolar triangle LFOs in [-1, 1]\nlet tri1 = 2.0 * triangle(p1, 0.5) - 1.0;\nlet tri2 = 2.0 * triangle(p2, 0.5) - 1.0;\n\n// Juno Mode Morph: 0.0 = single-LFO push-pull (Mode I style), 1.0 = 65/35 sum of both LFOs (I+II ensemble)\nlet jMode = clamp(juno_mode_morph, 0.0, 1.0);\nlet lfoL = linearinterp(jMode, tri1, 0.65 * tri1 + 0.35 * tri2);\n// Push-pull anti-phase LFO on Right in Mode I/II, quadrature offset in Mode I+II\nlet lfoR = linearinterp(jMode, -tri1, -0.65 * tri1 + 0.35 * tri2);\n\n// Nominal MN3007 BBD stages N = 512 (256 buckets per channel): f_clock0 = N / (2 * delay_sec)\nlet nomDelSec = clamp(center_delay_ms, 1.5, 15.0) * 0.001;\nlet stagesN = 512.0;\nlet fClock0 = stagesN / (2.0 * nomDelSec);\n\n// Modulate BBD clock frequency linearly -> Delay time warps hyperbolically as 1 / f_clock! (DAFx-05 Fig. 9)\nlet modDepth = clamp(clock_mod_depth, 0.0, 1.0) * 0.48;\nlet fClockL = maximum(fClock0 * (1.0 + modDepth * lfoL), 6000.0);\nlet fClockR = maximum(fClock0 * (1.0 + modDepth * lfoR), 6000.0);\n\n// Huovilainen Eq. 25: td = avg(N * fs / (2 * f_clock), M) where M is average delay in samples\nlet rawTdL = (stagesN * sr) / (2.0 * fClockL);\nlet rawTdR = (stagesN * sr) / (2.0 * fClockR);\nlet avgAlpha = 1.0 / clamp(nomDelSec * sr, 16.0, 2000.0);\nsmoothTdL += (rawTdL - smoothTdL) * avgAlpha;\nsmoothTdR += (rawTdR - smoothTdR) * avgAlpha;\n\n// --- 3. Pre-BBD Sallen-Key Anti-Aliasing Filter (DAFx-10 Sec 2.2, DAFx-18 Sec 3.1) ---\nlet warmth = clamp(bbd_warmth_thd, 0.0, 1.0);\nlet aaCutoffL = clamp(fClockL * (0.42 - 0.18 * warmth), 1800.0, 18000.0);\nlet aaCutoffR = clamp(fClockR * (0.42 - 0.18 * warmth), 1800.0, 18000.0);\n\nlet bbdInL = aaLp2L.next(aaLp1L.next(compInL, aaCutoffL), aaCutoffL);\nlet bbdInR = aaLp2R.next(aaLp1R.next(compInR, aaCutoffR), aaCutoffR);\n\n// Stage-accumulated MOSFET bucket charge-transfer asymmetry & saturation (DAFx-10 Sec 4.4)\nlet drive = 1.0 + warmth * 0.85;\nlet asymBias = warmth * 0.08;\nbbdBufL[writeIdx] = (tanh(bbdInL * drive + asymBias) - tanh(asymBias)) / drive;\nbbdBufR[writeIdx] = (tanh(bbdInR * drive - asymBias) + tanh(asymBias)) / drive;\n\nlet rpOutL = writeIdx - clamp(smoothTdL, 2.0, 4090.0);\nwhile (rpOutL < 0.0) { rpOutL += 4096.0; }\nlet iOutL: Int = floor(rpOutL);\nlet delOutL = cubicinterp(rpOutL - iOutL, bbdBufL[(iOutL - 1 + 4096) & 4095], bbdBufL[iOutL & 4095], bbdBufL[(iOutL + 1) & 4095], bbdBufL[(iOutL + 2) & 4095]);\n\nlet rpOutR = writeIdx - clamp(smoothTdR, 2.0, 4090.0);\nwhile (rpOutR < 0.0) { rpOutR += 4096.0; }\nlet iOutR: Int = floor(rpOutR);\nlet delOutR = cubicinterp(rpOutR - iOutR, bbdBufR[(iOutR - 1 + 4096) & 4095], bbdBufR[iOutR & 4095], bbdBufR[(iOutR + 1) & 4095], bbdBufR[(iOutR + 2) & 4095]);\nwriteIdx = (writeIdx + 1) & 4095;\n\n// --- 4. Post-BBD Reconstruction Filter (also covers the small sinc(f/f_BBD) S&H roll-off, DAFx-18 Eq. 34) ---\nlet recL = recLp2L.next(recLp1L.next(delOutL, aaCutoffL * 0.9), aaCutoffL * 0.9);\nlet recR = recLp2R.next(recLp1R.next(delOutR, aaCutoffR * 0.9), aaCutoffR * 0.9);\n\n// --- 5. NE570-style 1:1.5 Feedforward Expander After BBD (DAFx-05 Sec 5.2 Eq. 26, DAFx-10 Sec 3.4) ---\nexpEnvL += (abs(recL) - expEnvL) * rectAlpha;\nexpEnvR += (abs(recR) - expEnvR) * rectAlpha;\n\nlet expOutL = linearinterp(compAmt, recL, recL * clamp(sqrt(expEnvL + 0.0004) * 1.42, 0.1, 3.0));\nlet expOutR = linearinterp(compAmt, recR, recR * clamp(sqrt(expEnvR + 0.0004) * 1.42, 0.1, 3.0));\n\n// DC Blockers\nlet wetL = expOutL - dcXL + 0.995 * dcYL;\ndcXL = expOutL; dcYL = wetL;\nlet wetR = expOutR - dcXR + 0.995 * dcYR;\ndcXR = expOutR; dcYR = wetR;\n\n// Constant-power dry/wet chorus blend\nlet mix = clamp(dry_wet_mix, 0.0, 1.0);\nlet dryGain = cos(mix * 0.5 * pi);\nlet wetGain = sin(mix * 0.5 * pi);\n\nout1 = dryGain * xL + wetGain * wetL;\nout2 = dryGain * xR + wetGain * wetR;\n"
                                                    },
                                                    "rnbo_serial": 1,
