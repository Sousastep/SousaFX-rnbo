                    },
                    "id": "obj-51",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 1,
                    "outlettype": [ "signal" ],
                    "patching_rect": [ 398.0, 1420.0, 35.0, 23.0 ],
                    "rnbo_classname": "gen~",
                    "rnbo_extra_attributes": {
                        "exposeparams": 0,
                        "gencode": "upsample2x_ppiir(x) {\n\tHistory p0_d1(0);\n\tHistory p0_d2(0);\n\tHistory p0_d3(0);\n\tHistory p1_d1(0);\n\tHistory p1_d2(0);\n\tHistory p1_d3(0);\n\tp0_a0 = 0.052037289518901;\n\tp0_a1 = 0.4378390730273;\n\tp1_a0 = 0.20139892364006;\n\tp1_a1 = 0.77390943595264;\n\tp1_d3_last = p1_d3;\n\ts = p0_d1 + (p0_a0 * ((x - p0_d2)));\n\ty = p0_d2 + (p0_a1 * ((s - p0_d3)));\n\tp0_d3 = y;\n\tp0_d2 = s;\n\tp0_d1 = x;\n\ts_1 = p1_d1 + (p1_a0 * ((x - p1_d2)));\n\ty_2 = p1_d2 + (p1_a1 * ((s_1 - p1_d3)));\n\tp1_d3 = y_2;\n\tp1_d2 = s_1;\n\tp1_d1 = x;\n\treturn ((p0_d3 + p1_d3_last)) * 0.5, ((p0_d3 + p1_d3)) * 0.5;\n}\n\ndownsample2x_ppiir(x1, x2) {\n\tHistory p0_d1(0);\n\tHistory p0_d2(0);\n\tHistory p0_d3(0);\n\tHistory p1_d1(0);\n\tHistory p1_d2(0);\n\tHistory p1_d3(0);\n\tp0_a0 = 0.052037289518901;\n\tp0_a1 = 0.4378390730273;\n\tp1_a0 = 0.20139892364006;\n\tp1_a1 = 0.77390943595264;\n\tp1_d3_last = p1_d3;\n\ts = p0_d1 + (p0_a0 * ((x1 - p0_d2)));\n\ty = p0_d2 + (p0_a1 * ((s - p0_d3)));\n\tp0_d3 = y;\n\tp0_d2 = s;\n\tp0_d1 = x1;\n\ts_3 = p1_d1 + (p1_a0 * ((x2 - p1_d2)));\n\ty_4 = p1_d2 + (p1_a1 * ((s_3 - p1_d3)));\n\tp1_d3 = y_4;\n\tp1_d2 = s_3;\n\tp1_d1 = x2;\n\treturn ((p0_d3 + p1_d3_last)) * 0.5;\n}\n\nupsample4x_ppiir(x) {\n\tData pass1_buf(16, 1);\n\tData pass2_buf(16, 1);\n\ta, b = upsample2x_ppiir(x);\n\tpoke(pass1_buf, a, 0, 0, 0);\n\tpoke(pass1_buf, b, 1, 0, 0);\n\tfor(i = 0; i < 2; i = i + 1) {\n\t\tv = peek(pass1_buf, i, 0);\n\t\ta, b = upsample2x_ppiir(v);\n\t\tpoke(pass2_buf, a, i * 2, 0, 0);\n\t\tpoke(pass2_buf, b, (i * 2) + 1, 0, 0);\n\t}\n\ty1 = peek(pass2_buf, 0, 0);\n\ty2 = peek(pass2_buf, 1, 0);\n\ty3 = peek(pass2_buf, 2, 0);\n\ty4 = peek(pass2_buf, 3, 0);\n\treturn y1, y2, y3, y4;\n}\n\ndownsample4x_ppiir(x1, x2, x3, x4) {\n\tData pass1_buf(16, 1);\n\tData pass2_buf(16, 1);\n\tpoke(pass1_buf, x1, 0, 0, 0);\n\tpoke(pass1_buf, x2, 1, 0, 0);\n\tpoke(pass1_buf, x3, 2, 0, 0);\n\tpoke(pass1_buf, x4, 3, 0, 0);\n\tfor(i = 0; i < 2; i