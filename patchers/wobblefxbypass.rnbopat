            {
                "box": {
                    "genpatcher": {
                        "patcher": {
                            "fileversion": 1,
                            "appversion": {
                                "major": 9,
                                "minor": 1,
                                "revision": 5,
                                "architecture": "x64",
                                "modernui": 1
                            },
                            "classnamespace": "dsp.gen",
                            "rect": [ 577.0, 503.0, 522.0, 445.0 ],
                            "default_fontname": "Lato",
                            "gridonopen": 2,
                            "gridsize": [ 10.0, 10.0 ],
                            "gridsnaponopen": 2,
                            "objectsnaponopen": 0,
                            "subpatcher_template": "MP-Rnbo",
                            "boxes": [
                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 20.0, 56.0, 430.0, 290.0 ],
                                        "fontsize": 12.0,
                                        "outlettype": [ "" ],
                                        "fontname": "<Monospaced>",
                                        "numinlets": 1,
                                        "fontface": 0,
                                        "numoutlets": 1,
                                        "id": "obj-5",
                                        "code": "require(\"halfband_ppiir.genexpr\");\r\n\r\noversample(x)\r\n{\r\n\treturn (x);\r\n}\r\n\r\nup0, up1, up2, up3 = upsample4x_ppiir(in1);\r\n// do something to the upsampled values\r\nup0 = oversample(up0);\r\nup1 = oversample(up1);\r\nup2 = oversample(up2);\r\nup3 = oversample(up3);\r\nout1 = downsample4x_ppiir(up0, up1, up2, up3);\r\n"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "in 1",
                                        "patching_rect": [ 20.0, 20.0, 28.0, 23.0 ],
                                        "outlettype": [ "" ],
