                                        "boxes": [
                                            {
                                                "box": {
                                                    "code": "// ============================================================================\n// 06_asymmetric_delay_adfm.txt\n// Unix-Style Effect 6: Delay-Line Asymmetric Adaptive FM (ASDFM1 / ASDFM2)\n// Implements Lazzarini, Timoney & Lysaght (DAFx-08):\n// \"Asymmetric-Spectra Methods for Adaptive FM Synthesis\" (Sec 2.1 & 2.2, Eq. 1-4).\n// Applies adaptive phase modulation to the full stereo tuba signal via a cubic-\n// interpolated variable delay line, ring-modulated by an exponentially mapped\n// cosine with Palamin symmetry parameter r and modified-Bessel I0 normalization.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Full Tuba Carrier)\n//   in2: Right Audio Input (Full Tuba Carrier)\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n// Outlets:\n//   out1: Left Asymmetric AdFM Output\n//   out2: Right Asymmetric AdFM Output\n\n@param({ min: 0.25, max: 4.0 }) cm_ratio = 1.0;\n@param({ min: 0.0, max: 6.0 }) mod_index = 2.0;\n@param({ min: -1.0, max: 1.0 }) symmetry_r = 0.35;\n@param({ min: 0.0, max: 1.0 }) bessel_mode = 1.0;\n\n// Delay lines (4096 samples per channel, power-of-2 wrap)\n@state delayBufL = new FixedSampleArray(4096);\n@state delayBufR = new FixedSampleArray(4096);\n@state writeIdx: Int = 0;\n\n// Modulator phasor\n@state modPhasor = new phasor();\n\n// Fallback ZC pitch tracker\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n\n// Rational polynomial approximation of ln(I0(x)) for Modified Bessel normalization\n// Prevents exponential overload at large k * |r +/- 1/r| (Paper Sec 2.2 & 4.2)\nfunction lnBesselI0(x: number): number {\n\tlet ax = abs(x);\n\tlet res = 0.0;\n\tif (ax < 3.75) {\n\t\tlet t = ax / 3.75;\n\t\tlet t2 = t * t;\n\t\tlet i0 = 1.0 + t2 * (3.5156229 + t2 * (3.0899424 + t2 * (1.2067492 + t2 * (0.2659732 + t2 * (0.0360768 + t2 * 0.0045813)))));\n\t\tres = log(i0);\n\t} else {\n\t\t// Asymptotic expansion: ln(I0(x)) ~ |x| - 0.5*ln(2*pi*|x|)\n\t\tres = ax - 0.5 * log(2.0 * pi * ax) + 0.125 / ax;\n\t}\n\treturn res;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\n\n// --- 1. Pitch Conditioning ---\nlet monoLow = lpTrack.next(0.5 * (xL + xR), 180.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nsmoothF0 += (rawF0 - smoothF0) * (1.0 - exp(-1.0 / (0.008 * sr)));\nlet f0 = clamp(smoothF0, 25.0, 1000.0);\n\n// --- 2. Write Incoming Tuba Carrier to Circular Delay Buffer ---\ndelayBufL[writeIdx] = xL;\ndelayBufR[writeIdx] = xR;\n\n// --- 3. Compute Asymmetric AdFM Parameters (Paper Eq. 3 & 4) ---\nlet k = pow(clamp(mod_index / 6.0, 0.0, 1.0), 1.3) * 6.0;\n// symmetry_r in [-1, 1] maps exponentially to r in [0.25, 4.0] (0 -> r=1 symmetric)\nlet r = pow(4.0, clamp(symmetry_r, -1.0, 1.0));\nlet rPlus = 0.5 * (r + 1.0 / r);\nlet rMinus = 0.5 * (r - 1.0 / r);\n\n// Blend between ASDFM1 (Eq. 3: standard Bessel Jn) and ASDFM2 (Eq. 4: Modified Bessel In moving formants)\nlet mMode = clamp(bessel_mode, 0.0, 1.0);\n// The phase index keeps its sign (Eq. 4 uses k * rMinus, negative for r < 1); a\n// negative index is realised by inverting the delay modulation below\nlet kDelay = k * linearinterp(mMode, rPlus, rMinus);\nlet pmSign = (kDelay < 0.0) ? -1.0 : 1.0;\nlet kAmp = k * linearinterp(mMode, rMinus, rPlus);\n// Keep kAmp bounded for numerical stability\nkAmp = clamp(kAmp, -8.0, 8.0);\n\n// Modulator frequency fm = f0 / cm_ratio\nlet fm = clamp(f0 / clamp(cm_ratio, 0.25, 4.0), 8.0, 2000.0);\nlet phL = modPhasor.next(fm);\nlet phR = wrap(phL + 0.06, 0.0, 1.0); // Slight stereo modulator phase spread\n\n// Raised, scaled, inverted sine for delay modulation (Paper Sec 2.1: pi/2 offset from cosine)\nlet modSinL = 0.5 * (1.0 - pmSign * sin(2.0 * pi * phL));\nlet modSinR = 0.5 * (1.0 - pmSign * sin(2.0 * pi * phR));\n\n// Delay modulation depth in samples: adt = (kDelay / (pi * f0)) * sr * modSin + 2 samples offset\nlet maxDelaySamps = clamp((abs(kDelay) / (pi * f0)) * sr, 0.0, 2000.0);\nlet delaySampsL = 2.0 + maxDelaySamps * modSinL;\nlet delaySampsR = 2.0 + maxDelaySamps * modSinR;\n\n// --- 4. Cubic Interpolated Delay Read ---\nlet readPosL = writeIdx - delaySampsL;\nwhile (readPosL < 0.0) { readPosL += 4096.0; }\nlet idxL0: Int = floor(readPosL);\nlet fracL = readPosL - idxL0;\nlet iLm1: Int = (idxL0 - 1 + 4096) % 4096;\nlet iL0: Int = idxL0 % 4096;\nlet iL1: Int = (idxL0 + 1) % 4096;\nlet iL2: Int = (idxL0 + 2) % 4096;\nlet delL = cubicinterp(fracL, delayBufL[iLm1], delayBufL[iL0], delayBufL[iL1], delayBufL[iL2]);\n\nlet readPosR = writeIdx - delaySampsR;\nwhile (readPosR < 0.0) { readPosR += 4096.0; }\nlet idxR0: Int = floor(readPosR);\nlet fracR = readPosR - idxR0;\nlet iRm1: Int = (idxR0 - 1 + 4096) % 4096;\nlet iR0: Int = idxR0 % 4096;\nlet iR1: Int = (idxR0 + 1) % 4096;\nlet iR2: Int = (idxR0 + 2) % 4096;\nlet delR = cubicinterp(fracR, delayBufR[iRm1], delayBufR[iR0], delayBufR[iR1], delayBufR[iR2]);\n\nwriteIdx = (writeIdx + 1) % 4096;\n\n// --- 5. Exponential Cosine Ring Modulation with I0 Normalization ---\nlet modCosL = cos(2.0 * pi * phL);\nlet modCosR = cos(2.0 * pi * phR);\nlet lnI0 = lnBesselI0(kAmp);\n\nlet envModL = exp(kAmp * modCosL - lnI0);\nlet envModR = exp(kAmp * modCosR - lnI0);\n\nout1 = delL * envModL;\nout2 = delR * envModR;\n",
                                                    "fontface": 0,
                                                    "fontname": "<Monospaced>",
                                                    "fontsize": 12.0,
                                                    "id": "obj-2",
                                                    "maxclass": "codebox~",
                                                    "numinlets": 3,
                                                    "numoutlets": 2,
                                                    "outlettype": [ "signal", "signal" ],
                                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                                    "rnbo_classname": "codebox~",
                                                    "rnbo_extra_attributes": {
                                                        "nocache": 0,
                                                        "expr": "",
                                                        "safemath": 1,
                                                        "code": "// ============================================================================\n// 06_asymmetric_delay_adfm.txt\n// Unix-Style Effect 6: Delay-Line Asymmetric Adaptive FM (ASDFM1 / ASDFM2)\n// Implements Lazzarini, Timoney & Lysaght (DAFx-08):\n// \"Asymmetric-Spectra Methods for Adaptive FM Synthesis\" (Sec 2.1 & 2.2, Eq. 1-4).\n// Applies adaptive phase modulation to the full stereo tuba signal via a cubic-\n// interpolated variable delay line, ring-modulated by an exponentially mapped\n// cosine with Palamin symmetry parameter r and modified-Bessel I0 normalization.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Full Tuba Carrier)\n//   in2: Right Audio Input (Full Tuba Carrier)\n//   in3: Tracked Fundamental Pitch in Hz (from fluid.pitch~; fallback ZC if <=0)\n// Outlets:\n//   out1: Left Asymmetric AdFM Output\n//   out2: Right Asymmetric AdFM Output\n\n@param({ min: 0.25, max: 4.0 }) cm_ratio = 1.0;\n@param({ min: 0.0, max: 6.0 }) mod_index = 2.0;\n@param({ min: -1.0, max: 1.0 }) symmetry_r = 0.35;\n@param({ min: 0.0, max: 1.0 }) bessel_mode = 1.0;\n\n// Delay lines (4096 samples per channel, power-of-2 wrap)\n@state delayBufL = new FixedSampleArray(4096);\n@state delayBufR = new FixedSampleArray(4096);\n@state writeIdx: Int = 0;\n\n// Modulator phasor\n@state modPhasor = new phasor();\n\n// Fallback ZC pitch tracker\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 55.0;\n@state smoothF0 = 55.0;\n\n// Rational polynomial approximation of ln(I0(x)) for Modified Bessel normalization\n// Prevents exponential overload at large k * |r +/- 1/r| (Paper Sec 2.2 & 4.2)\nfunction lnBesselI0(x: number): number {\n\tlet ax = abs(x);\n\tlet res = 0.0;\n\tif (ax < 3.75) {\n\t\tlet t = ax / 3.75;\n\t\tlet t2 = t * t;\n\t\tlet i0 = 1.0 + t2 * (3.5156229 + t2 * (3.0899424 + t2 * (1.2067492 + t2 * (0.2659732 + t2 * (0.0360768 + t2 * 0.0045813)))));\n\t\tres = log(i0);\n\t} else {\n\t\t// Asymptotic expansion: ln(I0(x)) ~ |x| - 0.5*ln(2*pi*|x|)\n\t\tres = ax - 0.5 * log(2.0 * pi * ax) + 0.125 / ax;\n\t}\n\treturn res;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\nlet xR = in2;\nlet pitchIn = in3;\n\n// --- 1. Pitch Conditioning ---\nlet monoLow = lpTrack.next(0.5 * (xL + xR), 180.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nsmoothF0 += (rawF0 - smoothF0) * (1.0 - exp(-1.0 / (0.008 * sr)));\nlet f0 = clamp(smoothF0, 25.0, 1000.0);\n\n// --- 2. Write Incoming Tuba Carrier to Circular Delay Buffer ---\ndelayBufL[writeIdx] = xL;\ndelayBufR[writeIdx] = xR;\n\n// --- 3. Compute Asymmetric AdFM Parameters (Paper Eq. 3 & 4) ---\nlet k = pow(clamp(mod_index / 6.0, 0.0, 1.0), 1.3) * 6.0;\n// symmetry_r in [-1, 1] maps exponentially to r in [0.25, 4.0] (0 -> r=1 symmetric)\nlet r = pow(4.0, clamp(symmetry_r, -1.0, 1.0));\nlet rPlus = 0.5 * (r + 1.0 / r);\nlet rMinus = 0.5 * (r - 1.0 / r);\n\n// Blend between ASDFM1 (Eq. 3: standard Bessel Jn) and ASDFM2 (Eq. 4: Modified Bessel In moving formants)\nlet mMode = clamp(bessel_mode, 0.0, 1.0);\n// The phase index keeps its sign (Eq. 4 uses k * rMinus, negative for r < 1); a\n// negative index is realised by inverting the delay modulation below\nlet kDelay = k * linearinterp(mMode, rPlus, rMinus);\nlet pmSign = (kDelay < 0.0) ? -1.0 : 1.0;\nlet kAmp = k * linearinterp(mMode, rMinus, rPlus);\n// Keep kAmp bounded for numerical stability\nkAmp = clamp(kAmp, -8.0, 8.0);\n\n// Modulator frequency fm = f0 / cm_ratio\nlet fm = clamp(f0 / clamp(cm_ratio, 0.25, 4.0), 8.0, 2000.0);\nlet phL = modPhasor.next(fm);\nlet phR = wrap(phL + 0.06, 0.0, 1.0); // Slight stereo modulator phase spread\n\n// Raised, scaled, inverted sine for delay modulation (Paper Sec 2.1: pi/2 offset from cosine)\nlet modSinL = 0.5 * (1.0 - pmSign * sin(2.0 * pi * phL));\nlet modSinR = 0.5 * (1.0 - pmSign * sin(2.0 * pi * phR));\n\n// Delay modulation depth in samples: adt = (kDelay / (pi * f0)) * sr * modSin + 2 samples offset\nlet maxDelaySamps = clamp((abs(kDelay) / (pi * f0)) * sr, 0.0, 2000.0);\nlet delaySampsL = 2.0 + maxDelaySamps * modSinL;\nlet delaySampsR = 2.0 + maxDelaySamps * modSinR;\n\n// --- 4. Cubic Interpolated Delay Read ---\nlet readPosL = writeIdx - delaySampsL;\nwhile (readPosL < 0.0) { readPosL += 4096.0; }\nlet idxL0: Int = floor(readPosL);\nlet fracL = readPosL - idxL0;\nlet iLm1: Int = (idxL0 - 1 + 4096) % 4096;\nlet iL0: Int = idxL0 % 4096;\nlet iL1: Int = (idxL0 + 1) % 4096;\nlet iL2: Int = (idxL0 + 2) % 4096;\nlet delL = cubicinterp(fracL, delayBufL[iLm1], delayBufL[iL0], delayBufL[iL1], delayBufL[iL2]);\n\nlet readPosR = writeIdx - delaySampsR;\nwhile (readPosR < 0.0) { readPosR += 4096.0; }\nlet idxR0: Int = floor(readPosR);\nlet fracR = readPosR - idxR0;\nlet iRm1: Int = (idxR0 - 1 + 4096) % 4096;\nlet iR0: Int = idxR0 % 4096;\nlet iR1: Int = (idxR0 + 1) % 4096;\nlet iR2: Int = (idxR0 + 2) % 4096;\nlet delR = cubicinterp(fracR, delayBufR[iRm1], delayBufR[iR0], delayBufR[iR1], delayBufR[iR2]);\n\nwriteIdx = (writeIdx + 1) % 4096;\n\n// --- 5. Exponential Cosine Ring Modulation with I0 Normalization ---\nlet modCosL = cos(2.0 * pi * phL);\nlet modCosR = cos(2.0 * pi * phR);\nlet lnI0 = lnBesselI0(kAmp);\n\nlet envModL = exp(kAmp * modCosL - lnI0);\nlet envModR = exp(kAmp * modCosR - lnI0);\n\nout1 = delL * envModL;\nout2 = delR * envModR;\n"
                                                    },
