                            },
                            {
                                "box": {
                                    "id": "obj-14",
                                    "maxclass": "newobj",
                                    "numinlets": 2,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patcher": {
                                        "fileversion": 1,
                                        "appversion": {
                                            "major": 9,
                                            "minor": 2,
                                            "revision": 0,
                                            "architecture": "x64",
                                            "modernui": 1
                                        },
                                        "classnamespace": "rnbo",
                                        "rect": [ 100.0, 100.0, 2034.0, 780.0 ],
                                        "default_fontname": "Lato",
                                        "title": "ai.rev_sdn_room",
                                        "boxes": [
                                            {
                                                "box": {
                                                    "code": "// ============================================================================\n// rev_sdn_room.txt\n// A small shoebox room as a scattering delay network (six wall nodes): punch and size without a wash.\n// From: Fontana, Presti, Fantini, Avanzini & Rey, \"A Highly Parametrized\n//       Scattering Delay Network Implementation for Interactive Room\n//       Auralization\", DAFx-24 Paper 34, §2.2-2.3 (one scattering node per\n//       wall at the first-order reflection point; nodes joined by\n//       bidirectional delay lines D = fs*|xk - xj|/c, Eq. 2; S = beta*A with\n//       beta = sqrt(1 - alpha) and the lossless A = (2/K)*1*1^T - I, Eq. 6;\n//       source-to-node lines with 1/r spreading; node-to-receiver lines with\n//       weights 2/K and gain 1/(1 + |xk - xR| / |xS - xk|), Eq. 3) and §3.2\n//       (frequency-dependent wall absorption as a filter H(z) in S = H(z)A).\n//       Mezza, Giampiccolo, De Sena & Bernardini, \"Differentiable Scattering\n//       Delay Networks for Artificial Reverberation\", DAFx-25 Paper 51, §2.2\n//       (the scattering junction, source pressure split 1/2 into each\n//       incoming wave).\n// First-order reflections land at their exact geometric times; higher orders\n// are approximated by the node network. The line-of-sight path is left out\n// (the dry sound lives outside this effect).\n// 100% wet. No dry path, no limiter, no metering.\n// Inlets:\n//   in1 / in2: stereo audio (summed: one source)\n// Outlets:\n//   out1 / out2: two spaced omni receivers, wet only\n// ============================================================================\n\n// predelay\n@param({ min: 0, max: 100 }) predelay_ms = 0;\n// room length (width 0.8x, height 0.45x)\n@param({ min: 2, max: 30, exponent: 2 }) room_m = 6;\n// wall absorption coefficient\n@param({ min: 0.05, max: 0.9 }) absorb = 0.3;\n// wall lowpass (frequency-dependent absorption)\n@param({ min: 500, max: 16000, exponent: 2 }) wall_hz = 5000;\n// source distance from the receivers (fraction of the room)\n@param({ min: 0.1, max: 0.9 }) source_pos = 0.5;\n// receiver spacing\n@param({ min: 0, max: 1 }) width = 0.8;\n// low cut\n@param({ min: 20, max: 600, exponent: 2 }) lowcut_hz = 120;\n// output gain\n@param({ min: -24, max: 12 }) out_gain_db = 0;\n\n@state pre = new FixedSampleArray(32768);\n@state preIdx: Int = 0;\n\n// 0-29 node->node (k*5 + slot), 30-35 source->node, 36-47 node->receiver\n@state lines = new FixedSampleArray(48, 16384);\n@state del = new FixedSampleArray(48);\n@state wIdx: Int = 0;\n\n@state gS = new FixedSampleArray(6);\n@state gR = new FixedSampleArray(12);\n@state nx = new FixedSampleArray(6);\n@state ny = new FixedSampleArray(6);\n@state nz = new FixedSampleArray(6);\n\n@state inc = new FixedSampleArray(30);\n@state wallLp = new FixedSampleArray(30);\n@state srcIn = new FixedSampleArray(6);\n\n@state roomS = -1.0;\n@state posS = -1.0;\n@state widS = -1.0;\n@state ctr: Int = 0;\n\n@state hx1 = 0.0;\n@state hy1 = 0.0;\n@state hx2 = 0.0;\n@state hy2 = 0.0;\n\nfunction dist(ax: number, ay: number, az: number, bx: number, by: number, bz: number) {\n\tlet dx = ax - bx;\n\tlet dy = ay - by;\n\tlet dz = az - bz;\n\treturn sqrt(dx * dx + dy * dy + dz * dz);\n}\n\n// node->node line index from k to j (j != k)\nfunction lineIdx(k: Int, j: Int) {\n\tlet slot: Int = j;\n\tif (j > k) {\n\t\tslot = j - 1;\n\t}\n\treturn k * 5 + slot;\n}\n\n// geometry -> delay lengths and gains (§2.3.1-2.3.3)\nfunction geom(lx: number, pos: number, wid: number, sr: number) {\n\tlet ly = 0.8 * lx;\n\tlet lz = 0.45 * lx;\n\tlet rx = 0.5 * lx;\n\tlet ry = 0.3 * ly;\n\tlet rz = 0.4 * lz;\n\tlet sx = 0.6 * lx;\n\tlet sy = ry + pos * 0.65 * ly;\n\tlet sz = 0.45 * lz;\n\tlet k343 = sr / 343.0;\n\n\t// node k: first-order reflection point on wall k (x0, xL, y0, yL, z0, zL)\n\tfor (let k: Int = 0; k < 6; k++) {\n\t\tlet ax: Int = k >> 1;\n\t\tlet w = 0.0;\n\t\tif ((k & 1) == 1) {\n\t\t\tif (ax == 0) {\n\t\t\t\tw = lx;\n\t\t\t} else if (ax == 1) {\n\t\t\t\tw = ly;\n\t\t\t} else {\n\t\t\t\tw = lz;\n\t\t\t}\n\t\t}\n\t\tlet ix = sx;\n\t\tlet iy = sy;\n\t\tlet iz = sz;\n\t\tlet t = 0.0;\n\t\tif (ax == 0) {\n\t\t\tix = 2.0 * w - sx;\n\t\t\tt = (w - rx) / (ix - rx);\n\t\t} else if (ax == 1) {\n\t\t\tiy = 2.0 * w - sy;\n\t\t\tt = (w - ry) / (iy - ry);\n\t\t} else {\n\t\t\tiz = 2.0 * w - sz;\n\t\t\tt = (w - rz) / (iz - rz);\n\t\t}\n\t\tnx[k] = rx + t * (ix - rx);\n\t\tny[k] = ry + t * (iy - ry);\n\t\tnz[k] = rz + t * (iz - rz);\n\t}\n\n\tfor (let k: Int = 0; k < 6; k++) {\n\t\tlet dS = maximum(dist(sx, sy, sz, nx[k], ny[k], nz[k]), 0.1);\n\t\tdel[30 + k] = clamp(dS * k343, 2.0, 16000.0);\n\t\tgS[k] = 1.0 / dS;\n\t\tfor (let j: Int = 0; j < 6; j++) {\n\t\t\tif (j != k) {\n\t\t\t\tlet li: Int = lineIdx(k, j);\n\t\t\t\tdel[li] = clamp(dist(nx[k], ny[k], nz[k], nx[j], ny[j], nz[j]) * k343, 2.0, 16000.0);\n\t\t\t}\n\t\t}\n\t\t// two receivers spaced along x around the listening point\n\t\tlet half = 0.5 * wid * minimum(2.5, 0.4 * lx);\n\t\tfor (let m: Int = 0; m < 2; m++) {\n\t\t\tlet mx = rx - half;\n\t\t\tif (m == 1) {\n\t\t\t\tmx = rx + half;\n\t\t\t}\n\t\t\tlet dR = dist(mx, ry, rz, nx[k], ny[k], nz[k]);\n\t\t\tdel[36 + m * 6 + k] = clamp(dR * k343, 2.0, 16000.0);\n\t\t\tgR[m * 6 + k] = 1.0 / (1.0 + dR / dS);\n\t\t}\n\t}\n}\n\n// fractional read of line i, d samples back\nfunction rd(i: Int, d: number) {\n\tlet p = wIdx - d + 16384.0;\n\tlet pi0: Int = floor(p);\n\treturn linearinterp(p - pi0, lines[i][pi0 & 16383], lines[i][(pi0 + 1) & 16383]);\n}\n\nlet sr = maximum(samplerate(), 1.0);\n\n// --- Geometry: smoothed controls, recomputed every 32 samples -------------\nlet smC = 1.0 - exp(0.0 - 32.0 / (0.15 * sr));\nif (roomS < 0.0) {\n\troomS = clamp(room_m, 2.0, 30.0);\n\tposS = clamp(source_pos, 0.1, 0.9);\n\twidS = clamp(width, 0.0, 1.0);\n\tgeom(roomS, posS, widS, sr);\n}\nctr = ctr + 1;\nif (ctr >= 32) {\n\tctr = 0;\n\troomS = roomS + smC * (clamp(room_m, 2.0, 30.0) - roomS);\n\tposS = posS + smC * (clamp(source_pos, 0.1, 0.9) - posS);\n\twidS = widS + smC * (clamp(width, 0.0, 1.0) - widS);\n\tgeom(roomS, posS, widS, sr);\n}\n\n// --- Predelay + low cut on the mono source ---------------------------------\npre[preIdx] = 0.5 * (in1 + in2);\nlet preS: Int = clamp(floor(mstosamps(predelay_ms) + 0.5), 0, 32000);\nlet xp = pre[(preIdx - preS + 32768) & 32767];\npreIdx = (preIdx + 1) & 32767;\n\nlet cutR = exp(0.0 - 2.0 * pi * clamp(lowcut_hz, 10.0, sr * 0.45) / sr);\nlet ha = xp - hx1 + cutR * hy1;\nhx1 = xp;\nhy1 = ha;\nlet x = ha - hx2 + cutR * hy2;\nhx2 = ha;\nhy2 = x;\n\n// --- Read every line before writing any -----------------------------------\nlet wallC = 1.0 - exp(0.0 - 2.0 * pi * clamp(wall_hz, 100.0, sr * 0.45) / sr);\nfor (let i: Int = 0; i < 30; i++) {\n\tlet v = rd(i, del[i]);\n\t// wall filter H(z): it is the same at every node, so it commutes with A\n\tlet l = wallLp[i] + wallC * (v - wallLp[i]);\n\twallLp[i] = l;\n\tinc[i] = l;\n}\nfor (let k: Int = 0; k < 6; k++) {\n\tsrcIn[k] = rd(30 + k, del[30 + k]);\n}\nlet outL = 0.0;\nlet outR = 0.0;\nfor (let k: Int = 0; k < 12; k++) {\n\tlet v = rd(36 + k, del[36 + k]);\n\tif (k < 6) {\n\t\toutL += v;\n\t} else {\n\t\toutR += v;\n\t}\n}\n\n// --- Scattering at each wall node: p- = beta * A * p+ ---------------------\nlet beta = sqrt(1.0 - clamp(absorb, 0.05, 0.9));\nfor (let k: Int = 0; k < 6; k++) {\n\t// incoming waves from the five other nodes, plus half the source pressure\n\tlet half = 0.5 * srcIn[k];\n\tlet sum = 0.0;\n\tfor (let j: Int = 0; j < 6; j++) {\n\t\tif (j != k) {\n\t\t\tlet li: Int = lineIdx(j, k);\n\t\t\tsum += inc[li] + half;\n\t\t}\n\t}\n\tlet pe = 0.0;\n\tfor (let j: Int = 0; j < 6; j++) {\n\t\tif (j != k) {\n\t\t\tlet li: Int = lineIdx(j, k);\n\t\t\tlet pm = beta * (0.4 * sum - (inc[li] + half));\n\t\t\tpe += pm;\n\t\t\tlet lo: Int = lineIdx(k, j);\n\t\t\tlines[lo][wIdx] = pm;\n\t\t}\n\t}\n\t// to the receivers: weights 2/K\n\tlines[36 + k][wIdx] = 0.4 * pe * gR[k];\n\tlines[42 + k][wIdx] = 0.4 * pe * gR[6 + k];\n\t// from the source\n\tlines[30 + k][wIdx] = x * gS[k];\n}\nwIdx = (wIdx + 1) & 16383;\n\nlet outG = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = 1.5 * outL * outG;\nout2 = 1.5 * outR * outG;\n",
                                                    "fontface": 0,
                                                    "fontname": "<Monospaced>",
                                                    "fontsize": 12.0,
                                                    "id": "obj-2",
                                                    "maxclass": "codebox~",
                                                    "numinlets": 2,
                                                    "numoutlets": 2,
                                                    "outlettype": [ "signal", "signal" ],
                                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                                    "rnbo_classname": "codebox~",
                                                    "rnbo_extra_attributes": {
                                                        "nocache": 0,
                                                        "expr": "",
                                                        "safemath": 1,
                                                        "code": "// ============================================================================\n// rev_sdn_room.txt\n// A small shoebox room as a scattering delay network (six wall nodes): punch and size without a wash.\n// From: Fontana, Presti, Fantini, Avanzini & Rey, \"A Highly Parametrized\n//       Scattering Delay Network Implementation for Interactive Room\n//       Auralization\", DAFx-24 Paper 34, §2.2-2.3 (one scattering node per\n//       wall at the first-order reflection point; nodes joined by\n//       bidirectional delay lines D = fs*|xk - xj|/c, Eq. 2; S = beta*A with\n//       beta = sqrt(1 - alpha) and the lossless A = (2/K)*1*1^T - I, Eq. 6;\n//       source-to-node lines with 1/r spreading; node-to-receiver lines with\n//       weights 2/K and gain 1/(1 + |xk - xR| / |xS - xk|), Eq. 3) and §3.2\n//       (frequency-dependent wall absorption as a filter H(z) in S = H(z)A).\n//       Mezza, Giampiccolo, De Sena & Bernardini, \"Differentiable Scattering\n//       Delay Networks for Artificial Reverberation\", DAFx-25 Paper 51, §2.2\n//       (the scattering junction, source pressure split 1/2 into each\n//       incoming wave).\n// First-order reflections land at their exact geometric times; higher orders\n// are approximated by the node network. The line-of-sight path is left out\n// (the dry sound lives outside this effect).\n// 100% wet. No dry path, no limiter, no metering.\n// Inlets:\n//   in1 / in2: stereo audio (summed: one source)\n// Outlets:\n//   out1 / out2: two spaced omni receivers, wet only\n// ============================================================================\n\n// predelay\n@param({ min: 0, max: 100 }) predelay_ms = 0;\n// room length (width 0.8x, height 0.45x)\n@param({ min: 2, max: 30, exponent: 2 }) room_m = 6;\n// wall absorption coefficient\n@param({ min: 0.05, max: 0.9 }) absorb = 0.3;\n// wall lowpass (frequency-dependent absorption)\n@param({ min: 500, max: 16000, exponent: 2 }) wall_hz = 5000;\n// source distance from the receivers (fraction of the room)\n@param({ min: 0.1, max: 0.9 }) source_pos = 0.5;\n// receiver spacing\n@param({ min: 0, max: 1 }) width = 0.8;\n// low cut\n@param({ min: 20, max: 600, exponent: 2 }) lowcut_hz = 120;\n// output gain\n@param({ min: -24, max: 12 }) out_gain_db = 0;\n\n@state pre = new FixedSampleArray(32768);\n@state preIdx: Int = 0;\n\n// 0-29 node->node (k*5 + slot), 30-35 source->node, 36-47 node->receiver\n@state lines = new FixedSampleArray(48, 16384);\n@state del = new FixedSampleArray(48);\n@state wIdx: Int = 0;\n\n@state gS = new FixedSampleArray(6);\n@state gR = new FixedSampleArray(12);\n@state nx = new FixedSampleArray(6);\n@state ny = new FixedSampleArray(6);\n@state nz = new FixedSampleArray(6);\n\n@state inc = new FixedSampleArray(30);\n@state wallLp = new FixedSampleArray(30);\n@state srcIn = new FixedSampleArray(6);\n\n@state roomS = -1.0;\n@state posS = -1.0;\n@state widS = -1.0;\n@state ctr: Int = 0;\n\n@state hx1 = 0.0;\n@state hy1 = 0.0;\n@state hx2 = 0.0;\n@state hy2 = 0.0;\n\nfunction dist(ax: number, ay: number, az: number, bx: number, by: number, bz: number) {\n\tlet dx = ax - bx;\n\tlet dy = ay - by;\n\tlet dz = az - bz;\n\treturn sqrt(dx * dx + dy * dy + dz * dz);\n}\n\n// node->node line index from k to j (j != k)\nfunction lineIdx(k: Int, j: Int) {\n\tlet slot: Int = j;\n\tif (j > k) {\n\t\tslot = j - 1;\n\t}\n\treturn k * 5 + slot;\n}\n\n// geometry -> delay lengths and gains (§2.3.1-2.3.3)\nfunction geom(lx: number, pos: number, wid: number, sr: number) {\n\tlet ly = 0.8 * lx;\n\tlet lz = 0.45 * lx;\n\tlet rx = 0.5 * lx;\n\tlet ry = 0.3 * ly;\n\tlet rz = 0.4 * lz;\n\tlet sx = 0.6 * lx;\n\tlet sy = ry + pos * 0.65 * ly;\n\tlet sz = 0.45 * lz;\n\tlet k343 = sr / 343.0;\n\n\t// node k: first-order reflection point on wall k (x0, xL, y0, yL, z0, zL)\n\tfor (let k: Int = 0; k < 6; k++) {\n\t\tlet ax: Int = k >> 1;\n\t\tlet w = 0.0;\n\t\tif ((k & 1) == 1) {\n\t\t\tif (ax == 0) {\n\t\t\t\tw = lx;\n\t\t\t} else if (ax == 1) {\n\t\t\t\tw = ly;\n\t\t\t} else {\n\t\t\t\tw = lz;\n\t\t\t}\n\t\t}\n\t\tlet ix = sx;\n\t\tlet iy = sy;\n\t\tlet iz = sz;\n\t\tlet t = 0.0;\n\t\tif (ax == 0) {\n\t\t\tix = 2.0 * w - sx;\n\t\t\tt = (w - rx) / (ix - rx);\n\t\t} else if (ax == 1) {\n\t\t\tiy = 2.0 * w - sy;\n\t\t\tt = (w - ry) / (iy - ry);\n\t\t} else {\n\t\t\tiz = 2.0 * w - sz;\n\t\t\tt = (w - rz) / (iz - rz);\n\t\t}\n\t\tnx[k] = rx + t * (ix - rx);\n\t\tny[k] = ry + t * (iy - ry);\n\t\tnz[k] = rz + t * (iz - rz);\n\t}\n\n\tfor (let k: Int = 0; k < 6; k++) {\n\t\tlet dS = maximum(dist(sx, sy, sz, nx[k], ny[k], nz[k]), 0.1);\n\t\tdel[30 + k] = clamp(dS * k343, 2.0, 16000.0);\n\t\tgS[k] = 1.0 / dS;\n\t\tfor (let j: Int = 0; j < 6; j++) {\n\t\t\tif (j != k) {\n\t\t\t\tlet li: Int = lineIdx(k, j);\n\t\t\t\tdel[li] = clamp(dist(nx[k], ny[k], nz[k], nx[j], ny[j], nz[j]) * k343, 2.0, 16000.0);\n\t\t\t}\n\t\t}\n\t\t// two receivers spaced along x around the listening point\n\t\tlet half = 0.5 * wid * minimum(2.5, 0.4 * lx);\n\t\tfor (let m: Int = 0; m < 2; m++) {\n\t\t\tlet mx = rx - half;\n\t\t\tif (m == 1) {\n\t\t\t\tmx = rx + half;\n\t\t\t}\n\t\t\tlet dR = dist(mx, ry, rz, nx[k], ny[k], nz[k]);\n\t\t\tdel[36 + m * 6 + k] = clamp(dR * k343, 2.0, 16000.0);\n\t\t\tgR[m * 6 + k] = 1.0 / (1.0 + dR / dS);\n\t\t}\n\t}\n}\n\n// fractional read of line i, d samples back\nfunction rd(i: Int, d: number) {\n\tlet p = wIdx - d + 16384.0;\n\tlet pi0: Int = floor(p);\n\treturn linearinterp(p - pi0, lines[i][pi0 & 16383], lines[i][(pi0 + 1) & 16383]);\n}\n\nlet sr = maximum(samplerate(), 1.0);\n\n// --- Geometry: smoothed controls, recomputed every 32 samples -------------\nlet smC = 1.0 - exp(0.0 - 32.0 / (0.15 * sr));\nif (roomS < 0.0) {\n\troomS = clamp(room_m, 2.0, 30.0);\n\tposS = clamp(source_pos, 0.1, 0.9);\n\twidS = clamp(width, 0.0, 1.0);\n\tgeom(roomS, posS, widS, sr);\n}\nctr = ctr + 1;\nif (ctr >= 32) {\n\tctr = 0;\n\troomS = roomS + smC * (clamp(room_m, 2.0, 30.0) - roomS);\n\tposS = posS + smC * (clamp(source_pos, 0.1, 0.9) - posS);\n\twidS = widS + smC * (clamp(width, 0.0, 1.0) - widS);\n\tgeom(roomS, posS, widS, sr);\n}\n\n// --- Predelay + low cut on the mono source ---------------------------------\npre[preIdx] = 0.5 * (in1 + in2);\nlet preS: Int = clamp(floor(mstosamps(predelay_ms) + 0.5), 0, 32000);\nlet xp = pre[(preIdx - preS + 32768) & 32767];\npreIdx = (preIdx + 1) & 32767;\n\nlet cutR = exp(0.0 - 2.0 * pi * clamp(lowcut_hz, 10.0, sr * 0.45) / sr);\nlet ha = xp - hx1 + cutR * hy1;\nhx1 = xp;\nhy1 = ha;\nlet x = ha - hx2 + cutR * hy2;\nhx2 = ha;\nhy2 = x;\n\n// --- Read every line before writing any -----------------------------------\nlet wallC = 1.0 - exp(0.0 - 2.0 * pi * clamp(wall_hz, 100.0, sr * 0.45) / sr);\nfor (let i: Int = 0; i < 30; i++) {\n\tlet v = rd(i, del[i]);\n\t// wall filter H(z): it is the same at every node, so it commutes with A\n\tlet l = wallLp[i] + wallC * (v - wallLp[i]);\n\twallLp[i] = l;\n\tinc[i] = l;\n}\nfor (let k: Int = 0; k < 6; k++) {\n\tsrcIn[k] = rd(30 + k, del[30 + k]);\n}\nlet outL = 0.0;\nlet outR = 0.0;\nfor (let k: Int = 0; k < 12; k++) {\n\tlet v = rd(36 + k, del[36 + k]);\n\tif (k < 6) {\n\t\toutL += v;\n\t} else {\n\t\toutR += v;\n\t}\n}\n\n// --- Scattering at each wall node: p- = beta * A * p+ ---------------------\nlet beta = sqrt(1.0 - clamp(absorb, 0.05, 0.9));\nfor (let k: Int = 0; k < 6; k++) {\n\t// incoming waves from the five other nodes, plus half the source pressure\n\tlet half = 0.5 * srcIn[k];\n\tlet sum = 0.0;\n\tfor (let j: Int = 0; j < 6; j++) {\n\t\tif (j != k) {\n\t\t\tlet li: Int = lineIdx(j, k);\n\t\t\tsum += inc[li] + half;\n\t\t}\n\t}\n\tlet pe = 0.0;\n\tfor (let j: Int = 0; j < 6; j++) {\n\t\tif (j != k) {\n\t\t\tlet li: Int = lineIdx(j, k);\n\t\t\tlet pm = beta * (0.4 * sum - (inc[li] + half));\n\t\t\tpe += pm;\n\t\t\tlet lo: Int = lineIdx(k, j);\n\t\t\tlines[lo][wIdx] = pm;\n\t\t}\n\t}\n\t// to the receivers: weights 2/K\n\tlines[36 + k][wIdx] = 0.4 * pe * gR[k];\n\tlines[42 + k][wIdx] = 0.4 * pe * gR[6 + k];\n\t// from the source\n\tlines[30 + k][wIdx] = x * gS[k];\n}\nwIdx = (wIdx + 1) & 16383;\n\nlet outG = dbtoa(clamp(out_gain_db, -24.0, 12.0));\nout1 = 1.5 * outL * outG;\nout2 = 1.5 * outR * outG;\n"
                                                    },
                                                    "rnbo_serial": 1,
                                                    "rnbo_uniqueid": "effect_code",
