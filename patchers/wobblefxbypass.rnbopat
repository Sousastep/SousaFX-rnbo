                    "rnbo_extra_attributes": {
                        "exposeparams": 0,
                        "gencode": "ExponentialEaseIn(value) {\n\treturn value == 0 ? value : pow(1.93, 10 * ((value - 1)));\n}\n\nexpr_1 = ExponentialEaseIn(in1);\nmul_2 = expr_1 * 9694;\nadd_3 = mul_2 + 6;\nclamp_4 = clamp(add_3, 6, 9700);\nout1 = clamp_4;",
                        "geninlets": 1,
                        "genoutlets": 1
