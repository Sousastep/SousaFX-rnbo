                            },
                            {
                                "box": {
                                    "id": "obj-9",
                                    "maxclass": "newobj",
                                    "numinlets": 2,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patcher": {
                                        "fileversion": 1,
                                        "appversion": {
                                            "major": 9,
                                            "minor": 2,
                                            "revision": 0,
                                            "architecture": "x64",
                                            "modernui": 1
                                        },
                                        "classnamespace": "rnbo",
                                        "rect": [ 100.0, 100.0, 1944.0, 780.0 ],
                                        "default_fontname": "Lato",
                                        "title": "ai.transformer_flux_sat",
                                        "boxes": [
                                            {
                                                "box": {
                                                    "code": "// ============================================================================\n// transformer_flux_sat.txt — output-transformer core saturation with\n//                            hysteresis: the core flux is the integral of the\n//                            voltage, so low notes saturate long before high\n//                            ones (frequency-dependent breakup with no\n//                            crossover filter anywhere)\n//\n// From: J. Macak, J. Schimmel, \"Simulation of a Vacuum-Tube Push-Pull Guitar\n//       Power Amplifier\", DAFx-11 (2011_05_e): §2.2 (output transformer\n//       model: magnetizing inductance whose current rises steeply as the\n//       core saturates), §3.2 (circuit with the nonlinear transformer: the\n//       saturating magnetizing current loads the source, so the output\n//       collapses on the low-frequency peaks);\n//       J. Chowdhury, \"Real-time Physical Modelling for Analog Tape\n//       Machines\", DAFx-19 paper 3: §2.2 (magnetisation M follows the field\n//       H through a hysteresis loop, Jiles–Atherton), §3 (discretizing the\n//       stiff magnetic ODE: an implicit step keeps it stable).\n//\n// Model, per channel (flux phi; phis = 0.0004 core_size;\n//                     a = 2 pi primary_hz / (1 + 3 hyst)):\n//   dphi/dt = v - a * i(phi),     out = dphi/dt,     v = x * G\n//   i(phi)  = phis * atanh(phi / phis)          (anhysteretic: linear when\n//                                                small, unbounded at phis)\n//           + hc * (phi - p) / w                 (hysteresis: play operator\n//             p = clamp(p, phi - w, phi + w)      of width w = 0.1 phis,\n//                                                 hc = 0.3 phis * hyst)\n// Linear region: a one-pole high-pass at primary_hz (a is divided by the\n// play operator's in-band stiffness 1 + 3 hyst, so hysteresis does not move\n// the corner). Flux amplitude = V / (2 pi f): halving the frequency doubles\n// how hard the core is hit. A fixed 8 kHz lowpass (leakage inductance and\n// winding capacitance) rounds the steps as the core leaves saturation.\n// Discretized with implicit Euler (4 Newton iterations, flux = phis tanh u;\n// the hysteresis current is taken from the previous sample).\n// wet = out / G (unity below saturation).\n//\n// Inlets:\n//   in1 / in2: stereo tuba\n// Outlets:\n//   out1 / out2: stereo\n// No safety limiter, no metering.\n// ============================================================================\n\n// Drive into the transformer (dB)\n@param({ min: 0, max: 36 }) drive_db = 12;\n// Core size (saturation flux, relative)\n@param({ min: 0.1, max: 2, exponent: 2 }) core_size = 1;\n// Hysteresis\n@param({ min: 0, max: 100 }) hysteresis_pct = 40;\n// Primary inductance corner (Hz)\n@param({ min: 5, max: 200, exponent: 2 }) primary_hz = 30;\n// Dry/wet\n@param({ min: 0, max: 1 }) mix = 1;\n// Output gain (dB)\n@param({ min: -36, max: 12 }) output_db = 0;\n\n// core state u: flux = phis * tanh(u), so the flux can never pass phis\n@state ucore = new FixedSampleArray(2);\n@state play = new FixedSampleArray(2);\n// TPT one-pole states: 0/1 leakage lowpass\n@state zs = new FixedSampleArray(2);\n\n// TPT one-pole lowpass on state slot idx; gg = g / (1 + g)\nfunction lp1(idx: Int, x: number, gg: number): number {\n\tlet v = (x - zs[idx]) * gg;\n\tlet y = v + zs[idx];\n\tzs[idx] = y + v;\n\treturn y;\n}\n\n// One implicit Euler step of the core on channel ch; returns dphi/dt.\n// Solves phis (tanh u' + c u') = flux + dt (v - a ih) by Newton in u\n// (the left side is strictly increasing, slope >= phis c).\nfunction core(ch: Int, v: number, a: number, phis: number, hc: number, w: number, dt: number): number {\n\tlet u0 = ucore[ch];\n\tlet ph = phis * tanh(u0);\n\tlet p = clamp(play[ch], ph - w, ph + w);\n\tlet ih = hc * (ph - p) / w;\n\tlet c = dt * a;\n\tlet rhs = ph + dt * (v - a * ih);\n\tlet u = u0;\n\tfor (let it: Int = 0; it < 4; it++) {\n\t\tlet t = tanh(u);\n\t\tlet gu = phis * (t + c * u) - rhs;\n\t\tlet du = gu / (phis * (1.0 - t * t + c));\n\t\tu = u - clamp(du, -2.0, 2.0);\n\t}\n\tucore[ch] = u;\n\tlet phNew = phis * tanh(u);\n\tplay[ch] = clamp(p, phNew - w, phNew + w);\n\treturn (phNew - ph) / dt;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet dt = 1.0 / sr;\nlet xL = in1;\nlet xR = in2;\n\nlet G = dbtoa(clamp(drive_db, 0.0, 36.0));\nlet hy = clamp(hysteresis_pct, 0.0, 100.0) * 0.01;\nlet a = 2.0 * pi * clamp(primary_hz, 5.0, 200.0) / (1.0 + 3.0 * hy);\nlet phis = 0.0004 * clamp(core_size, 0.1, 2.0);\nlet hc = 0.3 * phis * hy;\nlet gLk = tan(pi * minimum(8000.0, sr * 0.45) / sr);\nlet ggLk = gLk / (1.0 + gLk);\nlet w = 0.1 * phis;\n\nlet wetL = lp1(0, core(0, G * xL, a, phis, hc, w, dt), ggLk) / G;\nlet wetR = lp1(1, core(1, G * xR, a, phis, hc, w, dt), ggLk) / G;\n\nlet mx = clamp(mix, 0.0, 1.0);\nlet outGain = dbtoa(clamp(output_db, -36.0, 12.0));\nout1 = linearinterp(mx, xL, wetL) * outGain;\nout2 = linearinterp(mx, xR, wetR) * outGain;\n",
                                                    "fontface": 0,
                                                    "fontname": "<Monospaced>",
                                                    "fontsize": 12.0,
                                                    "id": "obj-2",
                                                    "maxclass": "codebox~",
                                                    "numinlets": 2,
                                                    "numoutlets": 2,
                                                    "outlettype": [ "signal", "signal" ],
                                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                                    "rnbo_classname": "codebox~",
                                                    "rnbo_extra_attributes": {
                                                        "nocache": 0,
                                                        "expr": "",
                                                        "safemath": 1,
                                                        "code": "// ============================================================================\n// transformer_flux_sat.txt — output-transformer core saturation with\n//                            hysteresis: the core flux is the integral of the\n//                            voltage, so low notes saturate long before high\n//                            ones (frequency-dependent breakup with no\n//                            crossover filter anywhere)\n//\n// From: J. Macak, J. Schimmel, \"Simulation of a Vacuum-Tube Push-Pull Guitar\n//       Power Amplifier\", DAFx-11 (2011_05_e): §2.2 (output transformer\n//       model: magnetizing inductance whose current rises steeply as the\n//       core saturates), §3.2 (circuit with the nonlinear transformer: the\n//       saturating magnetizing current loads the source, so the output\n//       collapses on the low-frequency peaks);\n//       J. Chowdhury, \"Real-time Physical Modelling for Analog Tape\n//       Machines\", DAFx-19 paper 3: §2.2 (magnetisation M follows the field\n//       H through a hysteresis loop, Jiles–Atherton), §3 (discretizing the\n//       stiff magnetic ODE: an implicit step keeps it stable).\n//\n// Model, per channel (flux phi; phis = 0.0004 core_size;\n//                     a = 2 pi primary_hz / (1 + 3 hyst)):\n//   dphi/dt = v - a * i(phi),     out = dphi/dt,     v = x * G\n//   i(phi)  = phis * atanh(phi / phis)          (anhysteretic: linear when\n//                                                small, unbounded at phis)\n//           + hc * (phi - p) / w                 (hysteresis: play operator\n//             p = clamp(p, phi - w, phi + w)      of width w = 0.1 phis,\n//                                                 hc = 0.3 phis * hyst)\n// Linear region: a one-pole high-pass at primary_hz (a is divided by the\n// play operator's in-band stiffness 1 + 3 hyst, so hysteresis does not move\n// the corner). Flux amplitude = V / (2 pi f): halving the frequency doubles\n// how hard the core is hit. A fixed 8 kHz lowpass (leakage inductance and\n// winding capacitance) rounds the steps as the core leaves saturation.\n// Discretized with implicit Euler (4 Newton iterations, flux = phis tanh u;\n// the hysteresis current is taken from the previous sample).\n// wet = out / G (unity below saturation).\n//\n// Inlets:\n//   in1 / in2: stereo tuba\n// Outlets:\n//   out1 / out2: stereo\n// No safety limiter, no metering.\n// ============================================================================\n\n// Drive into the transformer (dB)\n@param({ min: 0, max: 36 }) drive_db = 12;\n// Core size (saturation flux, relative)\n@param({ min: 0.1, max: 2, exponent: 2 }) core_size = 1;\n// Hysteresis\n@param({ min: 0, max: 100 }) hysteresis_pct = 40;\n// Primary inductance corner (Hz)\n@param({ min: 5, max: 200, exponent: 2 }) primary_hz = 30;\n// Dry/wet\n@param({ min: 0, max: 1 }) mix = 1;\n// Output gain (dB)\n@param({ min: -36, max: 12 }) output_db = 0;\n\n// core state u: flux = phis * tanh(u), so the flux can never pass phis\n@state ucore = new FixedSampleArray(2);\n@state play = new FixedSampleArray(2);\n// TPT one-pole states: 0/1 leakage lowpass\n@state zs = new FixedSampleArray(2);\n\n// TPT one-pole lowpass on state slot idx; gg = g / (1 + g)\nfunction lp1(idx: Int, x: number, gg: number): number {\n\tlet v = (x - zs[idx]) * gg;\n\tlet y = v + zs[idx];\n\tzs[idx] = y + v;\n\treturn y;\n}\n\n// One implicit Euler step of the core on channel ch; returns dphi/dt.\n// Solves phis (tanh u' + c u') = flux + dt (v - a ih) by Newton in u\n// (the left side is strictly increasing, slope >= phis c).\nfunction core(ch: Int, v: number, a: number, phis: number, hc: number, w: number, dt: number): number {\n\tlet u0 = ucore[ch];\n\tlet ph = phis * tanh(u0);\n\tlet p = clamp(play[ch], ph - w, ph + w);\n\tlet ih = hc * (ph - p) / w;\n\tlet c = dt * a;\n\tlet rhs = ph + dt * (v - a * ih);\n\tlet u = u0;\n\tfor (let it: Int = 0; it < 4; it++) {\n\t\tlet t = tanh(u);\n\t\tlet gu = phis * (t + c * u) - rhs;\n\t\tlet du = gu / (phis * (1.0 - t * t + c));\n\t\tu = u - clamp(du, -2.0, 2.0);\n\t}\n\tucore[ch] = u;\n\tlet phNew = phis * tanh(u);\n\tplay[ch] = clamp(p, phNew - w, phNew + w);\n\treturn (phNew - ph) / dt;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet dt = 1.0 / sr;\nlet xL = in1;\nlet xR = in2;\n\nlet G = dbtoa(clamp(drive_db, 0.0, 36.0));\nlet hy = clamp(hysteresis_pct, 0.0, 100.0) * 0.01;\nlet a = 2.0 * pi * clamp(primary_hz, 5.0, 200.0) / (1.0 + 3.0 * hy);\nlet phis = 0.0004 * clamp(core_size, 0.1, 2.0);\nlet hc = 0.3 * phis * hy;\nlet gLk = tan(pi * minimum(8000.0, sr * 0.45) / sr);\nlet ggLk = gLk / (1.0 + gLk);\nlet w = 0.1 * phis;\n\nlet wetL = lp1(0, core(0, G * xL, a, phis, hc, w, dt), ggLk) / G;\nlet wetR = lp1(1, core(1, G * xR, a, phis, hc, w, dt), ggLk) / G;\n\nlet mx = clamp(mix, 0.0, 1.0);\nlet outGain = dbtoa(clamp(output_db, -36.0, 12.0));\nout1 = linearinterp(mx, xL, wetL) * outGain;\nout2 = linearinterp(mx, xR, wetR) * outGain;\n"
                                                    },
