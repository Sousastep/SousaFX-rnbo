                            },
                            {
                                "box": {
                                    "id": "obj-14",
                                    "maxclass": "newobj",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patcher": {
                                        "fileversion": 1,
                                        "appversion": {
                                            "major": 9,
                                            "minor": 2,
                                            "revision": 0,
                                            "architecture": "x64",
                                            "modernui": 1
                                        },
                                        "classnamespace": "rnbo",
                                        "rect": [ 100.0, 100.0, 1970.0, 780.0 ],
                                        "default_fontname": "Lato",
                                        "title": "ai.chorus_univibe_optical_throb",
                                        "boxes": [
                                            {
                                                "box": {
                                                    "code": "// ============================================================================\n// chorus_univibe_optical_throb.txt\n// Standalone Stereo Chorus Effect: Shin-ei Uni-Vibe 4-Stage Optical Chorus/Vibrato\n// Implements Champ Darabundit, Russell Wedelich & Pete Bischoff (DAFx-19, Paper 31):\n// \"Digital Grey Box Model of the Uni-Vibe Effects Pedal\" (Sections 2, 3.1, 3.2 & 4.2,\n// Eq. 1-21, Table 1, Fig. 2-8).\n// Captures the three crucial physical mechanisms discovered in the paper that make\n// the Uni-Vibe Chorus sound like a throbbing, double-beating rotary chorus rather\n// than a standard symmetric phaser:\n//   1. Staggered Phasing Capacitors Cp (Table 1):\n//      Stage 1: 0.015 uF, Stage 2: 0.22 uF, Stage 3: 470 pF, Stage 4: 0.0047 uF\n//      producing spread, non-paired notches where only two main notches dominate (\"double beat\").\n//   2. Collector/Emitter Gain Imbalance (alpha_n != beta_n, Table 1) + Blocking Capacitor\n//      C_DC (Eq. 4-21, Fig. 6): Each stage is NOT a unity-gain allpass filter, but a\n//      sum H_n(z) = H_cn(z) + H_en(z) with a sweeping high-shelf magnitude response that\n//      creates the iconic low-end \"throbbing pulse\" in Chorus mode!\n//   3. Asymmetric Emitter-Follower Bias Clipping (Sec 3.2.1, Fig. 7) + Incandescent Lamp\n//      Fast-Turn-On / Slow-CdS-Decay LDR Trajectory (Sec 4.2, Fig. 8).\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: Optional Envelope Modulator [0..1] (boosts incandescent bulb intensity on attacks).\n//        Exception to the in3-pitch contract: values above 20 (a pitch in Hz) are ignored.\n//   in4: Optional 1-Bar Phasor [0..1] (exception to the in4-in-Hz contract): while it\n//        moves, the lamp makes 2 cycles per bar\n// Outlets:\n//   out1: Left Uni-Vibe Optical Chorus/Vibrato Output\n//   out2: Right Uni-Vibe Optical Chorus/Vibrato Output\n\n@param({ min: 0.2, max: 7.6 }) pedal_speed_hz = 1.35;           // pedal speed\n@param({ min: 0.0, max: 1.0 }) lamp_intensity = 0.78;           // intensity\n@param({ min: 0.0, max: 1.0 }) shelf_throb_cdc = 0.75;          // ideal -> measured stages\n@param({ min: 0.0, max: 1.0 }) emitter_bias_grit = 0.35;        // stage saturation\n@param({ min: 0.0, max: 1.0 }) stereo_chamber_spread = 0.45;    // L/R lamp offset\n@param({ min: 0.0, max: 1.0 }) chorus_to_vibrato = 0.0;         // chorus -> vibrato\n\n// 4-Stage Uni-Vibe Bilinear Filter States per channel (Eq. 19-21)\n@state stXL = new FixedSampleArray(4); @state stYL = new FixedSampleArray(4);\n@state stXR = new FixedSampleArray(4); @state stYR = new FixedSampleArray(4);\n\n// Per-stage DC-blocking filter states after asymmetric emitter-follower tanh (Fig. 7)\n@state dcXL = new FixedSampleArray(4); @state dcYL = new FixedSampleArray(4);\n@state dcXR = new FixedSampleArray(4); @state dcYR = new FixedSampleArray(4);\n\n@state lampPhasor = new phasor();\n@state prevBarIn = 0.0;\n@state barHold = 0.0;\n@state in2Hold = 0.0;\n\n// Asymmetric Incandescent Lamp + CdS LDR conductance trajectory (DAFx-19 Sec 4.2, Fig. 8)\n// Fast filament turn-on peak + exponential CdS darkness recovery tail, with intensity-dependent skew\nfunction evalLdrOmegaNorm(phase: number, intensity: number): number {\n\tlet p = wrap(phase, 0.0, 1.0);\n\t// Skew peak earlier as intensity increases (Fig. 8)\n\tlet skewP = pow(p, 1.0 - 0.38 * intensity);\n\tlet wave = 0.5 * (1.0 - cos(2.0 * pi * skewP));\n\t// Sharp exponential lamp-on peak (CdS resistance drops by >200x under bright filament)\n\treturn pow(wave, 1.8 + 1.4 * intensity) * intensity;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\n// in2 counts as patched for 250 ms after any non-zero sample (a per-sample test\n// would swap in xL for single samples at in2's zero crossings)\nif (abs(in2) > 0.0000001) {\n\tin2Hold = 0.25 * sr;\n} else if (in2Hold > 0.0) {\n\tin2Hold -= 1.0;\n}\nlet xR = (in2Hold > 0.0) ? in2 : xL;\nlet envMod = (in3 > 20.0) ? 0.0 : clamp(in3, 0.0, 1.0);\nlet barIn = in4;\n\n// --- 1. LFO & Non-Orthogonal Speed/Intensity Coupling (DAFx-19 Sec 2.1) ---\nlet inten = clamp(lamp_intensity + 0.25 * envMod, 0.0, 1.0);\n// Sec 2.1: Regenerative phase-shift oscillator drifts slightly faster at high intensity\nlet baseSpeed = clamp(pedal_speed_hz, 0.2, 7.6) * (1.0 + 0.08 * inten);\n\n// Bar phasor counts as active for 100 ms after it last moved (a constant in4 must not freeze the lamp)\nif (abs(barIn - prevBarIn) > 0.000001) {\n\tbarHold = 0.1 * sr;\n} else if (barHold > 0.0) {\n\tbarHold -= 1.0;\n}\nprevBarIn = barIn;\n\nlet freePh = lampPhasor.next(baseSpeed);\nlet phL = (barHold > 0.0) ? wrap(barIn * 2.0, 0.0, 1.0) : freePh;\nlet spread = clamp(stereo_chamber_spread, 0.0, 1.0) * 0.35;\nlet phR = wrap(phL + spread, 0.0, 1.0);\n\nlet ldrModL = evalLdrOmegaNorm(phL, inten);\nlet ldrModR = evalLdrOmegaNorm(phR, inten);\n\n// --- 2. 4-Stage Uni-Vibe Phasing Cascade with Staggered Cp & Blocking Cap C_DC (Sec 3.1-3.2) ---\n// Table 1 gives Cp, alpha_n and beta_n; the kappa values below imply C_DC ~ 0.24 uF.\n// The sweep ranges are this model's choice (narrower than the full measured LDR min/max):\n// Stage 1 (Cp = 0.015 uF):  f_min = 24 Hz   -> f_max = 1150 Hz\n// Stage 2 (Cp = 0.220 uF):  f_min = 4.5 Hz  -> f_max = 185 Hz  (Deep Sub/Bass Throb Stage!)\n// Stage 3 (Cp = 470 pF):    f_min = 680 Hz  -> f_max = 14500 Hz\n// Stage 4 (Cp = 0.0047 uF): f_min = 75 Hz   -> f_max = 4200 Hz\nlet throbAmt = clamp(shelf_throb_cdc, 0.0, 1.0);\nlet grit = clamp(emitter_bias_grit, 0.0, 1.0);\nlet driveG = 0.35 + 0.85 * grit;\nlet biasU = 0.12 * grit;\nlet tanhBias = tanh(biasU);\n\nlet sigL = xL;\nlet sigR = xR;\n\nfor (let n: Int = 0; n < 4; n++) {\n\t// Stage-specific min/max frequency & Table 1 alpha_n, beta_n, and C_p / C_DC ratios\n\tlet fMin = 24.0;  let fMax = 1150.0;\n\tlet alphaN = 1.01; let betaN = 1.11; let kcBase = 0.06;\n\tif (n == 1) {\n\t\tfMin = 4.5;   fMax = 185.0;\n\t\talphaN = 0.98; betaN = 1.09; kcBase = 0.48; // Large Cp = 0.22uF comparable to C_DC!\n\t} else if (n == 2) {\n\t\tfMin = 680.0; fMax = 14500.0;\n\t\talphaN = 0.97; betaN = 1.10; kcBase = 0.003;\n\t} else if (n == 3) {\n\t\tfMin = 75.0;  fMax = 4200.0;\n\t\talphaN = 0.95; betaN = 1.09; kcBase = 0.025;\n\t}\n\n\t// Eq. 6-7: kappa_cn = Cp / (Cp + C_DC), kappa_en = C_DC / (Cp + C_DC)\n\tlet kcn = kcBase * throbAmt;\n\tlet ken = 1.0 - kcn;\n\tlet effAlpha = linearinterp(throbAmt, 1.0, alphaN);\n\tlet effBeta  = linearinterp(throbAmt, 1.0, betaN);\n\n\t// --- Sec 3.2.1 Fig. 7: Asymmetric Emitter-Follower tanh + DC Blocking Filter ---\n\tlet nlL = (tanh(sigL * driveG + biasU) - tanhBias) / driveG;\n\tlet dcOutL = nlL - dcXL[n] + 0.996 * dcYL[n];\n\tdcXL[n] = nlL; dcYL[n] = dcOutL;\n\n\tlet nlR = (tanh(sigR * driveG - biasU) + tanhBias) / driveG;\n\tlet dcOutR = nlR - dcXR[n] + 0.996 * dcYR[n];\n\tdcXR[n] = nlR; dcYR[n] = dcOutR;\n\n\t// --- Sec 3.2 Eq. 19-21: Pre-warped Bilinear Transform of H_cn[z] + H_en[z] ---\n\tlet f0L = clamp(fMin * pow(fMax / fMin, ldrModL), 4.0, sr * 0.44);\n\tlet W0L = tan(pi * f0L / sr);\n\tlet normL = 1.0 / (W0L + 1.0);\n\tlet b0L = (effAlpha * ken * W0L - effBeta * (kcn * W0L + 1.0)) * normL;\n\tlet b1L = (effAlpha * ken * W0L - effBeta * (kcn * W0L - 1.0)) * normL;\n\tlet a1L = (W0L - 1.0) * normL;\n\n\tlet yL = b0L * dcOutL + b1L * stXL[n] - a1L * stYL[n];\n\tstXL[n] = dcOutL; stYL[n] = yL;\n\tsigL = yL;\n\n\tlet f0R = clamp(fMin * pow(fMax / fMin, ldrModR), 4.0, sr * 0.44);\n\tlet W0R = tan(pi * f0R / sr);\n\tlet normR = 1.0 / (W0R + 1.0);\n\tlet b0R = (effAlpha * ken * W0R - effBeta * (kcn * W0R + 1.0)) * normR;\n\tlet b1R = (effAlpha * ken * W0R - effBeta * (kcn * W0R - 1.0)) * normR;\n\tlet a1R = (W0R - 1.0) * normR;\n\n\tlet yR = b0R * dcOutR + b1R * stXR[n] - a1R * stYR[n];\n\tstXR[n] = dcOutR; stYR[n] = yR;\n\tsigR = yR;\n}\n\n// --- 3. Output Mixer Chorus / Vibrato Switch (DAFx-19 Sec 2, Fig. 2) ---\nlet vibMode = clamp(chorus_to_vibrato, 0.0, 1.0);\nlet chOutL = 0.55 * (xL + sigL);\nlet chOutR = 0.55 * (xR + sigR);\n\nout1 = linearinterp(vibMode, chOutL, sigL);\nout2 = linearinterp(vibMode, chOutR, sigR);\n",
                                                    "fontface": 0,
                                                    "fontname": "<Monospaced>",
                                                    "fontsize": 12.0,
                                                    "id": "obj-2",
                                                    "maxclass": "codebox~",
                                                    "numinlets": 4,
                                                    "numoutlets": 2,
                                                    "outlettype": [ "signal", "signal" ],
                                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                                    "rnbo_classname": "codebox~",
                                                    "rnbo_extra_attributes": {
                                                        "nocache": 0,
                                                        "expr": "",
                                                        "safemath": 1,
                                                        "code": "// ============================================================================\n// chorus_univibe_optical_throb.txt\n// Standalone Stereo Chorus Effect: Shin-ei Uni-Vibe 4-Stage Optical Chorus/Vibrato\n// Implements Champ Darabundit, Russell Wedelich & Pete Bischoff (DAFx-19, Paper 31):\n// \"Digital Grey Box Model of the Uni-Vibe Effects Pedal\" (Sections 2, 3.1, 3.2 & 4.2,\n// Eq. 1-21, Table 1, Fig. 2-8).\n// Captures the three crucial physical mechanisms discovered in the paper that make\n// the Uni-Vibe Chorus sound like a throbbing, double-beating rotary chorus rather\n// than a standard symmetric phaser:\n//   1. Staggered Phasing Capacitors Cp (Table 1):\n//      Stage 1: 0.015 uF, Stage 2: 0.22 uF, Stage 3: 470 pF, Stage 4: 0.0047 uF\n//      producing spread, non-paired notches where only two main notches dominate (\"double beat\").\n//   2. Collector/Emitter Gain Imbalance (alpha_n != beta_n, Table 1) + Blocking Capacitor\n//      C_DC (Eq. 4-21, Fig. 6): Each stage is NOT a unity-gain allpass filter, but a\n//      sum H_n(z) = H_cn(z) + H_en(z) with a sweeping high-shelf magnitude response that\n//      creates the iconic low-end \"throbbing pulse\" in Chorus mode!\n//   3. Asymmetric Emitter-Follower Bias Clipping (Sec 3.2.1, Fig. 7) + Incandescent Lamp\n//      Fast-Turn-On / Slow-CdS-Decay LDR Trajectory (Sec 4.2, Fig. 8).\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: Optional Envelope Modulator [0..1] (boosts incandescent bulb intensity on attacks).\n//        Exception to the in3-pitch contract: values above 20 (a pitch in Hz) are ignored.\n//   in4: Optional 1-Bar Phasor [0..1] (exception to the in4-in-Hz contract): while it\n//        moves, the lamp makes 2 cycles per bar\n// Outlets:\n//   out1: Left Uni-Vibe Optical Chorus/Vibrato Output\n//   out2: Right Uni-Vibe Optical Chorus/Vibrato Output\n\n@param({ min: 0.2, max: 7.6 }) pedal_speed_hz = 1.35;           // pedal speed\n@param({ min: 0.0, max: 1.0 }) lamp_intensity = 0.78;           // intensity\n@param({ min: 0.0, max: 1.0 }) shelf_throb_cdc = 0.75;          // ideal -> measured stages\n@param({ min: 0.0, max: 1.0 }) emitter_bias_grit = 0.35;        // stage saturation\n@param({ min: 0.0, max: 1.0 }) stereo_chamber_spread = 0.45;    // L/R lamp offset\n@param({ min: 0.0, max: 1.0 }) chorus_to_vibrato = 0.0;         // chorus -> vibrato\n\n// 4-Stage Uni-Vibe Bilinear Filter States per channel (Eq. 19-21)\n@state stXL = new FixedSampleArray(4); @state stYL = new FixedSampleArray(4);\n@state stXR = new FixedSampleArray(4); @state stYR = new FixedSampleArray(4);\n\n// Per-stage DC-blocking filter states after asymmetric emitter-follower tanh (Fig. 7)\n@state dcXL = new FixedSampleArray(4); @state dcYL = new FixedSampleArray(4);\n@state dcXR = new FixedSampleArray(4); @state dcYR = new FixedSampleArray(4);\n\n@state lampPhasor = new phasor();\n@state prevBarIn = 0.0;\n@state barHold = 0.0;\n@state in2Hold = 0.0;\n\n// Asymmetric Incandescent Lamp + CdS LDR conductance trajectory (DAFx-19 Sec 4.2, Fig. 8)\n// Fast filament turn-on peak + exponential CdS darkness recovery tail, with intensity-dependent skew\nfunction evalLdrOmegaNorm(phase: number, intensity: number): number {\n\tlet p = wrap(phase, 0.0, 1.0);\n\t// Skew peak earlier as intensity increases (Fig. 8)\n\tlet skewP = pow(p, 1.0 - 0.38 * intensity);\n\tlet wave = 0.5 * (1.0 - cos(2.0 * pi * skewP));\n\t// Sharp exponential lamp-on peak (CdS resistance drops by >200x under bright filament)\n\treturn pow(wave, 1.8 + 1.4 * intensity) * intensity;\n}\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\n// in2 counts as patched for 250 ms after any non-zero sample (a per-sample test\n// would swap in xL for single samples at in2's zero crossings)\nif (abs(in2) > 0.0000001) {\n\tin2Hold = 0.25 * sr;\n} else if (in2Hold > 0.0) {\n\tin2Hold -= 1.0;\n}\nlet xR = (in2Hold > 0.0) ? in2 : xL;\nlet envMod = (in3 > 20.0) ? 0.0 : clamp(in3, 0.0, 1.0);\nlet barIn = in4;\n\n// --- 1. LFO & Non-Orthogonal Speed/Intensity Coupling (DAFx-19 Sec 2.1) ---\nlet inten = clamp(lamp_intensity + 0.25 * envMod, 0.0, 1.0);\n// Sec 2.1: Regenerative phase-shift oscillator drifts slightly faster at high intensity\nlet baseSpeed = clamp(pedal_speed_hz, 0.2, 7.6) * (1.0 + 0.08 * inten);\n\n// Bar phasor counts as active for 100 ms after it last moved (a constant in4 must not freeze the lamp)\nif (abs(barIn - prevBarIn) > 0.000001) {\n\tbarHold = 0.1 * sr;\n} else if (barHold > 0.0) {\n\tbarHold -= 1.0;\n}\nprevBarIn = barIn;\n\nlet freePh = lampPhasor.next(baseSpeed);\nlet phL = (barHold > 0.0) ? wrap(barIn * 2.0, 0.0, 1.0) : freePh;\nlet spread = clamp(stereo_chamber_spread, 0.0, 1.0) * 0.35;\nlet phR = wrap(phL + spread, 0.0, 1.0);\n\nlet ldrModL = evalLdrOmegaNorm(phL, inten);\nlet ldrModR = evalLdrOmegaNorm(phR, inten);\n\n// --- 2. 4-Stage Uni-Vibe Phasing Cascade with Staggered Cp & Blocking Cap C_DC (Sec 3.1-3.2) ---\n// Table 1 gives Cp, alpha_n and beta_n; the kappa values below imply C_DC ~ 0.24 uF.\n// The sweep ranges are this model's choice (narrower than the full measured LDR min/max):\n// Stage 1 (Cp = 0.015 uF):  f_min = 24 Hz   -> f_max = 1150 Hz\n// Stage 2 (Cp = 0.220 uF):  f_min = 4.5 Hz  -> f_max = 185 Hz  (Deep Sub/Bass Throb Stage!)\n// Stage 3 (Cp = 470 pF):    f_min = 680 Hz  -> f_max = 14500 Hz\n// Stage 4 (Cp = 0.0047 uF): f_min = 75 Hz   -> f_max = 4200 Hz\nlet throbAmt = clamp(shelf_throb_cdc, 0.0, 1.0);\nlet grit = clamp(emitter_bias_grit, 0.0, 1.0);\nlet driveG = 0.35 + 0.85 * grit;\nlet biasU = 0.12 * grit;\nlet tanhBias = tanh(biasU);\n\nlet sigL = xL;\nlet sigR = xR;\n\nfor (let n: Int = 0; n < 4; n++) {\n\t// Stage-specific min/max frequency & Table 1 alpha_n, beta_n, and C_p / C_DC ratios\n\tlet fMin = 24.0;  let fMax = 1150.0;\n\tlet alphaN = 1.01; let betaN = 1.11; let kcBase = 0.06;\n\tif (n == 1) {\n\t\tfMin = 4.5;   fMax = 185.0;\n\t\talphaN = 0.98; betaN = 1.09; kcBase = 0.48; // Large Cp = 0.22uF comparable to C_DC!\n\t} else if (n == 2) {\n\t\tfMin = 680.0; fMax = 14500.0;\n\t\talphaN = 0.97; betaN = 1.10; kcBase = 0.003;\n\t} else if (n == 3) {\n\t\tfMin = 75.0;  fMax = 4200.0;\n\t\talphaN = 0.95; betaN = 1.09; kcBase = 0.025;\n\t}\n\n\t// Eq. 6-7: kappa_cn = Cp / (Cp + C_DC), kappa_en = C_DC / (Cp + C_DC)\n\tlet kcn = kcBase * throbAmt;\n\tlet ken = 1.0 - kcn;\n\tlet effAlpha = linearinterp(throbAmt, 1.0, alphaN);\n\tlet effBeta  = linearinterp(throbAmt, 1.0, betaN);\n\n\t// --- Sec 3.2.1 Fig. 7: Asymmetric Emitter-Follower tanh + DC Blocking Filter ---\n\tlet nlL = (tanh(sigL * driveG + biasU) - tanhBias) / driveG;\n\tlet dcOutL = nlL - dcXL[n] + 0.996 * dcYL[n];\n\tdcXL[n] = nlL; dcYL[n] = dcOutL;\n\n\tlet nlR = (tanh(sigR * driveG - biasU) + tanhBias) / driveG;\n\tlet dcOutR = nlR - dcXR[n] + 0.996 * dcYR[n];\n\tdcXR[n] = nlR; dcYR[n] = dcOutR;\n\n\t// --- Sec 3.2 Eq. 19-21: Pre-warped Bilinear Transform of H_cn[z] + H_en[z] ---\n\tlet f0L = clamp(fMin * pow(fMax / fMin, ldrModL), 4.0, sr * 0.44);\n\tlet W0L = tan(pi * f0L / sr);\n\tlet normL = 1.0 / (W0L + 1.0);\n\tlet b0L = (effAlpha * ken * W0L - effBeta * (kcn * W0L + 1.0)) * normL;\n\tlet b1L = (effAlpha * ken * W0L - effBeta * (kcn * W0L - 1.0)) * normL;\n\tlet a1L = (W0L - 1.0) * normL;\n\n\tlet yL = b0L * dcOutL + b1L * stXL[n] - a1L * stYL[n];\n\tstXL[n] = dcOutL; stYL[n] = yL;\n\tsigL = yL;\n\n\tlet f0R = clamp(fMin * pow(fMax / fMin, ldrModR), 4.0, sr * 0.44);\n\tlet W0R = tan(pi * f0R / sr);\n\tlet normR = 1.0 / (W0R + 1.0);\n\tlet b0R = (effAlpha * ken * W0R - effBeta * (kcn * W0R + 1.0)) * normR;\n\tlet b1R = (effAlpha * ken * W0R - effBeta * (kcn * W0R - 1.0)) * normR;\n\tlet a1R = (W0R - 1.0) * normR;\n\n\tlet yR = b0R * dcOutR + b1R * stXR[n] - a1R * stYR[n];\n\tstXR[n] = dcOutR; stYR[n] = yR;\n\tsigR = yR;\n}\n\n// --- 3. Output Mixer Chorus / Vibrato Switch (DAFx-19 Sec 2, Fig. 2) ---\nlet vibMode = clamp(chorus_to_vibrato, 0.0, 1.0);\nlet chOutL = 0.55 * (xL + sigL);\nlet chOutR = 0.55 * (xR + sigR);\n\nout1 = linearinterp(vibMode, chOutL, sigL);\nout2 = linearinterp(vibMode, chOutR, sigR);\n"
                                                    },
