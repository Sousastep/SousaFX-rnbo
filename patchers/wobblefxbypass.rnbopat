            {
                "box": {
                    "code": "function smootheststep(edge0, edge1, x) {\n  let t = clip((x - edge0) / (edge1 - edge0), 0.0, 1.0);\n  t = t * t * t * t * (t * (t * (-20.0 * t + 70.0) - 84.0) + 35.0);\n  return edge0 + t * (edge1 - edge0);\n}\n\nlet result = smootheststep(in2, in3, in1);\nout1 = result;",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-173",
                    "maxclass": "codebox~",
                    "numinlets": 3,
                    "numoutlets": 1,
                    "outlettype": [ "signal" ],
                    "patching_rect": [ 1496.0, 1440.0, 569.0, 165.0 ],
                    "rnbo_classname": "codebox~",
                    "rnbo_extra_attributes": {
                        "nocache": 0,
                        "code": "function smootheststep(edge0, edge1, x) {\n  let t = clip((x - edge0) / (edge1 - edge0), 0.0, 1.0);\n  t = t * t * t * t * (t * (t * (-20.0 * t + 70.0) - 84.0) + 35.0);\n  return edge0 + t * (edge1 - edge0);\n}\n\nlet result = smootheststep(in2, in3, in1);\nout1 = result;",
                        "expr": "",
                        "safemath": 1
                    },
                    "rnbo_serial": 1,
                    "rnbo_uniqueid": "codebox~_obj-173",
                    "rnboinfo": {
                        "needsInstanceInfo": 1,
                        "argnames": {
