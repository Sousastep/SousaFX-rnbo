eek(pass2_buf, (i * 2) + 1);\n\t\tv = downsample2x_ppiir(a, b);\n\t\tpoke(pass3_buf, v, i);\n\t}\n\tfor(i = 0; i < 2; i = i + 1) {\n\t\ta = peek(pass3_buf, i * 2);\n\t\tb = peek(pass3_buf, (i * 2) + 1);\n\t\tv = downsample2x_ppiir(a, b);\n\t\tpoke(pass4_buf, v, i);\n\t}\n\ty1 = peek(pass4_buf, 0);\n\ty2 = peek(pass4_buf, 1);\n\treturn downsample2x_ppiir(y1, y2);\n}\n\n\n\noversample(x) {\n\treturn x;\n}\n\nup0, up1, up2, up3 = upsample4x_ppiir(in1);\nup_5 = oversample(up0);\nup1 = oversample(up1);\nup2 = oversample(up2);\nup3 = oversample(up3);\nexpr_6 = downsample4x_ppiir(up_5, up1, up2, up3);\nout1 = expr_6;",
