                                }
                            },
                            {
                                "box": {
                                    "id": "obj-18",
                                    "linecount": 6,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 559.0, 304.0, 176.0, 93.0 ],
                                    "text": "1. thru\n2. sideband sub growl\n3. phaseshaper supersaw tri\n4. asymmetric delay adfm\n5. heterodyne fof resonator\n6. virtual riot phase distortion"
                                }
                            },
                            {
                                "box": {
                                    "id": "obj-15",
                                    "maxclass": "newobj",
                                    "numinlets": 4,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patcher": {
                                        "fileversion": 1,
                                        "appversion": {
                                            "major": 9,
                                            "minor": 2,
                                            "revision": 0,
                                            "architecture": "x64",
                                            "modernui": 1
                                        },
                                        "classnamespace": "rnbo",
                                        "rect": [ 100.0, 100.0, 1885.0, 780.0 ],
                                        "default_fontname": "Lato",
                                        "title": "ai.heterodyne_fof_resonator",
                                        "boxes": [
                                            {
                                                "box": {
                                                    "code": "// ============================================================================\n// heterodyne_fof_resonator.txt\n// Unix-Style Stereo Effect: Filterless Heterodyne & FOF Formant Resonator\n// Implements Lazzarini & Timoney (DAFx-12, Paper 58):\n// \"Synthesis of Resonant Sounds with a Heterodyne Model\"\n// (Sections 2.1, 2.2, 3 & 3.1, Eq. 4-14, Fig. 2-4).\n// Generates high-Q vocal/brass resonant formants and Casio CZ-style resonant\n// waveforms WITHOUT an IIR filter (zero self-oscillation blowup or phase smear):\n//   1. Resets an exponential decay envelope `ephasor` M(n) = R^(n mod T0)\n//      (or dual-exponential FOF skirt Ma(n) - Mb(n), Eq. 12) at every period T0\n//      of the tuba's phase-locked fundamental phasor.\n//   2. Crossfades two adjacent harmonic carriers cos(k*w0*n) and cos((k+1)*w0*n)\n//      (Eq. 8-10) so the formant frequency f_c sweeps smoothly without aliasing!\n//   3. Can either ring-modulate the live stereo tuba with the heterodyne grain\n//      or synthesize the pure FOF/CZ resonant wave tracked to the tuba's envelope.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: Tracked Fundamental Pitch f0 in Hz (from 00_tuba_freq_tracker; fallback ZC if <=0)\n//   in4: Optional 1-Bar Phasor [0..1] (sweeps formant_ratio when sweep_depth > 0)\n// Outlets:\n//   out1: Left Heterodyne / FOF Resonant Output\n//   out2: Right Heterodyne / FOF Resonant Output\n\n@param({ min: 1.0, max: 16.0 }) formant_ratio = 4.5;\n@param({ min: 1.0, max: 40.0 }) resonance_q = 12.0;\n@param({ min: 0.0, max: 1.0 }) fof_attack_skirt = 0.5;\n@param({ min: 0.0, max: 1.0 }) cz_window_mode = 0.0;\n@param({ min: 0.0, max: 1.0 }) sweep_depth = 0.35;\n@param({ min: 0.0, max: 1.0 }) tuba_ring_blend = 0.45;\n\n// Fundamental isolation SVF + 4-stage Quadrature IIR Hilbert network for PLL phase lock\n@state fundSvf = new svf();\n@state hReX = new FixedSampleArray(4); @state hReY = new FixedSampleArray(4);\n@state hImX = new FixedSampleArray(4); @state hImY = new FixedSampleArray(4);\n@state hDelRe = 0.0;\n@state pllPhase = 0.0;\n\n// Fallback trackers & state\n@state barFallback = new phasor();\n@state prevBarIn = 0.0;\n@state barHold = 0.0;\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 58.27;\n@state smoothF0 = 58.27;\n@state smoothEnv = 0.0;\n@state in2Hold = 0.0;\n@state smoothRatio = 4.5;\n@state smoothQ = 12.0;\n@state dcXL = 0.0; @state dcYL = 0.0;\n@state dcXR = 0.0; @state dcYR = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\n// Mono fallback: in2 counts as patched for 250 ms after its last non-zero sample\nif (abs(in2) > 0.0000001) {\n\tin2Hold = 0.25 * sr;\n} else if (in2Hold > 0.0) {\n\tin2Hold -= 1.0;\n}\nlet xR = (in2Hold > 0.0) ? in2 : xL;\nlet pitchIn = in3;\nlet barIn = in4;\n\n// --- 1. Pitch Conditioning ---\nlet mono = 0.5 * (xL + xR);\nlet monoLow = lpTrack.next(mono, 190.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slew = 1.0 - exp(-1.0 / (0.006 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slew;\nlet f0 = clamp(smoothF0, 24.0, 1000.0);\n\n// --- 2. Extract Phase-Locked Fundamental Phasor phBase in [0, 1) & Envelope ---\nlet isoFund = fundSvf.next(mono, f0, 0.80)[2];\n\nlet cR0 = 0.4794008656; let cR1 = 0.8762184935; let cR2 = 0.9765975895; let cR3 = 0.9974992559;\nlet cI0 = 0.1617584983; let cI1 = 0.7330289323; let cI2 = 0.9453497003; let cI3 = 0.9905991567;\n\n// Quadrature allpass: y[n] = c * (x[n] + y[n-1]) - x[n-1] (H = (c - z^-1)/(1 - c z^-1))\n// This cR/cI order is the negative Hilbert; the imaginary branch is negated below.\nlet re = isoFund;\nlet t = cR0 * (re + hReY[0]) - hReX[0]; hReX[0] = re; hReY[0] = t; re = t;\nt = cR1 * (re + hReY[1]) - hReX[1]; hReX[1] = re; hReY[1] = t; re = t;\nt = cR2 * (re + hReY[2]) - hReX[2]; hReX[2] = re; hReY[2] = t; re = t;\nt = cR3 * (re + hReY[3]) - hReX[3]; hReX[3] = re; hReY[3] = t; re = t;\nlet sigRe = hDelRe;\nhDelRe = re;\n\nlet im = isoFund;\nt = cI0 * (im + hImY[0]) - hImX[0]; hImX[0] = im; hImY[0] = t; im = t;\nt = cI1 * (im + hImY[1]) - hImX[1]; hImX[1] = im; hImY[1] = t; im = t;\nt = cI2 * (im + hImY[2]) - hImX[2]; hImX[2] = im; hImY[2] = t; im = t;\nt = cI3 * (im + hImY[3]) - hImX[3]; hImX[3] = im; hImY[3] = t; im = t;\nlet sigIm = 0.0 - im; // negate: this order is the negative Hilbert (+f analytic phase)\n\nlet fullAmp = maximum(abs(xL), abs(xR));\nlet envAtk = 1.0 - exp(-1.0 / (0.0025 * sr));\nlet envRel = 1.0 - exp(-1.0 / (0.025 * sr));\nsmoothEnv = (fullAmp > smoothEnv) ? (smoothEnv + (fullAmp - smoothEnv) * envAtk) : (smoothEnv + (fullAmp - smoothEnv) * envRel);\n\n// Phase-Locked Loop (PLL) locks a clean monotonic [0, 1) ramp to the tuba's fundamental\nlet hilbPh = wrap((atan2(sigIm, sigRe) + pi) / (2.0 * pi), 0.0, 1.0);\nlet phErr = wrap(hilbPh - pllPhase + 0.5, 0.0, 1.0) - 0.5;\nlet lockGain = (smoothEnv > 0.002) ? 0.035 : 0.0;\npllPhase = wrap(pllPhase + (f0 / sr) + lockGain * phErr, 0.0, 1.0);\nlet phBase = pllPhase;\n\n// --- 3. Bar-Synced Formant Sweep & Pole Radius R (DAFx-12 Eq. 4, 6, 12) ---\nif (abs(barIn - prevBarIn) > 0.0000001) {\n\tbarHold = 0.1 * sr;\n} else if (barHold > 0.0) {\n\tbarHold -= 1.0;\n}\nprevBarIn = barIn;\nlet fbPh = barFallback.next(0.5);\nlet barPh = (barHold > 0.0) ? wrap(barIn * 2.0, 0.0, 1.0) : fbPh;\nlet lfoBi = sin(2.0 * pi * barPh);\n\nsmoothRatio += (clamp(formant_ratio, 1.0, 16.0) - smoothRatio) * slew;\nsmoothQ += (clamp(resonance_q, 1.0, 40.0) - smoothQ) * slew;\n\nlet swOct = clamp(sweep_depth, 0.0, 1.0) * 1.2;\nlet ratioL = clamp(smoothRatio * pow(2.0, swOct * lfoBi - 0.04), 1.0, 20.0);\nlet ratioR = clamp(smoothRatio * pow(2.0, -swOct * lfoBi + 0.04), 1.0, 20.0);\n\n// Paper Eq. 4: R = exp(-pi * fc / (sr * Q)), so R^(n mod T0) = exp(-pi * (fc/f0) * phBase / Q)\nlet alphaL = pi * ratioL / smoothQ;\nlet alphaR = pi * ratioR / smoothQ;\nlet decayExpL = exp(0.0 - alphaL * phBase);\nlet decayExpR = exp(0.0 - alphaR * phBase);\n\n// Paper Eq. 12: FOF attack skirt subtracts a second faster-decaying exponential Mb(n)\n// Normalize peak amplitude of (e^(-alpha*t) - skirt*e^(-fast*alpha*t)) so high skirt settings stay punchy!\nlet skirtAmt = clamp(fof_attack_skirt, 0.0, 1.0);\nlet fastMult = 3.0 + 12.0 * skirtAmt;\nlet skirtGain = 1.0 + 0.55 * skirtAmt;\nlet fofEnvL = (decayExpL - skirtAmt * exp(0.0 - alphaL * fastMult * phBase)) * skirtGain;\nlet fofEnvR = (decayExpR - skirtAmt * exp(0.0 - alphaR * fastMult * phBase)) * skirtGain;\n\n// Paper Section 3.1 (Eq. 13-14): Casio CZ Resonant Wave modulator (inverted saw / triangle)\n// NOTE: uses phBase (not phi, which RNBO expands to the golden ratio 1.618!)\nlet czEnv = linearinterp(skirtAmt, 1.0 - phBase, triangle(phBase, 0.20));\nlet czBlend = clamp(cz_window_mode, 0.0, 1.0);\nlet modEnvL = linearinterp(czBlend, fofEnvL, czEnv) * sqrt(1.0 + 0.22 * alphaL);\nlet modEnvR = linearinterp(czBlend, fofEnvR, czEnv) * sqrt(1.0 + 0.22 * alphaR);\n\n// --- 4. Fine-Grained Adjacent-Harmonic Dual Carrier Interpolation (Paper Eq. 8-10) ---\nlet kL = floor(ratioL);\nlet aL = ratioL - kL;\nlet carL = (1.0 - aL) * cos(2.0 * pi * kL * phBase) + aL * cos(2.0 * pi * (kL + 1.0) * phBase);\n\nlet kR = floor(ratioR);\nlet aR = ratioR - kR;\nlet carR = (1.0 - aR) * cos(2.0 * pi * kR * phBase) + aR * cos(2.0 * pi * (kR + 1.0) * phBase);\n\n// Add fundamental warmth + formant grain for pure FOF synthesis mode\nlet fundWarmth = 0.28 * sin(2.0 * pi * phBase);\nlet envScale = clamp(smoothEnv * 1.6, 0.0, 1.3);\nlet fofWaveL = (modEnvL * carL + fundWarmth) * envScale;\nlet fofWaveR = (modEnvR * carR + fundWarmth) * envScale;\n\n// Heterodyne-excited acoustic tuba: ring-modulates the tuba with the FOF formant grain\n// while preserving a solid fundamental core\nlet hetGrainL = modEnvL * carL;\nlet hetGrainR = modEnvR * carR;\nlet ringTubaL = xL * (0.45 + 1.65 * hetGrainL) + 0.35 * fofWaveL;\nlet ringTubaR = xR * (0.45 + 1.65 * hetGrainR) + 0.35 * fofWaveR;\n\nlet b = clamp(tuba_ring_blend, 0.0, 1.0);\nlet rawOutL = linearinterp(b, fofWaveL, ringTubaL);\nlet rawOutR = linearinterp(b, fofWaveR, ringTubaR);\n\n// DC blocker\nlet dcPole = 1.0 - (2.0 * pi * 10.0 / sr); // 10 Hz (a fixed 0.995 was 38 Hz at 48 kHz: -1.6 dB at 58 Hz, -4 dB at 29 Hz)\nlet dcOutL = rawOutL - dcXL + dcPole * dcYL;\ndcXL = rawOutL; dcYL = dcOutL;\nlet dcOutR = rawOutR - dcXR + dcPole * dcYR;\ndcXR = rawOutR; dcYR = dcOutR;\n\nout1 = tanh(dcOutL);\nout2 = tanh(dcOutR);\n",
                                                    "fontface": 0,
                                                    "fontname": "<Monospaced>",
                                                    "fontsize": 12.0,
                                                    "id": "obj-2",
                                                    "maxclass": "codebox~",
                                                    "numinlets": 4,
                                                    "numoutlets": 2,
                                                    "outlettype": [ "signal", "signal" ],
                                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                                    "rnbo_classname": "codebox~",
                                                    "rnbo_extra_attributes": {
                                                        "nocache": 0,
                                                        "expr": "",
                                                        "safemath": 1,
                                                        "code": "// ============================================================================\n// heterodyne_fof_resonator.txt\n// Unix-Style Stereo Effect: Filterless Heterodyne & FOF Formant Resonator\n// Implements Lazzarini & Timoney (DAFx-12, Paper 58):\n// \"Synthesis of Resonant Sounds with a Heterodyne Model\"\n// (Sections 2.1, 2.2, 3 & 3.1, Eq. 4-14, Fig. 2-4).\n// Generates high-Q vocal/brass resonant formants and Casio CZ-style resonant\n// waveforms WITHOUT an IIR filter (zero self-oscillation blowup or phase smear):\n//   1. Resets an exponential decay envelope `ephasor` M(n) = R^(n mod T0)\n//      (or dual-exponential FOF skirt Ma(n) - Mb(n), Eq. 12) at every period T0\n//      of the tuba's phase-locked fundamental phasor.\n//   2. Crossfades two adjacent harmonic carriers cos(k*w0*n) and cos((k+1)*w0*n)\n//      (Eq. 8-10) so the formant frequency f_c sweeps smoothly without aliasing!\n//   3. Can either ring-modulate the live stereo tuba with the heterodyne grain\n//      or synthesize the pure FOF/CZ resonant wave tracked to the tuba's envelope.\n// ============================================================================\n// Inlets:\n//   in1: Left Audio Input (Tuba)\n//   in2: Right Audio Input (if unpatched, mono in1 is used automatically)\n//   in3: Tracked Fundamental Pitch f0 in Hz (from 00_tuba_freq_tracker; fallback ZC if <=0)\n//   in4: Optional 1-Bar Phasor [0..1] (sweeps formant_ratio when sweep_depth > 0)\n// Outlets:\n//   out1: Left Heterodyne / FOF Resonant Output\n//   out2: Right Heterodyne / FOF Resonant Output\n\n@param({ min: 1.0, max: 16.0 }) formant_ratio = 4.5;\n@param({ min: 1.0, max: 40.0 }) resonance_q = 12.0;\n@param({ min: 0.0, max: 1.0 }) fof_attack_skirt = 0.5;\n@param({ min: 0.0, max: 1.0 }) cz_window_mode = 0.0;\n@param({ min: 0.0, max: 1.0 }) sweep_depth = 0.35;\n@param({ min: 0.0, max: 1.0 }) tuba_ring_blend = 0.45;\n\n// Fundamental isolation SVF + 4-stage Quadrature IIR Hilbert network for PLL phase lock\n@state fundSvf = new svf();\n@state hReX = new FixedSampleArray(4); @state hReY = new FixedSampleArray(4);\n@state hImX = new FixedSampleArray(4); @state hImY = new FixedSampleArray(4);\n@state hDelRe = 0.0;\n@state pllPhase = 0.0;\n\n// Fallback trackers & state\n@state barFallback = new phasor();\n@state prevBarIn = 0.0;\n@state barHold = 0.0;\n@state lpTrack = new onepole();\n@state prevSig = 0.0;\n@state zcCount = 0.0;\n@state zcHz = 58.27;\n@state smoothF0 = 58.27;\n@state smoothEnv = 0.0;\n@state in2Hold = 0.0;\n@state smoothRatio = 4.5;\n@state smoothQ = 12.0;\n@state dcXL = 0.0; @state dcYL = 0.0;\n@state dcXR = 0.0; @state dcYR = 0.0;\n\nlet sr = maximum(samplerate(), 1.0);\nlet xL = in1;\n// Mono fallback: in2 counts as patched for 250 ms after its last non-zero sample\nif (abs(in2) > 0.0000001) {\n\tin2Hold = 0.25 * sr;\n} else if (in2Hold > 0.0) {\n\tin2Hold -= 1.0;\n}\nlet xR = (in2Hold > 0.0) ? in2 : xL;\nlet pitchIn = in3;\nlet barIn = in4;\n\n// --- 1. Pitch Conditioning ---\nlet mono = 0.5 * (xL + xR);\nlet monoLow = lpTrack.next(mono, 190.0);\nzcCount += 1.0;\nif (prevSig <= 0.0 && monoLow > 0.0) {\n\tif (zcCount > sr / 500.0 && zcCount < sr / 22.0) {\n\t\tzcHz = sr / zcCount;\n\t}\n\tzcCount = 0.0;\n}\nprevSig = monoLow;\n\nlet rawF0 = (pitchIn > 20.0 && pitchIn < 1000.0) ? pitchIn : zcHz;\nlet slew = 1.0 - exp(-1.0 / (0.006 * sr));\nsmoothF0 += (rawF0 - smoothF0) * slew;\nlet f0 = clamp(smoothF0, 24.0, 1000.0);\n\n// --- 2. Extract Phase-Locked Fundamental Phasor phBase in [0, 1) & Envelope ---\nlet isoFund = fundSvf.next(mono, f0, 0.80)[2];\n\nlet cR0 = 0.4794008656; let cR1 = 0.8762184935; let cR2 = 0.9765975895; let cR3 = 0.9974992559;\nlet cI0 = 0.1617584983; let cI1 = 0.7330289323; let cI2 = 0.9453497003; let cI3 = 0.9905991567;\n\n// Quadrature allpass: y[n] = c * (x[n] + y[n-1]) - x[n-1] (H = (c - z^-1)/(1 - c z^-1))\n// This cR/cI order is the negative Hilbert; the imaginary branch is negated below.\nlet re = isoFund;\nlet t = cR0 * (re + hReY[0]) - hReX[0]; hReX[0] = re; hReY[0] = t; re = t;\nt = cR1 * (re + hReY[1]) - hReX[1]; hReX[1] = re; hReY[1] = t; re = t;\nt = cR2 * (re + hReY[2]) - hReX[2]; hReX[2] = re; hReY[2] = t; re = t;\nt = cR3 * (re + hReY[3]) - hReX[3]; hReX[3] = re; hReY[3] = t; re = t;\nlet sigRe = hDelRe;\nhDelRe = re;\n\nlet im = isoFund;\nt = cI0 * (im + hImY[0]) - hImX[0]; hImX[0] = im; hImY[0] = t; im = t;\nt = cI1 * (im + hImY[1]) - hImX[1]; hImX[1] = im; hImY[1] = t; im = t;\nt = cI2 * (im + hImY[2]) - hImX[2]; hImX[2] = im; hImY[2] = t; im = t;\nt = cI3 * (im + hImY[3]) - hImX[3]; hImX[3] = im; hImY[3] = t; im = t;\nlet sigIm = 0.0 - im; // negate: this order is the negative Hilbert (+f analytic phase)\n\nlet fullAmp = maximum(abs(xL), abs(xR));\nlet envAtk = 1.0 - exp(-1.0 / (0.0025 * sr));\nlet envRel = 1.0 - exp(-1.0 / (0.025 * sr));\nsmoothEnv = (fullAmp > smoothEnv) ? (smoothEnv + (fullAmp - smoothEnv) * envAtk) : (smoothEnv + (fullAmp - smoothEnv) * envRel);\n\n// Phase-Locked Loop (PLL) locks a clean monotonic [0, 1) ramp to the tuba's fundamental\nlet hilbPh = wrap((atan2(sigIm, sigRe) + pi) / (2.0 * pi), 0.0, 1.0);\nlet phErr = wrap(hilbPh - pllPhase + 0.5, 0.0, 1.0) - 0.5;\nlet lockGain = (smoothEnv > 0.002) ? 0.035 : 0.0;\npllPhase = wrap(pllPhase + (f0 / sr) + lockGain * phErr, 0.0, 1.0);\nlet phBase = pllPhase;\n\n// --- 3. Bar-Synced Formant Sweep & Pole Radius R (DAFx-12 Eq. 4, 6, 12) ---\nif (abs(barIn - prevBarIn) > 0.0000001) {\n\tbarHold = 0.1 * sr;\n} else if (barHold > 0.0) {\n\tbarHold -= 1.0;\n}\nprevBarIn = barIn;\nlet fbPh = barFallback.next(0.5);\nlet barPh = (barHold > 0.0) ? wrap(barIn * 2.0, 0.0, 1.0) : fbPh;\nlet lfoBi = sin(2.0 * pi * barPh);\n\nsmoothRatio += (clamp(formant_ratio, 1.0, 16.0) - smoothRatio) * slew;\nsmoothQ += (clamp(resonance_q, 1.0, 40.0) - smoothQ) * slew;\n\nlet swOct = clamp(sweep_depth, 0.0, 1.0) * 1.2;\nlet ratioL = clamp(smoothRatio * pow(2.0, swOct * lfoBi - 0.04), 1.0, 20.0);\nlet ratioR = clamp(smoothRatio * pow(2.0, -swOct * lfoBi + 0.04), 1.0, 20.0);\n\n// Paper Eq. 4: R = exp(-pi * fc / (sr * Q)), so R^(n mod T0) = exp(-pi * (fc/f0) * phBase / Q)\nlet alphaL = pi * ratioL / smoothQ;\nlet alphaR = pi * ratioR / smoothQ;\nlet decayExpL = exp(0.0 - alphaL * phBase);\nlet decayExpR = exp(0.0 - alphaR * phBase);\n\n// Paper Eq. 12: FOF attack skirt subtracts a second faster-decaying exponential Mb(n)\n// Normalize peak amplitude of (e^(-alpha*t) - skirt*e^(-fast*alpha*t)) so high skirt settings stay punchy!\nlet skirtAmt = clamp(fof_attack_skirt, 0.0, 1.0);\nlet fastMult = 3.0 + 12.0 * skirtAmt;\nlet skirtGain = 1.0 + 0.55 * skirtAmt;\nlet fofEnvL = (decayExpL - skirtAmt * exp(0.0 - alphaL * fastMult * phBase)) * skirtGain;\nlet fofEnvR = (decayExpR - skirtAmt * exp(0.0 - alphaR * fastMult * phBase)) * skirtGain;\n\n// Paper Section 3.1 (Eq. 13-14): Casio CZ Resonant Wave modulator (inverted saw / triangle)\n// NOTE: uses phBase (not phi, which RNBO expands to the golden ratio 1.618!)\nlet czEnv = linearinterp(skirtAmt, 1.0 - phBase, triangle(phBase, 0.20));\nlet czBlend = clamp(cz_window_mode, 0.0, 1.0);\nlet modEnvL = linearinterp(czBlend, fofEnvL, czEnv) * sqrt(1.0 + 0.22 * alphaL);\nlet modEnvR = linearinterp(czBlend, fofEnvR, czEnv) * sqrt(1.0 + 0.22 * alphaR);\n\n// --- 4. Fine-Grained Adjacent-Harmonic Dual Carrier Interpolation (Paper Eq. 8-10) ---\nlet kL = floor(ratioL);\nlet aL = ratioL - kL;\nlet carL = (1.0 - aL) * cos(2.0 * pi * kL * phBase) + aL * cos(2.0 * pi * (kL + 1.0) * phBase);\n\nlet kR = floor(ratioR);\nlet aR = ratioR - kR;\nlet carR = (1.0 - aR) * cos(2.0 * pi * kR * phBase) + aR * cos(2.0 * pi * (kR + 1.0) * phBase);\n\n// Add fundamental warmth + formant grain for pure FOF synthesis mode\nlet fundWarmth = 0.28 * sin(2.0 * pi * phBase);\nlet envScale = clamp(smoothEnv * 1.6, 0.0, 1.3);\nlet fofWaveL = (modEnvL * carL + fundWarmth) * envScale;\nlet fofWaveR = (modEnvR * carR + fundWarmth) * envScale;\n\n// Heterodyne-excited acoustic tuba: ring-modulates the tuba with the FOF formant grain\n// while preserving a solid fundamental core\nlet hetGrainL = modEnvL * carL;\nlet hetGrainR = modEnvR * carR;\nlet ringTubaL = xL * (0.45 + 1.65 * hetGrainL) + 0.35 * fofWaveL;\nlet ringTubaR = xR * (0.45 + 1.65 * hetGrainR) + 0.35 * fofWaveR;\n\nlet b = clamp(tuba_ring_blend, 0.0, 1.0);\nlet rawOutL = linearinterp(b, fofWaveL, ringTubaL);\nlet rawOutR = linearinterp(b, fofWaveR, ringTubaR);\n\n// DC blocker\nlet dcPole = 1.0 - (2.0 * pi * 10.0 / sr); // 10 Hz (a fixed 0.995 was 38 Hz at 48 kHz: -1.6 dB at 58 Hz, -4 dB at 29 Hz)\nlet dcOutL = rawOutL - dcXL + dcPole * dcYL;\ndcXL = rawOutL; dcYL = dcOutL;\nlet dcOutR = rawOutR - dcXR + dcPole * dcYR;\ndcXR = rawOutR; dcYR = dcOutR;\n\nout1 = tanh(dcOutL);\nout2 = tanh(dcOutR);\n"
                                                    },
                                                    "rnbo_serial": 1,
                                                    "rnbo_uniqueid": "effect_code",
