                        "gencode": "Param g(1, max=1, min=-1);\nParam c(0, max=1, min=-1);\nParam k(0, max=1, min=-1);\nDelay delay_1(samplerate);\nDelay delay_2(samplerate);\nmtof_3 = mtof(in2, 440);\nrdiv_4 = samplerate / mtof_3;\nmtof_5 = mtof(in3, 440);\nrdiv_6 = samplerate / mtof_5;\ntap_7 = delay_1.read(rdiv_6);\nneg_8 = -k;\nmul_9 = tap_7 * neg_8;\ntap_10 = delay_2.read(rdiv_4);\nmul_11 = tap_10 * c;\nadd_12 = mul_11 + mul_9;\nmul_13 = add_12 * k;\nadd_14 = mul_13 + tap_7;\nadd_15 = in1 + add_14;\nmul_16 = add_15 * g;\nadd_17 = mul_16 + add_14;\ngen_18 = add_17;\nout1 = gen_18;\ndelay_1.write(add_12);\ndelay_2.write(add_15);",
