            {
                "box": {
                    "code": "svf_ap(xin, cf, q) {\n    History y0(0), y1(0);\n\n    g = tan(cf * pi / samplerate);\n    r = 1 / q;\n\n    a1 = 1 / (1 + g * (g + r));\n    a2 = g * a1;\n    a3 = g * a2;\n\n    v3 = xin - y1;\n    v1 = a1 * y0 + a2 * v3;\n    v2 = y1 + a2 * y0 + a3 * v3;\n\n    y0 = 2 * v1 - y0;\n    y1 = 2 * v2 - y1;\n\n    lp = v2;\n    bp = v1;\n    hp = xin - r * v1 - v2;\n\n    return lp + hp - r * bp;\n}\n\nlimit = samplerate / 2;\n\ncf = clip(in2, 0, limit);\nq = clip(in3, 0, 1) * 20 + 0.5;\n\nout1 = svf_ap(in1, cf, q);",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-53",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 536.0, 1321.0, 250.0, 160.0 ]
                }
            },
            {
                "box": {
                    "id": "obj-52",
                    "maxclass": "newobj",
                    "numinlets": 0,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 316.0, 1222.0, 29.0, 22.0 ],
                    "text": "220"
                }
            },
            {
                "box": {
                    "code": "svf_ap(xin, cf, q) {\n    History y0(0), y1(0);\n\n    g = tan(cf * pi / samplerate);\n    r = 1 / q;\n\n    a1 = 1 / (1 + g * (g + r));\n    a2 = g * a1;\n    a3 = g * a2;\n\n    v3 = xin - y1;\n    v1 = a1 * y0 + a2 * v3;\n    v2 = y1 + a2 * y0 + a3 * v3;\n\n    y0 = 2 * v1 - y0;\n    y1 = 2 * v2 - y1;\n\n    lp = v2;\n    bp = v1;\n    hp = xin - r * v1 - v2;\n\n    return lp + hp - r * bp;\n}\n\nlimit = samplerate / 2;\n\ncf = clip(in2, 0, limit);\nq = clip(in3, 0, 1) * 20 + 0.5;\n\nout1 = svf_ap(in1, cf, q);",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-51",
                    "maxclass": "codebox",
                    "numinlets": 3,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 116.0, 1321.0, 250.0, 160.0 ]
                }
