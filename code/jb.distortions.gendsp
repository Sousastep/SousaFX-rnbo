            {
                "box": {
                    "code": "require(\"halfband_ppiir.genexpr\");\r\n\r\noversample(x)\r\n{\r\n\treturn(x > 0 ? atan(x) : x);\r\n    //return atan(x);\r\n}\r\n\r\nup0, up1, up2, up3 = upsample4x_ppiir(in1);\r\n// do something to the upsampled values\r\nup0 = oversample(up0);\r\nup1 = oversample(up1);\r\nup2 = oversample(up2);\r\nup3 = oversample(up3);\r\nout1 = dcblock(downsample4x_ppiir(up0, up1, up2, up3));\r\n",
